    fun (xs : List.{0} (Finset.{0} (Fin q))) =>
    @List.all.{0} (Finset.{0} (Fin q)) xs fun (T : Finset.{0} (Fin q)) =>
      @Decidable.decide (Not (@KomorebiRepair.RationalCertificates.InInterval q lo hi T))
        (@instDecidableNot (@KomorebiRepair.RationalCertificates.InInterval q lo hi T)
