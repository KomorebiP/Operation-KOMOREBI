            (@LE.le.{0} (Finset.{0} (Fin q))
              (@Preorder.toLE.{0} (Finset.{0} (Fin q))
                (@PartialOrder.toPreorder.{0} (Finset.{0} (Fin q)) (@Finset.instPartialOrder.{0} (Fin q))))
              lo T)
            (@LE.le.{0} (Finset.{0} (Fin q))
              (@Preorder.toLE.{0} (Finset.{0} (Fin q))
                (@PartialOrder.toPreorder.{0} (Finset.{0} (Fin q)) (@Finset.instPartialOrder.{0} (Fin q))))
              T hi)
            (@Finset.instDecidableLE.{0} (Fin q) (instDecidableEqFin q) lo T)
            (@Finset.instDecidableLE.{0} (Fin q) (instDecidableEqFin q) T hi)))
