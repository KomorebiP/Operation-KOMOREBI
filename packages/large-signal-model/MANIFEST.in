include *.md *.json *.toml *.cff .gitignore .gitattributes .editorconfig .python-version
include LICENSE AUTHORS.md CITATION.cff CHANGELOG.md README.md RELEASE_AUDIT.md REPRODUCIBILITY.md
include requirements-runtime.txt environment.yml pr-lasm.ps1
recursive-include src *.py py.typed
recursive-include tests *.py
recursive-include examples *.py
recursive-include scripts *.py *.ps1 *.md
recursive-include docs *.md *.pdf *.png *.json
recursive-include paper *.md *.pdf *.tex *.png *.json
recursive-include benchmarks *.json *.csv *.md
recursive-include verification *.json *.xml *.log *.txt *.py *.patch *.csv
recursive-include .github *.yml *.md
include environment_files/README.md
prune build
prune dist
prune results
prune .pytest_cache
global-exclude __pycache__ *.py[cod] .coverage

recursive-include config *.json
recursive-include test_environment_files *.py *.json
