      "width": 1672,
      "height": 1078,
      "caption": "The collisionless hierarchy and the earlier adiabatic-fluid closure agree at large scale but differ materially after free streaming populates higher angular moments."
    },
    {
      "source": "monographs/physics/source/cosmology/figures/cb/matter_power_ratio_history.png",
      "source_sha256": "d2d9b5727012761574212cca9af7c8f79685399d319126f45de3afd48dec35b9",
