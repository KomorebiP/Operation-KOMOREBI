Komorebi.SpecialFunctions.Coupled.Scales.Python.Expressions.source_return_interpreted
  (p : Komorebi.SpecialFunctions.Coupled.Scales.RationalScales) (x : ℚ) (last : Option ℕ) (outer : Option ℚ)
