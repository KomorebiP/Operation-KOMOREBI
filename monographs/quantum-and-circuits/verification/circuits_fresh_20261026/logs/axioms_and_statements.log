theorem CircuitObstructions.complete_safe_cover : ∀ {X W : Type} [inst : DecidableEq W]
  (e : CircuitObstructions.Boundary X W) (p q : CircuitObstructions.Circuit W) (f : X → Bool),
  CircuitObstructions.Restores e (p ++ q) f →
    (∀ (x : X) (i : W), CircuitObstructions.packet e p q x i = true → f x = true) ∧
      ∀ (x : X), f x = true ↔ ∃ i, CircuitObstructions.packet e p q x i = true :=
⋯
theorem CircuitObstructions.canonical_complete_safe_cover : ∀ (n a : Nat)
  (c : CircuitObstructions.Circuit (CircuitObstructions.CanonicalWire n a)) (f : (Fin n → Bool) → Bool),
  CircuitObstructions.Restores (CircuitObstructions.canonicalBoundary n a) c f →
    ∀ (k : Nat),
      (∀ (x : Fin n → Bool) (i : CircuitObstructions.CanonicalWire n a),
          CircuitObstructions.packet (CircuitObstructions.canonicalBoundary n a) (List.take k c) (List.drop k c) x i =
              true →
            f x = true) ∧
        ∀ (x : Fin n → Bool),
          f x = true ↔
            ∃ i,
              CircuitObstructions.packet (CircuitObstructions.canonicalBoundary n a) (List.take k c) (List.drop k c) x
                  i =
                true :=
⋯
