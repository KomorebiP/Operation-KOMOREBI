def CircuitObstructions.Restores : {X W : Type} →
  [DecidableEq W] → CircuitObstructions.Boundary X W → CircuitObstructions.Circuit W → (X → Bool) → Prop :=
fun {X W} [DecidableEq W] e c f =>
  ∀ (x : X) (b : Bool), CircuitObstructions.run c (e.encode x b) = e.encode x (b ^^ f x)
theorem CircuitObstructions.cut_transport_identity : ∀ {X W : Type} [inst : DecidableEq W]
  (e : CircuitObstructions.Boundary X W) (p q : CircuitObstructions.Circuit W) (f : X → Bool),
  CircuitObstructions.Restores e (p ++ q) f →
    ∀ (x : X) (i : W), CircuitObstructions.packet e p q x i = (f x && CircuitObstructions.direction e p x i) :=
