Komorebi.QuantumArithmetic.interpret_normSq (z : Komorebi.QuantumArithmetic.Cyclo12) :
  Komorebi.QuantumArithmetic.interpret (Komorebi.QuantumArithmetic.kNormSq z) =
    ↑(Complex.normSq (Komorebi.QuantumArithmetic.interpret z))
