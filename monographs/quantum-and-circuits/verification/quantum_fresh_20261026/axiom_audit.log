'Komorebi.QuantumArithmetic.arithmetic_signal_quantum_bridge' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.arithmetic_signal_quantum_bridge :
  Komorebi.QuantumArithmetic.matMulN 12 Komorebi.QuantumArithmetic.projector12 Komorebi.QuantumArithmetic.projector12 =
      Komorebi.QuantumArithmetic.projector12 ∧
    Komorebi.QuantumArithmetic.matVec Komorebi.QuantumArithmetic.projector12 Komorebi.QuantumArithmetic.testSignal12 =
        Komorebi.QuantumArithmetic.ramanujan12 ∧
      List.map (Komorebi.QuantumArithmetic.dft12 Komorebi.QuantumArithmetic.ramanujanCVector) (List.range 12) =
          [Komorebi.QuantumArithmetic.cRat 0, Komorebi.QuantumArithmetic.cRat 12, Komorebi.QuantumArithmetic.cRat 0,
            Komorebi.QuantumArithmetic.cRat 0, Komorebi.QuantumArithmetic.cRat 0, Komorebi.QuantumArithmetic.cRat 12,
            Komorebi.QuantumArithmetic.cRat 0, Komorebi.QuantumArithmetic.cRat 12, Komorebi.QuantumArithmetic.cRat 0,
            Komorebi.QuantumArithmetic.cRat 0, Komorebi.QuantumArithmetic.cRat 0, Komorebi.QuantumArithmetic.cRat 12] ∧
        Komorebi.QuantumArithmetic.sqEntries Komorebi.QuantumArithmetic.ramanujan12 =
          Komorebi.QuantumArithmetic.sqEntries Komorebi.QuantumArithmetic.absRamanujan12
'Komorebi.QuantumArithmetic.coprime_residues_exact' does not depend on any axioms
Komorebi.QuantumArithmetic.coprime_residues_exact :
  List.filter (fun a => a.gcd 12 == 1) (List.range 12) = Komorebi.QuantumArithmetic.unitResidues12
'Komorebi.QuantumArithmetic.root_exact_order' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.root_exact_order (n : Fin 12) :
  0 < ↑n → Komorebi.QuantumArithmetic.cPow Komorebi.QuantumArithmetic.zeta12 ↑n ≠ Komorebi.QuantumArithmetic.cOne
'Komorebi.QuantumArithmetic.normalized_fourier_left' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.normalized_fourier_left (i j : Komorebi.QuantumArithmetic.Index) :
  Komorebi.QuantumArithmetic.kMatMul (Komorebi.QuantumArithmetic.kAdjoint Komorebi.QuantumArithmetic.exactFourier)
      Komorebi.QuantumArithmetic.exactFourier i j =
