Komorebi.QuantumArithmetic.signed_state_recovers_arithmetic :
  Komorebi.QuantumArithmetic.coprimeProbability
      (Komorebi.QuantumArithmetic.F.conjTranspose.mulVec Komorebi.QuantumArithmetic.psi) =
    1
'Komorebi.QuantumArithmetic.unsigned_state_erases_arithmetic' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.unsigned_state_erases_arithmetic :
  Komorebi.QuantumArithmetic.coprimeProbability
      (Komorebi.QuantumArithmetic.F.conjTranspose.mulVec Komorebi.QuantumArithmetic.chi) =
    0
'Komorebi.QuantumArithmetic.projector_fixes_psi' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.projector_fixes_psi :
  Komorebi.QuantumArithmetic.P.mulVec Komorebi.QuantumArithmetic.psi = Komorebi.QuantumArithmetic.psi
'Komorebi.QuantumArithmetic.projector_kills_chi' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.projector_kills_chi : Komorebi.QuantumArithmetic.P.mulVec Komorebi.QuantumArithmetic.chi = 0
'Komorebi.QuantumArithmetic.root_is_exponential' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.root_is_exponential :
  Komorebi.QuantumArithmetic.interpret Komorebi.QuantumArithmetic.zeta12 = Complex.exp (↑(Real.pi / 6) * Complex.I)
