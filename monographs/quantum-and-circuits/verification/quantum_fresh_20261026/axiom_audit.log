'Komorebi.QuantumArithmetic.recovered_mode_probability' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.recovered_mode_probability : 12 ^ 2 / (48 * 12) = 1 / 4
'Komorebi.QuantumArithmetic.recovered_total_probability' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.recovered_total_probability : 4 * (12 ^ 2 / (48 * 12)) = 1
