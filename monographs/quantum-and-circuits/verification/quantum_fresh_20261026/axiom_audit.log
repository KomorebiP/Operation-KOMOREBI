Komorebi.QuantumArithmetic.exact_state_recovery (i : Komorebi.QuantumArithmetic.Index) :
  Komorebi.QuantumArithmetic.kMatVec (Komorebi.QuantumArithmetic.kAdjoint Komorebi.QuantumArithmetic.exactFourier)
