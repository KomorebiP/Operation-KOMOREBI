Komorebi.QuantumArithmetic.fourier_unitary_left :
  Komorebi.QuantumArithmetic.F.conjTranspose * Komorebi.QuantumArithmetic.F = 1
'Komorebi.QuantumArithmetic.fourier_unitary_right' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.fourier_unitary_right :
  Komorebi.QuantumArithmetic.F * Komorebi.QuantumArithmetic.F.conjTranspose = 1
'Komorebi.QuantumArithmetic.projector_transport' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.projector_transport :
  Komorebi.QuantumArithmetic.F * Komorebi.QuantumArithmetic.D * Komorebi.QuantumArithmetic.F.conjTranspose =
    Komorebi.QuantumArithmetic.P
'Komorebi.QuantumArithmetic.state_preparation' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.state_preparation :
  Komorebi.QuantumArithmetic.F.mulVec Komorebi.QuantumArithmetic.unitState = Komorebi.QuantumArithmetic.psi
'Komorebi.QuantumArithmetic.state_recovery' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.state_recovery :
  Komorebi.QuantumArithmetic.F.conjTranspose.mulVec Komorebi.QuantumArithmetic.psi =
