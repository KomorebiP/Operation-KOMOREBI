Komorebi.QuantumArithmetic.root_power_twelve :
  Komorebi.QuantumArithmetic.interpret Komorebi.QuantumArithmetic.zeta12 ^ 12 = 1
'Komorebi.QuantumArithmetic.rootPower_interpret' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.rootPower_interpret (n : ℕ) :
  Komorebi.QuantumArithmetic.interpret (Komorebi.QuantumArithmetic.rootPower n) =
    Komorebi.QuantumArithmetic.interpret Komorebi.QuantumArithmetic.zeta12 ^ n
'Komorebi.QuantumArithmetic.sqrt_twelve' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.sqrt_twelve : √12 = 2 * √3
'Komorebi.QuantumArithmetic.sqrt_fortyeight' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.sqrt_fortyeight : √48 = 4 * √3
'Komorebi.QuantumArithmetic.fourierScale_interpret' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.fourierScale_interpret :
  Komorebi.QuantumArithmetic.interpret Komorebi.QuantumArithmetic.fourierScale = ↑(1 / √12)
'Komorebi.QuantumArithmetic.stateScale_interpret' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.stateScale_interpret :
  Komorebi.QuantumArithmetic.interpret Komorebi.QuantumArithmetic.stateScale = ↑(1 / √48)
'Komorebi.QuantumArithmetic.fourier_entry_formula' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.fourier_entry_formula (i j : Komorebi.QuantumArithmetic.Index) :
  Komorebi.QuantumArithmetic.F i j = ↑(1 / √12) * Complex.exp (2 * ↑Real.pi * Complex.I * ↑↑i * ↑↑j / 12)
'Komorebi.QuantumArithmetic.psi_entry_formula' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.psi_entry_formula (i : Komorebi.QuantumArithmetic.Index) :
  Komorebi.QuantumArithmetic.psi i = ↑(1 / √48) * ↑(List.getD Komorebi.QuantumArithmetic.ramanujan12 (↑i) 0)
'Komorebi.QuantumArithmetic.chi_entry_formula' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.chi_entry_formula (i : Komorebi.QuantumArithmetic.Index) :
  Komorebi.QuantumArithmetic.chi i = ↑(1 / √48) * ↑(List.getD Komorebi.QuantumArithmetic.absRamanujan12 (↑i) 0)
'Komorebi.QuantumArithmetic.unitState_entry_formula' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.unitState_entry_formula (i : Komorebi.QuantumArithmetic.Index) :
  Komorebi.QuantumArithmetic.unitState i = if (↑i).gcd 12 = 1 then 1 / 2 else 0
'Komorebi.QuantumArithmetic.projector_entry_formula' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.projector_entry_formula (i j : Komorebi.QuantumArithmetic.Index) :
  Komorebi.QuantumArithmetic.P i j = ↑(List.getD Komorebi.QuantumArithmetic.ramanujan12 ((↑i + 12 - ↑j) % 12) 0) / 12
'Komorebi.QuantumArithmetic.selector_idempotent' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.selector_idempotent :
  Komorebi.QuantumArithmetic.D * Komorebi.QuantumArithmetic.D = Komorebi.QuantumArithmetic.D
'Komorebi.QuantumArithmetic.selector_selfAdjoint' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.selector_selfAdjoint :
  Komorebi.QuantumArithmetic.D.conjTranspose = Komorebi.QuantumArithmetic.D
'Komorebi.QuantumArithmetic.projector_idempotent_complex' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.projector_idempotent_complex :
  Komorebi.QuantumArithmetic.P * Komorebi.QuantumArithmetic.P = Komorebi.QuantumArithmetic.P
'Komorebi.QuantumArithmetic.projector_selfAdjoint_complex' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.projector_selfAdjoint_complex :
  Komorebi.QuantumArithmetic.P.conjTranspose = Komorebi.QuantumArithmetic.P
'Komorebi.QuantumArithmetic.complete_phase_separation' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.complete_phase_separation :
  Komorebi.QuantumArithmetic.totalProbability Komorebi.QuantumArithmetic.psi = 1 ∧
    Komorebi.QuantumArithmetic.totalProbability Komorebi.QuantumArithmetic.chi = 1 ∧
      (∀ (i : Komorebi.QuantumArithmetic.Index),
          Complex.normSq (Komorebi.QuantumArithmetic.psi i) = Complex.normSq (Komorebi.QuantumArithmetic.chi i)) ∧
        ∑ i, star (Komorebi.QuantumArithmetic.psi i) * Komorebi.QuantumArithmetic.chi i = 0 ∧
          Komorebi.QuantumArithmetic.coprimeProbability
                (Komorebi.QuantumArithmetic.F.conjTranspose.mulVec Komorebi.QuantumArithmetic.psi) =
              1 ∧
            Komorebi.QuantumArithmetic.coprimeProbability
                (Komorebi.QuantumArithmetic.F.conjTranspose.mulVec Komorebi.QuantumArithmetic.chi) =
              0
'Komorebi.QuantumArithmetic.exact_phase_signal_lookup' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.exact_phase_signal_lookup (i : Komorebi.QuantumArithmetic.Index) :
  Komorebi.QuantumArithmetic.ramanujanC12 ↑i =
    Komorebi.QuantumArithmetic.cRat (List.getD Komorebi.QuantumArithmetic.ramanujan12 (↑i) 0)
'Komorebi.QuantumArithmetic.complex_ramanujan_signal' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.complex_ramanujan_signal (i : Komorebi.QuantumArithmetic.Index) :
  (List.map (fun a => Complex.exp (↑(Real.pi / 6) * Complex.I) ^ (a * ↑i))
        Komorebi.QuantumArithmetic.unitResidues12).sum =
    ↑(List.getD Komorebi.QuantumArithmetic.ramanujan12 (↑i) 0)
'Komorebi.QuantumArithmetic.absolute_signal_lookup' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.absolute_signal_lookup (i : Komorebi.QuantumArithmetic.Index) :
  List.getD Komorebi.QuantumArithmetic.absRamanujan12 (↑i) 0 = |List.getD Komorebi.QuantumArithmetic.ramanujan12 (↑i) 0|
'Komorebi.QuantumArithmetic.retained_discarded_orthogonal' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.retained_discarded_orthogonal :
  Komorebi.QuantumArithmetic.dot Komorebi.QuantumArithmetic.ramanujan12 Komorebi.QuantumArithmetic.noise12 = 0
'Komorebi.QuantumArithmetic.signal_decomposition' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.signal_decomposition :
  Komorebi.QuantumArithmetic.vecAdd Komorebi.QuantumArithmetic.ramanujan12 Komorebi.QuantumArithmetic.noise12 =
    Komorebi.QuantumArithmetic.testSignal12
'Komorebi.QuantumArithmetic.projector_residual_reconstructs' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.projector_residual_reconstructs (v : Komorebi.QuantumArithmetic.Index → ℂ) :
  Komorebi.QuantumArithmetic.P.mulVec v + (1 - Komorebi.QuantumArithmetic.P).mulVec v = v
'Komorebi.QuantumArithmetic.no_reconstruction_from_initial_probabilities' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
Komorebi.QuantumArithmetic.no_reconstruction_from_initial_probabilities :
  ¬∃ R,
      (R fun i => Complex.normSq (Komorebi.QuantumArithmetic.psi i)) = Komorebi.QuantumArithmetic.psi ∧
        (R fun i => Complex.normSq (Komorebi.QuantumArithmetic.chi i)) = Komorebi.QuantumArithmetic.chi
'Komorebi.QuantumArithmetic.recovered_probability_at' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.recovered_probability_at (i : Komorebi.QuantumArithmetic.Index) :
  Complex.normSq (Komorebi.QuantumArithmetic.F.conjTranspose.mulVec Komorebi.QuantumArithmetic.psi i) =
    if (↑i).gcd 12 = 1 then 1 / 4 else 0
'Komorebi.QuantumArithmetic.projector_not_injective' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.projector_not_injective : ¬Function.Injective Komorebi.QuantumArithmetic.P.mulVec
'Komorebi.QuantumArithmetic.publication_bridge' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.publication_bridge :
  Komorebi.QuantumArithmetic.F.conjTranspose * Komorebi.QuantumArithmetic.F = 1 ∧
    Komorebi.QuantumArithmetic.F * Komorebi.QuantumArithmetic.F.conjTranspose = 1 ∧
      Komorebi.QuantumArithmetic.F * Komorebi.QuantumArithmetic.D * Komorebi.QuantumArithmetic.F.conjTranspose =
          Komorebi.QuantumArithmetic.P ∧
        Komorebi.QuantumArithmetic.P * Komorebi.QuantumArithmetic.P = Komorebi.QuantumArithmetic.P ∧
          Komorebi.QuantumArithmetic.P.conjTranspose = Komorebi.QuantumArithmetic.P ∧
            Komorebi.QuantumArithmetic.F.mulVec Komorebi.QuantumArithmetic.unitState = Komorebi.QuantumArithmetic.psi ∧
              Komorebi.QuantumArithmetic.F.conjTranspose.mulVec Komorebi.QuantumArithmetic.psi =
                  Komorebi.QuantumArithmetic.unitState ∧
                Komorebi.QuantumArithmetic.totalProbability Komorebi.QuantumArithmetic.psi = 1 ∧
                  Komorebi.QuantumArithmetic.totalProbability Komorebi.QuantumArithmetic.chi = 1 ∧
                    (∀ (i : Komorebi.QuantumArithmetic.Index),
                        Complex.normSq (Komorebi.QuantumArithmetic.psi i) =
