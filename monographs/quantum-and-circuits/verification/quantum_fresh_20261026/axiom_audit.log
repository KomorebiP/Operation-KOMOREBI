Komorebi.QuantumArithmetic.psi_normalized :
  Komorebi.QuantumArithmetic.totalProbability Komorebi.QuantumArithmetic.psi = 1
'Komorebi.QuantumArithmetic.chi_normalized' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.chi_normalized :
  Komorebi.QuantumArithmetic.totalProbability Komorebi.QuantumArithmetic.chi = 1
'Komorebi.QuantumArithmetic.unitState_normalized' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.unitState_normalized :
  Komorebi.QuantumArithmetic.totalProbability Komorebi.QuantumArithmetic.unitState = 1
'Komorebi.QuantumArithmetic.same_initial_probabilities' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.same_initial_probabilities (i : Komorebi.QuantumArithmetic.Index) :
  Complex.normSq (Komorebi.QuantumArithmetic.psi i) = Complex.normSq (Komorebi.QuantumArithmetic.chi i)
