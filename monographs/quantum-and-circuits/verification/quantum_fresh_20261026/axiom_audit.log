Komorebi.QuantumArithmetic.exact_projector_kills_chi (i : Komorebi.QuantumArithmetic.Index) :
  Komorebi.QuantumArithmetic.kMatVec Komorebi.QuantumArithmetic.exactProjector Komorebi.QuantumArithmetic.exactChi i =
