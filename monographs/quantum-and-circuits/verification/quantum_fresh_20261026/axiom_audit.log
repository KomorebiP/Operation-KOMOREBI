Komorebi.QuantumArithmetic.interpret_sum (xs : List Komorebi.QuantumArithmetic.Cyclo12) :
  Komorebi.QuantumArithmetic.interpret (Komorebi.QuantumArithmetic.cSum xs) =
    (List.map Komorebi.QuantumArithmetic.interpret xs).sum
'Komorebi.QuantumArithmetic.interpret_kSum' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.interpret_kSum (f : Komorebi.QuantumArithmetic.Index → Komorebi.QuantumArithmetic.Cyclo12) :
  Komorebi.QuantumArithmetic.interpret (Komorebi.QuantumArithmetic.kSum f) =
