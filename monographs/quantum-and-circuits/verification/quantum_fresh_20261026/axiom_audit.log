Komorebi.QuantumArithmetic.exact_unit_normalized :
  Komorebi.QuantumArithmetic.kMass Komorebi.QuantumArithmetic.exactUnitState = Komorebi.QuantumArithmetic.cOne
'Komorebi.QuantumArithmetic.exact_psi_normalized' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.exact_psi_normalized :
