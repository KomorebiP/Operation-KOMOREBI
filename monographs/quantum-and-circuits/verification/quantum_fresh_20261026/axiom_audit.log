'Komorebi.QuantumArithmetic.interpret_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.interpret_zero : Komorebi.QuantumArithmetic.interpret Komorebi.QuantumArithmetic.cZero = 0
'Komorebi.QuantumArithmetic.interpret_one' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.interpret_one : Komorebi.QuantumArithmetic.interpret Komorebi.QuantumArithmetic.cOne = 1
'Komorebi.QuantumArithmetic.interpret_rat' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.interpret_rat (r : ℚ) :
