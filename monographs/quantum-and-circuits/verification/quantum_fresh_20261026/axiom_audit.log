'Komorebi.QuantumArithmetic.complexMatrix_adjoint' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.complexMatrix_adjoint (A : Komorebi.QuantumArithmetic.KMatrix) :
  Komorebi.QuantumArithmetic.complexMatrix (Komorebi.QuantumArithmetic.kAdjoint A) =
    (Komorebi.QuantumArithmetic.complexMatrix A).conjTranspose
'Komorebi.QuantumArithmetic.complexMatrix_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.complexMatrix_identity :
  Komorebi.QuantumArithmetic.complexMatrix Komorebi.QuantumArithmetic.kIdentity = 1
'Komorebi.QuantumArithmetic.complexVector_mul' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.complexVector_mul (A : Komorebi.QuantumArithmetic.KMatrix)
  (v : Komorebi.QuantumArithmetic.KVector) :
  Komorebi.QuantumArithmetic.complexVector (Komorebi.QuantumArithmetic.kMatVec A v) =
    (Komorebi.QuantumArithmetic.complexMatrix A).mulVec (Komorebi.QuantumArithmetic.complexVector v)
