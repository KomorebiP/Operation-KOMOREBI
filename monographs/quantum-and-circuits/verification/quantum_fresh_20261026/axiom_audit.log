COMMAND ["lake", "env", "lean", "-DwarningAsError=true", "AxiomAudit.lean"]
'Komorebi.QuantumArithmetic.ramanujan12_length' depends on axioms: [propext, Quot.sound]
Komorebi.QuantumArithmetic.ramanujan12_length : List.length Komorebi.QuantumArithmetic.ramanujan12 = 12
'Komorebi.QuantumArithmetic.projector12_shape' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.projector12_shape :
  List.length Komorebi.QuantumArithmetic.projector12 = 12 ∧
    List.map List.length Komorebi.QuantumArithmetic.projector12 = List.replicate 12 12
