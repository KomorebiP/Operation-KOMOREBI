Komorebi.QuantumArithmetic.interpret_mass (v : Komorebi.QuantumArithmetic.KVector) :
  Komorebi.QuantumArithmetic.interpret (Komorebi.QuantumArithmetic.kMass v) =
    ↑(Komorebi.QuantumArithmetic.totalProbability (Komorebi.QuantumArithmetic.complexVector v))
'Komorebi.QuantumArithmetic.interpret_coprimeMass' depends on axioms: [propext, Classical.choice, Quot.sound]
Komorebi.QuantumArithmetic.interpret_coprimeMass (v : Komorebi.QuantumArithmetic.KVector) :
  Komorebi.QuantumArithmetic.interpret (Komorebi.QuantumArithmetic.kCoprimeMass v) =
    ↑(Komorebi.QuantumArithmetic.coprimeProbability (Komorebi.QuantumArithmetic.complexVector v))
