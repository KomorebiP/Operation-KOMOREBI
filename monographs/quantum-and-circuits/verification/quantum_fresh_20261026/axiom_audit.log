Komorebi.QuantumArithmetic.energy_decomposition :
  Komorebi.QuantumArithmetic.sqEnergy Komorebi.QuantumArithmetic.testSignal12 =
    Komorebi.QuantumArithmetic.sqEnergy Komorebi.QuantumArithmetic.ramanujan12 +
