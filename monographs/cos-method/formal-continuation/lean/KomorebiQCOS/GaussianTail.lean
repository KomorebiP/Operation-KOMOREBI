import KomorebiQCOS.TailProbability
import KomorebiQCOS.Acceptance
import Mathlib.Probability.Distributions.Gaussian.Real
import Mathlib.Probability.Independence.Basic

/-!
# Concrete Gaussian coupling and its acceptance contract

The sample space carries the actual finite product of standard Gaussian measures.
Its coordinate laws and their independence are derived from that product. No
independence predicate, Gaussian-law assertion, or tail value is postulated.
The endpoint numerical enclosures remain explicit hypotheses of acceptance.
-/

namespace KomorebiQCOS
open MeasureTheory ProbabilityTheory
open scoped BigOperators

variable {I : Type*} [Fintype I]

/-- Actual independent standard-Gaussian coordinates. -/
noncomputable def standardGaussianProduct (I : Type*) [Fintype I] : Measure (I → ℝ) :=
  Measure.pi (fun _ : I => gaussianReal 0 1)

instance standardGaussianProduct_isProbability (I : Type*) [Fintype I] :
    IsProbabilityMeasure (standardGaussianProduct I) := by
  unfold standardGaussianProduct
  infer_instance

theorem standardGaussian_coordinate_law (i : I) :
    (standardGaussianProduct I).map (fun z => z i) = gaussianReal 0 1 :=
  (measurePreserving_eval (fun _ : I => gaussianReal 0 1) i).map_eq

theorem standardGaussian_coordinates_independent :
    iIndepFun (fun i (z : I → ℝ) => z i) (standardGaussianProduct I) :=
  iIndepFun_pi (X := fun _ => id) (fun _ => aemeasurable_id)

/-- Closed upper-tail probability of a finite weighted sum of independent normal squares. -/
noncomputable def gaussianWeightedTail (coeff : I → ℝ) (q : ℝ) : ℝ :=
  tailProbability (standardGaussianProduct I) (weightedSquares Finset.univ coeff) q

/-- The distribution is an actual pushforward measure on the real line. -/
noncomputable def gaussianQuadraticLaw (coeff : I → ℝ) : Measure ℝ :=
  (standardGaussianProduct I).map (weightedSquares Finset.univ coeff)

theorem gaussianWeightedTail_measurable (coeff : I → ℝ) :
    Measurable (weightedSquares Finset.univ coeff) :=
  measurable_weightedSquares Finset.univ coeff id (fun i _ => measurable_pi_apply i)

theorem gaussianWeightedTail_eq_law (coeff : I → ℝ) (q : ℝ) :
    gaussianWeightedTail coeff q = (gaussianQuadraticLaw coeff).real (Set.Ici q) :=
  tailProbability_eq_map (standardGaussianProduct I) (gaussianWeightedTail_measurable coeff) q

theorem gaussianWeightedTail_nonneg (coeff : I → ℝ) (q : ℝ) :
    0 ≤ gaussianWeightedTail coeff q :=
  tailProbability_nonneg (standardGaussianProduct I) _ q

theorem gaussianWeightedTail_le_one (coeff : I → ℝ) (q : ℝ) :
    gaussianWeightedTail coeff q ≤ 1 :=
  tailProbability_le_one (standardGaussianProduct I) _ q

/-- Signed coefficients are permitted. The common squares are nonnegative. -/
theorem gaussianWeightedTail_mono (lower upper : I → ℝ)
    (h : ∀ i, lower i ≤ upper i) (q : ℝ) :
    gaussianWeightedTail lower q ≤ gaussianWeightedTail upper q :=
  weightedSquares_tailProbability_mono (standardGaussianProduct I) Finset.univ
    lower upper id (fun i _ => h i) q

theorem gaussianWeightedTail_enclosed (lower coeff upper : I → ℝ)
    (hl : ∀ i, lower i ≤ coeff i) (hu : ∀ i, coeff i ≤ upper i) (q : ℝ) :
    Enclosed (gaussianWeightedTail coeff q)
      (gaussianWeightedTail lower q) (gaussianWeightedTail upper q) :=
  ⟨gaussianWeightedTail_mono lower coeff hl q,
   gaussianWeightedTail_mono coeff upper hu q⟩

/-- The actual Gaussian probability is enclosed by certified endpoint calculations. -/
theorem gaussianWeightedTail_endpoint_enclosure (lower coeff upper : I → ℝ)
    (hl : ∀ i, lower i ≤ coeff i) (hu : ∀ i, coeff i ≤ upper i)
    (q L U : ℝ) (hL : L ≤ gaussianWeightedTail lower q)
    (hU : gaussianWeightedTail upper q ≤ U) :
    Enclosed (gaussianWeightedTail coeff q) L U :=
  enclosed_widen (gaussianWeightedTail_enclosed lower coeff upper hl hu q) hL hU

/-- Coupling, endpoint certificates, and exact executable acceptance compose.
The two endpoint bounds are not generated by this theorem. -/
theorem gaussianWeightedTail_rational_acceptance
    (lower coeff upper : I → ℝ)
    (hl : ∀ i, lower i ≤ coeff i) (hu : ∀ i, coeff i ≤ upper i)
    (q : ℝ) (L U tolerance : ℚ) (estimate : ℝ)
    (hL : (L : ℝ) ≤ gaussianWeightedTail lower q)
    (hU : gaussianWeightedTail upper q ≤ (U : ℝ))
    (he : Enclosed estimate (L : ℝ) (U : ℝ))
    (ha : acceptsRational L U tolerance = true) :
    0 < gaussianWeightedTail coeff q ∧
      |estimate - gaussianWeightedTail coeff q| / gaussianWeightedTail coeff q ≤
        (tolerance : ℝ) := by
  have hp := gaussianWeightedTail_endpoint_enclosure lower coeff upper hl hu q L U hL hU
  exact ⟨enclosed_positive hp (acceptsRational_sound ha).1,
    acceptsRational_relative_error hp he ha⟩

/-- Exact Gram semantics under the concrete standard-Gaussian sample law. -/
theorem gaussianGram_tail_eq_energy {Row Variant : Type*} [Fintype Row]
    (s : Finset Variant) (A : Row → Variant → ℝ) (q : ℝ) :
    tailProbability (standardGaussianProduct Row)
        (fun z => quadraticForm (gramEntry s A) z) q =
      tailProbability (standardGaussianProduct Row) (factorEnergy s A) q :=
  gram_tailProbability_eq_energy (standardGaussianProduct Row) s A id q

end KomorebiQCOS
