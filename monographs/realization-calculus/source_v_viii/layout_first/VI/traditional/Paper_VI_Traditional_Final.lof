\contentsline {figure}{\numberline {1}{\ignorespaces The common operator language used throughout the paper. Semigroups, resolvents, normalized Bayesian maps, and fractional powers are distinct realizations of the same transfer stage.}}{3}{figure.caption.2}%
\contentsline {figure}{\numberline {2}{\ignorespaces Two rational transfer steps resolved through all three intermediate states. The displayed products are computed exactly before plotting. This finite illustration explains the intermediate-packet sum.}}{4}{figure.caption.3}%
\contentsline {figure}{\numberline {3}{\ignorespaces Norms of the packet blocks $P_\mitbeta e^{tA}P_\mitalpha $. Off-diagonal entries quantify transfer between packets.}}{6}{figure.caption.4}%
\contentsline {figure}{\numberline {4}{\ignorespaces Exact generator intertwining gives a vanishing semigroup defect. A controlled perturbation produces a nonzero defect propagated by the Duhamel identity.}}{7}{figure.caption.5}%
\contentsline {figure}{\numberline {5}{\ignorespaces The point mass $\mitdelta _0$ propagated by repeated symmetric random-walk transfer.}}{9}{figure.caption.6}%
\contentsline {figure}{\numberline {6}{\ignorespaces Exact lumping agrees at every horizon. A small generator-level or one-step defect creates a controlled coarse discrepancy.}}{10}{figure.caption.7}%
\contentsline {figure}{\numberline {7}{\ignorespaces Hermite--Gaussian packets, which diagonalize the Ornstein--Uhlenbeck semigroup. The finite numerical release verifies their Gaussian orthogonality through quadrature. The five displayed modes run from n = 0 at the bottom to n = 4 at the top. Vertical offsets separate the curves.}}{12}{figure.caption.8}%
\contentsline {figure}{\numberline {8}{\ignorespaces A finite prior and posterior split into two state packets. Evidence changes both the local packet shape and the global packet mass.}}{14}{figure.caption.9}%
\contentsline {figure}{\numberline {9}{\ignorespaces Two rational priors with the same two coarse masses. A blockwise constant likelihood gives the same coarse update, while a likelihood varying within a block separates the posteriors. The exact fractions are calculated before plotting.}}{15}{figure.caption.10}%
\contentsline {figure}{\numberline {10}{\ignorespaces For strictly positive likelihoods and at least two coarse packets, the Bayesian refinement square commutes for every prior exactly when the likelihood is constant on each coarsening fiber, up to one global scale.}}{18}{figure.caption.11}%
\contentsline {figure}{\numberline {11}{\ignorespaces When packet sufficiency fails, the exact defect factors through the difference between the conditional effective likelihood and the declared coarse likelihood.}}{19}{figure.caption.12}%
\contentsline {figure}{\numberline {12}{\ignorespaces Continuous likelihood accumulation produces a nonlinear semigroup on the probability simplex.}}{20}{figure.caption.13}%
\contentsline {figure}{\numberline {13}{\ignorespaces A conjugate Bayesian update viewed as exact transfer of exponent packets.}}{21}{figure.caption.14}%
\contentsline {figure}{\numberline {14}{\ignorespaces A hidden Markov filter alternates a linear prediction semigroup with nonlinear Bayesian normalization.}}{22}{figure.caption.15}%
\contentsline {figure}{\numberline {15}{\ignorespaces Different spectral exponents produce different transfer profiles from the same point seed.}}{23}{figure.caption.16}%
\contentsline {figure}{\numberline {16}{\ignorespaces A generator-level refinement defect transfers quantitatively to fractional powers and then to fractional semigroups. The two upper curves are theorem certificates, not fitted error bars.}}{26}{figure.caption.17}%
\contentsline {figure}{\numberline {17}{\ignorespaces A section of the continuum Green kernel and the scaled discrete inverse. They agree at the grid nodes.}}{28}{figure.caption.18}%
\contentsline {figure}{\numberline {18}{\ignorespaces The first finite-difference eigenvalue converges with observed order approximately two.}}{29}{figure.caption.19}%
\contentsline {figure}{\numberline {19}{\ignorespaces Potential-weighted transfer values computed by the finite Feynman--Kac operator. Exhaustive path enumeration agrees with the matrix formula in the supplied tests.}}{30}{figure.caption.20}%
\contentsline {figure}{\numberline {20}{\ignorespaces The norm of the exact memory kernel produced by eliminated packets.}}{32}{figure.caption.21}%
\contentsline {figure}{\numberline {21}{\ignorespaces Survival and instantaneous hazard produced by one transient transfer semigroup.}}{33}{figure.caption.22}%
\contentsline {figure}{\numberline {E1}{\ignorespaces Packet block norms at three times. Transfer appears in the off diagonal blocks as soon as the generator couples the two packet spaces. The three panels are shown in consecutive figures.}}{46}{figure.caption.31}%
\contentsline {figure}{\numberline {E2}{\ignorespaces Packet block norms at time 0.8. The same fixed packet spaces and norm scale are used in the preceding panels.}}{46}{figure.caption.32}%
\contentsline {figure}{\numberline {E3}{\ignorespaces Packet block norms at time 2.0. The same fixed packet spaces and norm scale are used in the preceding panels.}}{47}{figure.caption.33}%
\contentsline {figure}{\numberline {E4}{\ignorespaces A finite semigroup defect and a direct Duhamel bound. The bound is designed to be uniform rather than sharp in this example.}}{50}{figure.caption.34}%
\contentsline {figure}{\numberline {E5}{\ignorespaces Exact lumping agrees at every horizon. A small violation of the block transition condition produces a visible but controlled discrepancy.}}{58}{figure.caption.35}%
\contentsline {figure}{\numberline {E6}{\ignorespaces Energy carried by the mean packet and three successive martingale difference packets in a finite weighted example.}}{60}{figure.caption.36}%
\contentsline {figure}{\numberline {E7}{\ignorespaces Hermite packet multipliers for the Ornstein Uhlenbeck semigroup and two fractional powers of its number operator.}}{63}{figure.caption.37}%
\contentsline {figure}{\numberline {E8}{\ignorespaces A prior and posterior on two coarse packets. The likelihood is constant in the first packet and varies inside the second, so only the second local conditional distribution changes.}}{65}{figure.caption.38}%
\contentsline {figure}{\numberline {E9}{\ignorespaces Relative information separated into a coarse packet contribution and conditional contributions inside the packets.}}{69}{figure.caption.39}%
\contentsline {figure}{\numberline {E10}{\ignorespaces A finite Bayesian flow. Mass concentrates on the states with the largest score, while every relative odds ratio follows an exact exponential law.}}{71}{figure.caption.40}%
\contentsline {figure}{\numberline {E11}{\ignorespaces Fractional semigroup multipliers at time one. Smaller exponents preserve more of the high spectral range.}}{75}{figure.caption.41}%
\contentsline {figure}{\numberline {E12}{\ignorespaces The continuum Dirichlet Green section and the scaled discrete inverse. The nodal values agree exactly.}}{77}{figure.caption.42}%
\contentsline {figure}{\numberline {E13}{\ignorespaces A two-coordinate Jordan hidden block has an exponential decay factor and a polynomial factor. The nilpotent polynomial is checked exactly at the displayed rational times. The exponential curve is a plotted illustration of the formula.}}{82}{figure.caption.43}%
\contentsline {figure}{\numberline {E14}{\ignorespaces A stable Jordan block produces a polynomial exponential memory mode. A diagonal hidden block produces only pure exponentials.}}{85}{figure.caption.44}%
\contentsline {figure}{\numberline {E15}{\ignorespaces Full and truncated memory kernels with their pointwise difference. The bound uses integrated error.}}{86}{figure.caption.45}%
\contentsline {figure}{\numberline {E16}{\ignorespaces Survival and two cause specific event densities from one transient semigroup.}}{89}{figure.caption.46}%
