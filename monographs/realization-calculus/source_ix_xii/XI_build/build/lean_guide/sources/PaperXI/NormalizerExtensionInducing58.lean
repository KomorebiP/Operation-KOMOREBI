import PaperXI.CentralExtensionInducing
import PaperXI.QuotientRepresentation
import Mathlib.GroupTheory.SemidirectProduct
import Mathlib.Tactic.Group
import Mathlib.LinearAlgebra.GeneralLinearGroup.Basic

/-!
# Extension across a noncentral normalizing cyclic direction

A single conjugation intertwiner propagates to all integer powers. Unique
semidirect coordinates then define an action on the literal generated subgroup.
No centrality assumption is made on the adjoined ambient group element.
-/
set_option autoImplicit false
noncomputable section
namespace PaperXI.NormalizerExtensionInducing58

section Covariance
variable {N H : Type*} [Group N] [Group H]

/-- Compatible automorphism/operator pairs form a group, including inverses. -/
def compatiblePairs (f : N →* H) : Subgroup (MulAut N × H) where
  carrier := {p | ∀ x, f (p.1 x) = p.2 * f x * p.2⁻¹}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb x
    change f (a.1 (b.1 x)) = (a.2 * b.2) * f x * (a.2 * b.2)⁻¹
    rw [ha, hb]
    group
  inv_mem' := by
    intro a ha x
    change f (a.1⁻¹ x) = a.2⁻¹ * f x * (a.2⁻¹)⁻¹
    have he := ha (a.1⁻¹ x)
    have he' : f x = a.2 * f (a.1⁻¹ x) * a.2⁻¹ := by simpa using he
    calc
      f (a.1⁻¹ x) = a.2⁻¹ * (a.2 * f (a.1⁻¹ x) * a.2⁻¹) * a.2 := by group
      _ = a.2⁻¹ * f x * (a.2⁻¹)⁻¹ := by rw [← he']; simp

/-- One generator covariance identity implies every positive and negative power. -/
theorem covariance_zpow (f : N →* H) (α : MulAut N) (A : H)
    (h : ∀ x, f (α x) = A * f x * A⁻¹) (r : ℤ) (x : N) :
    f ((α ^ r) x) = A ^ r * f x * (A ^ r)⁻¹ := by
  have hp : (α, A) ∈ compatiblePairs f := h
  have hh := (compatiblePairs f).zpow_mem hp r
  exact hh x
end Covariance

section Coordinates
variable {G : Type*} [Group G]
variable (J : Subgroup G) (t : G) (ht : t ∈ Subgroup.normalizer (J : Set G))

/-- The actual conjugation automorphism of the original subgroup. -/
def conjugation : MulAut J := J.normalizerMonoidHom ⟨t, ht⟩

/-- Integer powers act by actual conjugation inside the ambient group. -/
def conjugationAction : Multiplicative ℤ →* MulAut J :=
  zpowersHom (MulAut J) (conjugation J t ht)

@[simp] theorem conjugation_coe (j : J) :
    ((conjugation J t ht j : J) : G) = t * (j : G) * t⁻¹ := rfl

@[simp] theorem conjugationAction_coe (r : Multiplicative ℤ) (j : J) :
    ((conjugationAction J t ht r j : J) : G) =
      t ^ r.toAdd * (j : G) * (t ^ r.toAdd)⁻¹ := by
  exact covariance_zpow J.subtype (conjugation J t ht) t
    (fun x => conjugation_coe J t ht x) r.toAdd j

/-- Actual normal forms multiply by the semidirect rule. -/
def normalFormHom : SemidirectProduct J (Multiplicative ℤ) (conjugationAction J t ht) →* G :=
  SemidirectProduct.lift J.subtype (zpowersHom G t) (by
    intro r
    ext j
    exact conjugationAction_coe J t ht r j)

@[simp] theorem normalFormHom_apply
    (p : SemidirectProduct J (Multiplicative ℤ) (conjugationAction J t ht)) :
    normalFormHom J t ht p = (p.left : G) * t ^ p.right.toAdd := rfl

/-- The literal subgroup generated by the original subgroup and t. -/
def extendedSubgroup : Subgroup G := (normalFormHom J t ht).range

theorem le_extendedSubgroup : J ≤ extendedSubgroup J t ht := by
  intro j hj
  exact ⟨SemidirectProduct.inl ⟨j, hj⟩, by simp⟩

theorem generator_mem : t ∈ extendedSubgroup J t ht := by
  exact ⟨SemidirectProduct.inr (Multiplicative.ofAdd 1), by simp⟩

theorem extendedSubgroup_eq_sup : extendedSubgroup J t ht = J ⊔ Subgroup.zpowers t := by
  apply le_antisymm
  · rintro g ⟨p, rfl⟩
    exact Subgroup.mul_mem _ ((show J ≤ J ⊔ Subgroup.zpowers t from le_sup_left) p.left.property)
      ((show Subgroup.zpowers t ≤ J ⊔ Subgroup.zpowers t from le_sup_right)
        (Subgroup.zpow_mem _ (Subgroup.mem_zpowers t) p.right.toAdd))
  · exact sup_le (le_extendedSubgroup J t ht) (Subgroup.zpowers_le.mpr (generator_mem J t ht))

theorem normalFormHom_injective (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0) :
    Function.Injective (normalFormHom J t ht) := by
  apply (injective_iff_map_eq_one _).mpr
  intro p hp
  have he : t ^ p.right.toAdd = (p.left : G)⁻¹ := by
    have hh := congrArg (fun x : G => (p.left : G)⁻¹ * x) hp
    simpa [mul_assoc] using hh
  have hr : p.right.toAdd = 0 := hfree _ (he ▸ J.inv_mem p.left.property)
  have hr' : p.right = 1 := congrArg Multiplicative.ofAdd hr
  have hj : p.left = 1 := Subtype.ext (by simpa [hr'] using hp)
  apply SemidirectProduct.ext
  · exact hj
  · exact hr'

/-- Unique noncentral semidirect coordinates on an actual subgroup of G. -/
def normalFormEquiv (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0) :
    SemidirectProduct J (Multiplicative ℤ) (conjugationAction J t ht) ≃*
      extendedSubgroup J t ht := MonoidHom.ofInjective (normalFormHom_injective J t ht hfree)
@[simp] theorem normalFormEquiv_coe
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0)
    (p : SemidirectProduct J (Multiplicative ℤ) (conjugationAction J t ht)) :
    ((normalFormEquiv J t ht hfree p : extendedSubgroup J t ht) : G) =
      (p.left : G) * t ^ p.right.toAdd := rfl

/-- The original subgroup inside its actual generated extension. -/
def subgroupInclusion : J →* extendedSubgroup J t ht :=
  Subgroup.inclusion (le_extendedSubgroup J t ht)

/-- The normalizing generator as an element of the actual extended subgroup. -/
def generator : extendedSubgroup J t ht := ⟨t, generator_mem J t ht⟩

variable {k V : Type*} [Field k] [AddCommGroup V] [Module k V]
variable (σ : Representation k J V) (A : Units (Module.End k V))
variable (hA : ∀ j, σ.asGroupHom (conjugation J t ht j) = A * σ.asGroupHom j * A⁻¹)

/-- The action on semidirect coordinates, derived from one generator covariance. -/
def semidirectRepresentation :
    Representation k (SemidirectProduct J (Multiplicative ℤ) (conjugationAction J t ht)) V :=
  (Units.coeHom (Module.End k V)).comp
    (SemidirectProduct.lift σ.asGroupHom (zpowersHom (Units (Module.End k V)) A) (by
      intro r
      apply MonoidHom.ext
      intro j
      exact covariance_zpow σ.asGroupHom (conjugation J t ht) A hA r.toAdd j))

/-- Extend the given action to the literal subgroup generated by J and t. -/
def extendedRepresentation (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0) :
    Representation k (extendedSubgroup J t ht) V :=
  (semidirectRepresentation J t ht σ A hA).comp (normalFormEquiv J t ht hfree).symm.toMonoidHom

@[simp] theorem extendedRepresentation_normalForm
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0)
    (p : SemidirectProduct J (Multiplicative ℤ) (conjugationAction J t ht)) :
    extendedRepresentation J t ht σ A hA hfree (normalFormEquiv J t ht hfree p) =
      σ p.left * (A ^ p.right.toAdd : Units (Module.End k V)) := by
  simp [extendedRepresentation, semidirectRepresentation, SemidirectProduct.lift,
    Representation.asGroupHom_apply]

@[simp] theorem extendedRepresentation_restrict
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0) (j : J) :
    extendedRepresentation J t ht σ A hA hfree (subgroupInclusion J t ht j) = σ j := by
  have he : subgroupInclusion J t ht j =
      normalFormEquiv J t ht hfree (SemidirectProduct.inl j) := Subtype.ext (by simp [subgroupInclusion])
  rw [he, extendedRepresentation_normalForm]
  simp

@[simp] theorem extendedRepresentation_generator
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0) :
    extendedRepresentation J t ht σ A hA hfree (generator J t ht) = (A : Module.End k V) := by
  have he : generator J t ht = normalFormEquiv J t ht hfree
      (SemidirectProduct.inr (Multiplicative.ofAdd 1)) := Subtype.ext (by simp [generator])
  rw [he, extendedRepresentation_normalForm]
  simp

/-- Extending a genuine irreducible action preserves irreducibility. -/
theorem extendedRepresentation_irreducible
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0) [Representation.IsIrreducible σ] :
    Representation.IsIrreducible (extendedRepresentation J t ht σ A hA hfree) := by
  let : Nontrivial V := GeneratedIrreducibility.nontrivial_space σ
  apply RepresentationStability.irreducible_of_stable
  intro S hS
  apply RepresentationStability.eq_bot_or_top σ S
  intro j v hv
  simpa using hS (subgroupInclusion J t ht j) v hv

/-- An actual intertwining equivalence supplies the generator covariance. -/
theorem equiv_unit_covariance
    (e : Representation.Equiv σ (σ.comp (conjugation J t ht).toMonoidHom)) (j : J) :
    σ.asGroupHom (conjugation J t ht j) =
      LinearMap.GeneralLinearGroup.ofLinearEquiv e.toLinearEquiv * σ.asGroupHom j *
        (LinearMap.GeneralLinearGroup.ofLinearEquiv e.toLinearEquiv)⁻¹ := by
  apply Units.ext
  apply LinearMap.ext
  intro v
  change σ (conjugation J t ht j) v =
    e.toLinearEquiv (σ j (e.toLinearEquiv.symm v))
  have he := LinearMap.congr_fun (e.isIntertwining' j) (e.toLinearEquiv.symm v)
  change e.toLinearEquiv (σ j (e.toLinearEquiv.symm v)) =
    σ (conjugation J t ht j) (e.toLinearEquiv (e.toLinearEquiv.symm v)) at he
  rw [e.toLinearEquiv.apply_symm_apply] at he
  exact he.symm

/-- A single nonzero normalizer intertwiner is invertible by actual irreducibility. -/
theorem intertwiner_bijective [Representation.IsIrreducible σ]
    (F : Representation.IntertwiningMap σ (σ.comp (conjugation J t ht).toMonoidHom))
    (hF : F ≠ 0) : Function.Bijective F := by
  let : Representation.IsIrreducible (σ.comp (conjugation J t ht).toMonoidHom) :=
    (QuotientRepresentation.irreducible_comp_iff (conjugation J t ht).toMonoidHom
      (conjugation J t ht).surjective σ).mpr inferInstance
  exact (Representation.IsIrreducible.bijective_or_eq_zero F).resolve_right hF

/-- Extend from one genuine intertwining equivalence, with no scalar action requirement. -/
def extensionOfEquiv
    (e : Representation.Equiv σ (σ.comp (conjugation J t ht).toMonoidHom))
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0) :
    Representation k (extendedSubgroup J t ht) V :=
  extendedRepresentation J t ht σ (LinearMap.GeneralLinearGroup.ofLinearEquiv e.toLinearEquiv)
    (equiv_unit_covariance J t ht σ e) hfree

@[simp] theorem extensionOfEquiv_restrict
    (e : Representation.Equiv σ (σ.comp (conjugation J t ht).toMonoidHom))
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0) (j : J) :
    extensionOfEquiv J t ht σ e hfree (subgroupInclusion J t ht j) = σ j := by
  simp [extensionOfEquiv]

@[simp] theorem extensionOfEquiv_generator
    (e : Representation.Equiv σ (σ.comp (conjugation J t ht).toMonoidHom))
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0) :
    extensionOfEquiv J t ht σ e hfree (generator J t ht) = e.toLinearMap := by
  simp [extensionOfEquiv]
  rfl

/-- A nonzero normalizer Hom supplies an actual irreducible extension to the
literal generated subgroup; its generator action is the supplied Hom operator. -/
theorem exists_extension_of_nonzero [Representation.IsIrreducible σ]
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0)
    (F : Representation.IntertwiningMap σ (σ.comp (conjugation J t ht).toMonoidHom))
    (hF : F ≠ 0) :
    ∃ Λ : Representation k (extendedSubgroup J t ht) V,
      (∀ j : J, Λ (subgroupInclusion J t ht j) = σ j) ∧
      Λ (generator J t ht) = F.toLinearMap ∧ Representation.IsIrreducible Λ := by
  let e := F.ofBijective (intertwiner_bijective J t ht σ F hF)
  refine ⟨extensionOfEquiv J t ht σ e hfree, ?_, ?_, ?_⟩
  · intro j
    exact extensionOfEquiv_restrict J t ht σ e hfree j
  · exact extensionOfEquiv_generator J t ht σ e hfree
  · exact extendedRepresentation_irreducible J t ht σ _ _ hfree

section Topology
variable [TopologicalSpace G] [IsTopologicalGroup G]

/-- The actual noncentral extension subgroup is open when J is open. -/
theorem extendedSubgroup_isOpen (hJ : IsOpen (J : Set G)) :
    IsOpen (extendedSubgroup J t ht : Set G) :=
  Subgroup.isOpen_mono (le_extendedSubgroup J t ht) hJ

/-- Every extended vector stabilizer contains its open original stabilizer. -/
theorem extendedRepresentation_smooth
    (hfree : ∀ r : ℤ, t ^ r ∈ J → r = 0)
    (hJ : IsOpen (J : Set G)) (hσ : SmoothDegreeQuotient.IsSmooth σ) :
    SmoothDegreeQuotient.IsSmooth (extendedRepresentation J t ht σ A hA hfree) := by
  intro v
  let B := (SmoothDegreeQuotient.vectorStabilizer σ v).map J.subtype
  have hB : IsOpen (B : Set G) := hJ.isOpenMap_subtype_val _ (hσ v)
  apply Subgroup.isOpen_mono (H₁ := B.subgroupOf (extendedSubgroup J t ht)) ?_
    ((extendedSubgroup J t ht).subgroupOf_isOpen B hB)
  intro x hx
  obtain ⟨j, hj, he⟩ := hx
  have hxe : x = subgroupInclusion J t ht j := Subtype.ext he.symm
  change extendedRepresentation J t ht σ A hA hfree x v = v
  rw [hxe, extendedRepresentation_restrict]
  exact hj
end Topology
end Coordinates

end PaperXI.NormalizerExtensionInducing58
