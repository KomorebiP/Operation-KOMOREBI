import PaperXI.ActualNormalizerTypeExtension58
import PaperXI.CompactQuotientPeriod69
import Mathlib.GroupTheory.Subgroup.Center

/-! Compactness modulo the actual base-field scalar matrices for E-times-J. -/
set_option autoImplicit false
noncomputable section
namespace PaperXI.ActualFieldTypeQuotient69
open Matrix ValuativeRel
open ActualLocalUnitTopology ActualLocalUnitDecomposition
open ActualEmbeddedUniformizer58 ActualDepthZeroExtension

variable (F E : Type*) [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]
  [Field E] [ValuativeRel E] [TopologicalSpace E]
  [IsNonarchimedeanLocalField E] [Algebra F E]
variable (n : Type*) [Fintype n] [DecidableEq n] [Nonempty n]
  (ι : E →ₐ[F] Matrix n n F) (J : Subgroup (GeneralLinearGroup n F))

/-- The actual subgroup generated by J and the embedded E-multiplicative group. -/
abbrev fieldGroup : Subgroup (GeneralLinearGroup n F) :=
  J ⊔ (unitsEmbedding F E n ι).range

/-- The actual base-field scalar matrices, as a subgroup of E-times-J. -/
def scalarHom : Fˣ →* fieldGroup F E n ι J where
  toFun a := ⟨GeneralLinearGroup.scalar n a, (show (unitsEmbedding F E n ι).range ≤ fieldGroup F E n ι J from le_sup_right)
    ⟨Units.map (algebraMap F E).toMonoidHom a, unitsEmbedding_baseScalar F E n ι a⟩⟩
  map_one' := by ext; simp
  map_mul' a b := by apply Subtype.ext; exact map_mul (GeneralLinearGroup.scalar n) a b

def scalarSubgroup : Subgroup (fieldGroup F E n ι J) :=
  (scalarHom F E n ι J).range

omit [ValuativeRel F] [TopologicalSpace F] [IsNonarchimedeanLocalField F]
  [ValuativeRel E] [TopologicalSpace E] [IsNonarchimedeanLocalField E] [Nonempty n] in
theorem scalar_central (z : scalarSubgroup F E n ι J) (g : GeneralLinearGroup n F) :
    Commute (((z : fieldGroup F E n ι J) : GeneralLinearGroup n F)) g := by
  obtain ⟨a, ha⟩ := z.property
  have hv := congrArg (fun x : fieldGroup F E n ι J => (x : GeneralLinearGroup n F)) ha
  rw [← hv]
  exact GeneralLinearGroup.scalar_commute a g

instance scalar_normal : (scalarSubgroup F E n ι J).Normal :=
  Subgroup.normal_of_le_center (by
    intro z hz
    apply Subgroup.mem_center_iff.mpr
    intro g
    apply Subtype.ext
    exact (scalar_central F E n ι J ⟨z,hz⟩ g).eq.symm)

def compactPart : Subgroup (fieldGroup F E n ι J) :=
  J.subgroupOf (fieldGroup F E n ι J)

/-- Determinant degree detects precisely J inside the field-generated group. -/
theorem degree_kernel
    (hF : Continuous (algebraMap F E))
    (hJ : IsCompact (J : Set (GeneralLinearGroup n F)))
    (ht : embeddedUniformizer F E n ι ∈ Subgroup.normalizer (J : Set (GeneralLinearGroup n F)))
    (hu : ∀ u : 𝒪[E]ˣ, unitsEmbedding F E n ι (unitEmbedding E u) ∈ J)
    (g : fieldGroup F E n ι J) :
    determinantDegree F n (g : GeneralLinearGroup n F) = 1 ↔
      g ∈ compactPart F E n ι J := by
  have hJker := CompactDegreeSeparation.compact_le_degree_ker J (determinantDegree F n)
    (determinantDegree_continuous F n) hJ
  have htn : determinantDegree F n (embeddedUniformizer F E n ι) ≠ 1 :=
    embeddedUniformizer_degree_ne_one F E n ι (algebraEmbedding_continuous F E n ι hF)
  constructor
  · intro hg
    have hmem : (g : GeneralLinearGroup n F) ∈
        NormalizerExtensionInducing58.extendedSubgroup J (embeddedUniformizer F E n ι) ht := by
      rw [ActualNormalizerTypeExtension58.extendedSubgroup_eq_field_join F E n ι J ht hu]
      exact g.property
    obtain ⟨p, hp⟩ := hmem
    have he : determinantDegree F n (embeddedUniformizer F E n ι) ^ p.right.toAdd = 1 := by
      rw [← hp, NormalizerExtensionInducing58.normalFormHom_apply, map_mul, map_zpow] at hg
      have hj : determinantDegree F n (p.left : GeneralLinearGroup n F) = 1 :=
        hJker p.left.property
      simpa only [hj, one_mul] using hg
    have hn : p.right.toAdd = 0 := by
      have hd : (determinantDegree F n (embeddedUniformizer F E n ι)).toAdd ≠ 0 := by
        intro hz
        apply htn
        exact Multiplicative.toAdd.injective hz
      have hmul : p.right.toAdd *
          (determinantDegree F n (embeddedUniformizer F E n ι)).toAdd = 0 := by
        simpa only [toAdd_zpow, zsmul_eq_mul, Int.cast_id, toAdd_one] using congrArg Multiplicative.toAdd he
      exact (mul_eq_zero.mp hmul).resolve_right hd
    have hx : (g : GeneralLinearGroup n F) = p.left := by
      rw [← hp, NormalizerExtensionInducing58.normalFormHom_apply, hn, zpow_zero, mul_one]
    change (g : GeneralLinearGroup n F) ∈ J
    rw [hx]
    exact p.left.property
  · intro hg
    exact hJker hg

/-- The determinant supplies a finite period in the quotient by genuine F-scalars.
The bound is the matrix rank, not a relabeled ramification index. -/
theorem quotient_compact
    (hF : Continuous (algebraMap F E))
    (hJ : IsCompact (J : Set (GeneralLinearGroup n F)))
    (ht : embeddedUniformizer F E n ι ∈ Subgroup.normalizer (J : Set (GeneralLinearGroup n F)))
    (hu : ∀ u : 𝒪[E]ˣ, unitsEmbedding F E n ι (unitEmbedding E u) ∈ J) :
    CompactSpace (fieldGroup F E n ι J ⧸ scalarSubgroup F E n ι J) := by
  let H := fieldGroup F E n ι J
  let Z := scalarSubgroup F E n ι J
  let C := compactPart F E n ι J
  let t : H := ⟨embeddedUniformizer F E n ι,
    (show (unitsEmbedding F E n ι).range ≤ H from le_sup_right) ⟨uniformizerUnit E, rfl⟩⟩
  let z : H := scalarHom F E n ι J (uniformizerUnit F)
  let q := QuotientGroup.mk' Z
  have hC : IsCompact (C : Set H) := by
    apply Topology.IsEmbedding.isCompact_iff
      (f := fun x : H => (x : GeneralLinearGroup n F)) Topology.IsEmbedding.subtypeVal |>.mpr
    convert hJ using 1
    ext x
    constructor
    · rintro ⟨g,hg,rfl⟩
      exact hg
    · intro hx
      exact ⟨⟨x, (show J ≤ H from le_sup_left) hx⟩, hx, rfl⟩
  have hcover : ∀ g : H, ∃ r : ℤ, ∃ j : C, g = t ^ r * (j : H) := by
    intro g
    have hmem : ((g⁻¹ : H) : GeneralLinearGroup n F) ∈
        NormalizerExtensionInducing58.extendedSubgroup J (embeddedUniformizer F E n ι) ht := by
      rw [ActualNormalizerTypeExtension58.extendedSubgroup_eq_field_join F E n ι J ht hu]
      exact (g⁻¹).property
    obtain ⟨p,hp⟩ := hmem
    refine ⟨-p.right.toAdd, ⟨⟨(p.left : GeneralLinearGroup n F)⁻¹,
      (show J ≤ H from le_sup_left) (J.inv_mem p.left.property)⟩, J.inv_mem p.left.property⟩, ?_⟩
    apply Subtype.ext
    change (g : GeneralLinearGroup n F) =
      embeddedUniformizer F E n ι ^ (-p.right.toAdd) * (p.left : GeneralLinearGroup n F)⁻¹
    have he := congrArg Inv.inv hp
    change (NormalizerExtensionInducing58.normalFormHom J
      (embeddedUniformizer F E n ι) ht p)⁻¹ = (g : GeneralLinearGroup n F) at he
    simpa only [NormalizerExtensionInducing58.normalFormHom_apply, _root_.mul_inv_rev,
      ← zpow_neg] using he.symm
  let d : ℤ := (determinantDegree F n (embeddedUniformizer F E n ι)).toAdd
  have hb : t ^ Fintype.card n * z ^ (-d) ∈ C := by
    apply (degree_kernel F E n ι J hF hJ ht hu _).mp
    change determinantDegree F n
      (embeddedUniformizer F E n ι ^ Fintype.card n *
        scalarUniformizer F n ^ (-d)) = 1
    rw [map_mul, map_pow, map_zpow, determinantDegree_scalarUniformizer]
    apply Multiplicative.toAdd.injective
    change (Fintype.card n : ℤ) * d + (-d) * (Fintype.card n : ℤ) = 0
    ring
  have hz : q z = 1 := (QuotientGroup.eq_one_iff _).mpr
    ⟨uniformizerUnit F,rfl⟩
  have hperiod : q t ^ Fintype.card n ∈ C.map q := by
    have hp : q (t ^ Fintype.card n * z ^ (-d)) ∈ C.map q :=
      Subgroup.mem_map.mpr ⟨_,hb,rfl⟩
    simpa only [map_mul, map_pow, map_zpow, hz, one_zpow, mul_one] using hp
  exact CompactQuotientPeriod69.compact_quotient_of_period C Z t hC hcover
    (Fintype.card n) Fintype.card_pos hperiod

end PaperXI.ActualFieldTypeQuotient69
