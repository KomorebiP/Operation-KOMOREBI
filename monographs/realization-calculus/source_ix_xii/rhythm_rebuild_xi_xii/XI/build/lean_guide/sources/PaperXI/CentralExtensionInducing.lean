import PaperXI.SmoothDegreeQuotient
import PaperXI.RepresentationStability
import Mathlib.Topology.Algebra.OpenSubgroup
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
# Extending inducing data by a central infinite cyclic direction

The extension is a representation of an actual subgroup of the ambient group.
Its hypotheses require that the adjoined central element has no nonzero power
in the original subgroup.  No assertion about simple types, intertwining, or
admissibility is supplied by this construction.
-/
set_option autoImplicit false
noncomputable section
namespace PaperXI.CentralExtensionInducing

variable {G : Type*} [Group G]

/-- A nonzero integer degree separates every nontrivial power from the degree kernel. -/
theorem hfree_from_degree (J : Subgroup G) (δ : G →* Multiplicative ℤ)
    (hJ : J ≤ δ.ker) (z : G) (hz : δ z ≠ 1) :
    ∀ n : ℤ, z ^ n ∈ J → n = 0 := by
  intro n hn
  have he : δ (z ^ n) = 1 := hJ hn
  have he' : n * (δ z).toAdd = 0 := by
    have h := congrArg Multiplicative.toAdd he
    simpa [map_zpow, toAdd_zpow, zsmul_eq_mul] using h
  exact (mul_eq_zero.mp he').resolve_right fun h => hz (congrArg Multiplicative.ofAdd h)

/-- Normal forms map to the original ambient group. -/
def normalFormHom (J : Subgroup G) (z : G) (hz : ∀ g : G, Commute z g) :
    J × Multiplicative ℤ →* G where
  toFun p := (p.1 : G) * z ^ p.2.toAdd
  map_one' := by simp
  map_mul' := by
    rintro ⟨j, n⟩ ⟨j', n'⟩
    change ((j : G) * j') * z ^ (n.toAdd + n'.toAdd) =
      ((j : G) * z ^ n.toAdd) * ((j' : G) * z ^ n'.toAdd)
    rw [zpow_add]
    calc
      _ = (j : G) * ((j' : G) * z ^ n.toAdd) * z ^ n'.toAdd := by simp [mul_assoc]
      _ = _ := by rw [← ((hz j').zpow_left n.toAdd).eq]; simp [mul_assoc]

@[simp] theorem normalFormHom_apply (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g) (j : J) (n : Multiplicative ℤ) :
    normalFormHom J z hz (j, n) = (j : G) * z ^ n.toAdd := rfl

/-- The genuine ambient subgroup generated by the normal forms. -/
def extendedSubgroup (J : Subgroup G) (z : G) (hz : ∀ g : G, Commute z g) : Subgroup G :=
  (normalFormHom J z hz).range

theorem le_extendedSubgroup (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g) : J ≤ extendedSubgroup J z hz := by
  intro j hj
  exact ⟨(⟨j, hj⟩, 1), by simp⟩

theorem central_mem_extendedSubgroup (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g) : z ∈ extendedSubgroup J z hz := by
  exact ⟨(1, Multiplicative.ofAdd 1), by simp⟩

/-- The range is exactly the join of the original subgroup and the central cyclic subgroup. -/
theorem extendedSubgroup_eq_sup (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g) :
    extendedSubgroup J z hz = J ⊔ Subgroup.zpowers z := by
  apply le_antisymm
  · rintro g ⟨⟨j, n⟩, rfl⟩
    exact Subgroup.mul_mem _ ((show J ≤ J ⊔ Subgroup.zpowers z from le_sup_left) j.property)
      ((show Subgroup.zpowers z ≤ J ⊔ Subgroup.zpowers z from le_sup_right)
        (Subgroup.zpow_mem _ (Subgroup.mem_zpowers z) n.toAdd))
  · exact sup_le (le_extendedSubgroup J z hz)
      (Subgroup.zpowers_le.mpr (central_mem_extendedSubgroup J z hz))

/-- Absence of nonzero powers in the original subgroup gives unique normal forms. -/
theorem normalFormHom_injective (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g)
    (hfree : ∀ n : ℤ, z ^ n ∈ J → n = 0) :
    Function.Injective (normalFormHom J z hz) := by
  apply (injective_iff_map_eq_one _).mpr
  rintro ⟨j, n⟩ h
  have hp : z ^ n.toAdd = (j : G)⁻¹ := by
    have he := congrArg (fun a : G => (j : G)⁻¹ * a) h
    simpa [normalFormHom, mul_assoc] using he
  have hn : n.toAdd = 0 := hfree _ (hp ▸ J.inv_mem j.property)
  have hn' : n = 1 := congrArg Multiplicative.ofAdd hn
  subst n
  have hj : j = 1 := Subtype.ext (by simpa using h)
  simp [hj]

/-- Explicit multiplicative coordinates for an actual subgroup of `G`. -/
def normalFormEquiv (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g)
    (hfree : ∀ n : ℤ, z ^ n ∈ J → n = 0) :
    J × Multiplicative ℤ ≃* extendedSubgroup J z hz :=
  MonoidHom.ofInjective (normalFormHom_injective J z hz hfree)

@[simp] theorem normalFormEquiv_coe (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g)
    (hfree : ∀ n : ℤ, z ^ n ∈ J → n = 0) (p : J × Multiplicative ℤ) :
    ((normalFormEquiv J z hz hfree p : extendedSubgroup J z hz) : G) =
      (p.1 : G) * z ^ p.2.toAdd := rfl

/-- The canonical inclusion of the original inducing subgroup. -/
def subgroupInclusion (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g) : J →* extendedSubgroup J z hz :=
  Subgroup.inclusion (le_extendedSubgroup J z hz)

/-- The adjoined element, viewed inside the enlarged subgroup. -/
def centralElement (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g) : extendedSubgroup J z hz :=
  ⟨z, central_mem_extendedSubgroup J z hz⟩

variable {k V : Type*} [Field k] [AddCommGroup V] [Module k V]

/-- The prescribed scalar is a unit, so all integer powers act invertibly. -/
def productRepresentation (J : Subgroup G) (σ : Representation k J V) (c : kˣ) :
    Representation k (J × Multiplicative ℤ) V where
  toFun p := ((c ^ p.2.toAdd : kˣ) : k) • σ p.1
  map_one' := by simp
  map_mul' := by
    rintro ⟨j, n⟩ ⟨j', n'⟩
    ext v
    simp [zpow_add, map_mul, Module.End.mul_apply, mul_smul]
    exact smul_comm _ _ _

/-- Extend the action to the literal subgroup `J ⊔ zpowers z` using unique normal forms. -/
def extendedRepresentation (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g)
    (hfree : ∀ n : ℤ, z ^ n ∈ J → n = 0)
    (σ : Representation k J V) (c : kˣ) :
    Representation k (extendedSubgroup J z hz) V :=
  (productRepresentation J σ c).comp (normalFormEquiv J z hz hfree).symm.toMonoidHom

/-- The extension has the expected formula on every normal form. -/
@[simp] theorem extendedRepresentation_normalForm (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g)
    (hfree : ∀ n : ℤ, z ^ n ∈ J → n = 0)
    (σ : Representation k J V) (c : kˣ) (j : J) (n : Multiplicative ℤ) :
    extendedRepresentation J z hz hfree σ c (normalFormEquiv J z hz hfree (j, n)) =
      ((c ^ n.toAdd : kˣ) : k) • σ j := by
  simp [extendedRepresentation, productRepresentation]

@[simp] theorem extendedRepresentation_restrict (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g)
    (hfree : ∀ n : ℤ, z ^ n ∈ J → n = 0)
    (σ : Representation k J V) (c : kˣ) (j : J) :
    extendedRepresentation J z hz hfree σ c (subgroupInclusion J z hz j) = σ j := by
  have he : subgroupInclusion J z hz j = normalFormEquiv J z hz hfree (j, 1) :=
    Subtype.ext (by simp [subgroupInclusion])
  rw [he, extendedRepresentation_normalForm]
  simp

@[simp] theorem extendedRepresentation_central (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g)
    (hfree : ∀ n : ℤ, z ^ n ∈ J → n = 0)
    (σ : Representation k J V) (c : kˣ) :
    extendedRepresentation J z hz hfree σ c (centralElement J z hz) =
      (c : k) • (LinearMap.id : Module.End k V) := by
  have he : centralElement J z hz =
      normalFormEquiv J z hz hfree (1, Multiplicative.ofAdd 1) :=
    Subtype.ext (by simp [centralElement])
  rw [he, extendedRepresentation_normalForm]
  simp
  rfl

/-- Irreducibility is inherited from the given action on the original subgroup. -/
theorem extendedRepresentation_irreducible (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g)
    (hfree : ∀ n : ℤ, z ^ n ∈ J → n = 0)
    (σ : Representation k J V) (c : kˣ) [Representation.IsIrreducible σ] :
    Representation.IsIrreducible (extendedRepresentation J z hz hfree σ c) := by
  let : Nontrivial V := GeneratedIrreducibility.nontrivial_space σ
  apply RepresentationStability.irreducible_of_stable
  intro S hS
  apply RepresentationStability.eq_bot_or_top σ S
  intro j v hv
  simpa using hS (subgroupInclusion J z hz j) v hv

section Topology
variable [TopologicalSpace G] [IsTopologicalGroup G]

/-- Adjoining the central direction preserves openness of the inducing subgroup. -/
theorem extendedSubgroup_isOpen (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g) (hJ : IsOpen (J : Set G)) :
    IsOpen (extendedSubgroup J z hz : Set G) :=
  Subgroup.isOpen_mono (le_extendedSubgroup J z hz) hJ

/-- Smoothness transfers because every extended stabilizer contains an open original stabilizer. -/
theorem extendedRepresentation_smooth (J : Subgroup G) (z : G)
    (hz : ∀ g : G, Commute z g)
    (hfree : ∀ n : ℤ, z ^ n ∈ J → n = 0)
    (σ : Representation k J V) (c : kˣ)
    (hJ : IsOpen (J : Set G)) (hσ : SmoothDegreeQuotient.IsSmooth σ) :
    SmoothDegreeQuotient.IsSmooth (extendedRepresentation J z hz hfree σ c) := by
  intro v
  let K := (SmoothDegreeQuotient.vectorStabilizer σ v).map J.subtype
  have hK : IsOpen (K : Set G) := hJ.isOpenMap_subtype_val _ (hσ v)
  apply Subgroup.isOpen_mono (H₁ := K.subgroupOf (extendedSubgroup J z hz)) ?_
    ((extendedSubgroup J z hz).subgroupOf_isOpen K hK)
  intro x hx
  obtain ⟨j, hj, he⟩ := hx
  have hxe : x = subgroupInclusion J z hz j := Subtype.ext he.symm
  change extendedRepresentation J z hz hfree σ c x v = v
  rw [hxe, extendedRepresentation_restrict]
  exact hj

end Topology
end PaperXI.CentralExtensionInducing
