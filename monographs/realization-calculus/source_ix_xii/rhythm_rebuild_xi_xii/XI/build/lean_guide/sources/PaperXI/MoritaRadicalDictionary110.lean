import PaperXI.MoritaActualCartan110
import Mathlib.Data.Matrix.Basic

/-! The literal additive product with the actual mapped maximal-order radical.
Only mapped coefficient matrices commute with its scalar; no centrality in the
whole endomorphism ring is asserted. -/
set_option autoImplicit false
noncomputable section
namespace PaperXI.MoritaRadicalDictionary110
open Matrix PaperXI.MoritaLattice110 PaperXI.MoritaCornerRank110
open PaperXI.MoritaActualCartan110

section Product
variable {A : Type*} [Ring A]

/-- The additive subgroup generated by literal products of its two factors. -/
def additiveProduct (P L : AddSubgroup A) : AddSubgroup A :=
  AddSubgroup.closure {z | ∃ q ∈ P, ∃ x ∈ L, q * x = z}

theorem mul_mem_additiveProduct (P L : AddSubgroup A) {q x : A}
    (hq : q ∈ P) (hx : x ∈ L) : q * x ∈ additiveProduct P L :=
  AddSubgroup.subset_closure ⟨q, hq, x, hx, rfl⟩

end Product

section MappedMaximalOrder
variable {R D m : Type*} [CommRing R] [Ring D] [Fintype m] [DecidableEq m]

/-- The literal image of `π M_m(R)` in the ambient coefficient matrix ring. -/
def maximalOrderRadical (φ : R →+* D) (π : R) : AddSubgroup (Matrix m m D) :=
  (⊤ : AddSubgroup (Matrix m m R)).map
    ((AddMonoidHom.mulLeft (Matrix.scalar m (φ π))).comp φ.mapMatrix.toAddMonoidHom)

theorem scalar_mem_maximalOrderRadical (φ : R →+* D) (π : R) :
    Matrix.scalar m (φ π) ∈ maximalOrderRadical φ π := by
  refine ⟨1, AddSubgroup.mem_top _, ?_⟩
  change Matrix.scalar m (φ π) * (1 : Matrix m m R).map φ = _
  simp

/-- The radical scalar commutes with actual mapped integral matrices, even
though it need not commute with arbitrary ambient coefficient matrices. -/
theorem scalar_commutes_mapped (φ : R →+* D) (π : R) (b : Matrix m m R) :
    Matrix.scalar m (φ π) * b.map φ = b.map φ * Matrix.scalar m (φ π) := by
  apply Matrix.scalar_comm_iff.mpr
  ext i j
  exact (Commute.all π (b i j)).map φ

/-- The actual left radical product is the scalar-uniformizer image. -/
theorem radical_product_eq_left_image (φ : R →+* D) (π : R)
    (L : AddSubgroup (Matrix m m D)) (hL : IsMatrixBimodule φ L) :
    additiveProduct (maximalOrderRadical φ π) L =
      L.map (AddMonoidHom.mulLeft (Matrix.scalar m (φ π))) := by
  apply le_antisymm
  · apply (AddSubgroup.closure_le _).mpr
    rintro z ⟨q, hq, x, hx, rfl⟩
    obtain ⟨b, _, hb⟩ := hq
    change Matrix.scalar m (φ π) * b.map φ = q at hb
    subst q
    refine ⟨b.map φ * x, hL.1 b x hx, ?_⟩
    change Matrix.scalar m (φ π) * (b.map φ * x) = _
    exact (mul_assoc _ _ _).symm
  · rintro z ⟨x, hx, rfl⟩
    change Matrix.scalar m (φ π) * x ∈ additiveProduct (maximalOrderRadical φ π) L
    exact mul_mem_additiveProduct (q := Matrix.scalar m (φ π)) (x := x)
      (maximalOrderRadical φ π) L
      (scalar_mem_maximalOrderRadical (m := m) φ π) hx

/-- The actual right radical product is the right scalar-uniformizer image. -/
theorem product_radical_eq_right_image (φ : R →+* D) (π : R)
    (L : AddSubgroup (Matrix m m D)) (hL : IsMatrixBimodule φ L) :
    additiveProduct L (maximalOrderRadical φ π) =
      L.map (AddMonoidHom.mulRight (Matrix.scalar m (φ π))) := by
  apply le_antisymm
  · apply (AddSubgroup.closure_le _).mpr
    rintro z ⟨x, hx, q, hq, rfl⟩
    obtain ⟨b, _, hb⟩ := hq
    change Matrix.scalar m (φ π) * b.map φ = q at hb
    subst q
    refine ⟨x * b.map φ, hL.2 b x hx, ?_⟩
    change (x * b.map φ) * Matrix.scalar m (φ π) = _
    rw [mul_assoc, ← scalar_commutes_mapped φ π b]
  · rintro z ⟨x, hx, rfl⟩
    change x * Matrix.scalar m (φ π) ∈ additiveProduct L (maximalOrderRadical φ π)
    exact mul_mem_additiveProduct (q := x) (x := Matrix.scalar m (φ π))
      L (maximalOrderRadical φ π) hx
      (scalar_mem_maximalOrderRadical (m := m) φ π)

/-- Literal source-style radical-product commutation implies scalar-image
commutation; the desired scalar equality is a conclusion, not a premise. -/
theorem scalar_images_eq_of_radical_products_eq (φ : R →+* D) (π : R)
    (L : AddSubgroup (Matrix m m D)) (hL : IsMatrixBimodule φ L)
    (hcomm : additiveProduct (maximalOrderRadical φ π) L =
      additiveProduct L (maximalOrderRadical φ π)) :
    L.map (AddMonoidHom.mulLeft (Matrix.scalar m (φ π))) =
      L.map (AddMonoidHom.mulRight (Matrix.scalar m (φ π))) := by
  rw [← radical_product_eq_left_image φ π L hL,
    ← product_radical_eq_right_image φ π L hL]
  exact hcomm

end MappedMaximalOrder

section ActualEndomorphismRing
open Module ValuativeRel
variable (F E : Type*) [Field F] [Field E] [Algebra F E]
  [ValuativeRel E] [TopologicalSpace E] [IsNonarchimedeanLocalField E]
variable (m : Type*) [Fintype m] [DecidableEq m]

/-- The actual maximal centralizer-order radical in `M_m(End_F(E))`. -/
def actualRadical : AddSubgroup (Matrix m m (Module.End F E)) :=
  maximalOrderRadical (coefficientMap F E) (PaperXI.ActualLocalUnitDecomposition.uniformizer E)

/-- The literal actual-radical product equality supplies the named input of the
checked Cartan arithmetic theorem. Canonical order/basis identification remains
a separate source attachment. -/
theorem RadicalCommutes_of_actual_radical_products
    (L : AddSubgroup (Matrix m m (Module.End F E)))
    (hL : IsMatrixBimodule (coefficientMap F E) L)
    (hcomm : additiveProduct (actualRadical F E m) L =
      additiveProduct L (actualRadical F E m)) : RadicalCommutes F E m L := by
  have h := scalar_images_eq_of_radical_products_eq (coefficientMap F E)
    (PaperXI.ActualLocalUnitDecomposition.uniformizer E) L hL hcomm
  have he : Matrix.scalar m ((coefficientMap F E)
      (PaperXI.ActualLocalUnitDecomposition.uniformizer E)) =
      ((diagonalUnit (fun _ : m => uniformizerEndUnit F E) :
        (Matrix m m (Module.End F E))ˣ) : Matrix m m (Module.End F E)) := by
    rfl
  unfold RadicalCommutes
  rw [← he]
  exact h

end ActualEndomorphismRing
end PaperXI.MoritaRadicalDictionary110
