import PaperXI.ActualELatticeQuotient59
import PaperXI.ActualELatticeFreeness59

/-!
# The literal field-times-lattice inducing subgroup

Integral extension-field units already lie in the actual integral matrix
factor. The unit/uniformizer decomposition of E× therefore identifies the
subgroup generated by J and pi_E with the subgroup generated by J and E×.
-/
set_option autoImplicit false
noncomputable section
namespace PaperXI.ActualELatticeFieldJoin59
open Matrix ValuativeRel
open ActualELatticeResidue59 ActualELatticeTypeGroup59 ActualELatticeQuotient59
open ActualELatticeFreeness59 NormalizerExtensionInducing58

variable (K E : Type*) [Field K] [Field E] [Algebra K E]
variable (n : Type*) [Fintype n] [DecidableEq n]
variable [ValuativeRel E] [TopologicalSpace E] [IsNonarchimedeanLocalField E]

omit [TopologicalSpace E] [IsNonarchimedeanLocalField E] in
/-- An integral scalar matrix acts by the actual extension-field unit. -/
theorem integralMatrix_scalar (u : 𝒪[E]ˣ) :
    integralMatrix K E n (GeneralLinearGroup.scalar n u) =
      scalarAction K E n (ActualLocalUnitTopology.unitEmbedding E u) := by
  ext v i
  simp [integralMatrix, restrictScalarMatrix, ActualIntegralGeneralLinear.embedding,
    GeneralLinearGroup.map_scalar, Matrix.mulVec, dotProduct, Matrix.scalar_apply,
    scalarAction_apply, ActualLocalUnitTopology.unitEmbedding, Matrix.diagonal_apply]
  exact Or.inl rfl

/-- Every actual integral E-unit lies in the literal product group. -/
theorem integralUnit_mem_typeGroup (u : 𝒪[E]ˣ) :
    scalarAction K E n (ActualLocalUnitTopology.unitEmbedding E u) ∈ typeGroup K E n := by
  exact (show integralImage K E n ≤ typeGroup K E n from le_sup_left)
    ⟨GeneralLinearGroup.scalar n u, integralMatrix_scalar K E n u⟩

/-- Exact identification of the extension domain with the actual E×-join. -/
theorem extendedSubgroup_eq_field_join :
    extendedSubgroup (typeGroup K E n) (uniformizerAction K E n)
      (uniformizer_normalizes K E n) =
      typeGroup K E n ⊔ (scalarAction K E n).range := by
  apply le_antisymm
  · rw [extendedSubgroup_eq_sup]
    apply sup_le le_sup_left
    apply Subgroup.zpowers_le.mpr
    exact (show (scalarAction K E n).range ≤
      typeGroup K E n ⊔ (scalarAction K E n).range from le_sup_right)
      ⟨ActualLocalUnitDecomposition.uniformizerUnit E, rfl⟩
  · apply sup_le (le_extendedSubgroup _ _ _)
    rintro g ⟨a, rfl⟩
    obtain ⟨⟨u, r⟩, ha⟩ := (ActualLocalUnitDecomposition.normalFormEquiv E).surjective a
    rw [← ha, ActualLocalUnitDecomposition.normalFormEquiv_apply, map_mul, map_zpow]
    apply Subgroup.mul_mem
    · exact le_extendedSubgroup _ _ _ (integralUnit_mem_typeGroup K E n u)
    · exact Subgroup.zpow_mem _ (generator_mem _ _ _) r.toAdd

/-- The entire actual field group normalizes the literal lattice-product group. -/
theorem field_normalizes_typeGroup : (scalarAction K E n).range ≤
    Subgroup.normalizer (typeGroup K E n : Set ((n → E) ≃ₗ[K] (n → E))) := by
  rintro g ⟨a, rfl⟩
  obtain ⟨⟨u, r⟩, ha⟩ := (ActualLocalUnitDecomposition.normalFormEquiv E).surjective a
  rw [← ha, ActualLocalUnitDecomposition.normalFormEquiv_apply, map_mul, map_zpow]
  apply Subgroup.mul_mem
  · exact (typeGroup K E n).le_normalizer (integralUnit_mem_typeGroup K E n u)
  · exact Subgroup.zpow_mem _ (uniformizer_normalizes K E n) r.toAdd

open scoped Pointwise
/-- Setwise, the actual extension domain is exactly E× times J. -/
theorem extendedSubgroup_coe_eq_field_mul :
    (extendedSubgroup (typeGroup K E n) (uniformizerAction K E n)
      (uniformizer_normalizes K E n) : Set ((n → E) ≃ₗ[K] (n → E))) =
      ((scalarAction K E n).range : Set ((n → E) ≃ₗ[K] (n → E))) *
        (typeGroup K E n : Set ((n → E) ≃ₗ[K] (n → E))) := by
  rw [extendedSubgroup_eq_field_join, sup_comm]
  exact Subgroup.coe_mul_of_left_le_normalizer_right
    (scalarAction K E n).range (typeGroup K E n) (field_normalizes_typeGroup K E n)

end PaperXI.ActualELatticeFieldJoin59
