import Komorebi.SufficientResolution.CalibrationFrame

/-!
# Calibration-generated uncertainty in sufficient reconstruction

The whole-operator allowance is generated from a split calibration frame and then
fed into the existing source-bound-free discrepancy theory.
-/
set_option autoImplicit false
noncomputable section

namespace Komorebi.SufficientResolution.CalibrationRecovery

open Filter Topology
open CalibrationFrame GeneralizedDiscrepancy MinimumNormReconstruction

variable {K G V : Type*}
variable [NormedAddCommGroup K] [NormedSpace ℝ K]
variable [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G]
variable [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]

/-- The whole-operator allowance generated by a calibration frame. -/
def generatedDelta (F : CalibrationFrame.Frame K G) (etaCal fit : ℝ) : ℝ :=
  (etaCal+fit)*‖F.analysis‖

omit [CompleteSpace G] [CompleteSpace V] in
 theorem generatedDelta_nonneg (F : CalibrationFrame.Frame K G)
    (A C : G →L[ℝ] V) (Y : K →L[ℝ] V) (etaCal fit : ℝ)
    (hA : ‖Y-A.comp F.synthesis‖ ≤ etaCal)
    (hC : ‖Y-C.comp F.synthesis‖ ≤ fit) :
    0 ≤ generatedDelta F etaCal fit := by
  exact F.generated_allowance_nonneg A C Y etaCal fit hA hC

omit [CompleteSpace G] [CompleteSpace V] in
 theorem generated_operator_bound (F : CalibrationFrame.Frame K G)
    (A C : G →L[ℝ] V) (Y : K →L[ℝ] V) (etaCal fit : ℝ)
    (hA : ‖Y-A.comp F.synthesis‖ ≤ etaCal)
    (hC : ‖Y-C.comp F.synthesis‖ ≤ fit) :
    ‖C-A‖ ≤ generatedDelta F etaCal fit := by
  exact F.measured_operator_bound A C Y etaCal fit hA hC

omit [CompleteSpace G] in
 theorem generatedDelta_tendsto_zero {ι : Type*} (f : Filter ι)
    (F : CalibrationFrame.Frame K G) (etaCal fit : ι → ℝ)
    (hcal : Tendsto etaCal f (𝓝 0)) (hfit : Tendsto fit f (𝓝 0)) :
    Tendsto (fun i => generatedDelta F (etaCal i) (fit i)) f (𝓝 0) := by
  simp only [generatedDelta]
  have hs : Tendsto (fun i => etaCal i + fit i) f (𝓝 0) := by
    simpa only [zero_add] using hcal.add hfit
  simpa only [zero_mul] using hs.mul (tendsto_const_nhds (x := ‖F.analysis‖))

 theorem calibrated_norm_control (F : CalibrationFrame.Frame K G)
    (A C : G →L[ℝ] V) (Y : K →L[ℝ] V) (p x : G) (v : V)
    (eta etaCal fit tau : ℝ)
    (hA : ‖Y-A.comp F.synthesis‖ ≤ etaCal)
    (hC : ‖Y-C.comp F.synthesis‖ ≤ fit)
    (he : ‖A p-v‖ ≤ eta)
    (hx : Accepted C v eta (generatedDelta F etaCal fit) tau x) :
    ‖x‖ ≤ ‖p‖ := by
  exact accepted_norm_control A C p x v eta (generatedDelta F etaCal fit) tau
    (generated_operator_bound F A C Y etaCal fit hA hC) he hx

 theorem calibrated_true_residual (F : CalibrationFrame.Frame K G)
    (A C : G →L[ℝ] V) (Y : K →L[ℝ] V) (p x : G) (v : V)
    (eta etaCal fit tau : ℝ) (ht : 0 ≤ tau)
    (hA : ‖Y-A.comp F.synthesis‖ ≤ etaCal)
    (hC : ‖Y-C.comp F.synthesis‖ ≤ fit)
    (he : ‖A p-v‖ ≤ eta)
    (hx : Accepted C v eta (generatedDelta F etaCal fit) tau x) :
    ‖A x-A p‖ ≤ (tau+1) * candidateNoise eta (generatedDelta F etaCal fit) p := by
  exact accepted_true_residual A C p x v eta (generatedDelta F etaCal fit) tau ht
    (generated_operator_bound F A C Y etaCal fit hA hC) he hx

 theorem calibrated_consistent {ι : Type*} (f : Filter ι)
    (F : CalibrationFrame.Frame K G) (A : G →L[ℝ] V)
    (C : ι → G →L[ℝ] V) (Y : ι → K →L[ℝ] V)
    (v : ι → V) (eta etaCal fit : ι → ℝ) (x : ι → G)
    (p : G) (tau : ℝ)
    (hp : p ∈ A.kerᗮ) (ht : 0 ≤ tau)
    (hA : ∀ i, ‖Y i-A.comp F.synthesis‖ ≤ etaCal i)
    (hC : ∀ i, ‖Y i-(C i).comp F.synthesis‖ ≤ fit i)
    (he : ∀ i, ‖A p-v i‖ ≤ eta i)
    (hx : ∀ i, Accepted (C i) (v i) (eta i)
      (generatedDelta F (etaCal i) (fit i)) tau (x i))
    (heta0 : Tendsto eta f (𝓝 0))
    (hcal0 : Tendsto etaCal f (𝓝 0)) (hfit0 : Tendsto fit f (𝓝 0)) :
    Tendsto x f (𝓝 p) := by
  apply accepted_consistent f A C v eta
    (fun i => generatedDelta F (etaCal i) (fit i)) x p tau hp ht
  · intro i
    exact generated_operator_bound F A (C i) (Y i) (etaCal i) (fit i) (hA i) (hC i)
  · exact he
  · exact hx
  · exact heta0
  · exact generatedDelta_tendsto_zero f F etaCal fit hcal0 hfit0

 theorem calibrated_error_norm_limit {ι : Type*} (f : Filter ι)
    (F : CalibrationFrame.Frame K G) (A : G →L[ℝ] V)
    (C : ι → G →L[ℝ] V) (Y : ι → K →L[ℝ] V)
    (v : ι → V) (eta etaCal fit : ι → ℝ) (x : ι → G)
    (g : G) (tau : ℝ) (ht : 0 ≤ tau)
    (hA : ∀ i, ‖Y i-A.comp F.synthesis‖ ≤ etaCal i)
    (hC : ∀ i, ‖Y i-(C i).comp F.synthesis‖ ≤ fit i)
    (he : ∀ i, ‖A g-v i‖ ≤ eta i)
    (hx : ∀ i, Accepted (C i) (v i) (eta i)
      (generatedDelta F (etaCal i) (fit i)) tau (x i))
    (heta0 : Tendsto eta f (𝓝 0))
    (hcal0 : Tendsto etaCal f (𝓝 0)) (hfit0 : Tendsto fit f (𝓝 0)) :
    Tendsto (fun i => ‖x i-g‖) f (𝓝 ‖A.ker.starProjection g‖) := by
  have hp := A.kerᗮ.starProjection_apply_mem g
  have hsrc : ∀ i, ‖A (A.kerᗮ.starProjection g)-v i‖ ≤ eta i := by
    intro i
    simpa only [MinimumNormReconstruction.source_projection_image] using he i
  have hconv := calibrated_consistent f F A C Y v eta etaCal fit x
    (A.kerᗮ.starProjection g) tau hp ht hA hC hsrc hx heta0 hcal0 hfit0
  have h := hconv.sub (tendsto_const_nhds (x := g))
  have hn := h.norm
  have hid : A.kerᗮ.starProjection g-g = -(A.ker.starProjection g) := by
    rw [Submodule.starProjection_orthogonal_val]
    abel
  simpa only [hid, norm_neg] using hn

end Komorebi.SufficientResolution.CalibrationRecovery
