  [inst_1 : AddCommGroup X] [inst_2 : Module K X] {Y : Type u_3} [inst_3 : AddCommGroup Y] [inst_4 : Module K Y]
  {I : Type u_4} (T : I → X →ₗ[K] X) (O : X →ₗ[K] Y) [FiniteDimensional K X] (x y : X),
  (∀ (w : List I),
