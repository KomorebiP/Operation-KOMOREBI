  [inst_4 : Module K Y] {Z : Type u_4} [inst_5 : AddCommGroup Z] [inst_6 : Module K Z] {I : Type u_5}
  (T : I → X →ₗ[K] X) (O : X →ₗ[K] Y) (q : X →ₗ[K] Z) (U : I → Z →ₗ[K] Z) (V : Z →ₗ[K] Y),
  (∀ (i : I), q ∘ₗ T i = U i ∘ₗ q) →
    V ∘ₗ q = O →
