Komorebi.SufficientResolution.ClosedRangeReconstruction.closed_range_iff_coercivity.{u_1, u_2} {G : Type u_1}
  {V : Type u_2} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] [CompleteSpace V] (A : G →L[ℝ] V) :
  IsClosed ↑(↑A).range ↔
    ∃ alpha, 0 < alpha ∧ Komorebi.SufficientResolution.HilbertConditioning.CoerciveOffKernel A alpha
Komorebi.SufficientResolution.ClosedRangeReconstruction.bounded_recovery_iff_closed_range.{u_1, u_2} {G : Type u_1}
  {V : Type u_2} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] [CompleteSpace V] (A : G →L[ℝ] V) :
  (∃ B, ∀ (g : G), B (A g) = (↑A).kerᗮ.starProjection g) ↔ IsClosed ↑(↑A).range
Komorebi.SufficientResolution.ClosedRangeReconstruction.nonclosed_no_bounded_recovery.{u_1, u_2} {G : Type u_1}
  {V : Type u_2} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] [CompleteSpace V] (A : G →L[ℝ] V) (hn : ¬IsClosed ↑(↑A).range) :
  ¬∃ B, ∀ (g : G), B (A g) = (↑A).kerᗮ.starProjection g
Komorebi.SufficientResolution.ReconstructionGlobalization.candidate_total_error_sq.{u_1, u_2, u_3} {G : Type u_1}
  {V : Type u_2} {W : Type u_3} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] [CompleteSpace V] [NormedAddCommGroup W] [NormedSpace ℝ W] (A : G →L[ℝ] V)
  [CompleteSpace ↥(↑A).range] (delta : V →L[ℝ] W) (h : delta ∘SL A = 0) (v : V) (g : G) :
  ‖v - A g‖ ^ 2 =
    ‖(Komorebi.SufficientResolution.OrthogonalResolution.obstruction (↑A).range (↑delta).ker) v‖ ^ 2 +
        ‖(Komorebi.SufficientResolution.OrthogonalResolution.inconsistency (↑delta).ker) v‖ ^ 2 +
      ‖A (g - (Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) v)‖ ^ 2
Komorebi.SufficientResolution.ReconstructionGlobalization.two_condition_reconstruction.{u_1, u_2, u_3} {G : Type u_1}
  {V : Type u_2} {W : Type u_3} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] [CompleteSpace V] [NormedAddCommGroup W] [NormedSpace ℝ W] (A : G →L[ℝ] V)
  [CompleteSpace ↥(↑A).range] (delta : V →L[ℝ] W) (h : delta ∘SL A = 0) (alpha sigma : ℝ) (ha : 0 < alpha)
  (hs : 0 < sigma) (hA : Komorebi.SufficientResolution.HilbertConditioning.CoerciveOffKernel A alpha)
  (hd : Komorebi.SufficientResolution.HilbertConditioning.CoerciveOffKernel delta sigma) (v : V) :
  ‖(Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) v‖ ≤ ‖v‖ / alpha ∧
    ‖v - A ((Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) v)‖ ^ 2 ≤
      ‖(Komorebi.SufficientResolution.OrthogonalResolution.obstruction (↑A).range (↑delta).ker) v‖ ^ 2 +
        (‖delta v‖ / sigma) ^ 2
Komorebi.SufficientResolution.ReconstructionExamples.scalar_recover_norm (c : ℝ) (hc : 0 < c) (v : ℝ) :
  ‖(Komorebi.SufficientResolution.MinimumNormReconstruction.recover
          (Komorebi.SufficientResolution.ReconstructionExamples.scalar c))
        v‖ =
    ‖v‖ / c
Komorebi.SufficientResolution.ReconstructionExamples.arbitrarily_small_data_unit_source (epsilon : ℝ)
  (he : 0 < epsilon) :
  ∃ c,
    0 < c ∧
      ‖c‖ < epsilon ∧
        ‖(Komorebi.SufficientResolution.MinimumNormReconstruction.recover
                (Komorebi.SufficientResolution.ReconstructionExamples.scalar c))
              c‖ =
          1
Komorebi.SufficientResolution.ReconstructionExamples.no_uniform_source_conditioning :
  ¬∃ C,
      ∀ (c : ℝ),
        0 < c →
          ∀ (v : ℝ),
            ‖(Komorebi.SufficientResolution.MinimumNormReconstruction.recover
                    (Komorebi.SufficientResolution.ReconstructionExamples.scalar c))
                  v‖ ≤
              C * ‖v‖
