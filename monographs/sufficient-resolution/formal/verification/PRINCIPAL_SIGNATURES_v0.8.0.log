Komorebi.SufficientResolution.MinimumNormReconstruction.recover.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] : V →L[ℝ] G
Komorebi.SufficientResolution.MinimumNormReconstruction.restrictionEquiv.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] : ↥(↑A).kerᗮ ≃L[ℝ] ↥(↑A).range
Komorebi.SufficientResolution.MinimumNormReconstruction.image_comp_recover.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] :
  A ∘SL Komorebi.SufficientResolution.MinimumNormReconstruction.recover A = (↑A).range.starProjection
Komorebi.SufficientResolution.MinimumNormReconstruction.recover_comp_image.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] :
  Komorebi.SufficientResolution.MinimumNormReconstruction.recover A ∘SL A = (↑A).kerᗮ.starProjection
Komorebi.SufficientResolution.MinimumNormReconstruction.image_projection_symmetric.{u_1, u_2} {G : Type u_1}
  {V : Type u_2} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] (v w : V) :
  inner ℝ (A ((Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) v)) w =
    inner ℝ v (A ((Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) w))
Komorebi.SufficientResolution.MinimumNormReconstruction.source_projection_symmetric.{u_1, u_2} {G : Type u_1}
  {V : Type u_2} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] (g h : G) :
  inner ℝ ((Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) (A g)) h =
    inner ℝ g ((Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) (A h))
Komorebi.SufficientResolution.MinimumNormOptimality.unique_minimum_norm_least_squares.{u_1, u_2} {G : Type u_1}
  {V : Type u_2} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] (v : V) :
  ∃! g, ‖v - A g‖ = Metric.infDist v ↑(↑A).range ∧ ∀ (h : G), ‖v - A h‖ = Metric.infDist v ↑(↑A).range → ‖g‖ ≤ ‖h‖
Komorebi.SufficientResolution.MinimumNormOptimality.all_least_squares_sources.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] (v : V) (g : G) :
  ‖v - A g‖ = Metric.infDist v ↑(↑A).range ↔
    ∃ k ∈ (↑A).ker, g = (Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) v + k
Komorebi.SufficientResolution.MinimumNormOptimality.noisy_source_error_sq.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] (g : G) (e : V) :
  ‖(Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) (A g + e) - g‖ ^ 2 =
    ‖(Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) e‖ ^ 2 + ‖(↑A).ker.starProjection g‖ ^ 2
Komorebi.SufficientResolution.SourceConditioning.exists_source_coercivity.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] :
  ∃ alpha, 0 < alpha ∧ Komorebi.SufficientResolution.HilbertConditioning.CoerciveOffKernel A alpha
Komorebi.SufficientResolution.SourceConditioning.recover_opNorm_bound.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] (alpha : ℝ) (ha : 0 < alpha)
  (hc : Komorebi.SufficientResolution.HilbertConditioning.CoerciveOffKernel A alpha) :
  ‖Komorebi.SufficientResolution.MinimumNormReconstruction.recover A‖ ≤ alpha⁻¹
Komorebi.SufficientResolution.SourceConditioning.noisy_source_bound_sq.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] (alpha : ℝ) (ha : 0 < alpha)
  (hc : Komorebi.SufficientResolution.HilbertConditioning.CoerciveOffKernel A alpha) (g : G) (e : V) :
  ‖(Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) (A g + e) - g‖ ^ 2 ≤
    (‖e‖ / alpha) ^ 2 + ‖(↑A).ker.starProjection g‖ ^ 2
Komorebi.SufficientResolution.SourceConditioning.candidate_tolerance_bound_sq.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  (A : G →L[ℝ] V) [CompleteSpace ↥(↑A).range] (alpha : ℝ) (ha : 0 < alpha)
  (hc : Komorebi.SufficientResolution.HilbertConditioning.CoerciveOffKernel A alpha) (v : V) (g : G) (tau kappa : ℝ)
  (ht : ‖A g - (↑A).range.starProjection v‖ ≤ tau) (hk : ‖(↑A).ker.starProjection g‖ ≤ kappa) :
  ‖g - (Komorebi.SufficientResolution.MinimumNormReconstruction.recover A) v‖ ^ 2 ≤ (tau / alpha) ^ 2 + kappa ^ 2
