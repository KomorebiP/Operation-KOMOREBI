Komorebi.SufficientResolution.InexactToleranceCertificates.protected_window_exists_iff (eta tau omega xi : ℝ) :
  (∃ measured, eta + omega + xi ≤ measured ∧ measured ≤ tau * eta - omega - xi) ↔ 2 * (omega + xi) ≤ (tau - 1) * eta
Komorebi.SufficientResolution.InexactExamples.certified_nonexact_source :
  Komorebi.SufficientResolution.InexactDiscrepancy.NearAccepted
      (Komorebi.SufficientResolution.TikhonovExamples.scalar 1) 4 1 3 (1 / 50) (201 / 100) ∧
    201 / 100 ≠
      (Komorebi.SufficientResolution.TikhonovConstruction.regularized
          (Komorebi.SufficientResolution.TikhonovExamples.scalar 1) 1 ⋯)
        4
Komorebi.SufficientResolution.InexactExamples.small_raw_residuals_do_not_force_convergence.{u_1} {ι : Type u_1}
  (f : Filter ι) [f.NeBot] (s : ι → ℝ) (hs : ∀ (i : ι), 0 < s i) (hlim : Filter.Tendsto s f (nhds 0)) :
  Filter.Tendsto
      (fun i =>
        ‖Komorebi.SufficientResolution.InexactResidual.normalResidual
            (Komorebi.SufficientResolution.TikhonovExamples.scalar 0) (s i) (s i) 1‖)
      f (nhds 0) ∧
    Filter.Tendsto (fun i => ‖(Komorebi.SufficientResolution.TikhonovExamples.scalar 0) 1 - s i‖) f (nhds 0) ∧
      ¬Filter.Tendsto (fun x => 1) f (nhds 0)
