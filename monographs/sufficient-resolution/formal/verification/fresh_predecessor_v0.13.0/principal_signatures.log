Komorebi.SufficientResolution.InexactConsistency.scaled_normal_consistent.{u_1, u_2, u_3} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [CompleteSpace V] (A : G →L[ℝ] V) {ι : Type u_3} (f : Filter ι) (lam eta measured omega : ι → ℝ)
  (hl : ∀ (i : ι), 0 < lam i) (v : ι → V) (x : ι → G) (g : G) (tau : ℝ) (hnoise : ∀ (i : ι), ‖A g - v i‖ ≤ eta i)
  (hm : ∀ (i : ι), |measured i - ‖A (x i) - v i‖| ≤ omega i)
  (hlo :
    ∀ (i : ι),
      eta i + omega i +
          ‖Komorebi.SufficientResolution.InexactResidual.normalResidual A (lam i) (v i) (x i)‖ / (2 * √(lam i)) ≤
        measured i)
  (hhi :
    ∀ (i : ι),
      measured i ≤
        tau * eta i - omega i -
          ‖Komorebi.SufficientResolution.InexactResidual.normalResidual A (lam i) (v i) (x i)‖ / (2 * √(lam i)))
  (heta : Filter.Tendsto eta f (nhds 0))
  (hscaled :
    Filter.Tendsto
      (fun i => ‖Komorebi.SufficientResolution.InexactResidual.normalResidual A (lam i) (v i) (x i)‖ / lam i) f
      (nhds 0)) :
  Filter.Tendsto x f (nhds ((↑A).kerᗮ.starProjection g))
