Komorebi.SufficientResolution.DiscrepancyResidual.residual_strictMono.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [CompleteSpace V] (A : G →L[ℝ] V) (v : V) (hv : (ContinuousLinearMap.adjoint A) v ≠ 0) {lam mu : ℝ} (hlam : 0 < lam)
  (hmu : 0 < mu) (hlt : lam < mu) :
  Komorebi.SufficientResolution.DiscrepancyResidual.residual A v lam <
    Komorebi.SufficientResolution.DiscrepancyResidual.residual A v mu
Komorebi.SufficientResolution.DiscrepancySelection.exists_unique_parameter_of_distance.{u_1, u_2} {G : Type u_1}
  {V : Type u_2} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] [CompleteSpace V] (A : G →L[ℝ] V) (v : V) (rho : ℝ) (hf : Metric.infDist v ↑(↑A).range < rho)
  (hu : rho < ‖v‖) : ∃! lam, 0 < lam ∧ Komorebi.SufficientResolution.DiscrepancyResidual.residual A v lam = rho
Komorebi.SufficientResolution.DiscrepancySelection.noisy_parameter_exists.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [CompleteSpace V] (A : G →L[ℝ] V) (g : G) (v : V) (eta tau : ℝ) (heta : 0 < eta) (htau : 1 < tau)
  (hnoise : ‖A g - v‖ ≤ eta) (hlarge : tau * eta < ‖v‖) :
  ∃! lam, 0 < lam ∧ Komorebi.SufficientResolution.DiscrepancyResidual.residual A v lam = tau * eta
Komorebi.SufficientResolution.DiscrepancyConvergence.norm_control_residual_tendsto.{u_1, u_2, u_3} {G : Type u_1}
  {V : Type u_2} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] [CompleteSpace V] (A : G →L[ℝ] V) {ι : Type u_3} (f : Filter ι) (x : ι → G) (g : G)
  (hg : g ∈ (↑A).kerᗮ) (hn : ∀ (i : ι), ‖x i‖ ≤ ‖g‖) (hr : Filter.Tendsto (fun i => ‖A (x i) - A g‖) f (nhds 0)) :
  Filter.Tendsto x f (nhds g)
Komorebi.SufficientResolution.DiscrepancyConvergence.discrepancy_consistent.{u_1, u_2, u_3} {G : Type u_1}
  {V : Type u_2} [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V]
  [InnerProductSpace ℝ V] [CompleteSpace V] (A : G →L[ℝ] V) {ι : Type u_3} (f : Filter ι) (lam eta : ι → ℝ) (v : ι → V)
  (g : G) (tau : ℝ) (hlam : ∀ (i : ι), 0 < lam i) (heta : ∀ (i : ι), 0 ≤ eta i) (htau : 1 ≤ tau)
  (hnoise : ∀ (i : ι), ‖A g - v i‖ ≤ eta i)
  (he : ∀ (i : ι), Komorebi.SufficientResolution.DiscrepancyResidual.residual A (v i) (lam i) = tau * eta i)
  (heta0 : Filter.Tendsto eta f (nhds 0)) :
  Filter.Tendsto (fun i => (Komorebi.SufficientResolution.TikhonovConstruction.regularized A (lam i) ⋯) (v i)) f
    (nhds ((↑A).kerᗮ.starProjection g))
Komorebi.SufficientResolution.DiscrepancyRule.selectedSource_consistent.{u_1, u_2, u_3} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [CompleteSpace V] (A : G →L[ℝ] V) {ι : Type u_3} (f : Filter ι) (eta : ι → ℝ) (v : ι → V) (g : G) (tau : ℝ)
  (he : ∀ (i : ι), 0 < eta i) (ht : 1 < tau) (hnoise : ∀ (i : ι), ‖A g - v i‖ ≤ eta i)
  (heta0 : Filter.Tendsto eta f (nhds 0)) :
  Filter.Tendsto (fun i => Komorebi.SufficientResolution.DiscrepancyRule.selectedSource A (v i) (eta i) tau ⋯ ht ⋯) f
    (nhds ((↑A).kerᗮ.starProjection g))
Komorebi.SufficientResolution.DiscrepancyRule.accepted_source_rate.{u_1, u_2} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [CompleteSpace V] (A : G →L[ℝ] V) (v w : V) (eta tau : ℝ) (x : G)
  (hnoise : ‖A ((ContinuousLinearMap.adjoint A) w) - v‖ ≤ eta)
  (hx : Komorebi.SufficientResolution.DiscrepancyRule.Accepted A v eta tau x) :
  ‖x - (ContinuousLinearMap.adjoint A) w‖ ^ 2 ≤ 2 * ‖w‖ * (tau + 1) * eta
Komorebi.SufficientResolution.DiscrepancyRule.accepted_error_norm_limit.{u_1, u_2, u_3} {G : Type u_1} {V : Type u_2}
  [NormedAddCommGroup G] [InnerProductSpace ℝ G] [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V]
  [CompleteSpace V] (A : G →L[ℝ] V) {ι : Type u_3} (f : Filter ι) (eta : ι → ℝ) (v : ι → V) (x : ι → G) (g : G)
  (tau : ℝ) (hnoise : ∀ (i : ι), ‖A g - v i‖ ≤ eta i)
  (hx : ∀ (i : ι), Komorebi.SufficientResolution.DiscrepancyRule.Accepted A (v i) (eta i) tau (x i))
  (heta0 : Filter.Tendsto eta f (nhds 0)) : Filter.Tendsto (fun i => ‖x i - g‖) f (nhds ‖(↑A).ker.starProjection g‖)
Komorebi.SufficientResolution.DiscrepancyBoundaries.identity_parameter_formula (v rho : ℝ) (hr : 0 < rho)
  (hv : rho < v) :
  let lam := rho / (v - rho);
  have hl := ⋯;
  (Komorebi.SufficientResolution.TikhonovConstruction.regularized (ContinuousLinearMap.id ℝ ℝ) lam hl) v = v - rho ∧
    Komorebi.SufficientResolution.DiscrepancyResidual.residual (ContinuousLinearMap.id ℝ ℝ) v lam = rho
