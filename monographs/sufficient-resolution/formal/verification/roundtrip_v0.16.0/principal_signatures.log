  (hA : ∀ (i : ι), ‖Y i - A ∘SL F.synthesis‖ ≤ etaCal i) (hC : ∀ (i : ι), ‖Y i - C i ∘SL F.synthesis‖ ≤ fit i)
  (he : ∀ (i : ι), ‖A p - v i‖ ≤ eta i)
  (hx :
