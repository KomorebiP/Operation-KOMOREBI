  (F : Komorebi.SufficientResolution.CalibrationFrame.Frame K G) (A : G →L[ℝ] V) (C : ι → G →L[ℝ] V) (Y : ι → K →L[ℝ] V)
  (v : ι → V) (eta etaCal fit : ι → ℝ) (x : ι → G) (g : G) (tau : ℝ) (ht : 0 ≤ tau)
  (hA : ∀ (i : ι), ‖Y i - A ∘SL F.synthesis‖ ≤ etaCal i) (hC : ∀ (i : ι), ‖Y i - C i ∘SL F.synthesis‖ ≤ fit i)
  (he : ∀ (i : ι), ‖A g - v i‖ ≤ eta i)
  (hx :
    ∀ (i : ι),
      Komorebi.SufficientResolution.GeneralizedDiscrepancy.Accepted (C i) (v i) (eta i)
        (Komorebi.SufficientResolution.CalibrationRecovery.generatedDelta F (etaCal i) (fit i)) tau (x i))
  (heta0 : Filter.Tendsto eta f (nhds 0)) (hcal0 : Filter.Tendsto etaCal f (nhds 0))
  (hfit0 : Filter.Tendsto fit f (nhds 0)) : Filter.Tendsto (fun i => ‖x i - g‖) f (nhds ‖(↑A).ker.starProjection g‖)
Komorebi.SufficientResolution.CalibrationSelection.exists_accepted_from_calibration.{u_1, u_2, u_3} {K : Type u_1}
  {G : Type u_2} {V : Type u_3} [NormedAddCommGroup K] [NormedSpace ℝ K] [NormedAddCommGroup G] [InnerProductSpace ℝ G]
  [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V]
  (F : Komorebi.SufficientResolution.CalibrationFrame.Frame K G) (A C : G →L[ℝ] V) (Y : K →L[ℝ] V) (p : G) (v : V)
  (eta etaCal fit tau : ℝ) (heta : 0 < eta) (htau : 1 < tau) (hA : ‖Y - A ∘SL F.synthesis‖ ≤ etaCal)
  (hC : ‖Y - C ∘SL F.synthesis‖ ≤ fit) (he : ‖A p - v‖ ≤ eta)
  (hrel : Komorebi.SufficientResolution.CalibrationRecovery.generatedDelta F etaCal fit * ‖p‖ < (tau - 1) * eta) :
  ∃ x,
    Komorebi.SufficientResolution.GeneralizedDiscrepancy.Accepted C v eta
        (Komorebi.SufficientResolution.CalibrationRecovery.generatedDelta F etaCal fit) tau x ∧
      ‖x‖ ≤ ‖p‖
Komorebi.SufficientResolution.CalibrationSelection.calibrated_selected_consistent.{u_1, u_2, u_3, u_4} {K : Type u_1}
  {G : Type u_2} {V : Type u_3} [NormedAddCommGroup K] [NormedSpace ℝ K] [NormedAddCommGroup G] [InnerProductSpace ℝ G]
  [CompleteSpace G] [NormedAddCommGroup V] [InnerProductSpace ℝ V] [CompleteSpace V] {ι : Type u_4} (f : Filter ι)
  (F : Komorebi.SufficientResolution.CalibrationFrame.Frame K G) (A : G →L[ℝ] V) (C : ι → G →L[ℝ] V) (Y : ι → K →L[ℝ] V)
  (v : ι → V) (eta etaCal fit : ι → ℝ) (p : G) (tau : ℝ) (hp : p ∈ (↑A).kerᗮ) (heta : ∀ (i : ι), 0 < eta i)
  (htau : 1 < tau) (hA : ∀ (i : ι), ‖Y i - A ∘SL F.synthesis‖ ≤ etaCal i)
  (hC : ∀ (i : ι), ‖Y i - C i ∘SL F.synthesis‖ ≤ fit i) (he : ∀ (i : ι), ‖A p - v i‖ ≤ eta i)
  (hrel :
    ∀ (i : ι),
      Komorebi.SufficientResolution.CalibrationRecovery.generatedDelta F (etaCal i) (fit i) * ‖p‖ < (tau - 1) * eta i)
  (heta0 : Filter.Tendsto eta f (nhds 0)) (hcal0 : Filter.Tendsto etaCal f (nhds 0))
  (hfit0 : Filter.Tendsto fit f (nhds 0)) :
  Filter.Tendsto
    (fun i =>
      Komorebi.SufficientResolution.CalibrationSelection.selectedSource F A (C i) (Y i) p (v i) (eta i) (etaCal i)
        (fit i) tau ⋯ htau ⋯ ⋯ ⋯ ⋯)
    f (nhds p)
Komorebi.SufficientResolution.CalibrationHierarchy.hierarchical_operator_bound.{u_1, u_2, u_3, u_4} {J : Type u_1}
  {K : Type u_2} {G : Type u_3} {V : Type u_4} [NormedAddCommGroup J] [NormedSpace ℝ J] [NormedAddCommGroup K]
  [NormedSpace ℝ K] [NormedAddCommGroup G] [NormedSpace ℝ G] [NormedAddCommGroup V] [NormedSpace ℝ V]
  (F : Komorebi.SufficientResolution.CalibrationFrame.Frame K G)
  (E : Komorebi.SufficientResolution.CalibrationFrame.Frame J K) (A C : G →L[ℝ] V) (Y : J →L[ℝ] V) (etaCal fit : ℝ)
  (heta : 0 ≤ etaCal) (hfit : 0 ≤ fit)
  (hA : ‖Y - A ∘SL (Komorebi.SufficientResolution.CalibrationHierarchy.comp F E).synthesis‖ ≤ etaCal)
  (hC : ‖Y - C ∘SL (Komorebi.SufficientResolution.CalibrationHierarchy.comp F E).synthesis‖ ≤ fit) :
  ‖C - A‖ ≤ (etaCal + fit) * (‖E.analysis‖ * ‖F.analysis‖)
Komorebi.SufficientResolution.CalibrationExamples.partial_not_surjective :
  ¬Function.Surjective ⇑Komorebi.SufficientResolution.CalibrationExamples.partialCalibration
Komorebi.SufficientResolution.CalibrationExamples.arbitrarily_large_unseen_error (M : ℝ) :
  ∃ C, C ∘SL Komorebi.SufficientResolution.CalibrationExamples.partialCalibration = 0 ∧ M < ‖C‖
Komorebi.SufficientResolution.CalibrationExamples.perfect_partial_calibration_unbounded (M : ℝ) :
  ∃ C,
    ‖0 - 0 ∘SL Komorebi.SufficientResolution.CalibrationExamples.partialCalibration‖ = 0 ∧
      ‖0 - C ∘SL Komorebi.SufficientResolution.CalibrationExamples.partialCalibration‖ = 0 ∧ M < ‖C - 0‖
