Komorebi.SufficientResolution.OperatorUncertaintyExamples.biased_model_wrong_limit.{u_1} {ι : Type u_1} (f : Filter ι)
  [f.NeBot] (s : ι → ℝ) (hs : ∀ (i : ι), 0 < s i) (hu : ∀ (i : ι), s i < 1) (hlim : Filter.Tendsto s f (nhds 0)) :
  (∀ (i : ι),
      Komorebi.SufficientResolution.DiscrepancyRule.Accepted (Komorebi.SufficientResolution.TikhonovExamples.scalar 2) 1
        (s i) 2 ((1 - s i) / 2)) ∧
    Filter.Tendsto (fun i => (1 - s i) / 2) f (nhds (1 / 2)) ∧ ¬Filter.Tendsto (fun i => (1 - s i) / 2) f (nhds 1)
