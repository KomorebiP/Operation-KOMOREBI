+def discover_modules():
+    """Discover and topologically order every production source module.
+
+    Only project-local import edges are ordered here; the pinned imported
+    Lean/Mathlib dependencies remain the runtime's responsibility. Missing
+    production imports and cycles fail rather than silently reducing coverage.
+    """
+    source_root = ROOT / 'Komorebi/SufficientResolution'
+    files = {p.stem: p for p in sorted(source_root.glob('*.lean'))}
+    if not files:
+        raise ValueError('No production SufficientResolution modules found')
+    dependencies = {}
+    for name, path in files.items():
+        text = re.sub(r'/\-.*?\-/', '', path.read_text(), flags=re.S)
+        text = re.sub(r'--[^\n]*', '', text)
+        imports = []
+        for match in re.finditer(r'^\s*import\s+([^\n]+)', text, flags=re.M):
+            for imported in match.group(1).split():
+                if imported.startswith('Komorebi.SufficientResolution.'):
+                    dependency = imported.removeprefix('Komorebi.SufficientResolution.')
+                    if dependency not in files:
+                        raise ValueError('Missing production import: '+name+' -> '+dependency)
+                    imports.append(dependency)
+        dependencies[name] = sorted(set(imports))
+    order, active, completed = [], set(), set()
+    def visit(name):
+        if name in completed:
+            return
+        if name in active:
+            raise ValueError('Production import cycle at '+name)
+        active.add(name)
+        for dependency in dependencies[name]:
+            visit(dependency)
+        active.remove(name)
+        completed.add(name)
+        order.append(name)
+    for name in sorted(files):
+        visit(name)
+    if set(order) != set(files) or len(order) != len(files):
+        raise ValueError('Production module coverage mismatch')
+    return order
+
+
+MODULES = discover_modules()
 
