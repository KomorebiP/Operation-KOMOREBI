include README.md STATUS.md CHANGELOG.md CONTRIBUTING.md CITATION.cff LICENSE_NOTICE.md RELEASE_AUDIT.md
include pyproject.toml setup.py MANIFEST.in
recursive-include docs *.tex *.pdf *.png *.md
recursive-include examples *.json *.md *.py
recursive-include schemas *.json
recursive-include scripts *.py *.ps1
recursive-include data *.csv *.json *.md
recursive-include github-integration *.md *.yml
recursive-include tests *.py
global-exclude *.aux *.log *.out *.toc *.pyc
global-exclude __pycache__ .pytest_cache

recursive-include formal *.lean *.json lean-toolchain
recursive-include evidence/lean *.json *.log *.lean
include PROGRESS_LEDGER_v1.3.0.md PROOFREADING_REPORT.md
recursive-include editorial *.json *.md *.diff
recursive-include historical *.json *.md *.tex *.pdf *.csv

# The final report hashes distributions, so it is external to the sdist.
exclude data/release_verification.json

# The dated delivery report hashes distributions and remains outside the sdist.
exclude data/editorial_verification.json

include PROGRESS_LEDGER_v1.6.0.md VERIFICATION_SUMMARY.md VISUAL_UPGRADE_REPORT.md
exclude data/publication_verification_1.6.0.json

include PROGRESS_LEDGER_v1.7.0.md FINALIZATION_REPORT.md
recursive-include evidence/formal_1.7.0 *.json *.lean
recursive-include editorial/new_content_1.7.0 *.tex
exclude data/publication_verification_1.7.0.json

# The signed-off handoff report is external to the installable distribution.
exclude FINALIZATION_REPORT.md

include PROGRESS_LEDGER_v1.8.0.md FINALIZATION_REPORT.md
recursive-include evidence/formal_1.8.0 *.json *.lean
recursive-include editorial/new_content_1.8.0 *.tex
exclude data/publication_verification_1.8.0.json

# Current signed-off handoff report is external to installable distributions.
exclude FINALIZATION_REPORT.md
