{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:komorebi:proof-path-theory:schema:certificate:1.0",
  "title": "Proof Path Theory certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "justifications", "targets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "nodes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "justifications": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
