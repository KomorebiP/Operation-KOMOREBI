import KomorebiLSM.Block7Examples

/-! Exact boundaries for shared policies and redundant coefficient choices. -/
set_option autoImplicit false
namespace Komorebi.LSM.Block7BoundaryExamples
open scoped BigOperators
open BaseNorm FiniteTV FiniteBayes FiniteInstruments ObservationTree PositiveLift Block7Examples

/-- The same physical instrument reports the chosen action deterministically. -/
noncomputable def echo (_ : List (Fin 2 × Fin 2)) (s : Fin 2 × Fin 2) : ℝ →ₗ[ℝ] ℝ :=
  if s.1=s.2 then LinearMap.id else 0

theorem echo_instrument (h : List (Fin 2 × Fin 2)) (a : Fin 2) :
    scalarCone.Instrument (fun o => echo h (a,o)) := by
  constructor
  · intro o x hx
    by_cases hae : a=o
    · simpa [echo,hae] using hx
    · simpa [echo,hae] using scalarCone.zero_mem
  · intro x
    fin_cases a <;> simp [echo,Fin.sum_univ_two,scalarCone]

noncomputable def fixedPolicy (a : Fin 2) : List (Fin 2 × Fin 2) → Fin 2 → ℝ :=
  deterministicPolicy (fun _ => a)

theorem fixedPolicy_prior (a : Fin 2) (h : List (Fin 2 × Fin 2)) :
    IsPrior (fixedPolicy a h) := deterministicPolicy_prior (fun _ => a) h

theorem one_record_eq (a b : Fin 2) :
    (show Record (Fin 2) 1 from (a,PUnit.unit))=(b,PUnit.unit) ↔ a=b := by
  constructor
  · intro h; exact congrArg Prod.fst h
  · intro h; subst b; rfl

theorem changed_policy_observation_distance :
    distance (observationLaw scalarCone (fixedPolicy 0) echo 1 1)
      (observationLaw scalarCone (fixedPolicy 1) echo 1 1)=1 := by
  unfold distance l1 observationLaw aggregate
  simp_rw [Pi.sub_apply,sum_record_succ,sum_record_zero]
  norm_num [recordMap,recordLaw,recordState,policyBranches,fixedPolicy,deterministicPolicy,
    pointMass,echo,scalarCone,Fintype.sum_prod_type,Fin.sum_univ_two,record_pair_eq_iff]

theorem identical_instrument_has_zero_discrepancy (h : List (Fin 2 × Fin 2)) (a : Fin 2) (x : ℝ) :
    scalarCone.discrepancy (fun o => echo h (a,o)) (fun o => echo h (a,o)) x=0 := by
  simp [ProbabilityCone.discrepancy]

/-- Model identity cannot bound laws generated by different policies. -/
theorem changed_policy_not_zero_error :
    ¬ distance (observationLaw scalarCone (fixedPolicy 0) echo 1 1)
      (observationLaw scalarCone (fixedPolicy 1) echo 1 1) ≤ 0 := by
  rw [changed_policy_observation_distance]; norm_num

noncomputable def fairPolicy (_ : List (Fin 2 × Fin 2)) : Fin 2 → ℝ := ![1/2,1/2]

theorem fairPolicy_prior (h : List (Fin 2 × Fin 2)) : IsPrior (fairPolicy h) := by
  constructor
  · intro a; fin_cases a <;> norm_num [fairPolicy]
  · norm_num [fairPolicy,Fin.sum_univ_two]

/-- A shared randomized policy is an actual instance of the whole-record theorem. -/
theorem fair_policy_identical_laws (n : ℕ) :
    distance (observationLaw scalarCone fairPolicy echo n 1)
      (observationLaw scalarCone fairPolicy echo n 1)=0 := by
  have he : ∀ (h : List (Fin 2 × Fin 2)) (a : Fin 2) x, x ∈ scalarCone.base →
      scalarCone.discrepancy (fun o => echo h (a,o)) (fun o => echo h (a,o)) x ≤
        (fun _ : ℕ => (0 : ℝ)) h.length := by
    intro h a x _
    rw [identical_instrument_has_zero_discrepancy]
  have hb := shared_policy_observation_tv_bound scalarCone fairPolicy fairPolicy_prior echo echo
    echo_instrument echo_instrument (fun _ => 0) he n 1 1 scalar_initial scalar_initial
  simp only [sub_self,ProbabilityCone.value_zero,zero_div,Finset.sum_const_zero,add_zero,
    min_eq_right (by norm_num : (0 : ℝ) ≤ 1)] at hb
  exact le_antisymm hb (distance_nonneg _ _)

noncomputable def redundantSynthesis : (Fin 3 → ℝ) →ₗ[ℝ] (Fin 2 → ℝ) :=
  (!![1,1,1;0,1,2] : Matrix (Fin 2) (Fin 3) ℝ).mulVecLin

def firstMass : (Fin 2 → ℝ) →ₗ[ℝ] ℝ := LinearMap.proj 0

theorem redundant_normalized : firstMass.comp redundantSynthesis=mass := by
  apply LinearMap.ext
  intro x
  simp [firstMass,redundantSynthesis,Matrix.mulVec,dotProduct,mass_apply,Fin.sum_univ_three,Matrix.cons_val_two]

theorem redundant_surjective : Function.Surjective redundantSynthesis := by
  intro x
  refine ⟨![x 0-x 1,x 1,0],?_⟩
  funext i
  fin_cases i <;> simp [redundantSynthesis,Matrix.mulVec,dotProduct,Fin.sum_univ_three,Matrix.cons_val_two]

noncomputable def redundantCone : ProbabilityCone (Fin 2 → ℝ) :=
  finiteCone redundantSynthesis firstMass redundant_normalized redundant_surjective

noncomputable def leastSquareCoefficients : Fin 3 → ℝ := ![5/6,1/3,-1/6]

theorem redundant_same_state : redundantSynthesis leastSquareCoefficients=![1,0] := by
  ext i; fin_cases i <;> norm_num [redundantSynthesis,leastSquareCoefficients,
    Matrix.mulVec,dotProduct,Fin.sum_univ_three,Matrix.cons_val_two]

theorem redundant_state_in_cone : (![1,0] : Fin 2 → ℝ) ∈ redundantCone.carrier := by
  refine ⟨![1,0,0],?_,?_⟩
  · intro i; fin_cases i <;> norm_num
  · ext i; fin_cases i <;> norm_num [redundantSynthesis,Matrix.mulVec,dotProduct,Fin.sum_univ_three,Matrix.cons_val_two]

theorem redundant_base_norm_one : redundantCone.value (![1,0])=1 :=
  (redundantCone.value_on_cone redundant_state_in_cone).trans (by rfl)

theorem redundant_coefficients_l1 : l1 leastSquareCoefficients=4/3 := by
  norm_num [l1,leastSquareCoefficients,Fin.sum_univ_three,Matrix.cons_val_two]

/-- This coefficient vector really minimizes squared Euclidean length under the synthesis constraint. -/
theorem leastSquareCoefficients_minimal (a : Fin 3 → ℝ)
    (ha : redundantSynthesis a=![1,0]) :
    (∑ j, (leastSquareCoefficients j)^2) ≤ ∑ j, (a j)^2 := by
  have h0 := congrFun ha 0
  have h1 := congrFun ha 1
  simp [redundantSynthesis,Matrix.mulVec,dotProduct,Fin.sum_univ_three,Matrix.cons_val_two] at h0 h1
  have he0 : a 0=1+a 2 := by linarith
  have he1 : a 1= -2*a 2 := by linarith
  norm_num [leastSquareCoefficients,Fin.sum_univ_three,Matrix.cons_val_two]
  rw [he0,he1]
  nlinarith [sq_nonneg (a 2+1/6)]

/-- Even minimum Euclidean-length coefficients need not compute the base norm. -/
theorem least_square_l1_is_not_base_norm :
    redundantCone.value (redundantSynthesis leastSquareCoefficients) ≠ l1 leastSquareCoefficients := by
  rw [redundant_same_state,redundant_base_norm_one,redundant_coefficients_l1]
  norm_num

end Komorebi.LSM.Block7BoundaryExamples
