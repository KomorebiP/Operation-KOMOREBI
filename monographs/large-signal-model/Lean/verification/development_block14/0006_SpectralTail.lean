import KomorebiLSM.SpectralSubspaces

set_option autoImplicit false
namespace Komorebi.LSM.Spectral
variable {E F : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
variable [NormedAddCommGroup F] [InnerProductSpace ℝ F]
variable [FiniteDimensional ℝ E] [FiniteDimensional ℝ F]

/-- Actual left subspace generated by the images of the first right singular modes.
It has dimension `k` whenever `k` is at most the rank. -/
noncomputable def leadingLeft (A : E →ₗ[ℝ] F) (k : ℕ)
    (hk : k ≤ Module.finrank ℝ E) : Submodule ℝ F :=
  (rightHead A k hk).map A

theorem rightHead_le_kernel_orthogonal (A : E →ₗ[ℝ] F) (k : ℕ)
    (hk : k ≤ Module.finrank ℝ E) (hr : k ≤ Module.finrank ℝ A.range) :
    rightHead A k hk ≤ A.kerᗮ := by
  apply Submodule.span_le.mpr
  rintro _ ⟨i,rfl⟩
  exact positive_mode_orthogonal A _ (A.singularValues_pos_iff_lt_finrank_range.mpr
    (lt_of_lt_of_le i.isLt hr))

theorem leadingLeft_finrank (A : E →ₗ[ℝ] F) (k : ℕ)
    (hk : k ≤ Module.finrank ℝ E) (hr : k ≤ Module.finrank ℝ A.range) :
    Module.finrank ℝ (leadingLeft A k hk) = k := by
  have hinj : Function.Injective (A.comp (rightHead A k hk).subtype) := by
    apply LinearMap.ker_eq_bot.mp
    apply le_antisymm _ bot_le
    intro x hx
    have hm : (x:E) ∈ A.ker := hx
    have ho := rightHead_le_kernel_orthogonal A k hk hr x.property
    have he : (x:E) = 0 := by
      simpa using A.ker.inner_right_of_mem_orthogonal hm ho
    change x = 0
    exact Subtype.ext he
  have h := LinearMap.finrank_range_of_inj hinj
  rw [LinearMap.range_comp, Submodule.range_subtype, rightHead_finrank] at h
  exact h

theorem image_tail_orthogonal (A : E →ₗ[ℝ] F) (k : ℕ)
    (hk : k ≤ Module.finrank ℝ E) (x : E) (hx : x ∈ (rightHead A k hk)ᗮ) :
    A x ∈ (leadingLeft A k hk)ᗮ := by
  intro y hy
  obtain ⟨v,hv,rfl⟩ := hy
  induction hv using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨i,rfl⟩ := hv
    rw [image_inner, rightTail_coordinate_zero A k hk x hx _ i.isLt, mul_zero]
  | zero => simp
  | add v w hv hw ihv ihw => simp [map_add, inner_add_left, ihv, ihw]
  | smul a v hv ih => simp [map_smul, inner_smul_left, ih]

theorem leadingLeft_residual_apply (A : E →ₗ[ℝ] F) (k : ℕ)
    (hk : k ≤ Module.finrank ℝ E) (x : E) :
    (leadingLeft A k hk)ᗮ.starProjection (A x) =
      A ((rightHead A k hk)ᗮ.starProjection x) := by
  have hsum := (rightHead A k hk).starProjection_add_starProjection_orthogonal x
  have hm : A ((rightHead A k hk).starProjection x) ∈ leadingLeft A k hk :=
    ⟨_,(rightHead A k hk).starProjection_apply_mem x,rfl⟩
  have ho := image_tail_orthogonal A k hk _
    ((rightHead A k hk)ᗮ.starProjection_apply_mem x)
  conv_lhs => rw [← hsum, map_add, map_add]
  rw [(leadingLeft A k hk).starProjection_orthogonal_apply_eq_zero hm,
    (leadingLeft A k hk)ᗮ.starProjection_eq_self_iff.mpr ho, zero_add]

theorem leadingLeft_tail_bound (A : E →L[ℝ] F) (k : ℕ)
    (hk : k ≤ Module.finrank ℝ E) :
    ‖(leadingLeft A.toLinearMap k hk)ᗮ.starProjection.comp A‖ ≤
      A.toLinearMap.singularValues k := by
  apply ContinuousLinearMap.opNorm_le_bound _ (A.toLinearMap.singularValues_nonneg k)
  intro x
  change ‖(leadingLeft A.toLinearMap k hk)ᗮ.starProjection (A.toLinearMap x)‖ ≤ _
  rw [leadingLeft_residual_apply]
  exact (upper_on_rightTail A.toLinearMap k hk _
    ((rightHead A.toLinearMap k hk)ᗮ.starProjection_apply_mem x)).trans
    (mul_le_mul_of_nonneg_left ((rightHead A.toLinearMap k hk)ᗮ.norm_starProjection_apply_le x)
      (A.toLinearMap.singularValues_nonneg k))

/-- The residual norm is exactly the next singular value, including a zero tail
when every domain direction is retained. -/
theorem leadingLeft_tail_norm (A : E →L[ℝ] F) (k : ℕ)
    (hk : k ≤ Module.finrank ℝ E) :
    ‖(leadingLeft A.toLinearMap k hk)ᗮ.starProjection.comp A‖ =
      A.toLinearMap.singularValues k := by
  apply le_antisymm (leadingLeft_tail_bound A k hk)
  by_cases hlt : k < Module.finrank ℝ E
  · let i : Fin (Module.finrank ℝ E) := ⟨k,hlt⟩
    have h := ((leadingLeft A.toLinearMap k hk)ᗮ.starProjection.comp A).le_opNorm
      (rightBasis A.toLinearMap i)
    change ‖(leadingLeft A.toLinearMap k hk)ᗮ.starProjection
      (A.toLinearMap (rightBasis A.toLinearMap i))‖ ≤ _ at h
    rw [leadingLeft_residual_apply,
      (rightHead A.toLinearMap k hk)ᗮ.starProjection_eq_self_iff.mpr
        (basis_mem_rightTail A.toLinearMap k hk i le_rfl),
      image_basis_norm, (rightBasis A.toLinearMap).norm_eq_one, mul_one] at h
    exact h
  · have hz : A.toLinearMap.singularValues k = 0 :=
      A.toLinearMap.singularValues_eq_zero_iff_le_finrank_range.mpr
        ((LinearMap.finrank_range_le A.toLinearMap).trans (by omega))
    rw [hz]
    exact norm_nonneg _

end Komorebi.LSM.Spectral
