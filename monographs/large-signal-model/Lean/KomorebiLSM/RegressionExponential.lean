import KomorebiLSM.ConditionalRandomMultiplier
import KomorebiLSM.RegressionGeometry
import Mathlib.Probability.Martingale.Basic
import Mathlib.MeasureTheory.Integral.Prod

/-! The literal exponential product generated by predictable regression designs
is a nonnegative supermartingale. A fixed probability mixture is derived by
joint measurability and actual product-measure integration. -/
set_option autoImplicit false
namespace Komorebi.LSM.RegressionConfidence
open MeasureTheory ProbabilityTheory Matrix Real
open scoped BigOperators ENNReal
variable {Ω : Type*} [mΩ : MeasurableSpace Ω]
variable {μ : Measure Ω} [IsProbabilityMeasure μ]
variable {I : Type*} [Fintype I] [DecidableEq I]

/-- The predictable scalar projection used for one fixed exponential direction. -/
noncomputable def projection (σ : ℝ) (φ : ℕ → Ω → I → ℝ) (q : I → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  (q ⬝ᵥ φ n ω)/σ

/-- The actual finite product, starting before observation zero. -/
noncomputable def exponentialProcess (σ : ℝ) (φ : ℕ → Ω → I → ℝ) (ξ : ℕ → Ω → ℝ)
    (q : I → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  ∏ i∈Finset.range n,factor (ξ i) σ (projection σ φ q i) ω

omit [MeasurableSpace Ω] [DecidableEq I] in
@[simp] theorem exponentialProcess_zero (σ : ℝ) (φ : ℕ → Ω → I → ℝ)
    (ξ : ℕ → Ω → ℝ) (q : I → ℝ) (ω : Ω) : exponentialProcess σ φ ξ q 0 ω=1 := by
  simp [exponentialProcess]

omit [MeasurableSpace Ω] [DecidableEq I] in
theorem exponentialProcess_succ (σ : ℝ) (φ : ℕ → Ω → I → ℝ)
    (ξ : ℕ → Ω → ℝ) (q : I → ℝ) (n : ℕ) (ω : Ω) :
    exponentialProcess σ φ ξ q (n+1) ω=
      exponentialProcess σ φ ξ q n ω*factor (ξ n) σ (projection σ φ q n) ω := by
  simp only [exponentialProcess,Finset.prod_range_succ]

omit [MeasurableSpace Ω] [DecidableEq I] in
theorem exponentialProcess_pos (σ : ℝ) (φ : ℕ → Ω → I → ℝ)
    (ξ : ℕ → Ω → ℝ) (q : I → ℝ) (n : ℕ) (ω : Ω) :
    0<exponentialProcess σ φ ξ q n ω :=
  Finset.prod_pos (fun _ _ => factor_pos _ _)

omit [MeasurableSpace Ω] [DecidableEq I] in
/-- The product equals the exact source score/Gram exponential, rather than
being supplied as a process with an assumed logarithmic formula. -/
theorem exponentialProcess_eq (σ : ℝ) (hσ : σ≠0) (φ : ℕ → Ω → I → ℝ)
    (ξ : ℕ → Ω → ℝ) (q : I → ℝ) (n : ℕ) (ω : Ω) :
    exponentialProcess σ φ ξ q n ω=
      exp ((q ⬝ᵥ responseVector (fun i => φ i ω) (fun i => ξ i ω) n)/σ-
        (q ⬝ᵥ (designGram (fun i => φ i ω) n *ᵥ q))/2) := by
  have he (i : ℕ) : factor (ξ i) σ (projection σ φ q i) ω=
      exp ((q ⬝ᵥ φ i ω)*ξ i ω/σ-(q ⬝ᵥ φ i ω)^2/2) := by
    unfold factor projection
    congr 1
    field_simp
  unfold exponentialProcess
  simp only [he]
  rw [← Real.exp_sum]
  congr 1
  rw [designGram_quadratic]
  simp only [responseVector,dotProduct_sum,dotProduct_smul,smul_eq_mul,
    Finset.sum_sub_distrib,Finset.sum_div]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  ring

section Predictable
variable (ℱ : Filtration ℕ mΩ) (σ : ℝ) (φ : ℕ → Ω → I → ℝ) (ξ : ℕ → Ω → ℝ)
variable (hφ : ∀ n i,Measurable[ℱ n] (fun ω => φ n ω i))
variable (hξ : ∀ n,Measurable[ℱ (n+1)] (ξ n))
variable (H : ∀ n,ConditionalSubgaussian (ℱ.le n) (ξ n) σ μ)

include hφ in
omit [DecidableEq I] in
theorem projection_measurable (q : I → ℝ) (n : ℕ) :
    Measurable[ℱ n] (projection σ φ q n) := by
  unfold projection dotProduct
  exact (Finset.measurable_sum _ (fun i _ => measurable_const.mul (hφ n i))).div_const σ

include hφ hξ in
omit [DecidableEq I] in
theorem exponentialProcess_measurable (q : I → ℝ) :
    ∀ n,Measurable[ℱ n] (exponentialProcess σ φ ξ q n)
  | 0 => by
    have he : exponentialProcess σ φ ξ q 0=(fun _ : Ω => (1:ℝ)) :=
      funext (exponentialProcess_zero σ φ ξ q)
    rw [he]
    exact measurable_const
  | n+1 => by
    have hp : Measurable[ℱ (n+1)] (exponentialProcess σ φ ξ q n) :=
      (exponentialProcess_measurable q n).mono (ℱ.mono (Nat.le_succ n)) le_rfl
    have hf : Measurable[ℱ (n+1)] (factor (ξ n) σ (projection σ φ q n)) := by
      let : MeasurableSpace Ω := ℱ (n+1)
      exact factor_measurable (mΩ := ℱ (n+1)) (hξ n)
        ((projection_measurable (mΩ := mΩ) ℱ σ φ hφ q n).mono (ℱ.mono (Nat.le_succ n)) le_rfl)
    have he : exponentialProcess σ φ ξ q (n+1)=
        (fun ω => exponentialProcess σ φ ξ q n ω*factor (ξ n) σ (projection σ φ q n) ω) :=
      funext (exponentialProcess_succ σ φ ξ q n)
    rw [he]
    exact hp.mul hf

include hφ hξ H in
omit [DecidableEq I] in
theorem exponentialProcess_integrable (q : I → ℝ) :
    ∀ n,Integrable (exponentialProcess σ φ ξ q n) μ
  | 0 => by
    have he : exponentialProcess σ φ ξ q 0=(fun _ : Ω => (1:ℝ)) :=
      funext (exponentialProcess_zero σ φ ξ q)
    rw [he]
    exact integrable_const _
  | n+1 => by
    have hi := (H n).weighted_factor_integrable (projection σ φ q n)
      (projection_measurable ℱ σ φ hφ q n) (exponentialProcess σ φ ξ q n)
      (exponentialProcess_measurable ℱ σ φ ξ hφ hξ q n)
      (exponentialProcess_integrable q n) (fun ω => (exponentialProcess_pos σ φ ξ q n ω).le)
    have he : exponentialProcess σ φ ξ q (n+1)=
        (fun ω => exponentialProcess σ φ ξ q n ω*factor (ξ n) σ (projection σ φ q n) ω) :=
      funext (exponentialProcess_succ σ φ ξ q n)
    rw [he]
    exact hi

include hφ hξ H in
omit [DecidableEq I] in
theorem exponentialProcess_setIntegral_succ_le (q : I → ℝ) (n : ℕ)
    {s : Set Ω} (hs : MeasurableSet[ℱ n] s) :
    (∫ ω in s,exponentialProcess σ φ ξ q (n+1) ω∂μ)≤
      ∫ ω in s,exponentialProcess σ φ ξ q n ω∂μ := by
  simpa only [exponentialProcess_succ] using (H n).setIntegral_weighted_factor_le
    (projection σ φ q n) (projection_measurable ℱ σ φ hφ q n)
    (exponentialProcess σ φ ξ q n) (exponentialProcess_measurable ℱ σ φ ξ hφ hξ q n)
    (exponentialProcess_integrable ℱ σ φ ξ hφ hξ H q n)
    (fun ω => (exponentialProcess_pos σ φ ξ q n ω).le) hs

include hφ hξ H in
omit [DecidableEq I] in
/-- Fixed-q supermartingale status follows from the actual conditional noise
bounds, predictable designs and the literal product recurrence. -/
theorem exponentialProcess_supermartingale (q : I → ℝ) :
    Supermartingale (exponentialProcess σ φ ξ q) ℱ μ :=
  supermartingale_of_setIntegral_succ_le
    (fun n => (exponentialProcess_measurable ℱ σ φ ξ hφ hξ q n).stronglyMeasurable)
    (exponentialProcess_integrable ℱ σ φ ξ hφ hξ H q)
    (fun n _ hs => exponentialProcess_setIntegral_succ_le ℱ σ φ ξ hφ hξ H q n hs)

end Predictable
/-- A fixed probability mixture of the literal processes. -/
noncomputable def probabilityMixture {Q : Type*} [MeasurableSpace Q] (ν : Measure Q)
    (F : Q → ℕ → Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ := ∫ q,F q n ω∂ν

section GeneralMixture
variable {Q : Type*} [mQ : MeasurableSpace Q] (ν : Measure Q) [IsProbabilityMeasure ν]
variable (ℱ : Filtration ℕ mΩ) (F : Q → ℕ → Ω → ℝ)
variable (hF : ∀ q,Supermartingale (F q) ℱ μ)
variable (hjoint : ∀ n,Measurable[mQ.prod (ℱ n)] (fun p : Q × Ω => F p.1 n p.2))
variable (hnonneg : ∀ q n ω,0≤F q n ω) (hinit : ∀ q ω,F q 0 ω=1)

include hF hjoint hnonneg hinit in
/-- Joint integrability is derived from Tonelli's norm criterion and the
individual supermartingale expectation budgets. It is not a mixture premise. -/
theorem mixture_joint_integrable (n : ℕ) :
    Integrable (fun p : Q × Ω => F p.1 n p.2) (ν.prod μ) := by
  have hprod : mQ.prod (ℱ n)≤mQ.prod mΩ :=
    sup_le_sup le_rfl (MeasurableSpace.comap_mono (g := Prod.snd) (ℱ.le n))
  have hm : Measurable (fun p : Q × Ω => F p.1 n p.2) :=
    (hjoint n).mono hprod le_rfl
  have hb (q : Q) : (∫ ω,F q n ω∂μ)≤1 := by
    have hs := (hF q).setIntegral_le (i := 0) (j := n) (Nat.zero_le n) MeasurableSet.univ
    simpa only [Measure.restrict_univ,hinit,integral_const,measureReal_def,
      measure_univ,ENNReal.toReal_one,one_smul] using hs
  apply (integrable_prod_iff hm.aestronglyMeasurable).2
  refine ⟨ae_of_all _ (fun q => (hF q).integrable n),?_⟩
  apply Integrable.of_bound hm.norm.stronglyMeasurable.integral_prod_right'.aestronglyMeasurable 1
  filter_upwards [] with q
  have he : (∫ ω,‖F q n ω‖∂μ)=∫ ω,F q n ω∂μ :=
    integral_congr_ae (ae_of_all _ (fun ω => Real.norm_of_nonneg (hnonneg q n ω)))
  rw [Real.norm_eq_abs,abs_of_nonneg (integral_nonneg (fun ω => norm_nonneg (F q n ω))),he]
  exact hb q

include hF hjoint hnonneg hinit in
/-- A probability mixture of nonnegative supermartingales starting at one is
an actual supermartingale. Joint measurability and Tonelli/Fubini derive the
conditional event inequalities. -/
theorem probabilityMixture_supermartingale : Supermartingale (probabilityMixture ν F) ℱ μ := by
  have hi := mixture_joint_integrable ν ℱ F hF hjoint hnonneg hinit
  apply supermartingale_of_setIntegral_succ_le
  · intro n
    let : MeasurableSpace Ω := ℱ n
    exact (hjoint n).stronglyMeasurable.integral_prod_left'
  · intro n
    exact (hi n).integral_prod_right
  · intro n s hs
    have hin : Integrable (fun p : Q × Ω => F p.1 n p.2) (ν.prod (μ.restrict s)) :=
      (hi n).mono_measure (Measure.prod_mono le_rfl Measure.restrict_le_self)
    have his : Integrable (fun p : Q × Ω => F p.1 (n+1) p.2) (ν.prod (μ.restrict s)) :=
      (hi (n+1)).mono_measure (Measure.prod_mono le_rfl Measure.restrict_le_self)
    calc (∫ ω in s,probabilityMixture ν F (n+1) ω∂μ)=
        ∫ q,∫ ω in s,F q (n+1) ω∂μ∂ν := (integral_integral_swap his).symm
      _ ≤ ∫ q,∫ ω in s,F q n ω∂μ∂ν :=
        integral_mono his.integral_prod_left hin.integral_prod_left
          (fun q => (hF q).setIntegral_le (Nat.le_succ n) hs)
      _ = ∫ ω in s,probabilityMixture ν F n ω∂μ := integral_integral_swap hin
end GeneralMixture

section RegressionMixture
variable (ℱ : Filtration ℕ mΩ) (σ : ℝ) (φ : ℕ → Ω → I → ℝ) (ξ : ℕ → Ω → ℝ)
variable (hφ : ∀ n i,Measurable[ℱ n] (fun ω => φ n ω i))
variable (hξ : ∀ n,Measurable[ℱ (n+1)] (ξ n))
variable (H : ∀ n,ConditionalSubgaussian (ℱ.le n) (ξ n) σ μ)

include hφ hξ in
omit [DecidableEq I] in
/-- The literal regression family is jointly measurable in the mixing direction
and recorded history, already at the current filtration level. -/
theorem exponentialProcess_joint_measurable (n : ℕ) :
    Measurable[(inferInstance : MeasurableSpace (I → ℝ)).prod (ℱ n)]
      (fun p : (I → ℝ) × Ω => exponentialProcess σ φ ξ p.1 n p.2) := by
  let : MeasurableSpace Ω := ℱ n
  unfold exponentialProcess
  apply Finset.measurable_prod
  intro i hi
  have hlt : i<n := Finset.mem_range.mp hi
  have ha : Measurable (fun p : (I → ℝ) × Ω => projection σ φ p.1 i p.2) := by
    unfold projection dotProduct
    apply Measurable.div_const
    apply Finset.measurable_sum
    intro j _
    exact ((measurable_pi_apply j).comp measurable_fst).mul
      (((hφ i j).mono (ℱ.mono (Nat.le_of_lt hlt)) le_rfl).comp measurable_snd)
  have hx : Measurable (fun p : (I → ℝ) × Ω => ξ i p.2) :=
    ((hξ i).mono (ℱ.mono (Nat.succ_le_of_lt hlt)) le_rfl).comp measurable_snd
  exact factor_measurable hx ha

/-- The literal probability mixture of fixed-direction regression products. -/
noncomputable def exponentialMixture (ν : Measure (I → ℝ)) (n : ℕ) (ω : Ω) : ℝ :=
  probabilityMixture ν (fun q => exponentialProcess σ φ ξ q) n ω

omit [MeasurableSpace Ω] [DecidableEq I] in
@[simp] theorem exponentialMixture_zero (ν : Measure (I → ℝ)) [IsProbabilityMeasure ν]
    (ω : Ω) : exponentialMixture σ φ ξ ν 0 ω=1 := by
  simp [exponentialMixture,probabilityMixture]

omit [MeasurableSpace Ω] [DecidableEq I] in
theorem exponentialMixture_nonneg (ν : Measure (I → ℝ)) (n : ℕ) (ω : Ω) :
    0≤exponentialMixture σ φ ξ ν n ω :=
  integral_nonneg (fun q => (exponentialProcess_pos σ φ ξ q n ω).le)

omit [MeasurableSpace Ω] [DecidableEq I] in
/-- The mixture integrand is exactly the score/Gram exponential used by the
Gaussian completing-square calculation. -/
theorem exponentialMixture_eq (hσ : σ≠0) (ν : Measure (I → ℝ)) (n : ℕ) (ω : Ω) :
    exponentialMixture σ φ ξ ν n ω=
      ∫ q,exp ((q ⬝ᵥ responseVector (fun i => φ i ω) (fun i => ξ i ω) n)/σ-
        (q ⬝ᵥ (designGram (fun i => φ i ω) n *ᵥ q))/2)∂ν :=
  integral_congr_ae (ae_of_all _ (fun q => exponentialProcess_eq σ hσ φ ξ q n ω))

include hφ hξ H in
omit [DecidableEq I] in
/-- Every fixed probability law on directions gives an actual nonnegative
regression-mixture supermartingale, without a design bound or density margin. -/
theorem exponentialMixture_supermartingale (ν : Measure (I → ℝ)) [IsProbabilityMeasure ν] :
    Supermartingale (exponentialMixture σ φ ξ ν) ℱ μ :=
  probabilityMixture_supermartingale ν ℱ (fun q => exponentialProcess σ φ ξ q)
    (fun q => exponentialProcess_supermartingale ℱ σ φ ξ hφ hξ H q)
    (exponentialProcess_joint_measurable ℱ σ φ ξ hφ hξ)
    (fun q n ω => (exponentialProcess_pos σ φ ξ q n ω).le)
    (fun q ω => exponentialProcess_zero σ φ ξ q ω)

include hφ hξ H in
omit [DecidableEq I] in
/-- Tonelli also supplies actual almost-everywhere integrability of the mixing
fiber; it is derived rather than silently presumed. -/
theorem exponentialMixture_fiber_integrable_ae (ν : Measure (I → ℝ)) [IsProbabilityMeasure ν]
    (n : ℕ) : ∀ᵐ ω∂μ,Integrable (fun q => exponentialProcess σ φ ξ q n ω) ν := by
  have hi := mixture_joint_integrable ν ℱ (fun q => exponentialProcess σ φ ξ q)
    (fun q => exponentialProcess_supermartingale ℱ σ φ ξ hφ hξ H q)
    (exponentialProcess_joint_measurable ℱ σ φ ξ hφ hξ)
    (fun q n ω => (exponentialProcess_pos σ φ ξ q n ω).le)
    (fun q ω => exponentialProcess_zero σ φ ξ q ω) n
  exact hi.prod_left_ae
end RegressionMixture

end Komorebi.LSM.RegressionConfidence
