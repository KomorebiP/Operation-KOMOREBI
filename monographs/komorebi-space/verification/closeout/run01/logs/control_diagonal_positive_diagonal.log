KomorebiSpace.DiagonalRegularization.proposition_30_1 (m K : ℕ) (hm : 1 ≤ m) (hmK : m ≤ K) :
  a m = KomorebiSpace.RegularizedHilbertRepair.correction T (alpha m) ⋯ w ∧
    w - T (a m) = v m ∧
      ‖a m‖ ^ 2 = A m ∧
        ‖v m‖ ^ 2 = B m ∧
          ↑m / 4 ≤ A m ∧
            A m ≤ 4 * ↑m / 3 ∧
              1 / (4 * (↑m + 1)) ≤ B m ∧
                B m ≤ 2 / ↑m ∧
                  0 ≤ A m - partialA m K ∧
                    A m - partialA m K ≤ ↑m ^ 4 / (3 * ↑K ^ 3) ∧ 0 ≤ B m - partialB m K ∧ B m - partialB m K ≤ 1 / ↑K
KomorebiSpace.DiagonalRegularization.corollary_30_3 (s : H) {δ : ℝ} (hδ : 0 < δ) (hδ₁ : δ ≤ 1) (hdata : ‖s - b‖ ≤ δ) :
  let m := ⌈δ ^ (-2 / 3)⌉₊;
  have hm := ⋯;
  ‖KomorebiSpace.RegularizedHilbertRepair.correction T (alpha m) ⋯ s - w‖ ≤ √(2 / ↑m) + δ * ↑m / 2 ∧
    √(2 / ↑m) + δ * ↑m / 2 ≤ (√2 + 1) * δ ^ (1 / 3)
'KomorebiSpace.DiagonalRegularization.proposition_30_1' depends on axioms: [propext, Classical.choice, Quot.sound]
'KomorebiSpace.DiagonalRegularization.corollary_30_3' depends on axioms: [propext, Classical.choice, Quot.sound]
