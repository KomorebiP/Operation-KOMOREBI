import Mathlib.CategoryTheory.Sites.Grothendieck
import Mathlib.CategoryTheory.Category.Preorder
import Mathlib.Data.Set.Lattice.Bounded

set_option autoImplicit false

/-!
# A Grothendieck topology on full patches of views

A sieve covers a patch exactly when it contains the support of every
composable pair of arrows in that patch. All three topology axioms are
proved. This is a specified topology, not a universal view doctrine.
-/
universe u v z t
namespace KomorebiSpace
open CategoryTheory
namespace CompositionSite
variable {V : Type u} [Category.{v} V]

/-- A composable pair, with its three endpoint views. -/
structure Triangle (V : Type u) [Category.{v} V] where
  a : V
  b : V
  c : V
  first : a ⟶ b
  second : b ⟶ c

namespace Triangle
variable (q : Triangle V)

def support : Set V := {x | x = q.a ∨ x = q.b ∨ x = q.c}

@[simp] theorem a_mem : q.a ∈ q.support := Or.inl rfl
@[simp] theorem b_mem : q.b ∈ q.support := Or.inr (Or.inl rfl)
@[simp] theorem c_mem : q.c ∈ q.support := Or.inr (Or.inr rfl)

theorem support_le_iff (W : Set V) :
    q.support ⊆ W ↔ q.a ∈ W ∧ q.b ∈ W ∧ q.c ∈ W := by
  constructor
  · intro h
    exact ⟨h q.a_mem, h q.b_mem, h q.c_mem⟩
  · rintro ⟨ha, hb, hc⟩ x (rfl | rfl | rfl)
    · exact ha
    · exact hb
    · exact hc

/-- A degenerate triangle detects a single view. -/
def point (a : V) : Triangle V := ⟨a, a, a, 𝟙 a, 𝟙 a⟩

end Triangle

/-- Covering means that every composition support is a member of the sieve. -/
def Covers (W : Set V) (s : Sieve W) : Prop :=
  ∀ (q : Triangle V) (h : q.support ⊆ W), s (homOfLE h)

/-- The composition topology, constructed using mathlib's actual sieve API. -/
def topology (V : Type u) [Category.{v} V] : GrothendieckTopology (Set V) where
  sieves W := {s | Covers W s}
  top_mem' := by intro W q h; trivial
  pullback_stable' := by
    intro W Z s f hs q hq
    exact hs q (hq.trans (leOfHom f))
  transitive' := by
    intro W s hs r hr q hq
    have ht := hr (hs q hq)
    exact ht q (Set.Subset.refl q.support)

@[simp] theorem covering_iff (W : Set V) (s : Sieve W) :
    s ∈ topology V W ↔ Covers W s := Iff.rfl

/-- The downward closure of a family of subpatches. -/
def familySieve {I : Type z} (W : Set V) (U : I → Set V)
    (_hU : ∀ i, U i ⊆ W) : Sieve W where
  arrows := fun {Z} _ => ∃ i, Z ⊆ U i
  downward_closed := by
    intro Z Z' f hf g
    obtain ⟨i, hi⟩ := hf
    exact ⟨i, (leOfHom g).trans hi⟩

/-- The relative composition-cover predicate, with containment separated. -/
def FamilyCovers {I : Type z} (W : Set V) (U : I → Set V) : Prop :=
  ∀ (q : Triangle V), q.support ⊆ W → ∃ i, q.support ⊆ U i

theorem familySieve_covering_iff {I : Type z} (W : Set V) (U : I → Set V)
    (hU : ∀ i, U i ⊆ W) :
    familySieve W U hU ∈ topology V W ↔ FamilyCovers W U := Iff.rfl

/-- Identity covers. -/
theorem identity_cover (W : Set V) : FamilyCovers W (fun _ : Unit => W) := by
  intro q hq
  exact ⟨(), hq⟩

/-- Pullback of a family is intersection with the smaller full patch. -/
theorem intersection_cover {I : Type z} {W Z : Set V} {U : I → Set V}
    (hZW : Z ⊆ W) (h : FamilyCovers W U) :
    FamilyCovers Z (fun i => U i ∩ Z) := by
  intro q hq
  obtain ⟨i, hi⟩ := h q (hq.trans hZW)
  exact ⟨i, fun x hx => ⟨hi hx, hq hx⟩⟩

/-- Composite covering families still see every composition relation. -/
theorem composite_cover {I : Type z} {J : I → Type t} {W : Set V}
    {U : I → Set V} {T : ∀ i, J i → Set V}
    (h : FamilyCovers W U) (k : ∀ i, FamilyCovers (U i) (T i)) :
    FamilyCovers W (fun ij : Sigma J => T ij.1 ij.2) := by
  intro q hq
  obtain ⟨i, hi⟩ := h q hq
  obtain ⟨j, hj⟩ := k i q hi
  exact ⟨⟨i, j⟩, hj⟩

/-- A composition cover is necessarily an object cover. -/
theorem covers_objects {I : Type z} {W : Set V} {U : I → Set V}
    (h : FamilyCovers W U) {a : V} (ha : a ∈ W) : ∃ i, a ∈ U i := by
  have hq : (Triangle.point a).support ⊆ W :=
    ((Triangle.point a).support_le_iff W).mpr ⟨ha, ha, ha⟩
  obtain ⟨i, hi⟩ := h (Triangle.point a) hq
  exact ⟨i, hi (Triangle.a_mem _)⟩

/-- Every covering sieve supplies its own covering family, not only chosen generators. -/
def sievePatches {W : Set V} (s : Sieve W) :=
  {Z : Set V // ∃ h : Z ⊆ W, s (homOfLE h)}

theorem sieve_family_covers {W : Set V} {s : Sieve W}
    (hs : s ∈ topology V W) :
    FamilyCovers W (fun Z : sievePatches s => Z.val) := by
  intro q hq
  exact ⟨⟨q.support, hq, hs q hq⟩, Set.Subset.refl _⟩

omit [Category.{v} V] in
/-- The explicit downward closure is the standard sieve generated by the family. -/
theorem familySieve_eq_ofArrows {I : Type z} (W : Set V) (U : I → Set V)
    (hU : ∀ i, U i ⊆ W) :
    familySieve W U hU = Sieve.ofArrows U (fun i => homOfLE (hU i)) := by
  apply Sieve.ext
  intro Z f
  rw [Sieve.mem_ofArrows_iff]
  constructor
  · rintro ⟨i, hi⟩
    exact ⟨i, homOfLE hi, Subsingleton.elim _ _⟩
  · rintro ⟨i, a, _⟩
    exact ⟨i, leOfHom a⟩

theorem ofArrows_covering_iff {I : Type z} (W : Set V) (U : I → Set V)
    (hU : ∀ i, U i ⊆ W) :
    Sieve.ofArrows U (fun i => homOfLE (hU i)) ∈ topology V W ↔ FamilyCovers W U := by
  rw [← familySieve_eq_ofArrows]
  exact Iff.rfl

/-- Covering sieve membership is local at the composable-pair supports. -/
theorem support_covering_iff_top (q : Triangle V) (s : Sieve q.support) :
    s ∈ topology V q.support ↔ s = ⊤ := by
  constructor
  · intro hs
    have hi : s (𝟙 q.support) := hs q (Set.Subset.refl _)
    apply Sieve.ext
    intro Z f
    constructor
    · intro _; trivial
    · intro _
      simpa only [Category.comp_id] using s.downward_closed hi f
  · intro hs
    rw [hs]
    exact (topology V).top_mem _

/-- The empty patch has its required empty cover. -/
theorem empty_cover : FamilyCovers (∅ : Set V) (fun i : Empty => nomatch i) := by
  intro q hq
  exact False.elim (hq q.a_mem)

end CompositionSite
end KomorebiSpace
