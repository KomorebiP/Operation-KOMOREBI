KomorebiSpace.CorrectionProblem.obstruction_zero_iff.{u, v, w} {E : Type u} {R : Type v} {S : Type w} [AddCommGroup E]
  [AddCommGroup R] [AddCommGroup S] (P : KomorebiSpace.CorrectionProblem E R S) (x : E) :
  P.obstruction x = 0 ↔ ∃ a, P.semantics a = 0 ∧ P.residual a = P.residual x
KomorebiSpace.CorrectionProblem.flatten_iff.{u, v, w} {E : Type u} {R : Type v} {S : Type w} [AddCommGroup E]
  [AddCommGroup R] [AddCommGroup S] (P : KomorebiSpace.CorrectionProblem E R S) (x : E) :
  P.obstruction x = 0 ↔ ∃ y, P.residual y = 0 ∧ P.semantics y = P.semantics x
KomorebiSpace.CorrectionProblem.obstruction_invariant.{u, v, w} {E : Type u} {R : Type v} {S : Type w} [AddCommGroup E]
  [AddCommGroup R] [AddCommGroup S] (P : KomorebiSpace.CorrectionProblem E R S) (x a : E) (ha : P.semantics a = 0) :
  P.obstruction (x - a) = P.obstruction x
KomorebiSpace.CorrectionProblem.nonzero_certificate.{u, v, w, z} {E : Type u} {R : Type v} {S : Type w} [AddCommGroup E]
  [AddCommGroup R] [AddCommGroup S] (P : KomorebiSpace.CorrectionProblem E R S) {D : Type z} [AddCommGroup D]
  (L : R →+ D) (x : E) (annihilate : ∀ (a : E), P.semantics a = 0 → L (P.residual a) = 0)
  (witness : L (P.residual x) ≠ 0) : P.obstruction x ≠ 0
