KomorebiSpace.CorrectionProblem.fiberParameters.{u, v, w} {E : Type u} {R : Type v} {S : Type w} [AddCommGroup E]
  [AddCommGroup R] [AddCommGroup S] (P : KomorebiSpace.CorrectionProblem E R S) {s : S} (base : P.ExactFiber s) :
  ↥P.homogeneous ≃ P.ExactFiber s
