KomorebiSpace.Resolution.Map.onLimit_unique.{u, v} {X : KomorebiSpace.Resolution} {Y : KomorebiSpace.Resolution}
  (f : X.Map Y) (g : X.Point → Y.Point) (hg : ∀ (x : X.Point) (n : ℕ), ↑(g x) n = f.app n (↑x n)) : g = f.onLimit
