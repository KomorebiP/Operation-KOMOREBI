  (F : KomorebiSpace.ViewSystem V) {x y : F.Ambient} (h : ∀ (a : V), F.evaluate a x = F.evaluate a y) : x = y
KomorebiSpace.ViewSystem.Cone.exists_unique_lift.{u, v, w, z} {V : Type u} [CategoryTheory.Category.{v, u} V]
  {F : KomorebiSpace.ViewSystem V} {T : Type z} (c : F.Cone T) : ∃! g, ∀ (x : T) (a : V), F.evaluate a (g x) = c.leg a x
KomorebiSpace.GroupViewSystem.CocycleMatching.descentEquiv.{u, v, w, z} {V : Type u} [CategoryTheory.Category.{v, u} V]
  {G : V → Type w} [(a : V) → Group (G a)] {I : Type z} {F : KomorebiSpace.GroupViewSystem V G} {U : I → Set V}
  (h : KomorebiSpace.GroupViewSystem.CompositionCover U) : F.Cocycle ≃ F.CocycleMatching U
KomorebiSpace.GroupViewSystem.CocycleDescentData.effective.{u, v, w, z} {V : Type u} [CategoryTheory.Category.{v, u} V]
  {G : V → Type w} [(a : V) → Group (G a)] {I : Type z} {F : KomorebiSpace.GroupViewSystem V G} {U : I → Set V}
