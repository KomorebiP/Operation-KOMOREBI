KomorebiSpace.DiagonalRegularization.sharp_diagonal_budget_asymptotic :
  Filter.Tendsto (fun m => KomorebiSpace.DiagonalRegularization.A m / ↑m) Filter.atTop (nhds (Real.pi / 4)) ∧
    Filter.Tendsto (fun m => ↑m * KomorebiSpace.DiagonalRegularization.B m) Filter.atTop (nhds (Real.pi / 4)) ∧
      Filter.Tendsto
          (fun M =>
            M *
              KomorebiSpace.BudgetProfile.beta KomorebiSpace.DiagonalRegularization.T
                KomorebiSpace.DiagonalRegularization.w M)
          Filter.atTop (nhds (Real.pi / 4)) ∧
        Filter.Tendsto
          (fun N =>
            √↑N *
              ‖KomorebiSpace.DiagonalRegularization.w -
                  KomorebiSpace.DiagonalRegularization.T (KomorebiSpace.DiagonalRegularization.hardPrefix N)‖)
          Filter.atTop (nhds 1)
