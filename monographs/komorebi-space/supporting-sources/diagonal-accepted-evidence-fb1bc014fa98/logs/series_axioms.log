'KomorebiSpace.DiagonalRegularization.proposition_30_1_series' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
KomorebiSpace.DiagonalRegularization.proposition_30_1_series (m K : ℕ) (hm : 1 ≤ m) (hmK : m ≤ K) :
  ↑m / 4 ≤ KomorebiSpace.DiagonalRegularization.A m ∧
    KomorebiSpace.DiagonalRegularization.A m ≤ 4 * ↑m / 3 ∧
      1 / (4 * (↑m + 1)) ≤ KomorebiSpace.DiagonalRegularization.B m ∧
        KomorebiSpace.DiagonalRegularization.B m ≤ 2 / ↑m ∧
          0 ≤ KomorebiSpace.DiagonalRegularization.A m - KomorebiSpace.DiagonalRegularization.partialA m K ∧
            KomorebiSpace.DiagonalRegularization.A m - KomorebiSpace.DiagonalRegularization.partialA m K ≤
                ↑m ^ 4 / (3 * ↑K ^ 3) ∧
              0 ≤ KomorebiSpace.DiagonalRegularization.B m - KomorebiSpace.DiagonalRegularization.partialB m K ∧
                KomorebiSpace.DiagonalRegularization.B m - KomorebiSpace.DiagonalRegularization.partialB m K ≤ 1 / ↑K
