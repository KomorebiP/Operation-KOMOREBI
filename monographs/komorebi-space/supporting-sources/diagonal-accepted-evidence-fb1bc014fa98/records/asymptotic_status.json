      "scope": "Actual lp/Hilbert T,w and existing BudgetProfile.beta; mesh is an internal proof device."
    },
    {
      "claim": "sqrt(N) times actual hard-prefix residual norm tends to one",
      "declaration": "tendsto_sqrt_mul_hardPrefix_residual",
      "scope": "Actual Hilbert hardPrefix N. norm_hardPrefix identifies sqrt(N) as its actual correction norm."
    }
