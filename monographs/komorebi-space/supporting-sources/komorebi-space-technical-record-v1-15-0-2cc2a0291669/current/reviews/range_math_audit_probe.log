def KomorebiSpace.DiagonalRegularization.unitCoordinate : ℕ → KomorebiSpace.DiagonalRegularization.H :=
fun j => lp.single 2 j 1
KomorebiSpace.DiagonalRegularization.norm_unitCoordinate (j : ℕ) :
  ‖KomorebiSpace.DiagonalRegularization.unitCoordinate j‖ = 1
KomorebiSpace.DiagonalRegularization.T_unitCoordinate (j : ℕ) :
  KomorebiSpace.DiagonalRegularization.T (KomorebiSpace.DiagonalRegularization.unitCoordinate j) =
    KomorebiSpace.DiagonalRegularization.wCoord j • KomorebiSpace.DiagonalRegularization.unitCoordinate j
KomorebiSpace.DiagonalRegularization.norm_T_unitCoordinate (j : ℕ) :
  ‖KomorebiSpace.DiagonalRegularization.T (KomorebiSpace.DiagonalRegularization.unitCoordinate j)‖ = 1 / (↑j + 1)
KomorebiSpace.DiagonalRegularization.tendsto_norm_T_unitCoordinate :
  Filter.Tendsto
    (fun j => ‖KomorebiSpace.DiagonalRegularization.T (KomorebiSpace.DiagonalRegularization.unitCoordinate j)‖)
    Filter.atTop (nhds 0)
KomorebiSpace.DiagonalRegularization.T_ker_eq_bot : (↑KomorebiSpace.DiagonalRegularization.T).ker = ⊥
KomorebiSpace.DiagonalRegularization.unitCoordinate_mem_ker_orthogonal (j : ℕ) :
  KomorebiSpace.DiagonalRegularization.unitCoordinate j ∈ (↑KomorebiSpace.DiagonalRegularization.T).kerᗮ
KomorebiSpace.DiagonalRegularization.unitCoordinate_witness (C : ℝ) (_hC : 0 ≤ C) :
  ∃ j, C * ‖KomorebiSpace.DiagonalRegularization.T (KomorebiSpace.DiagonalRegularization.unitCoordinate j)‖ < 1
KomorebiSpace.DiagonalRegularization.T_not_closed_range : ¬IsClosed (Set.range ⇑KomorebiSpace.DiagonalRegularization.T)
KomorebiSpace.DiagonalRegularization.tendsto_T_hardPrefix :
  Filter.Tendsto (fun N => KomorebiSpace.DiagonalRegularization.T (KomorebiSpace.DiagonalRegularization.hardPrefix N))
    Filter.atTop (nhds KomorebiSpace.DiagonalRegularization.w)
KomorebiSpace.DiagonalRegularization.w_mem_closure_range :
  KomorebiSpace.DiagonalRegularization.w ∈ closure (Set.range ⇑KomorebiSpace.DiagonalRegularization.T)
KomorebiSpace.DiagonalRegularization.w_not_mem_range :
  KomorebiSpace.DiagonalRegularization.w ∉ Set.range ⇑KomorebiSpace.DiagonalRegularization.T
KomorebiSpace.DiagonalRegularization.w_mem_closure_not_range :
  KomorebiSpace.DiagonalRegularization.w ∈ closure (Set.range ⇑KomorebiSpace.DiagonalRegularization.T) ∧
    KomorebiSpace.DiagonalRegularization.w ∉ Set.range ⇑KomorebiSpace.DiagonalRegularization.T
KomorebiSpace.HilbertKernelProjection.not_closed_range_of_unit_witnesses.{u, v} {E : Type u} {R : Type v}
  [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] [NormedAddCommGroup R] [NormedSpace ℝ R]
  (d : E →L[ℝ] R) [CompleteSpace R] (hw : ∀ (C : ℝ), 0 ≤ C → ∃ u ∈ (↑d).kerᗮ, ‖u‖ = 1 ∧ C * ‖d u‖ < 1) :
  ¬IsClosed (Set.range ⇑d)
