{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"RealizationBoundaries.ObservationSystems","name":"RealizationBoundaries.coordinateObservationIso._proof_4","record":"declaration","type":"∀ (W : Submodule ℚ RealizationBoundaries.TailSpace) (s : RealizationBoundaries.CoordinateIndex),\n  CategoryTheory.CategoryStruct.comp\n      (FiniteAddGrp.ofHom (RealizationBoundaries.finiteCoordinateQuotientEquiv W s).toAddMonoidHom)\n      (FiniteAddGrp.ofHom (RealizationBoundaries.finiteCoordinateQuotientEquiv W s).symm.toAddMonoidHom) =\n    CategoryTheory.CategoryStruct.id\n      (((RealizationBoundaries.coordinateIndexFunctor W).comp\n            (ProfiniteAddGrp.ProfiniteCompletion.finiteAddGrpDiagram\n              (AddGrpCat.of ↥(RealizationBoundaries.preimage W)))).obj\n        s)","unsafe":false}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"RealizationBoundaries.ObservationSystems","name":"RealizationBoundaries.ObservationDecoder.mk.sizeOf_spec","record":"declaration","type":"∀ (decode : RealizationBoundaries.FiniteObservation → AddGrpCat)\n  (invariant :\n    ∀ (A B : RealizationBoundaries.FiniteObservation),\n      RealizationBoundaries.CommonCofinalObservation A B → Nonempty (decode A ≅ decode B)),\n  sizeOf { decode := decode, invariant := invariant } = 1","unsafe":false}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"RealizationBoundaries.CompletionConsequences","name":"RealizationBoundaries.bottomFiniteSupportEquiv._proof_2","record":"declaration","type":"∀ (d : ↥RealizationBoundaries.finiteSupport), ↑d ∈ RealizationBoundaries.preimage ⊥","unsafe":false}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"RealizationBoundaries.RadicalCounts","name":"RealizationBoundaries.integerQuotient_card","record":"declaration","type":"∀ (W : Submodule ℚ RealizationBoundaries.TailSpace) {m : ℕ},\n  0 < m →\n    Nat.card (↥(RealizationBoundaries.preimage W) ⧸ RealizationBoundaries.multiples W m) =\n      RealizationBoundaries.primeRadical m","unsafe":false}
{"axioms":["propext","Quot.sound"],"kind":"theorem","module":"RealizationBoundaries.RootAlgorithm","name":"RealizationBoundaries.finiteRootTest_exact._simp_1_3","record":"declaration","type":"∀ {m n : ℕ}, (m ∈ List.range n) = (m < n)","unsafe":false}
