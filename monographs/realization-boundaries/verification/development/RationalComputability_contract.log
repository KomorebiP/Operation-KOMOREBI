RealizationBoundaries.RationalCode.value_surjective : Function.Surjective RationalCode.value
RealizationBoundaries.RationalCode.value_add (c e : RationalCode) : (c.add e).value = c.value + e.value
RealizationBoundaries.RationalCode.value_neg (c : RationalCode) : c.neg.value = -c.value
RealizationBoundaries.RationalCode.equal_iff (c e : RationalCode) : c.equal e = true ↔ c.value = e.value
RealizationBoundaries.RationalCode.primrec_add : Primrec₂ RationalCode.add
RealizationBoundaries.RationalCode.primrec_equal : Primrec₂ RationalCode.equal
RealizationBoundaries.RationalCode.normal_fields (c : RationalCode) :
  c.value.num = ↑c.normalPositive - ↑c.normalNegative ∧ c.value.den = c.normalDenominator
RealizationBoundaries.RationalCode.primrec_primeResidue : Primrec₂ RationalCode.primeResidue
RealizationBoundaries.RationalCode.primeResidue_cast (c : RationalCode) {p : ℕ} [Fact (Nat.Prime p)] :
  ↑(c.primeResidue p) = ↑c.value
RealizationBoundaries.RationalCode.primeResidue_eq_val (c : RationalCode) {p : ℕ} [Fact (Nat.Prime p)] :
  c.primeResidue p = (↑c.value).val
