RealizationBoundaries.finite_rationals_common_cyclic_lattice (s : Finset ℚ) :
  ∃ d, 0 < d ∧ ↑s ⊆ ↑(AddSubgroup.zmultiples (1 / ↑d))
RealizationBoundaries.rational_subgroup_fg_isAddCyclic (H : AddSubgroup ℚ) (hH : H.FG) : IsAddCyclic ↥H
RealizationBoundaries.rational_fg_isAddCyclic (H : AddSubgroup ℚ) [AddGroup.FG ↥H] : IsAddCyclic ↥H
RealizationBoundaries.rational_fg_equiv_int (H : AddSubgroup ℚ) [AddGroup.FG ↥H] (hH : H ≠ ⊥) : Nonempty (↥H ≃+ ℤ)
RealizationBoundaries.rational_fg_generator (H : AddSubgroup ℚ) [AddGroup.FG ↥H] :
  ∃ q, Function.Surjective fun n => n • q
'RealizationBoundaries.rational_fg_equiv_int' depends on axioms: [propext, Classical.choice, Quot.sound]
