RealizationBoundaries.primrec_nat_dvd : PrimrecRel fun x1 x2 => x1 ∣ x2
RealizationBoundaries.primrec_prime_predicate : PrimrecPred Nat.Prime
RealizationBoundaries.primrec_prime_decide : Primrec fun n => decide (Nat.Prime n)
RealizationBoundaries.primrec_prime_count : Primrec (Nat.count Nat.Prime)
RealizationBoundaries.computable_nth_prime : Computable (Nat.nth Nat.Prime)
RealizationBoundaries.computable_primeAt_value : Computable fun n => ↑(primeAt n)
'RealizationBoundaries.computable_primeAt_value' depends on axioms: [propext, Classical.choice, Quot.sound]
