RealizationBoundaries.observationPrimeProgram_eq (n : ℕ) : observationPrimeProgram n = ↑(primeAt n)
RealizationBoundaries.observationModulusProgram_eq (n : ℕ) : observationModulusProgram n = observationModulus n
RealizationBoundaries.observationValidProgram_eq (n x : ℕ) : observationValidProgram n x = decide (observationValid n x)
RealizationBoundaries.observationAddProgram_eq (n x y : ℕ) : observationAddProgram n x y = observationAddCode n x y
RealizationBoundaries.observationNegProgram_eq (n x : ℕ) : observationNegProgram n x = observationNegCode n x
RealizationBoundaries.observationRestrictionProgram_eq (m x : ℕ) :
  observationRestrictionProgram m x = observationRestrictionCode m x
RealizationBoundaries.computable_observationIndexRelation :
  Computable fun k => decide ((Nat.unpair k).2 ≤ (Nat.unpair k).1)
RealizationBoundaries.computable_observationEquality : Computable fun k => decide ((Nat.unpair k).1 = (Nat.unpair k).2)
