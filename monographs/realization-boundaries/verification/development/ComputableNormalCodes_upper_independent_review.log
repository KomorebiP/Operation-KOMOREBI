RealizationBoundaries.normalAddCell_oracleComputable (a X : ℕ → Bool) (ha : SelectorReducible a X) :
  OracleComputable X (normalAddCell a)
RealizationBoundaries.rawNormalAdd_oracleComputable (a X : ℕ → Bool) (ha : SelectorReducible a X) :
  OracleComputable X fun k => rawNormalAdd a (Nat.unpair k).1 (Nat.unpair k).2
RealizationBoundaries.rawNormalEqual_computable : Computable fun k => rawNormalEqual (Nat.unpair k).1 (Nat.unpair k).2
RealizationBoundaries.pairedRawCodes (a X : ℕ → Bool) (ha : SelectorReducible a X) :
  OracleRawGroupCodes X ↥(pairedGroup a)
RealizationBoundaries.pairedOracleCopy (a X : ℕ → Bool) (ha : SelectorReducible a X) :
  OracleGroupCopy X ↥(pairedGroup a)
RealizationBoundaries.paired_oracle_copy_iff (a X : ℕ → Bool) :
  Nonempty (OracleGroupCopy X ↥(pairedGroup a)) ↔ SelectorReducible a X
'RealizationBoundaries.rawNormalAdd_oracleComputable' depends on axioms: [propext, Classical.choice, Quot.sound]
'RealizationBoundaries.pairedOracleCopy' depends on axioms: [propext, Classical.choice, Quot.sound]
'RealizationBoundaries.paired_oracle_copy_iff' depends on axioms: [propext, Classical.choice, Quot.sound]
