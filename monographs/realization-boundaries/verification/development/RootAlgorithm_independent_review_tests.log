RealizationBoundaries.finiteRootSolver_sound (a : RealizationBoundaries.Prime → Bool) (r : ℚ) (d : List ℕ) (m : ℕ)
  (t : ℚ) (e : List ℕ) (h : finiteRootSolver a r d m = some (t, e)) :
  m • codedNormalValue a t e = codedNormalValue a r d
RealizationBoundaries.finiteRootSolver_complete (a : RealizationBoundaries.Prime → Bool) (r : ℚ) (d : List ℕ) {m : ℕ}
  (hm : 0 < m) : (∃ t e, finiteRootSolver a r d m = some (t, e)) ↔ ∃ y, m • y = ⟨codedNormalValue a r d, ⋯⟩
