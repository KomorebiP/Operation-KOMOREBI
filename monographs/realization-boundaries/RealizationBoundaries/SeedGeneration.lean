import RealizationBoundaries.DirectSumEndomorphisms

/-!
# Endomorphism hulls and closed coordinate obstructions

The hull is generated by the images of the actual seeds under all actual additive
endomorphisms. Finite compositions require no extra rule because endomorphisms
already contain the identity and are closed under composition. The closure below
is taken in the supplied topology, not in the completion of the group.
-/
set_option autoImplicit false
noncomputable section
namespace RealizationBoundaries

universe u
variable {G : Type u} [AddGroup G]

/-- All endomorphism images of the given seeds. -/
def endomorphismOrbit (S : Set G) : Set G :=
  {x | ∃ f : AddMonoid.End G, ∃ s ∈ S, f s = x}

/-- Algebraic generation with the entire endomorphism ring admitted. -/
def endomorphismHull (S : Set G) : AddSubgroup G :=
  AddSubgroup.closure (endomorphismOrbit S)

theorem seed_mem_endomorphismHull {S : Set G} {s : G} (hs : s ∈ S) :
    s ∈ endomorphismHull S :=
  AddSubgroup.subset_closure ⟨AddMonoidHom.id G, s, hs, rfl⟩

theorem orbit_mem_endomorphismHull (S : Set G) (f : AddMonoid.End G)
    {s : G} (hs : s ∈ S) : f s ∈ endomorphismHull S :=
  AddSubgroup.subset_closure ⟨f, s, hs, rfl⟩

/-- Universal property: an invariant subgroup containing the seeds contains their hull. -/
theorem endomorphismHull_le {S : Set G} {H : AddSubgroup G}
    (hS : S ⊆ H) (hH : ∀ f : AddMonoid.End G, ∀ x ∈ H, f x ∈ H) :
    endomorphismHull S ≤ H := by
  apply (AddSubgroup.closure_le _).mpr
  rintro x ⟨f, s, hs, rfl⟩
  exact hH f s (hS hs)

/-- The defined hull is itself invariant under every endomorphism. -/
theorem endomorphismHull_invariant (S : Set G) (f : AddMonoid.End G)
    {x : G} (hx : x ∈ endomorphismHull S) : f x ∈ endomorphismHull S := by
  have h : endomorphismHull S ≤ (endomorphismHull S).comap f := by
    apply (AddSubgroup.closure_le _).mpr
    rintro z ⟨g, s, hs, rfl⟩
    exact orbit_mem_endomorphismHull S (f.comp g) hs
  exact h hx

@[simp] theorem endomorphismHull_univ : endomorphismHull (Set.univ : Set G) = ⊤ := by
  apply top_unique
  intro x _
  exact seed_mem_endomorphismHull (Set.mem_univ x)

@[simp] theorem endomorphismHull_empty : endomorphismHull (∅ : Set G) = ⊥ := by
  apply le_antisymm _ bot_le
  apply (AddSubgroup.closure_le _).mpr
  rintro x ⟨f, s, hs, _⟩
  exact False.elim hs

/-- Topological operator generation inside the original group. -/
def topologicalEndomorphismHull [TopologicalSpace G] [IsTopologicalAddGroup G]
    (S : Set G) : AddSubgroup G := (endomorphismHull S).topologicalClosure

/-- A closed invariant subgroup remains an obstruction after topological closure. -/
theorem topologicalEndomorphismHull_le [TopologicalSpace G] [IsTopologicalAddGroup G]
    {S : Set G} {H : AddSubgroup G} (hH : IsClosed (H : Set G))
    (h : endomorphismHull S ≤ H) : topologicalEndomorphismHull S ≤ H := by
  exact closure_minimal h hH

/-- The exact coordinate-zero subgroup inside a given ambient subgroup. -/
def coordinateKernel (H : AddSubgroup Ambient) (p : Prime) : AddSubgroup H where
  carrier := {x | x.val p = 0}
  zero_mem' := rfl
  add_mem' := by intro x y hx hy; change x.val p + y.val p = 0; rw [hx, hy, add_zero]
  neg_mem' := by intro x hx; change -x.val p = 0; rw [hx, neg_zero]

@[simp] theorem mem_coordinateKernel (H : AddSubgroup Ambient) (p : Prime) (x : H) :
    x ∈ coordinateKernel H p ↔ x.val p = 0 := Iff.rfl

theorem coordinateKernel_closed (H : AddSubgroup Ambient) (p : Prime) :
    IsClosed (coordinateKernel H p : Set H) :=
  isClosed_eq ((continuous_apply p).comp continuous_subtype_val) continuous_const

/-- One omitted coordinate obstructs both algebraic and topological generation. -/
theorem coordinate_obstruction (H : AddSubgroup Ambient) (p : Prime) (S : Set H)
    (hS : ∀ s ∈ S, s.val p = 0)
    (hpres : ∀ f : AddMonoid.End H, ∀ x : H, x.val p = 0 → (f x).val p = 0) :
    endomorphismHull S ≤ coordinateKernel H p ∧
      topologicalEndomorphismHull S ≤ coordinateKernel H p := by
  have h : endomorphismHull S ≤ coordinateKernel H p :=
    endomorphismHull_le hS hpres
  exact ⟨h, topologicalEndomorphismHull_le (coordinateKernel_closed H p) h⟩

/-- The nonzero prime seed witnesses that this is a proper closed kernel. -/
theorem coordinateKernel_ne_top (H : AddSubgroup Ambient) (hD : finiteSupport ≤ H)
    (p : Prime) : coordinateKernel H p ≠ ⊤ := by
  classical
  intro h
  let e : H := ⟨(primeSeed p).val, hD (primeSeed p).property⟩
  have he : e ∈ coordinateKernel H p := h.symm ▸ AddSubgroup.mem_top e
  have h0 : (primeSeed p).val p = 0 := he
  simp [primeSeed, cut] at h0

end RealizationBoundaries
