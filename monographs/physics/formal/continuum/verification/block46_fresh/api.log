KomorebiPhysics.Relativistic3DFullFourierEvolution.exists_coeffTruncation_approx
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2) {ε : ℝ} (hε : 0 < ε) :
  ∃ S, ‖f - KomorebiPhysics.Relativistic3DFullFourierEvolution.coeffTruncation S f‖ < ε
KomorebiPhysics.Relativistic3DFullFourierEvolution.coeffPacketResidual (m h t : ℝ)
  (S : Finset KomorebiPhysics.Relativistic3DFullFourierEvolution.Mode)
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2) :
  ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2
KomorebiPhysics.Relativistic3DFullFourierEvolution.coeffPacketResidual_apply (m h t : ℝ)
  (S : Finset KomorebiPhysics.Relativistic3DFullFourierEvolution.Mode)
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2)
  (n : KomorebiPhysics.Relativistic3DFullFourierEvolution.Mode) :
  ↑(KomorebiPhysics.Relativistic3DFullFourierEvolution.coeffPacketResidual m h t S f) n =
    if n ∈ S then
      (KomorebiPhysics.Relativistic3DFourierHilbertStability.centralHilbertModePropagator m h n t -
          KomorebiPhysics.Relativistic3DFourierHilbertStability.continuumHilbertModePropagator m n t)
        (↑f n)
    else 0
KomorebiPhysics.Relativistic3DFullFourierEvolution.coeffPacketResidual_norm_sq (m h t : ℝ)
  (S : Finset KomorebiPhysics.Relativistic3DFullFourierEvolution.Mode)
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2) :
  ‖KomorebiPhysics.Relativistic3DFullFourierEvolution.coeffPacketResidual m h t S f‖ ^ 2 =
    ∑ n ∈ S,
      ‖(KomorebiPhysics.Relativistic3DFourierHilbertStability.centralHilbertModePropagator m h n t -
              KomorebiPhysics.Relativistic3DFourierHilbertStability.continuumHilbertModePropagator m n t)
            (↑f n)‖ ^
        2
KomorebiPhysics.Relativistic3DFullFourierEvolution.compactTimePacketResidualL2_norm_sq (m h t : ℝ)
  (S : Finset KomorebiPhysics.Relativistic3DFullFourierEvolution.Mode)
  (a :
    KomorebiPhysics.Relativistic3DFullFourierEvolution.Mode →
      KomorebiPhysics.Relativistic3DFourierHilbertStability.HilbertSpinor) :
  ‖KomorebiPhysics.Relativistic3DFourierCompactTime.compactTimePacketResidualL2 m h t S a‖ ^ 2 =
    ∑ n ∈ S,
      ‖(KomorebiPhysics.Relativistic3DFourierHilbertStability.centralHilbertModePropagator m h n t -
              KomorebiPhysics.Relativistic3DFourierHilbertStability.continuumHilbertModePropagator m n t)
            (a n)‖ ^
        2
KomorebiPhysics.Relativistic3DFullFourierEvolution.norm_coeffPacketResidual_eq_torus (m h t : ℝ)
  (S : Finset KomorebiPhysics.Relativistic3DFullFourierEvolution.Mode)
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2) :
  ‖KomorebiPhysics.Relativistic3DFullFourierEvolution.coeffPacketResidual m h t S f‖ =
    ‖KomorebiPhysics.Relativistic3DFourierCompactTime.compactTimePacketResidualL2 m h t S fun n => ↑f n‖
KomorebiPhysics.Relativistic3DFullFourierEvolution.exists_compactTime_coeffTruncation_bound (m T : ℝ)
  (S : Finset KomorebiPhysics.Relativistic3DFullFourierEvolution.Mode)
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2) (hT : 0 ≤ T) :
  ∃ K,
    0 ≤ K ∧
      ∀ᶠ (h : ℝ) in nhdsWithin 0 (Set.Ioi 0),
        ∀ (t : ℝ),
          |t| ≤ T → ‖KomorebiPhysics.Relativistic3DFullFourierEvolution.coeffPacketResidual m h t S f‖ ≤ K * ‖h ^ 2‖
KomorebiPhysics.Relativistic3DFullFourierEvolution.fullCoeffResidual (m h t : ℝ)
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2) :
  ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2
KomorebiPhysics.Relativistic3DFullFourierEvolution.eventually_fullCoeffResidual_lt (m T : ℝ) (hT : 0 ≤ T)
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2) {ε : ℝ} (hε : 0 < ε) :
  ∀ᶠ (h : ℝ) in nhdsWithin 0 (Set.Ioi 0),
    ∀ (t : ℝ), |t| ≤ T → ‖KomorebiPhysics.Relativistic3DFullFourierEvolution.fullCoeffResidual m h t f‖ < ε
KomorebiPhysics.Relativistic3DFullFourierEvolution.fullCoeffPropagator_compactTime_converges (m T : ℝ) (hT : 0 ≤ T)
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2) (ε : ℝ) :
  ε > 0 →
    ∀ᶠ (h : ℝ) in nhdsWithin 0 (Set.Ioi 0),
      ∀ (t : ℝ),
        |t| ≤ T →
          ‖(KomorebiPhysics.Relativistic3DFullFourierEvolution.centralCoeffPropagator m h t) f -
                (KomorebiPhysics.Relativistic3DFullFourierEvolution.continuumCoeffPropagator m t) f‖ <
            ε
KomorebiPhysics.Relativistic3DFullFourierEvolution.tendsto_centralCoeffPropagator (m t : ℝ)
  (f : ↥KomorebiPhysics.Relativistic3DFullFourierEvolution.CoeffL2) :
  Filter.Tendsto (fun h => (KomorebiPhysics.Relativistic3DFullFourierEvolution.centralCoeffPropagator m h t) f)
    (nhdsWithin 0 (Set.Ioi 0))
    (nhds ((KomorebiPhysics.Relativistic3DFullFourierEvolution.continuumCoeffPropagator m t) f))
