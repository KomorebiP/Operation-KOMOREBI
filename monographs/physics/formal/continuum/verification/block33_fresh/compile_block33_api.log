        (affineHalfProductLinkYOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (affineHalfProductLinkZOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (affineCoarseLinkXOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
