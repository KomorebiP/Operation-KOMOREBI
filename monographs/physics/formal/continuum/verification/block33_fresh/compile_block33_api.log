KomorebiPhysics.Relativistic3DAffineConnection.uniformBzConnection (B : ℝ) : AffineConnection3
KomorebiPhysics.Relativistic3DAffineConnection.uniformBz_plaquetteXY (B h : ℝ) (p : Point3) :
  plaquetteXY (uniformBzConnection B) h p = Circle.exp (h ^ 2 * B)
KomorebiPhysics.Relativistic3DAffineConnection.uniformBz_pi_unit_plaquette_ne_one (p : Point3) :
  plaquetteXY (uniformBzConnection Real.pi) 1 p ≠ 1
KomorebiPhysics.Relativistic3DAffineConnection.tendsto_affineConnectionLimit.{u} {Y : Type u} [MetricSpace Y]
  [CompleteSpace Y] (f : ℕ → Y) (C : AffineConnection3) (a₀ : ℝ)
  (hstep : ∀ (n : ℕ), dist (f n) (f n.succ) ≤ affineDyadicBudget C a₀ n) :
  Filter.Tendsto f Filter.atTop
    (nhds (Relativistic3DCombinedDefect.twoBudgetSummableDefect f (fun x => 0) (affineDyadicBudget C a₀) ⋯ ⋯ ⋯).limit)
KomorebiPhysics.Relativistic3DAffineConnection.dist_affineConnectionLimit_le_tail.{u} {Y : Type u} [MetricSpace Y]
  [CompleteSpace Y] (f : ℕ → Y) (C : AffineConnection3) (a₀ : ℝ)
  (hstep : ∀ (n : ℕ), dist (f n) (f n.succ) ≤ affineDyadicBudget C a₀ n) (n : ℕ) :
  dist (f n)
      (Relativistic3DCombinedDefect.twoBudgetSummableDefect f (fun x => 0) (affineDyadicBudget C a₀) ⋯ ⋯ ⋯).limit ≤
    ∑' (m : ℕ), affineDyadicBudget C a₀ (n + m)
