KomorebiPhysics.Relativistic3DFourierGenerator.centralDiracSymbol_sub_continuum (m kx ky kz h : ℝ)
  (ψ : KomorebiPhysics.Relativistic3DFourierGenerator.Spinor) :
  KomorebiPhysics.Relativistic3DFourierGenerator.centralDiracSymbol m kx ky kz h ψ -
      KomorebiPhysics.Relativistic3DFourierGenerator.continuumDiracSymbol m kx ky kz ψ =
    ↑(KomorebiPhysics.Relativistic3DFourierGenerator.sinQuot kx h - kx) •
          KomorebiPhysics.Relativistic3DCliffordTransportU1.alphaX ψ +
        ↑(KomorebiPhysics.Relativistic3DFourierGenerator.sinQuot ky h - ky) •
          KomorebiPhysics.Relativistic3DCliffordTransportU1.alphaY ψ +
      ↑(KomorebiPhysics.Relativistic3DFourierGenerator.sinQuot kz h - kz) •
        KomorebiPhysics.Relativistic3DCliffordTransportU1.alphaZ ψ
