KomorebiPhysics.Relativistic3DCombinedDefect.fineEdgeDefectCLM.{u} {Site : Type u} [Fintype Site]
  (P : KomorebiPhysics.Relativistic3DEdgeCompatibility.FineEdgePair Site)
  (A : KomorebiPhysics.Relativistic3DCliffordTransportU1.CliffordInvolution) (τ : Site ≃ Site)
  (u : KomorebiPhysics.Relativistic3DCliffordTransportU1.Link) :
  KomorebiPhysics.Relativistic3DCliffordTransportU1.State →L[ℂ] KomorebiPhysics.Relativistic3DCliffordTransportU1.State
KomorebiPhysics.Relativistic3DCombinedDefect.fineEdgeDefectCLM_energy.{u} {Site : Type u} [Fintype Site]
  (P : KomorebiPhysics.Relativistic3DEdgeCompatibility.FineEdgePair Site)
  (H : KomorebiPhysics.Relativistic3DCliffordHilbertRefinement.HermitianClifford) (τ : Site ≃ Site)
  (u : KomorebiPhysics.Relativistic3DCliffordTransportU1.Link)
  (ψ : KomorebiPhysics.Relativistic3DCliffordTransportU1.State) :
  KomorebiPhysics.Relativistic3DGeometricEdgeRefinement.halfCellIP
      ((KomorebiPhysics.Relativistic3DCombinedDefect.fineEdgeDefectCLM P H.toClifford τ u) ψ)
      ((KomorebiPhysics.Relativistic3DCombinedDefect.fineEdgeDefectCLM P H.toClifford τ u) ψ) =
    ∑ x,
      (KomorebiPhysics.Relativistic3DEdgeCompatibility.phaseErrorWeight (P.productLink (τ.symm x)) (u (τ.symm x)) *
          KomorebiPhysics.Relativistic3DCliffordHilbertRefinement.ip (H.toClifford.plus (ψ (τ.symm x)))
            (H.toClifford.plus (ψ (τ.symm x))) +
        KomorebiPhysics.Relativistic3DEdgeCompatibility.phaseErrorWeight (P.productLink x)⁻¹ (u x)⁻¹ *
          KomorebiPhysics.Relativistic3DCliffordHilbertRefinement.ip (H.toClifford.minus (ψ (τ x)))
            (H.toClifford.minus (ψ (τ x))))
