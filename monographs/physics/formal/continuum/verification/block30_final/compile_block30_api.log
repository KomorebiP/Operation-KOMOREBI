KomorebiPhysics.Relativistic3DCombinedDefect.summable_combinedScaleBudget {edge curvature : ℕ → ℝ}
  (hedge : Summable edge) (hcurvature : Summable curvature) :
  Summable (KomorebiPhysics.Relativistic3DCombinedDefect.combinedScaleBudget edge curvature)
KomorebiPhysics.Relativistic3DCombinedDefect.tendsto_twoBudgetLimit.{v} {Y : Type v} [MetricSpace Y] [CompleteSpace Y]
  (f : ℕ → Y) (edge curvature : ℕ → ℝ) (hedge : Summable edge) (hcurvature : Summable curvature)
  (hstep :
    ∀ (n : ℕ),
      dist (f n) (f n.succ) ≤ KomorebiPhysics.Relativistic3DCombinedDefect.combinedScaleBudget edge curvature n) :
  Filter.Tendsto f Filter.atTop
    (nhds
      (KomorebiPhysics.Relativistic3DCombinedDefect.twoBudgetSummableDefect f edge curvature hedge hcurvature
          hstep).limit)
KomorebiPhysics.Relativistic3DCombinedDefect.dist_twoBudgetLimit_le_tail.{v} {Y : Type v} [MetricSpace Y]
  [CompleteSpace Y] (f : ℕ → Y) (edge curvature : ℕ → ℝ) (hedge : Summable edge) (hcurvature : Summable curvature)
  (hstep :
    ∀ (n : ℕ),
      dist (f n) (f n.succ) ≤ KomorebiPhysics.Relativistic3DCombinedDefect.combinedScaleBudget edge curvature n)
  (n : ℕ) :
  dist (f n)
      (KomorebiPhysics.Relativistic3DCombinedDefect.twoBudgetSummableDefect f edge curvature hedge hcurvature
          hstep).limit ≤
    ∑' (m : ℕ), KomorebiPhysics.Relativistic3DCombinedDefect.combinedScaleBudget edge curvature (n + m)
