KomorebiPhysics.Relativistic3DRegularConnection.norm_regularGeneratedCombinedHilbertDefect_le.{u} {Site : Type u}
  [Fintype Site] [Nonempty Site]
  (m₀ m₁ :
    Relativistic3DHilbertScalarDefect.HilbertState Site →L[ℂ] Relativistic3DHilbertScalarDefect.HilbertState Site)
  (τx τy τz : Site ≃ Site) (pos : Site → Relativistic3DAffineConnection.Point3) (C : RegularConnection3)
  (B : CrossDerivativeBounds C) (h : ℝ) (p : Relativistic3DAffineConnection.Point3) (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
  ‖Relativistic3DHilbertFullWalkDefect.combinedHilbertDefect m₀ m₁ τx τy τz (regularHalfProductLinkXOn C h pos)
        (regularHalfProductLinkYOn C h pos) (regularHalfProductLinkZOn C h pos) (regularCoarseLinkXOn C h pos)
        (regularCoarseLinkYOn C h pos) (regularCoarseLinkZOn C h pos) (regularCubeLinks C h p)‖ ≤
    h ^ 2 * regularDerivativeAmplitude C B
KomorebiPhysics.Relativistic3DRegularConnection.regularDyadicBudget_eq (C : RegularConnection3)
  (B : CrossDerivativeBounds C) (a₀ : ℝ) (n : ℕ) :
  regularDyadicBudget C B a₀ n = a₀ ^ 2 * regularDerivativeAmplitude C B * 4⁻¹ ^ n
KomorebiPhysics.Relativistic3DRegularConnection.summable_regularDyadicBudget (C : RegularConnection3)
  (B : CrossDerivativeBounds C) (a₀ : ℝ) : Summable (regularDyadicBudget C B a₀)
KomorebiPhysics.Relativistic3DRegularConnection.tendsto_regularDyadicBudget_zero (C : RegularConnection3)
  (B : CrossDerivativeBounds C) (a₀ : ℝ) : Filter.Tendsto (regularDyadicBudget C B a₀) Filter.atTop (nhds 0)
KomorebiPhysics.Relativistic3DRegularConnection.norm_regularGeneratedCombinedHilbertDefect_dyadic_le.{u} {Site : Type u}
  [Fintype Site] [Nonempty Site]
  (m₀ m₁ :
    Relativistic3DHilbertScalarDefect.HilbertState Site →L[ℂ] Relativistic3DHilbertScalarDefect.HilbertState Site)
  (τx τy τz : Site ≃ Site) (pos : Site → Relativistic3DAffineConnection.Point3) (C : RegularConnection3)
  (B : CrossDerivativeBounds C) (a₀ : ℝ) (p : Relativistic3DAffineConnection.Point3) (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1)
  (n : ℕ) :
  ‖Relativistic3DHilbertFullWalkDefect.combinedHilbertDefect m₀ m₁ τx τy τz
        (regularHalfProductLinkXOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (regularHalfProductLinkYOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (regularHalfProductLinkZOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (regularCoarseLinkXOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (regularCoarseLinkYOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (regularCoarseLinkZOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (regularCubeLinks C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) p)‖ ≤
    regularDyadicBudget C B a₀ n
KomorebiPhysics.Relativistic3DRegularConnection.summable_norm_regularGeneratedCombinedHilbertDefect_dyadic.{u}
  {Site : Type u} [Fintype Site] [Nonempty Site]
  (m₀ m₁ :
    Relativistic3DHilbertScalarDefect.HilbertState Site →L[ℂ] Relativistic3DHilbertScalarDefect.HilbertState Site)
  (τx τy τz : Site ≃ Site) (pos : Site → Relativistic3DAffineConnection.Point3) (C : RegularConnection3)
  (B : CrossDerivativeBounds C) (a₀ : ℝ) (p : Relativistic3DAffineConnection.Point3) (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
  Summable fun n =>
