        (regularCoarseLinkYOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (regularCoarseLinkZOn C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) pos)
        (regularCubeLinks C (Relativistic3DHilbertScalarDefect.dyadicMesh a₀ n) p)‖
KomorebiPhysics.Relativistic3DRegularConnection.tendsto_regularConnectionLimit.{u} {Y : Type u} [MetricSpace Y]
  [CompleteSpace Y] (f : ℕ → Y) (C : RegularConnection3) (B : CrossDerivativeBounds C) (a₀ : ℝ)
  (hstep : ∀ (n : ℕ), dist (f n) (f n.succ) ≤ regularDyadicBudget C B a₀ n) :
  Filter.Tendsto f Filter.atTop
    (nhds
      (Relativistic3DCombinedDefect.twoBudgetSummableDefect f (fun x => 0) (regularDyadicBudget C B a₀) ⋯ ⋯ ⋯).limit)
KomorebiPhysics.Relativistic3DRegularConnection.dist_regularConnectionLimit_le_tail.{u} {Y : Type u} [MetricSpace Y]
  [CompleteSpace Y] (f : ℕ → Y) (C : RegularConnection3) (B : CrossDerivativeBounds C) (a₀ : ℝ)
  (hstep : ∀ (n : ℕ), dist (f n) (f n.succ) ≤ regularDyadicBudget C B a₀ n) (n : ℕ) :
  dist (f n)
      (Relativistic3DCombinedDefect.twoBudgetSummableDefect f (fun x => 0) (regularDyadicBudget C B a₀) ⋯ ⋯ ⋯).limit ≤
    ∑' (m : ℕ), regularDyadicBudget C B a₀ (n + m)
KomorebiPhysics.Relativistic3DRegularConnection.sinusoidalYConnection : RegularConnection3
KomorebiPhysics.Relativistic3DRegularConnection.sinusoidalYBounds : CrossDerivativeBounds sinusoidalYConnection
KomorebiPhysics.Relativistic3DRegularConnection.sinusoidalY_curvatureXY (p : Relativistic3DAffineConnection.Point3) :
  curvatureXY sinusoidalYConnection p = Real.cos p.x
KomorebiPhysics.Relativistic3DRegularConnection.sinusoidalY_curvature_varies :
  curvatureXY sinusoidalYConnection { x := 0, y := 0, z := 0 } ≠
    curvatureXY sinusoidalYConnection { x := Real.pi / 2, y := 0, z := 0 }
KomorebiPhysics.Relativistic3DRegularConnection.sinusoidalY_regularDerivativeAmplitude :
  regularDerivativeAmplitude sinusoidalYConnection sinusoidalYBounds = 1
KomorebiPhysics.Relativistic3DRegularConnection.norm_sinusoidalYGeneratedCombinedHilbertDefect_le.{u} {Site : Type u}
  [Fintype Site] [Nonempty Site]
  (m₀ m₁ :
    Relativistic3DHilbertScalarDefect.HilbertState Site →L[ℂ] Relativistic3DHilbertScalarDefect.HilbertState Site)
  (τx τy τz : Site ≃ Site) (pos : Site → Relativistic3DAffineConnection.Point3) (h : ℝ)
  (p : Relativistic3DAffineConnection.Point3) (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
  ‖Relativistic3DHilbertFullWalkDefect.combinedHilbertDefect m₀ m₁ τx τy τz
        (regularHalfProductLinkXOn sinusoidalYConnection h pos) (regularHalfProductLinkYOn sinusoidalYConnection h pos)
        (regularHalfProductLinkZOn sinusoidalYConnection h pos) (regularCoarseLinkXOn sinusoidalYConnection h pos)
        (regularCoarseLinkYOn sinusoidalYConnection h pos) (regularCoarseLinkZOn sinusoidalYConnection h pos)
        (regularCubeLinks sinusoidalYConnection h p)‖ ≤
    h ^ 2
