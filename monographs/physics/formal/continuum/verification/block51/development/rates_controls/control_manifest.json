{
  "schema": "komorebi.physics.centered-controls.v1",
  "controls": [
    {
      "id": "rates_nonzero_field",
      "kind": "positive",
      "path": "positive_controls/block51/rates/FiniteField.lean"
    },
    {
      "id": "rates_zero_boundaries_modal",
      "kind": "positive",
      "path": "positive_controls/block51/rates/SignedAndModal.lean"
    },
    {
      "id": "rates_missing_moment",
      "kind": "elaboration_reject",
      "path": "negative_controls/block51/rates/MissingMoment.lean",
      "expected_regex": "(?s)error: Type mismatch.*HasThirdOrderMoment f \u2192.*but is expected to have type"
    },
    {
      "id": "rates_signed_time",
      "kind": "elaboration_reject",
      "path": "negative_controls/block51/rates/SignedTime.lean",
      "expected_regex": "(?s)error: Type mismatch.*has type.*\u2264 \\|t\\| \\* h.*but is expected to have type.*\u2264 t \\* h"
    },
    {
      "id": "rates_missing_spacing",
      "kind": "elaboration_reject",
      "path": "negative_controls/block51/rates/MissingSpacing.lean",
      "expected_regex": "(?s)error: Tactic `assumption` failed.*\u22a2 h \u2260 0"
    }
  ]
}
