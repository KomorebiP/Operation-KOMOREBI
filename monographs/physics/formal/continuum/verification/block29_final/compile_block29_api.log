KomorebiPhysics.Relativistic3DEdgeCompatibility.FineEdgePair.fineIntertwiningDefect_energy.{u} {Site : Type u}
  [Fintype Site] (P : FineEdgePair Site) (H : Relativistic3DCliffordHilbertRefinement.HermitianClifford)
  (τ : Site ≃ Site) (u : Relativistic3DCliffordTransportU1.Link) (ψ : Relativistic3DCliffordTransportU1.State) :
  Relativistic3DGeometricEdgeRefinement.halfCellIP (P.fineIntertwiningDefect H.toClifford τ u ψ)
      (P.fineIntertwiningDefect H.toClifford τ u ψ) =
    ∑ x,
      (phaseErrorWeight (P.productLink (τ.symm x)) (u (τ.symm x)) *
          Relativistic3DCliffordHilbertRefinement.ip (H.toClifford.plus (ψ (τ.symm x)))
            (H.toClifford.plus (ψ (τ.symm x))) +
        phaseErrorWeight (P.productLink x)⁻¹ (u x)⁻¹ *
          Relativistic3DCliffordHilbertRefinement.ip (H.toClifford.minus (ψ (τ x))) (H.toClifford.minus (ψ (τ x))))
