/-! ## Coordinate-regular abelian connections -/

/-- A spatially varying abelian connection with enough coordinate regularity
for exact line integration and quantitative rectangular estimates. The six
cross-coordinate derivative fields are explicit data, together with checked
one-dimensional derivative identities and continuity along their coordinate
lines. -/
structure RegularConnection3 where
  ax : Point3 → ℝ
  ay : Point3 → ℝ
  az : Point3 → ℝ
  dAyDx : Point3 → ℝ
  dAxDy : Point3 → ℝ
  dAzDx : Point3 → ℝ
  dAxDz : Point3 → ℝ
  dAzDy : Point3 → ℝ
  dAyDz : Point3 → ℝ
  axAlongX : ∀ p, Continuous (fun t : ℝ => ax (shiftX t p))
  ayAlongY : ∀ p, Continuous (fun t : ℝ => ay (shiftY t p))
  azAlongZ : ∀ p, Continuous (fun t : ℝ => az (shiftZ t p))
  hasDerivAyX : ∀ p t, HasDerivAt (fun s : ℝ => ay (shiftX s p)) (dAyDx (shiftX t p)) t
  hasDerivAxY : ∀ p t, HasDerivAt (fun s : ℝ => ax (shiftY s p)) (dAxDy (shiftY t p)) t
  hasDerivAzX : ∀ p t, HasDerivAt (fun s : ℝ => az (shiftX s p)) (dAzDx (shiftX t p)) t
  hasDerivAxZ : ∀ p t, HasDerivAt (fun s : ℝ => ax (shiftZ s p)) (dAxDz (shiftZ t p)) t
  hasDerivAzY : ∀ p t, HasDerivAt (fun s : ℝ => az (shiftY s p)) (dAzDy (shiftY t p)) t
  hasDerivAyZ : ∀ p t, HasDerivAt (fun s : ℝ => ay (shiftZ s p)) (dAyDz (shiftZ t p)) t
  dAyDxAlongX : ∀ p, Continuous (fun t : ℝ => dAyDx (shiftX t p))
  dAxDyAlongY : ∀ p, Continuous (fun t : ℝ => dAxDy (shiftY t p))
  dAzDxAlongX : ∀ p, Continuous (fun t : ℝ => dAzDx (shiftX t p))
  dAxDzAlongZ : ∀ p, Continuous (fun t : ℝ => dAxDz (shiftZ t p))
  dAzDyAlongY : ∀ p, Continuous (fun t : ℝ => dAzDy (shiftY t p))
  dAyDzAlongZ : ∀ p, Continuous (fun t : ℝ => dAyDz (shiftZ t p))

/-- Uniform absolute bounds for the six cross-coordinate derivatives. -/
structure CrossDerivativeBounds (C : RegularConnection3) where
  bAyDx : ℝ
  bAxDy : ℝ
  bAzDx : ℝ
  bAxDz : ℝ
  bAzDy : ℝ
  bAyDz : ℝ
  bAyDx_nonneg : 0 ≤ bAyDx
  bAxDy_nonneg : 0 ≤ bAxDy
  bAzDx_nonneg : 0 ≤ bAzDx
  bAxDz_nonneg : 0 ≤ bAxDz
  bAzDy_nonneg : 0 ≤ bAzDy
  bAyDz_nonneg : 0 ≤ bAyDz
  boundAyDx : ∀ p, |C.dAyDx p| ≤ bAyDx
  boundAxDy : ∀ p, |C.dAxDy p| ≤ bAxDy
  boundAzDx : ∀ p, |C.dAzDx p| ≤ bAzDx
  boundAxDz : ∀ p, |C.dAxDz p| ≤ bAxDz
  boundAzDy : ∀ p, |C.dAzDy p| ≤ bAzDy
  boundAyDz : ∀ p, |C.dAyDz p| ≤ bAyDz

@[simp] theorem shiftX_add (a b : ℝ) (p : Point3) :
    shiftX a (shiftX b p) = shiftX (a + b) p := by
  cases p
  simp [shiftX]
  ring

@[simp] theorem shiftY_add (a b : ℝ) (p : Point3) :
    shiftY a (shiftY b p) = shiftY (a + b) p := by
  cases p
  simp [shiftY]
  ring

@[simp] theorem shiftZ_add (a b : ℝ) (p : Point3) :
    shiftZ a (shiftZ b p) = shiftZ (a + b) p := by
  cases p
  simp [shiftZ]
  ring

@[simp] theorem shiftX_shiftY (a b : ℝ) (p : Point3) :
    shiftX a (shiftY b p) = shiftY b (shiftX a p) := by
  cases p
  simp [shiftX, shiftY]

@[simp] theorem shiftX_shiftZ (a b : ℝ) (p : Point3) :
    shiftX a (shiftZ b p) = shiftZ b (shiftX a p) := by
  cases p
  simp [shiftX, shiftZ]

@[simp] theorem shiftY_shiftZ (a b : ℝ) (p : Point3) :
    shiftY a (shiftZ b p) = shiftZ b (shiftY a p) := by
  cases p
  simp [shiftY, shiftZ]

/-- Exact coordinate-edge line integrals. -/
def edgeAngleX (C : RegularConnection3) (h : ℝ) (p : Point3) : ℝ :=
  ∫ t in 0..h, C.ax (shiftX t p)

def edgeAngleY (C : RegularConnection3) (h : ℝ) (p : Point3) : ℝ :=
  ∫ t in 0..h, C.ay (shiftY t p)

def edgeAngleZ (C : RegularConnection3) (h : ℝ) (p : Point3) : ℝ :=
  ∫ t in 0..h, C.az (shiftZ t p)

/-- `U(1)` links generated by the exact coordinate-edge integrals. -/
def linkX (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  Circle.exp (edgeAngleX C h p)

def linkY (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  Circle.exp (edgeAngleY C h p)

def linkZ (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  Circle.exp (edgeAngleZ C h p)

/-- Exact bisection of a regular line integral. -/
theorem edgeAngleX_half_add (C : RegularConnection3) (h : ℝ) (p : Point3) :
    edgeAngleX C (h / 2) (shiftX (h / 2) p) + edgeAngleX C (h / 2) p =
      edgeAngleX C h p := by
  unfold edgeAngleX
  have hc : Continuous (fun t : ℝ => C.ax (shiftX t p)) := C.axAlongX p
  have hleft :
      (∫ t in 0..h / 2, C.ax (shiftX t (shiftX (h / 2) p))) =
        ∫ t in h / 2..h, C.ax (shiftX t p) := by
    calc
      (∫ t in 0..h / 2, C.ax (shiftX t (shiftX (h / 2) p))) =
          ∫ t in 0..h / 2, (fun s : ℝ => C.ax (shiftX s p)) (t + h / 2) := by
            congr 1
            funext t
            rw [shiftX_add]
      _ = ∫ t in 0 + h / 2..h / 2 + h / 2, C.ax (shiftX t p) := by
            simpa using
              (intervalIntegral.integral_comp_add_right
                (f := fun s : ℝ => C.ax (shiftX s p)) (a := 0) (b := h / 2) (h / 2))
      _ = ∫ t in h / 2..h, C.ax (shiftX t p) := by
            congr 1 <;> ring
  rw [hleft, add_comm]
  exact intervalIntegral.integral_add_adjacent_intervals
    (hc.intervalIntegrable 0 (h / 2)) (hc.intervalIntegrable (h / 2) h)

theorem edgeAngleY_half_add (C : RegularConnection3) (h : ℝ) (p : Point3) :
    edgeAngleY C (h / 2) (shiftY (h / 2) p) + edgeAngleY C (h / 2) p =
      edgeAngleY C h p := by
  unfold edgeAngleY
  have hc : Continuous (fun t : ℝ => C.ay (shiftY t p)) := C.ayAlongY p
  have hleft :
      (∫ t in 0..h / 2, C.ay (shiftY t (shiftY (h / 2) p))) =
        ∫ t in h / 2..h, C.ay (shiftY t p) := by
    calc
      (∫ t in 0..h / 2, C.ay (shiftY t (shiftY (h / 2) p))) =
          ∫ t in 0..h / 2, (fun s : ℝ => C.ay (shiftY s p)) (t + h / 2) := by
            congr 1
            funext t
            rw [shiftY_add]
      _ = ∫ t in 0 + h / 2..h / 2 + h / 2, C.ay (shiftY t p) := by
            simpa using
              (intervalIntegral.integral_comp_add_right
                (f := fun s : ℝ => C.ay (shiftY s p)) (a := 0) (b := h / 2) (h / 2))
      _ = ∫ t in h / 2..h, C.ay (shiftY t p) := by
            congr 1 <;> ring
  rw [hleft, add_comm]
  exact intervalIntegral.integral_add_adjacent_intervals
    (hc.intervalIntegrable 0 (h / 2)) (hc.intervalIntegrable (h / 2) h)

theorem edgeAngleZ_half_add (C : RegularConnection3) (h : ℝ) (p : Point3) :
    edgeAngleZ C (h / 2) (shiftZ (h / 2) p) + edgeAngleZ C (h / 2) p =
      edgeAngleZ C h p := by
  unfold edgeAngleZ
  have hc : Continuous (fun t : ℝ => C.az (shiftZ t p)) := C.azAlongZ p
  have hleft :
      (∫ t in 0..h / 2, C.az (shiftZ t (shiftZ (h / 2) p))) =
        ∫ t in h / 2..h, C.az (shiftZ t p) := by
    calc
      (∫ t in 0..h / 2, C.az (shiftZ t (shiftZ (h / 2) p))) =
          ∫ t in 0..h / 2, (fun s : ℝ => C.az (shiftZ s p)) (t + h / 2) := by
            congr 1
            funext t
            rw [shiftZ_add]
      _ = ∫ t in 0 + h / 2..h / 2 + h / 2, C.az (shiftZ t p) := by
            simpa using
              (intervalIntegral.integral_comp_add_right
                (f := fun s : ℝ => C.az (shiftZ s p)) (a := 0) (b := h / 2) (h / 2))
      _ = ∫ t in h / 2..h, C.az (shiftZ t p) := by
            congr 1 <;> ring
  rw [hleft, add_comm]
  exact intervalIntegral.integral_add_adjacent_intervals
    (hc.intervalIntegrable 0 (h / 2)) (hc.intervalIntegrable (h / 2) h)

/-- Exact link composition follows from additivity of the line integral. -/
theorem linkX_half_product (C : RegularConnection3) (h : ℝ) (p : Point3) :
    linkX C (h / 2) (shiftX (h / 2) p) * linkX C (h / 2) p = linkX C h p := by
  unfold linkX
  rw [← Circle.exp_add]
  exact congrArg Circle.exp (edgeAngleX_half_add C h p)

theorem linkY_half_product (C : RegularConnection3) (h : ℝ) (p : Point3) :
    linkY C (h / 2) (shiftY (h / 2) p) * linkY C (h / 2) p = linkY C h p := by
  unfold linkY
  rw [← Circle.exp_add]
  exact congrArg Circle.exp (edgeAngleY_half_add C h p)

theorem linkZ_half_product (C : RegularConnection3) (h : ℝ) (p : Point3) :
    linkZ C (h / 2) (shiftZ (h / 2) p) * linkZ C (h / 2) p = linkZ C h p := by
  unfold linkZ
  rw [← Circle.exp_add]
  exact congrArg Circle.exp (edgeAngleZ_half_add C h p)


/-! ## Cross-coordinate variation bounds -/

/-- Fundamental-theorem estimate for variation of `A_y` in the `x` direction. -/
theorem abs_ay_shiftX_sub_le (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (h : ℝ) (p : Point3) :
    |C.ay (shiftX h p) - C.ay p| ≤ B.bAyDx * |h| := by
  have hftc :
      (∫ t in 0..h, C.dAyDx (shiftX t p)) =
        C.ay (shiftX h p) - C.ay p := by
    simpa [shiftX] using
      (intervalIntegral.integral_eq_sub_of_hasDerivAt
        (a := 0) (b := h)
        (f := fun t : ℝ => C.ay (shiftX t p))
        (f' := fun t : ℝ => C.dAyDx (shiftX t p))
        (fun t _ => C.hasDerivAyX p t)
        ((C.dAyDxAlongX p).intervalIntegrable 0 h))
  rw [← hftc]
  simpa [Real.norm_eq_abs] using
    (intervalIntegral.norm_integral_le_of_norm_le_const
      (a := 0) (b := h) (C := B.bAyDx)
      (f := fun t : ℝ => C.dAyDx (shiftX t p))
      (fun t _ => by simpa [Real.norm_eq_abs] using B.boundAyDx (shiftX t p)))


/-- Fundamental-theorem estimate for variation of `A_x` in the `y` direction. -/
theorem abs_ax_shiftY_sub_le (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (h : ℝ) (p : Point3) :
    |C.ax (shiftY h p) - C.ax p| ≤ B.bAxDy * |h| := by
  have hftc :
      (∫ t in 0..h, C.dAxDy (shiftY t p)) =
        C.ax (shiftY h p) - C.ax p := by
    simpa [shiftY] using
      (intervalIntegral.integral_eq_sub_of_hasDerivAt
        (a := 0) (b := h)
        (f := fun t : ℝ => C.ax (shiftY t p))
        (f' := fun t : ℝ => C.dAxDy (shiftY t p))
        (fun t _ => C.hasDerivAxY p t)
        ((C.dAxDyAlongY p).intervalIntegrable 0 h))
  rw [← hftc]
  simpa [Real.norm_eq_abs] using
    (intervalIntegral.norm_integral_le_of_norm_le_const
      (a := 0) (b := h) (C := B.bAxDy)
      (f := fun t : ℝ => C.dAxDy (shiftY t p))
      (fun t _ => by simpa [Real.norm_eq_abs] using B.boundAxDy (shiftY t p)))

