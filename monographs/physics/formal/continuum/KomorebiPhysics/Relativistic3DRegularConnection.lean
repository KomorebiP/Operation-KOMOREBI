/-- Moving the base point of a `y`-edge in the `x` direction changes its exact
line integral by at most a quadratic amount. -/
theorem abs_edgeAngleY_shiftX_sub_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    |edgeAngleY C h (shiftX h p) - edgeAngleY C h p| ≤
      B.bAyDx * |h| ^ 2 := by
  unfold edgeAngleY
  have h₁ : IntervalIntegrable (fun t : ℝ => C.ay (shiftY t (shiftX h p)))
      MeasureTheory.volume 0 h := (C.ayAlongY (shiftX h p)).intervalIntegrable 0 h
  have h₂ : IntervalIntegrable (fun t : ℝ => C.ay (shiftY t p))
      MeasureTheory.volume 0 h := (C.ayAlongY p).intervalIntegrable 0 h
  rw [← intervalIntegral.integral_sub h₁ h₂]
  calc
    |∫ t in 0..h, C.ay (shiftY t (shiftX h p)) - C.ay (shiftY t p)| =
        ‖∫ t in 0..h, C.ay (shiftY t (shiftX h p)) - C.ay (shiftY t p)‖ := by
          rw [Real.norm_eq_abs]
    _ ≤ (B.bAyDx * |h|) * |h - 0| := by
      exact intervalIntegral.norm_integral_le_of_norm_le_const
        (a := 0) (b := h) (C := B.bAyDx * |h|)
        (f := fun t : ℝ => C.ay (shiftY t (shiftX h p)) - C.ay (shiftY t p))
        (fun t _ => by
          simpa [Real.norm_eq_abs] using
            (abs_ay_shiftX_sub_le C B h (shiftY t p)))
    _ = B.bAyDx * |h| ^ 2 := by
      rw [sub_zero]
      ring


theorem abs_edgeAngleX_shiftY_sub_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    |edgeAngleX C h (shiftY h p) - edgeAngleX C h p| ≤
      B.bAxDy * |h| ^ 2 := by
  unfold edgeAngleX
  have h₁ : IntervalIntegrable (fun t : ℝ => C.ax (shiftX t (shiftY h p)))
      MeasureTheory.volume 0 h := (C.axAlongX (shiftY h p)).intervalIntegrable 0 h
  have h₂ : IntervalIntegrable (fun t : ℝ => C.ax (shiftX t p))
      MeasureTheory.volume 0 h := (C.axAlongX p).intervalIntegrable 0 h
  rw [← intervalIntegral.integral_sub h₁ h₂]
  calc
    |∫ t in 0..h, C.ax (shiftX t (shiftY h p)) - C.ax (shiftX t p)| =
        ‖∫ t in 0..h, C.ax (shiftX t (shiftY h p)) - C.ax (shiftX t p)‖ := by
          rw [Real.norm_eq_abs]
    _ ≤ (B.bAxDy * |h|) * |h - 0| := by
      exact intervalIntegral.norm_integral_le_of_norm_le_const
        (a := 0) (b := h) (C := B.bAxDy * |h|)
        (f := fun t : ℝ => C.ax (shiftX t (shiftY h p)) - C.ax (shiftX t p))
        (fun t _ => by
          simpa [Real.norm_eq_abs] using
            (abs_ax_shiftY_sub_le C B h (shiftX t p)))
    _ = B.bAxDy * |h| ^ 2 := by
      rw [sub_zero]
      ring

theorem abs_edgeAngleZ_shiftX_sub_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    |edgeAngleZ C h (shiftX h p) - edgeAngleZ C h p| ≤
      B.bAzDx * |h| ^ 2 := by
  unfold edgeAngleZ
  have h₁ : IntervalIntegrable (fun t : ℝ => C.az (shiftZ t (shiftX h p)))
      MeasureTheory.volume 0 h := (C.azAlongZ (shiftX h p)).intervalIntegrable 0 h
  have h₂ : IntervalIntegrable (fun t : ℝ => C.az (shiftZ t p))
      MeasureTheory.volume 0 h := (C.azAlongZ p).intervalIntegrable 0 h
  rw [← intervalIntegral.integral_sub h₁ h₂]
  calc
    |∫ t in 0..h, C.az (shiftZ t (shiftX h p)) - C.az (shiftZ t p)| =
        ‖∫ t in 0..h, C.az (shiftZ t (shiftX h p)) - C.az (shiftZ t p)‖ := by
          rw [Real.norm_eq_abs]
    _ ≤ (B.bAzDx * |h|) * |h - 0| := by
      exact intervalIntegral.norm_integral_le_of_norm_le_const
        (a := 0) (b := h) (C := B.bAzDx * |h|)
        (f := fun t : ℝ => C.az (shiftZ t (shiftX h p)) - C.az (shiftZ t p))
        (fun t _ => by
          simpa [Real.norm_eq_abs] using
            (abs_az_shiftX_sub_le C B h (shiftZ t p)))
    _ = B.bAzDx * |h| ^ 2 := by
      rw [sub_zero]
      ring

theorem abs_edgeAngleX_shiftZ_sub_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    |edgeAngleX C h (shiftZ h p) - edgeAngleX C h p| ≤
      B.bAxDz * |h| ^ 2 := by
  unfold edgeAngleX
  have h₁ : IntervalIntegrable (fun t : ℝ => C.ax (shiftX t (shiftZ h p)))
      MeasureTheory.volume 0 h := (C.axAlongX (shiftZ h p)).intervalIntegrable 0 h
  have h₂ : IntervalIntegrable (fun t : ℝ => C.ax (shiftX t p))
      MeasureTheory.volume 0 h := (C.axAlongX p).intervalIntegrable 0 h
  rw [← intervalIntegral.integral_sub h₁ h₂]
  calc
    |∫ t in 0..h, C.ax (shiftX t (shiftZ h p)) - C.ax (shiftX t p)| =
        ‖∫ t in 0..h, C.ax (shiftX t (shiftZ h p)) - C.ax (shiftX t p)‖ := by
          rw [Real.norm_eq_abs]
    _ ≤ (B.bAxDz * |h|) * |h - 0| := by
      exact intervalIntegral.norm_integral_le_of_norm_le_const
        (a := 0) (b := h) (C := B.bAxDz * |h|)
        (f := fun t : ℝ => C.ax (shiftX t (shiftZ h p)) - C.ax (shiftX t p))
        (fun t _ => by
          simpa [Real.norm_eq_abs] using
            (abs_ax_shiftZ_sub_le C B h (shiftX t p)))
    _ = B.bAxDz * |h| ^ 2 := by
      rw [sub_zero]
      ring

theorem abs_edgeAngleZ_shiftY_sub_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    |edgeAngleZ C h (shiftY h p) - edgeAngleZ C h p| ≤
      B.bAzDy * |h| ^ 2 := by
  unfold edgeAngleZ
  have h₁ : IntervalIntegrable (fun t : ℝ => C.az (shiftZ t (shiftY h p)))
      MeasureTheory.volume 0 h := (C.azAlongZ (shiftY h p)).intervalIntegrable 0 h
  have h₂ : IntervalIntegrable (fun t : ℝ => C.az (shiftZ t p))
      MeasureTheory.volume 0 h := (C.azAlongZ p).intervalIntegrable 0 h
  rw [← intervalIntegral.integral_sub h₁ h₂]
  calc
    |∫ t in 0..h, C.az (shiftZ t (shiftY h p)) - C.az (shiftZ t p)| =
        ‖∫ t in 0..h, C.az (shiftZ t (shiftY h p)) - C.az (shiftZ t p)‖ := by
          rw [Real.norm_eq_abs]
    _ ≤ (B.bAzDy * |h|) * |h - 0| := by
      exact intervalIntegral.norm_integral_le_of_norm_le_const
        (a := 0) (b := h) (C := B.bAzDy * |h|)
        (f := fun t : ℝ => C.az (shiftZ t (shiftY h p)) - C.az (shiftZ t p))
        (fun t _ => by
          simpa [Real.norm_eq_abs] using
            (abs_az_shiftY_sub_le C B h (shiftZ t p)))
    _ = B.bAzDy * |h| ^ 2 := by
      rw [sub_zero]
      ring

theorem abs_edgeAngleY_shiftZ_sub_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    |edgeAngleY C h (shiftZ h p) - edgeAngleY C h p| ≤
      B.bAyDz * |h| ^ 2 := by
  unfold edgeAngleY
  have h₁ : IntervalIntegrable (fun t : ℝ => C.ay (shiftY t (shiftZ h p)))
      MeasureTheory.volume 0 h := (C.ayAlongY (shiftZ h p)).intervalIntegrable 0 h
  have h₂ : IntervalIntegrable (fun t : ℝ => C.ay (shiftY t p))
      MeasureTheory.volume 0 h := (C.ayAlongY p).intervalIntegrable 0 h
  rw [← intervalIntegral.integral_sub h₁ h₂]
  calc
    |∫ t in 0..h, C.ay (shiftY t (shiftZ h p)) - C.ay (shiftY t p)| =
        ‖∫ t in 0..h, C.ay (shiftY t (shiftZ h p)) - C.ay (shiftY t p)‖ := by
          rw [Real.norm_eq_abs]
    _ ≤ (B.bAyDz * |h|) * |h - 0| := by
      exact intervalIntegral.norm_integral_le_of_norm_le_const
        (a := 0) (b := h) (C := B.bAyDz * |h|)
        (f := fun t : ℝ => C.ay (shiftY t (shiftZ h p)) - C.ay (shiftY t p))
        (fun t _ => by
          simpa [Real.norm_eq_abs] using
            (abs_ay_shiftZ_sub_le C B h (shiftY t p)))
    _ = B.bAyDz * |h| ^ 2 := by
      rw [sub_zero]
      ring


/-! ## Plaquette phases and quadratic control -/

def pathXY (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkY C h (shiftX h p) * linkX C h p

def pathYX (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkX C h (shiftY h p) * linkY C h p

def pathXZ (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkZ C h (shiftX h p) * linkX C h p

def pathZX (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkX C h (shiftZ h p) * linkZ C h p

def pathYZ (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkZ C h (shiftY h p) * linkY C h p

def pathZY (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkY C h (shiftZ h p) * linkZ C h p

def plaquetteXY (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  pathXY C h p / pathYX C h p

def plaquetteXZ (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  pathXZ C h p / pathZX C h p

def plaquetteYZ (C : RegularConnection3) (h : ℝ) (p : Point3) : Circle :=
  pathYZ C h p / pathZY C h p

/-- Oriented boundary angles before exponentiation. -/
def plaquetteAngleXY (C : RegularConnection3) (h : ℝ) (p : Point3) : ℝ :=
  (edgeAngleY C h (shiftX h p) + edgeAngleX C h p) -
    (edgeAngleX C h (shiftY h p) + edgeAngleY C h p)

def plaquetteAngleXZ (C : RegularConnection3) (h : ℝ) (p : Point3) : ℝ :=
  (edgeAngleZ C h (shiftX h p) + edgeAngleX C h p) -
    (edgeAngleX C h (shiftZ h p) + edgeAngleZ C h p)

def plaquetteAngleYZ (C : RegularConnection3) (h : ℝ) (p : Point3) : ℝ :=
  (edgeAngleZ C h (shiftY h p) + edgeAngleY C h p) -
    (edgeAngleY C h (shiftZ h p) + edgeAngleZ C h p)

theorem plaquetteXY_eq_exp_angle (C : RegularConnection3) (h : ℝ) (p : Point3) :
    plaquetteXY C h p = Circle.exp (plaquetteAngleXY C h p) := by
  unfold plaquetteXY pathXY pathYX linkX linkY plaquetteAngleXY
  rw [← Circle.exp_add, ← Circle.exp_add, ← Circle.exp_sub]

theorem plaquetteXZ_eq_exp_angle (C : RegularConnection3) (h : ℝ) (p : Point3) :
    plaquetteXZ C h p = Circle.exp (plaquetteAngleXZ C h p) := by
  unfold plaquetteXZ pathXZ pathZX linkX linkZ plaquetteAngleXZ
  rw [← Circle.exp_add, ← Circle.exp_add, ← Circle.exp_sub]

theorem plaquetteYZ_eq_exp_angle (C : RegularConnection3) (h : ℝ) (p : Point3) :
    plaquetteYZ C h p = Circle.exp (plaquetteAngleYZ C h p) := by
  unfold plaquetteYZ pathYZ pathZY linkY linkZ plaquetteAngleYZ
  rw [← Circle.exp_add, ← Circle.exp_add, ← Circle.exp_sub]

/-- Quadratic boundary-angle control from the explicit coordinate derivatives. -/
theorem abs_plaquetteAngleXY_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    |plaquetteAngleXY C h p| ≤
      (B.bAyDx + B.bAxDy) * |h| ^ 2 := by
  have hid : plaquetteAngleXY C h p =
      (edgeAngleY C h (shiftX h p) - edgeAngleY C h p) -
        (edgeAngleX C h (shiftY h p) - edgeAngleX C h p) := by
    unfold plaquetteAngleXY
    ring
  rw [hid]
  calc
    |(edgeAngleY C h (shiftX h p) - edgeAngleY C h p) -
        (edgeAngleX C h (shiftY h p) - edgeAngleX C h p)| =
        ‖(edgeAngleY C h (shiftX h p) - edgeAngleY C h p) -
          (edgeAngleX C h (shiftY h p) - edgeAngleX C h p)‖ := by
            rw [Real.norm_eq_abs]
    _ ≤ ‖edgeAngleY C h (shiftX h p) - edgeAngleY C h p‖ +
        ‖edgeAngleX C h (shiftY h p) - edgeAngleX C h p‖ := norm_sub_le _ _
    _ = |edgeAngleY C h (shiftX h p) - edgeAngleY C h p| +
        |edgeAngleX C h (shiftY h p) - edgeAngleX C h p| := by
          simp [Real.norm_eq_abs]
    _ ≤ B.bAyDx * |h| ^ 2 + B.bAxDy * |h| ^ 2 :=
      add_le_add (abs_edgeAngleY_shiftX_sub_le C B h p)
        (abs_edgeAngleX_shiftY_sub_le C B h p)
    _ = (B.bAyDx + B.bAxDy) * |h| ^ 2 := by ring

theorem abs_plaquetteAngleXZ_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    |plaquetteAngleXZ C h p| ≤
      (B.bAzDx + B.bAxDz) * |h| ^ 2 := by
  have hid : plaquetteAngleXZ C h p =
      (edgeAngleZ C h (shiftX h p) - edgeAngleZ C h p) -
        (edgeAngleX C h (shiftZ h p) - edgeAngleX C h p) := by
    unfold plaquetteAngleXZ
    ring
  rw [hid]
  calc
    |(edgeAngleZ C h (shiftX h p) - edgeAngleZ C h p) -
        (edgeAngleX C h (shiftZ h p) - edgeAngleX C h p)| =
        ‖(edgeAngleZ C h (shiftX h p) - edgeAngleZ C h p) -
          (edgeAngleX C h (shiftZ h p) - edgeAngleX C h p)‖ := by
            rw [Real.norm_eq_abs]
    _ ≤ ‖edgeAngleZ C h (shiftX h p) - edgeAngleZ C h p‖ +
        ‖edgeAngleX C h (shiftZ h p) - edgeAngleX C h p‖ := norm_sub_le _ _
    _ = |edgeAngleZ C h (shiftX h p) - edgeAngleZ C h p| +
        |edgeAngleX C h (shiftZ h p) - edgeAngleX C h p| := by
          simp [Real.norm_eq_abs]
    _ ≤ B.bAzDx * |h| ^ 2 + B.bAxDz * |h| ^ 2 :=
      add_le_add (abs_edgeAngleZ_shiftX_sub_le C B h p)
        (abs_edgeAngleX_shiftZ_sub_le C B h p)
    _ = (B.bAzDx + B.bAxDz) * |h| ^ 2 := by ring

theorem abs_plaquetteAngleYZ_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    |plaquetteAngleYZ C h p| ≤
      (B.bAzDy + B.bAyDz) * |h| ^ 2 := by
  have hid : plaquetteAngleYZ C h p =
      (edgeAngleZ C h (shiftY h p) - edgeAngleZ C h p) -
        (edgeAngleY C h (shiftZ h p) - edgeAngleY C h p) := by
    unfold plaquetteAngleYZ
    ring
  rw [hid]
  calc
    |(edgeAngleZ C h (shiftY h p) - edgeAngleZ C h p) -
        (edgeAngleY C h (shiftZ h p) - edgeAngleY C h p)| =
        ‖(edgeAngleZ C h (shiftY h p) - edgeAngleZ C h p) -
          (edgeAngleY C h (shiftZ h p) - edgeAngleY C h p)‖ := by
            rw [Real.norm_eq_abs]
    _ ≤ ‖edgeAngleZ C h (shiftY h p) - edgeAngleZ C h p‖ +
        ‖edgeAngleY C h (shiftZ h p) - edgeAngleY C h p‖ := norm_sub_le _ _
    _ = |edgeAngleZ C h (shiftY h p) - edgeAngleZ C h p| +
        |edgeAngleY C h (shiftZ h p) - edgeAngleY C h p| := by
          simp [Real.norm_eq_abs]
    _ ≤ B.bAzDy * |h| ^ 2 + B.bAyDz * |h| ^ 2 :=
      add_le_add (abs_edgeAngleZ_shiftY_sub_le C B h p)
        (abs_edgeAngleY_shiftZ_sub_le C B h p)
    _ = (B.bAzDy + B.bAyDz) * |h| ^ 2 := by ring

theorem norm_plaquetteXY_sub_one_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    ‖(plaquetteXY C h p : ℂ) - 1‖ ≤
      (B.bAyDx + B.bAxDy) * |h| ^ 2 := by
  rw [plaquetteXY_eq_exp_angle]
  exact (norm_circleExp_sub_one_le _).trans (abs_plaquetteAngleXY_le C B h p)

theorem norm_plaquetteXZ_sub_one_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    ‖(plaquetteXZ C h p : ℂ) - 1‖ ≤
      (B.bAzDx + B.bAxDz) * |h| ^ 2 := by
  rw [plaquetteXZ_eq_exp_angle]
  exact (norm_circleExp_sub_one_le _).trans (abs_plaquetteAngleXZ_le C B h p)

theorem norm_plaquetteYZ_sub_one_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    ‖(plaquetteYZ C h p : ℂ) - 1‖ ≤
      (B.bAzDy + B.bAyDz) * |h| ^ 2 := by
  rw [plaquetteYZ_eq_exp_angle]
  exact (norm_circleExp_sub_one_le _).trans (abs_plaquetteAngleYZ_le C B h p)

/-- The ordinary coordinate curvature fields represented by the cross derivatives. -/
def curvatureXY (C : RegularConnection3) (p : Point3) : ℝ := C.dAyDx p - C.dAxDy p

def curvatureXZ (C : RegularConnection3) (p : Point3) : ℝ := C.dAzDx p - C.dAxDz p

def curvatureYZ (C : RegularConnection3) (p : Point3) : ℝ := C.dAzDy p - C.dAyDz p

theorem abs_curvatureXY_le (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (p : Point3) : |curvatureXY C p| ≤ B.bAyDx + B.bAxDy := by
  unfold curvatureXY
  calc
    |C.dAyDx p - C.dAxDy p| = ‖C.dAyDx p - C.dAxDy p‖ := by rw [Real.norm_eq_abs]
    _ ≤ ‖C.dAyDx p‖ + ‖C.dAxDy p‖ := norm_sub_le _ _
    _ = |C.dAyDx p| + |C.dAxDy p| := by simp [Real.norm_eq_abs]
    _ ≤ B.bAyDx + B.bAxDy := add_le_add (B.boundAyDx p) (B.boundAxDy p)

theorem abs_curvatureXZ_le (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (p : Point3) : |curvatureXZ C p| ≤ B.bAzDx + B.bAxDz := by
  unfold curvatureXZ
  calc
    |C.dAzDx p - C.dAxDz p| = ‖C.dAzDx p - C.dAxDz p‖ := by rw [Real.norm_eq_abs]
    _ ≤ ‖C.dAzDx p‖ + ‖C.dAxDz p‖ := norm_sub_le _ _
    _ = |C.dAzDx p| + |C.dAxDz p| := by simp [Real.norm_eq_abs]
    _ ≤ B.bAzDx + B.bAxDz := add_le_add (B.boundAzDx p) (B.boundAxDz p)

theorem abs_curvatureYZ_le (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (p : Point3) : |curvatureYZ C p| ≤ B.bAzDy + B.bAyDz := by
  unfold curvatureYZ
  calc
    |C.dAzDy p - C.dAyDz p| = ‖C.dAzDy p - C.dAyDz p‖ := by rw [Real.norm_eq_abs]
    _ ≤ ‖C.dAzDy p‖ + ‖C.dAyDz p‖ := norm_sub_le _ _
    _ = |C.dAzDy p| + |C.dAyDz p| := by simp [Real.norm_eq_abs]
    _ ≤ B.bAzDy + B.bAyDz := add_le_add (B.boundAzDy p) (B.boundAyDz p)


/-! ## Connection-generated cubical data -/

/-- The twelve coordinate-edge links generated by the regular connection on one cube. -/
def regularCubeLinks (C : RegularConnection3) (h : ℝ) (p : Point3) : CubeLinks where
  edgeX := fun bY bz => linkX C h (cubePoint p h false bY bz)
  edgeY := fun bx bz => linkY C h (cubePoint p h bx false bz)
  edgeZ := fun bx bY => linkZ C h (cubePoint p h bx bY false)

theorem regularCubeLinks_plaquetteXY (C : RegularConnection3) (h : ℝ)
    (p : Point3) (z : Bool) :
    (regularCubeLinks C h p).plaquetteXY z =
      plaquetteXY C h (cubePoint p h false false z) := by
  simp [CubeLinks.plaquetteXY, CubeLinks.pathXY, CubeLinks.pathYX,
    regularCubeLinks, plaquetteXY, pathXY, pathYX]

theorem regularCubeLinks_plaquetteXZ (C : RegularConnection3) (h : ℝ)
    (p : Point3) (y : Bool) :
    (regularCubeLinks C h p).plaquetteXZ y =
      plaquetteXZ C h (cubePoint p h false y false) := by
  simp [CubeLinks.plaquetteXZ, CubeLinks.pathXZ, CubeLinks.pathZX,
    regularCubeLinks, plaquetteXZ, pathXZ, pathZX]

theorem regularCubeLinks_plaquetteYZ (C : RegularConnection3) (h : ℝ)
    (p : Point3) (x : Bool) :
    (regularCubeLinks C h p).plaquetteYZ x =
      plaquetteYZ C h (cubePoint p h x false false) := by
  simp [CubeLinks.plaquetteYZ, CubeLinks.pathYZ, CubeLinks.pathZY,
    regularCubeLinks, plaquetteYZ, pathYZ, pathZY]

/-- A global derivative envelope sufficient for the five-face gluing budget. -/
def regularDerivativeAmplitude (C : RegularConnection3)
    (B : CrossDerivativeBounds C) : ℝ :=
  (B.bAyDx + B.bAxDy) +
    2 * (B.bAzDx + B.bAxDz) +
    2 * (B.bAzDy + B.bAyDz)

theorem regularDerivativeAmplitude_nonneg (C : RegularConnection3)
    (B : CrossDerivativeBounds C) :
    0 ≤ regularDerivativeAmplitude C B := by
  unfold regularDerivativeAmplitude
  nlinarith [B.bAyDx_nonneg, B.bAxDy_nonneg, B.bAzDx_nonneg,
    B.bAxDz_nonneg, B.bAzDy_nonneg, B.bAyDz_nonneg]

/-- The five-face gluing budget is quadratically small for every connection
satisfying the explicit uniform cross-derivative bounds. -/
theorem curvatureBudget_regularCubeLinks_le (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (h : ℝ) (p : Point3) :
    curvatureBudget (regularCubeLinks C h p) ≤
      h ^ 2 * regularDerivativeAmplitude C B := by
  unfold curvatureBudget
  rw [regularCubeLinks_plaquetteXY, regularCubeLinks_plaquetteXZ,
    regularCubeLinks_plaquetteYZ, regularCubeLinks_plaquetteYZ,
    regularCubeLinks_plaquetteXZ]
  calc
    ‖(plaquetteXY C h (cubePoint p h false false false) : ℂ) - 1‖ +
        ‖(plaquetteXZ C h (cubePoint p h false true false) : ℂ) - 1‖ +
        ‖(plaquetteYZ C h (cubePoint p h false false false) : ℂ) - 1‖ +
        ‖(plaquetteYZ C h (cubePoint p h true false false) : ℂ) - 1‖ +
        ‖(plaquetteXZ C h (cubePoint p h false false false) : ℂ) - 1‖ ≤
      (B.bAyDx + B.bAxDy) * |h| ^ 2 +
        (B.bAzDx + B.bAxDz) * |h| ^ 2 +
        (B.bAzDy + B.bAyDz) * |h| ^ 2 +
        (B.bAzDy + B.bAyDz) * |h| ^ 2 +
        (B.bAzDx + B.bAxDz) * |h| ^ 2 := by
          gcongr
          · exact norm_plaquetteXY_sub_one_le C B h _
          · exact norm_plaquetteXZ_sub_one_le C B h _
          · exact norm_plaquetteYZ_sub_one_le C B h _
          · exact norm_plaquetteYZ_sub_one_le C B h _
          · exact norm_plaquetteXZ_sub_one_le C B h _
    _ = h ^ 2 * regularDerivativeAmplitude C B := by
      simp only [sq_abs]
      unfold regularDerivativeAmplitude
      ring


/-! ## Insertion into the complete finite-Hilbert defect theorem -/

def regularCoarseLinkXOn {Site : Type u} (C : RegularConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) := fun s => linkX C h (pos s)

def regularCoarseLinkYOn {Site : Type u} (C : RegularConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) := fun s => linkY C h (pos s)

def regularCoarseLinkZOn {Site : Type u} (C : RegularConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) := fun s => linkZ C h (pos s)

def regularHalfProductLinkXOn {Site : Type u} (C : RegularConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) := fun s =>
  linkX C (h / 2) (shiftX (h / 2) (pos s)) * linkX C (h / 2) (pos s)

def regularHalfProductLinkYOn {Site : Type u} (C : RegularConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) := fun s =>
  linkY C (h / 2) (shiftY (h / 2) (pos s)) * linkY C (h / 2) (pos s)

def regularHalfProductLinkZOn {Site : Type u} (C : RegularConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) := fun s =>
  linkZ C (h / 2) (shiftZ (h / 2) (pos s)) * linkZ C (h / 2) (pos s)

@[simp] theorem regularHalfProductLinkXOn_eq_coarse {Site : Type u}
    (C : RegularConnection3) (h : ℝ) (pos : Site → Point3) :
    regularHalfProductLinkXOn C h pos = regularCoarseLinkXOn C h pos := by
  funext s
  exact linkX_half_product C h (pos s)

@[simp] theorem regularHalfProductLinkYOn_eq_coarse {Site : Type u}
    (C : RegularConnection3) (h : ℝ) (pos : Site → Point3) :
    regularHalfProductLinkYOn C h pos = regularCoarseLinkYOn C h pos := by
  funext s
  exact linkY_half_product C h (pos s)

@[simp] theorem regularHalfProductLinkZOn_eq_coarse {Site : Type u}
    (C : RegularConnection3) (h : ℝ) (pos : Site → Point3) :
    regularHalfProductLinkZOn C h pos = regularCoarseLinkZOn C h pos := by
  funext s
  exact linkZ_half_product C h (pos s)

/-- For exact line-integral links from a coordinate-regular connection, the
straight-edge budget vanishes and the complete finite-Hilbert defect is
quadratically controlled by the derivative envelope. -/
theorem norm_regularGeneratedCombinedHilbertDefect_le
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site) (pos : Site → Point3)
    (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (h : ℝ) (p : Point3) (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
    ‖combinedHilbertDefect m₀ m₁ τx τy τz
      (regularHalfProductLinkXOn C h pos)
      (regularHalfProductLinkYOn C h pos)
      (regularHalfProductLinkZOn C h pos)
      (regularCoarseLinkXOn C h pos)
      (regularCoarseLinkYOn C h pos)
      (regularCoarseLinkZOn C h pos)
      (regularCubeLinks C h p)‖ ≤
      h ^ 2 * regularDerivativeAmplitude C B := by
  simp only [regularHalfProductLinkXOn_eq_coarse,
    regularHalfProductLinkYOn_eq_coarse, regularHalfProductLinkZOn_eq_coarse]
  calc
    ‖combinedHilbertDefect m₀ m₁ τx τy τz
      (regularCoarseLinkXOn C h pos) (regularCoarseLinkYOn C h pos)
      (regularCoarseLinkZOn C h pos)
      (regularCoarseLinkXOn C h pos) (regularCoarseLinkYOn C h pos)
      (regularCoarseLinkZOn C h pos) (regularCubeLinks C h p)‖ ≤
        hilbertEdgeBudget
          (regularCoarseLinkXOn C h pos) (regularCoarseLinkYOn C h pos)
          (regularCoarseLinkZOn C h pos)
          (regularCoarseLinkXOn C h pos) (regularCoarseLinkYOn C h pos)
          (regularCoarseLinkZOn C h pos) +
          curvatureBudget (regularCubeLinks C h p) :=
      norm_combinedHilbertDefect_le m₀ m₁ τx τy τz
        (regularCoarseLinkXOn C h pos) (regularCoarseLinkYOn C h pos)
        (regularCoarseLinkZOn C h pos)
        (regularCoarseLinkXOn C h pos) (regularCoarseLinkYOn C h pos)
        (regularCoarseLinkZOn C h pos) (regularCubeLinks C h p) hm₀ hm₁
    _ = curvatureBudget (regularCubeLinks C h p) := by simp
    _ ≤ h ^ 2 * regularDerivativeAmplitude C B :=
      curvatureBudget_regularCubeLinks_le C B h p

/-! ## Explicit dyadic quadratic regime -/

def regularDyadicBudget (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (a₀ : ℝ) (n : ℕ) : ℝ :=
  (dyadicMesh a₀ n) ^ 2 * regularDerivativeAmplitude C B

theorem regularDyadicBudget_eq (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (a₀ : ℝ) (n : ℕ) :
    regularDyadicBudget C B a₀ n =
      (a₀ ^ 2 * regularDerivativeAmplitude C B) * ((4 : ℝ)⁻¹) ^ n := by
  unfold regularDyadicBudget dyadicMesh
  have hpow : (((2 : ℝ)⁻¹) ^ n) ^ 2 = ((4 : ℝ)⁻¹) ^ n := by
    rw [pow_two, ← mul_pow]
    norm_num
  rw [mul_pow, hpow]
  ring

theorem summable_regularDyadicBudget (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (a₀ : ℝ) :
    Summable (regularDyadicBudget C B a₀) := by
  have hgeom : Summable (fun n : ℕ => ((4 : ℝ)⁻¹) ^ n) :=
    summable_geometric_of_norm_lt_one (by norm_num)
  rw [show regularDyadicBudget C B a₀ = fun n =>
    (a₀ ^ 2 * regularDerivativeAmplitude C B) * ((4 : ℝ)⁻¹) ^ n by
      funext n
      exact regularDyadicBudget_eq C B a₀ n]
  exact hgeom.mul_left (a₀ ^ 2 * regularDerivativeAmplitude C B)

theorem tendsto_regularDyadicBudget_zero (C : RegularConnection3)
    (B : CrossDerivativeBounds C) (a₀ : ℝ) :
    Tendsto (regularDyadicBudget C B a₀) atTop (𝓝 0) := by
  rw [show regularDyadicBudget C B a₀ = fun n =>
    (a₀ ^ 2 * regularDerivativeAmplitude C B) * ((4 : ℝ)⁻¹) ^ n by
      funext n
      exact regularDyadicBudget_eq C B a₀ n]
  have hpow : Tendsto (fun n : ℕ => ((4 : ℝ)⁻¹) ^ n) atTop (𝓝 0) :=
    tendsto_pow_atTop_nhds_zero_of_norm_lt_one (by norm_num)
  simpa only [mul_zero] using
    hpow.const_mul (a₀ ^ 2 * regularDerivativeAmplitude C B)

theorem norm_regularGeneratedCombinedHilbertDefect_dyadic_le
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site) (pos : Site → Point3)
    (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (a₀ : ℝ) (p : Point3) (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) (n : ℕ) :
    ‖combinedHilbertDefect m₀ m₁ τx τy τz
      (regularHalfProductLinkXOn C (dyadicMesh a₀ n) pos)
      (regularHalfProductLinkYOn C (dyadicMesh a₀ n) pos)
      (regularHalfProductLinkZOn C (dyadicMesh a₀ n) pos)
      (regularCoarseLinkXOn C (dyadicMesh a₀ n) pos)
      (regularCoarseLinkYOn C (dyadicMesh a₀ n) pos)
      (regularCoarseLinkZOn C (dyadicMesh a₀ n) pos)
      (regularCubeLinks C (dyadicMesh a₀ n) p)‖ ≤
      regularDyadicBudget C B a₀ n := by
  exact norm_regularGeneratedCombinedHilbertDefect_le
    m₀ m₁ τx τy τz pos C B (dyadicMesh a₀ n) p hm₀ hm₁

theorem summable_norm_regularGeneratedCombinedHilbertDefect_dyadic
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site) (pos : Site → Point3)
    (C : RegularConnection3) (B : CrossDerivativeBounds C)
    (a₀ : ℝ) (p : Point3) (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
    Summable (fun n =>
      ‖combinedHilbertDefect m₀ m₁ τx τy τz
        (regularHalfProductLinkXOn C (dyadicMesh a₀ n) pos)
        (regularHalfProductLinkYOn C (dyadicMesh a₀ n) pos)
        (regularHalfProductLinkZOn C (dyadicMesh a₀ n) pos)
        (regularCoarseLinkXOn C (dyadicMesh a₀ n) pos)
        (regularCoarseLinkYOn C (dyadicMesh a₀ n) pos)
        (regularCoarseLinkZOn C (dyadicMesh a₀ n) pos)
        (regularCubeLinks C (dyadicMesh a₀ n) p)‖) := by
  exact Summable.of_nonneg_of_le
    (fun _ => norm_nonneg _)
    (fun n => norm_regularGeneratedCombinedHilbertDefect_dyadic_le
      m₀ m₁ τx τy τz pos C B a₀ p hm₀ hm₁ n)
    (summable_regularDyadicBudget C B a₀)

variable {Y : Type u} [MetricSpace Y] [CompleteSpace Y]

theorem tendsto_regularConnectionLimit (f : ℕ → Y)
    (C : RegularConnection3) (B : CrossDerivativeBounds C) (a₀ : ℝ)
    (hstep : ∀ n, dist (f n) (f n.succ) ≤ regularDyadicBudget C B a₀ n) :
    Tendsto f atTop
      (𝓝 ((twoBudgetSummableDefect f (fun _ => 0)
        (regularDyadicBudget C B a₀) summable_zero
        (summable_regularDyadicBudget C B a₀) (by
          intro n
          simpa [combinedScaleBudget] using hstep n)).limit)) := by
  let hcombined : ∀ n, dist (f n) (f n.succ) ≤
      combinedScaleBudget (fun _ => 0) (regularDyadicBudget C B a₀) n := by
    intro n
    simpa [combinedScaleBudget] using hstep n
  exact tendsto_twoBudgetLimit f (fun _ => 0) (regularDyadicBudget C B a₀)
    summable_zero (summable_regularDyadicBudget C B a₀) hcombined

theorem dist_regularConnectionLimit_le_tail (f : ℕ → Y)
    (C : RegularConnection3) (B : CrossDerivativeBounds C) (a₀ : ℝ)
    (hstep : ∀ n, dist (f n) (f n.succ) ≤ regularDyadicBudget C B a₀ n)
    (n : ℕ) :
    dist (f n)
      ((twoBudgetSummableDefect f (fun _ => 0)
        (regularDyadicBudget C B a₀) summable_zero
        (summable_regularDyadicBudget C B a₀) (by
          intro k
          simpa [combinedScaleBudget] using hstep k)).limit) ≤
      ∑' m : ℕ, regularDyadicBudget C B a₀ (n + m) := by
  simpa [combinedScaleBudget] using
    (dist_twoBudgetLimit_le_tail f (fun _ => 0)
      (regularDyadicBudget C B a₀) summable_zero
      (summable_regularDyadicBudget C B a₀) (by
        intro k
        simpa [combinedScaleBudget] using hstep k) n)


/-! ## Genuinely spatially varying witness -/

/-- Bounded non-affine background `A_y(x)=sin x`. Its curvature
`F_xy(x)=cos x` varies with position. -/
def sinusoidalYConnection : RegularConnection3 where
  ax := fun _ => 0
  ay := fun p => Real.sin p.x
  az := fun _ => 0
  dAyDx := fun p => Real.cos p.x
  dAxDy := fun _ => 0
  dAzDx := fun _ => 0
  dAxDz := fun _ => 0
  dAzDy := fun _ => 0
  dAyDz := fun _ => 0
  axAlongX := by
    intro p
    exact continuous_const
  ayAlongY := by
    intro p
    simpa [shiftY] using (continuous_const : Continuous (fun _ : ℝ => Real.sin p.x))
  azAlongZ := by
    intro p
    exact continuous_const
  hasDerivAyX := by
    intro p t
    simpa [shiftX] using ((hasDerivAt_id t).const_add p.x).sin
  hasDerivAxY := by
    intro p t
    simpa using (hasDerivAt_const t (0 : ℝ))
  hasDerivAzX := by
    intro p t
    simpa using (hasDerivAt_const t (0 : ℝ))
  hasDerivAxZ := by
    intro p t
    simpa using (hasDerivAt_const t (0 : ℝ))
  hasDerivAzY := by
    intro p t
    simpa using (hasDerivAt_const t (0 : ℝ))
  hasDerivAyZ := by
    intro p t
    simpa [shiftZ] using (hasDerivAt_const t (Real.sin p.x))
  dAyDxAlongX := by
    intro p
    fun_prop
  dAxDyAlongY := by
    intro p
    exact continuous_const
  dAzDxAlongX := by
    intro p
    exact continuous_const
  dAxDzAlongZ := by
    intro p
    exact continuous_const
  dAzDyAlongY := by
    intro p
    exact continuous_const
  dAyDzAlongZ := by
    intro p
    exact continuous_const

/-- Uniform derivative bounds for the sinusoidal witness. -/
def sinusoidalYBounds : CrossDerivativeBounds sinusoidalYConnection where
  bAyDx := 1
  bAxDy := 0
  bAzDx := 0
  bAxDz := 0
  bAzDy := 0
  bAyDz := 0
  bAyDx_nonneg := by norm_num
  bAxDy_nonneg := by norm_num
  bAzDx_nonneg := by norm_num
  bAxDz_nonneg := by norm_num
  bAzDy_nonneg := by norm_num
  bAyDz_nonneg := by norm_num
  boundAyDx := by
    intro p
    simpa [sinusoidalYConnection] using (Real.abs_cos_le_one p.x)
  boundAxDy := by simp [sinusoidalYConnection]
  boundAzDx := by simp [sinusoidalYConnection]
  boundAxDz := by simp [sinusoidalYConnection]
  boundAzDy := by simp [sinusoidalYConnection]
  boundAyDz := by simp [sinusoidalYConnection]

@[simp] theorem sinusoidalY_curvatureXY (p : Point3) :
    curvatureXY sinusoidalYConnection p = Real.cos p.x := by
  simp [curvatureXY, sinusoidalYConnection]

@[simp] theorem sinusoidalY_curvatureXZ (p : Point3) :
    curvatureXZ sinusoidalYConnection p = 0 := by
  simp [curvatureXZ, sinusoidalYConnection]

@[simp] theorem sinusoidalY_curvatureYZ (p : Point3) :
    curvatureYZ sinusoidalYConnection p = 0 := by
  simp [curvatureYZ, sinusoidalYConnection]

@[simp] theorem sinusoidalY_regularDerivativeAmplitude :
    regularDerivativeAmplitude sinusoidalYConnection sinusoidalYBounds = 1 := by
  norm_num [regularDerivativeAmplitude, sinusoidalYBounds]

/-- The witness is genuinely non-affine at the curvature level: its curvature
has different values at `x=0` and `x=π/2`. -/
theorem sinusoidalY_curvature_varies :
    curvatureXY sinusoidalYConnection ⟨0, 0, 0⟩ ≠
      curvatureXY sinusoidalYConnection ⟨Real.pi / 2, 0, 0⟩ := by
  simp [sinusoidalY_curvatureXY]

/-- The complete finite-Hilbert defect for the sinusoidal witness is bounded by
`h²`. -/
theorem norm_sinusoidalYGeneratedCombinedHilbertDefect_le
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site) (pos : Site → Point3)
    (h : ℝ) (p : Point3) (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
    ‖combinedHilbertDefect m₀ m₁ τx τy τz
      (regularHalfProductLinkXOn sinusoidalYConnection h pos)
      (regularHalfProductLinkYOn sinusoidalYConnection h pos)
      (regularHalfProductLinkZOn sinusoidalYConnection h pos)
      (regularCoarseLinkXOn sinusoidalYConnection h pos)
      (regularCoarseLinkYOn sinusoidalYConnection h pos)
      (regularCoarseLinkZOn sinusoidalYConnection h pos)
      (regularCubeLinks sinusoidalYConnection h p)‖ ≤ h ^ 2 := by
  simpa using
    (norm_regularGeneratedCombinedHilbertDefect_le m₀ m₁ τx τy τz pos
      sinusoidalYConnection sinusoidalYBounds h p hm₀ hm₁)

