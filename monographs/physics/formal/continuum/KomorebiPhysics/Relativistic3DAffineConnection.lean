/-! ## Affine abelian connection on Euclidean three-space -/

/-- A point in the local Euclidean chart used for the controlled connection model. -/
structure Point3 where
  x : ℝ
  y : ℝ
  z : ℝ

/-- A real affine scalar field on the chart. -/
structure AffineForm3 where
  c : ℝ
  dx : ℝ
  dy : ℝ
  dz : ℝ

/-- Evaluation of an affine scalar field. -/
def AffineForm3.eval (f : AffineForm3) (p : Point3) : ℝ :=
  f.c + f.dx * p.x + f.dy * p.y + f.dz * p.z

/-- Three components of an abelian affine connection. -/
structure AffineConnection3 where
  ax : AffineForm3
  ay : AffineForm3
  az : AffineForm3

/-- Coordinate translations. -/
def shiftX (h : ℝ) (p : Point3) : Point3 := ⟨p.x + h, p.y, p.z⟩
def shiftY (h : ℝ) (p : Point3) : Point3 := ⟨p.x, p.y + h, p.z⟩
def shiftZ (h : ℝ) (p : Point3) : Point3 := ⟨p.x, p.y, p.z + h⟩

@[simp] theorem AffineForm3.eval_shiftX (f : AffineForm3) (h : ℝ) (p : Point3) :
    f.eval (shiftX h p) = f.eval p + f.dx * h := by
  simp [AffineForm3.eval, shiftX]
  ring

@[simp] theorem AffineForm3.eval_shiftY (f : AffineForm3) (h : ℝ) (p : Point3) :
    f.eval (shiftY h p) = f.eval p + f.dy * h := by
  simp [AffineForm3.eval, shiftY]
  ring

@[simp] theorem AffineForm3.eval_shiftZ (f : AffineForm3) (h : ℝ) (p : Point3) :
    f.eval (shiftZ h p) = f.eval p + f.dz * h := by
  simp [AffineForm3.eval, shiftZ]
  ring

/-- Closed affine line-integral formula along an oriented coordinate edge. -/
def edgeAngleX (C : AffineConnection3) (h : ℝ) (p : Point3) : ℝ :=
  h * C.ax.eval p + h ^ 2 / 2 * C.ax.dx

def edgeAngleY (C : AffineConnection3) (h : ℝ) (p : Point3) : ℝ :=
  h * C.ay.eval p + h ^ 2 / 2 * C.ay.dy

def edgeAngleZ (C : AffineConnection3) (h : ℝ) (p : Point3) : ℝ :=
  h * C.az.eval p + h ^ 2 / 2 * C.az.dz

/-- The `U(1)` link generated by the affine edge angle. -/
def linkX (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  Circle.exp (edgeAngleX C h p)

def linkY (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  Circle.exp (edgeAngleY C h p)

def linkZ (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  Circle.exp (edgeAngleZ C h p)

/-- Exact additivity of an affine line integral under bisection. -/
theorem edgeAngleX_half_add (C : AffineConnection3) (h : ℝ) (p : Point3) :
    edgeAngleX C (h / 2) (shiftX (h / 2) p) + edgeAngleX C (h / 2) p =
      edgeAngleX C h p := by
  simp [edgeAngleX]
  ring

theorem edgeAngleY_half_add (C : AffineConnection3) (h : ℝ) (p : Point3) :
    edgeAngleY C (h / 2) (shiftY (h / 2) p) + edgeAngleY C (h / 2) p =
      edgeAngleY C h p := by
  simp [edgeAngleY]
  ring

theorem edgeAngleZ_half_add (C : AffineConnection3) (h : ℝ) (p : Point3) :
    edgeAngleZ C (h / 2) (shiftZ (h / 2) p) + edgeAngleZ C (h / 2) p =
      edgeAngleZ C h p := by
  simp [edgeAngleZ]
  ring

/-- The ordered product of the two generated half-links is exactly the full link. -/
theorem linkX_half_product (C : AffineConnection3) (h : ℝ) (p : Point3) :
    linkX C (h / 2) (shiftX (h / 2) p) * linkX C (h / 2) p =
      linkX C h p := by
  unfold linkX
  rw [← Circle.exp_add]
  exact congrArg Circle.exp (edgeAngleX_half_add C h p)

theorem linkY_half_product (C : AffineConnection3) (h : ℝ) (p : Point3) :
    linkY C (h / 2) (shiftY (h / 2) p) * linkY C (h / 2) p =
      linkY C h p := by
  unfold linkY
  rw [← Circle.exp_add]
  exact congrArg Circle.exp (edgeAngleY_half_add C h p)

theorem linkZ_half_product (C : AffineConnection3) (h : ℝ) (p : Point3) :
    linkZ C (h / 2) (shiftZ (h / 2) p) * linkZ C (h / 2) p =
      linkZ C h p := by
  unfold linkZ
  rw [← Circle.exp_add]
  exact congrArg Circle.exp (edgeAngleZ_half_add C h p)

/-! ## Constant curvature of the affine connection -/

/-- Coordinate curvature components `F_ij = ∂ᵢ Aⱼ - ∂ⱼ Aᵢ`. -/
def curvatureXY (C : AffineConnection3) : ℝ := C.ay.dx - C.ax.dy
def curvatureXZ (C : AffineConnection3) : ℝ := C.az.dx - C.ax.dz
def curvatureYZ (C : AffineConnection3) : ℝ := C.az.dy - C.ay.dz

/-- Two-edge paths across an elementary coordinate face. -/
def pathXY (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkY C h (shiftX h p) * linkX C h p

def pathYX (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkX C h (shiftY h p) * linkY C h p

def pathXZ (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkZ C h (shiftX h p) * linkX C h p

def pathZX (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkX C h (shiftZ h p) * linkZ C h p

def pathYZ (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkZ C h (shiftY h p) * linkY C h p

def pathZY (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  linkY C h (shiftZ h p) * linkZ C h p

/-- Oriented elementary plaquettes. -/
def plaquetteXY (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  pathXY C h p / pathYX C h p

def plaquetteXZ (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  pathXZ C h p / pathZX C h p

def plaquetteYZ (C : AffineConnection3) (h : ℝ) (p : Point3) : Circle :=
  pathYZ C h p / pathZY C h p

/-- Exact affine Stokes formulas: each plaquette is the exponential of area times curvature. -/
theorem plaquetteXY_eq_exp_curvature (C : AffineConnection3) (h : ℝ) (p : Point3) :
    plaquetteXY C h p = Circle.exp (h ^ 2 * curvatureXY C) := by
  unfold plaquetteXY pathXY pathYX linkX linkY
  rw [← Circle.exp_add, ← Circle.exp_add, ← Circle.exp_sub]
  congr 1
  simp [edgeAngleX, edgeAngleY, curvatureXY]
  ring

theorem plaquetteXZ_eq_exp_curvature (C : AffineConnection3) (h : ℝ) (p : Point3) :
    plaquetteXZ C h p = Circle.exp (h ^ 2 * curvatureXZ C) := by
  unfold plaquetteXZ pathXZ pathZX linkX linkZ
  rw [← Circle.exp_add, ← Circle.exp_add, ← Circle.exp_sub]
  congr 1
  simp [edgeAngleX, edgeAngleZ, curvatureXZ]
  ring

theorem plaquetteYZ_eq_exp_curvature (C : AffineConnection3) (h : ℝ) (p : Point3) :
    plaquetteYZ C h p = Circle.exp (h ^ 2 * curvatureYZ C) := by
  unfold plaquetteYZ pathYZ pathZY linkY linkZ
  rw [← Circle.exp_add, ← Circle.exp_add, ← Circle.exp_sub]
  congr 1
  simp [edgeAngleY, edgeAngleZ, curvatureYZ]
  ring

/-- Elementary unit-circle exponential estimate. -/
theorem norm_circleExp_sub_one_le (t : ℝ) :
    ‖(Circle.exp t : ℂ) - 1‖ ≤ |t| := by
  rw [Circle.coe_exp]
  simpa [mul_comm, Real.norm_eq_abs] using
    (Real.norm_exp_I_mul_ofReal_sub_one_le (x := t))

/-- Exact affine Stokes plus the exponential estimate gives quadratic plaquette scaling. -/
theorem norm_plaquetteXY_sub_one_le (C : AffineConnection3) (h : ℝ) (p : Point3) :
    ‖(plaquetteXY C h p : ℂ) - 1‖ ≤ |h ^ 2 * curvatureXY C| := by
  rw [plaquetteXY_eq_exp_curvature]
  exact norm_circleExp_sub_one_le _

theorem norm_plaquetteXZ_sub_one_le (C : AffineConnection3) (h : ℝ) (p : Point3) :
    ‖(plaquetteXZ C h p : ℂ) - 1‖ ≤ |h ^ 2 * curvatureXZ C| := by
  rw [plaquetteXZ_eq_exp_curvature]
  exact norm_circleExp_sub_one_le _

theorem norm_plaquetteYZ_sub_one_le (C : AffineConnection3) (h : ℝ) (p : Point3) :
    ‖(plaquetteYZ C h p : ℂ) - 1‖ ≤ |h ^ 2 * curvatureYZ C| := by
  rw [plaquetteYZ_eq_exp_curvature]
  exact norm_circleExp_sub_one_le _


/-! ## Connection-generated cubical data -/

/-- Convert a Boolean child coordinate into a physical displacement. -/
def bitDisplacement (b : Bool) (h : ℝ) : ℝ := if b then h else 0

/-- Physical point represented by a vertex of the refined elementary cube. -/
def cubePoint (p : Point3) (h : ℝ) (bx bY bz : Bool) : Point3 :=
  ⟨p.x + bitDisplacement bx h,
   p.y + bitDisplacement bY h,
   p.z + bitDisplacement bz h⟩

@[simp] theorem shiftX_cubePoint_false (p : Point3) (h : ℝ) (bY bz : Bool) :
    shiftX h (cubePoint p h false bY bz) = cubePoint p h true bY bz := by
  simp [shiftX, cubePoint, bitDisplacement]

@[simp] theorem shiftY_cubePoint_false (p : Point3) (h : ℝ) (bx bz : Bool) :
    shiftY h (cubePoint p h bx false bz) = cubePoint p h bx true bz := by
  simp [shiftY, cubePoint, bitDisplacement]

@[simp] theorem shiftZ_cubePoint_false (p : Point3) (h : ℝ) (bx bY : Bool) :
    shiftZ h (cubePoint p h bx bY false) = cubePoint p h bx bY true := by
  simp [shiftZ, cubePoint, bitDisplacement]

/-- The twelve elementary links generated by the affine connection on one cube. -/
def affineCubeLinks (C : AffineConnection3) (h : ℝ) (p : Point3) : CubeLinks where
  edgeX := fun bY bz => linkX C h (cubePoint p h false bY bz)
  edgeY := fun bx bz => linkY C h (cubePoint p h bx false bz)
  edgeZ := fun bx bY => linkZ C h (cubePoint p h bx bY false)

/-- Every `xy` face of an affine cell has the same constant-curvature holonomy. -/
theorem affineCubeLinks_plaquetteXY (C : AffineConnection3) (h : ℝ)
    (p : Point3) (z : Bool) :
    (affineCubeLinks C h p).plaquetteXY z =
      Circle.exp (h ^ 2 * curvatureXY C) := by
  simpa [CubeLinks.plaquetteXY, CubeLinks.pathXY, CubeLinks.pathYX,
    affineCubeLinks, plaquetteXY, pathXY, pathYX] using
    (plaquetteXY_eq_exp_curvature C h (cubePoint p h false false z))

/-- Every `xz` face of an affine cell has the same constant-curvature holonomy. -/
theorem affineCubeLinks_plaquetteXZ (C : AffineConnection3) (h : ℝ)
    (p : Point3) (y : Bool) :
    (affineCubeLinks C h p).plaquetteXZ y =
      Circle.exp (h ^ 2 * curvatureXZ C) := by
  simpa [CubeLinks.plaquetteXZ, CubeLinks.pathXZ, CubeLinks.pathZX,
    affineCubeLinks, plaquetteXZ, pathXZ, pathZX] using
    (plaquetteXZ_eq_exp_curvature C h (cubePoint p h false y false))

/-- Every `yz` face of an affine cell has the same constant-curvature holonomy. -/
theorem affineCubeLinks_plaquetteYZ (C : AffineConnection3) (h : ℝ)
    (p : Point3) (x : Bool) :
    (affineCubeLinks C h p).plaquetteYZ x =
      Circle.exp (h ^ 2 * curvatureYZ C) := by
  simpa [CubeLinks.plaquetteYZ, CubeLinks.pathYZ, CubeLinks.pathZY,
    affineCubeLinks, plaquetteYZ, pathYZ, pathZY] using
    (plaquetteYZ_eq_exp_curvature C h (cubePoint p h x false false))

/-- The curvature coefficient forced by the five-face Block 32 budget. -/
def affineCurvatureAmplitude (C : AffineConnection3) : ℝ :=
  |curvatureXY C| + 2 * |curvatureXZ C| + 2 * |curvatureYZ C|

theorem affineCurvatureAmplitude_nonneg (C : AffineConnection3) :
    0 ≤ affineCurvatureAmplitude C := by
  unfold affineCurvatureAmplitude
  positivity

/-- The checked five-face curvature budget is quadratically small in the mesh. -/
theorem curvatureBudget_affineCubeLinks_le (C : AffineConnection3) (h : ℝ)
    (p : Point3) :
    curvatureBudget (affineCubeLinks C h p) ≤
      h ^ 2 * affineCurvatureAmplitude C := by
  unfold curvatureBudget
  rw [affineCubeLinks_plaquetteXY, affineCubeLinks_plaquetteXZ,
    affineCubeLinks_plaquetteYZ, affineCubeLinks_plaquetteYZ,
    affineCubeLinks_plaquetteXZ]
  calc
    ‖(Circle.exp (h ^ 2 * curvatureXY C) : ℂ) - 1‖ +
        ‖(Circle.exp (h ^ 2 * curvatureXZ C) : ℂ) - 1‖ +
        ‖(Circle.exp (h ^ 2 * curvatureYZ C) : ℂ) - 1‖ +
        ‖(Circle.exp (h ^ 2 * curvatureYZ C) : ℂ) - 1‖ +
        ‖(Circle.exp (h ^ 2 * curvatureXZ C) : ℂ) - 1‖ ≤
      |h ^ 2 * curvatureXY C| +
        |h ^ 2 * curvatureXZ C| +
        |h ^ 2 * curvatureYZ C| +
        |h ^ 2 * curvatureYZ C| +
        |h ^ 2 * curvatureXZ C| := by
          gcongr <;> exact norm_circleExp_sub_one_le _
    _ = h ^ 2 * affineCurvatureAmplitude C := by
      simp only [abs_mul, abs_of_nonneg (sq_nonneg h)]
      unfold affineCurvatureAmplitude
      ring

/-! ## Insertion into the complete Block 32 Hilbert defect theorem -/

@[simp] theorem edgeRatioSup_self {Site : Type u} [Fintype Site] [Nonempty Site]
    (u : Link (Site := Site)) : edgeRatioSup u u = 0 := by
  simp [edgeRatioSup, edgeRatio]

@[simp] theorem hilbertEdgeBudget_self {Site : Type u} [Fintype Site]
    [Nonempty Site] (ux uy uz : Link (Site := Site)) :
    hilbertEdgeBudget ux uy uz ux uy uz = 0 := by
  simp [hilbertEdgeBudget]

/-! ### Actual connection-generated coarse links and ordered half-link products -/

/-- Coarse `x` link obtained by sampling the affine connection at a finite site's
physical coordinate. -/
def affineCoarseLinkXOn {Site : Type u} (C : AffineConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) :=
  fun s => linkX C h (pos s)

def affineCoarseLinkYOn {Site : Type u} (C : AffineConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) :=
  fun s => linkY C h (pos s)

def affineCoarseLinkZOn {Site : Type u} (C : AffineConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) :=
  fun s => linkZ C h (pos s)

/-- Ordered product of the two generated `x` half-links over each finite site. -/
def affineHalfProductLinkXOn {Site : Type u} (C : AffineConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) :=
  fun s => linkX C (h / 2) (shiftX (h / 2) (pos s)) *
    linkX C (h / 2) (pos s)

def affineHalfProductLinkYOn {Site : Type u} (C : AffineConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) :=
  fun s => linkY C (h / 2) (shiftY (h / 2) (pos s)) *
    linkY C (h / 2) (pos s)

def affineHalfProductLinkZOn {Site : Type u} (C : AffineConnection3) (h : ℝ)
    (pos : Site → Point3) : Link (Site := Site) :=
  fun s => linkZ C (h / 2) (shiftZ (h / 2) (pos s)) *
    linkZ C (h / 2) (pos s)

@[simp] theorem affineHalfProductLinkXOn_eq_coarse {Site : Type u}
    (C : AffineConnection3) (h : ℝ) (pos : Site → Point3) :
    affineHalfProductLinkXOn C h pos = affineCoarseLinkXOn C h pos := by
  funext s
  exact linkX_half_product C h (pos s)

@[simp] theorem affineHalfProductLinkYOn_eq_coarse {Site : Type u}
    (C : AffineConnection3) (h : ℝ) (pos : Site → Point3) :
    affineHalfProductLinkYOn C h pos = affineCoarseLinkYOn C h pos := by
  funext s
  exact linkY_half_product C h (pos s)

@[simp] theorem affineHalfProductLinkZOn_eq_coarse {Site : Type u}
    (C : AffineConnection3) (h : ℝ) (pos : Site → Point3) :
    affineHalfProductLinkZOn C h pos = affineCoarseLinkZOn C h pos := by
  funext s
  exact linkZ_half_product C h (pos s)

/-- Direct Block 32 estimate for the actual links generated by affine line
integrals.  The straight-edge budget vanishes by exact bisection, leaving only
the quadratic plaquette/gluing term. -/
theorem norm_affineGeneratedCombinedHilbertDefect_le
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site)
    (pos : Site → Point3)
    (C : AffineConnection3) (h : ℝ) (p : Point3)
    (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
    ‖combinedHilbertDefect m₀ m₁ τx τy τz
      (affineHalfProductLinkXOn C h pos)
      (affineHalfProductLinkYOn C h pos)
      (affineHalfProductLinkZOn C h pos)
      (affineCoarseLinkXOn C h pos)
      (affineCoarseLinkYOn C h pos)
      (affineCoarseLinkZOn C h pos)
      (affineCubeLinks C h p)‖ ≤
      h ^ 2 * affineCurvatureAmplitude C := by
  simp only [affineHalfProductLinkXOn_eq_coarse,
    affineHalfProductLinkYOn_eq_coarse, affineHalfProductLinkZOn_eq_coarse]
  calc
    ‖combinedHilbertDefect m₀ m₁ τx τy τz
      (affineCoarseLinkXOn C h pos) (affineCoarseLinkYOn C h pos)
      (affineCoarseLinkZOn C h pos)
      (affineCoarseLinkXOn C h pos) (affineCoarseLinkYOn C h pos)
      (affineCoarseLinkZOn C h pos) (affineCubeLinks C h p)‖ ≤
        hilbertEdgeBudget
          (affineCoarseLinkXOn C h pos) (affineCoarseLinkYOn C h pos)
          (affineCoarseLinkZOn C h pos)
          (affineCoarseLinkXOn C h pos) (affineCoarseLinkYOn C h pos)
          (affineCoarseLinkZOn C h pos) +
          curvatureBudget (affineCubeLinks C h p) :=
      norm_combinedHilbertDefect_le m₀ m₁ τx τy τz
        (affineCoarseLinkXOn C h pos) (affineCoarseLinkYOn C h pos)
        (affineCoarseLinkZOn C h pos)
        (affineCoarseLinkXOn C h pos) (affineCoarseLinkYOn C h pos)
        (affineCoarseLinkZOn C h pos) (affineCubeLinks C h p) hm₀ hm₁
    _ = curvatureBudget (affineCubeLinks C h p) := by simp
    _ ≤ h ^ 2 * affineCurvatureAmplitude C :=
      curvatureBudget_affineCubeLinks_le C h p

/-- For links reconstructed exactly from affine half-edge integrals, only the
curvature/gluing channel remains in the complete Block 32 estimate. -/
theorem norm_affineCombinedHilbertDefect_le
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site)
    (ux uy uz : Link (Site := Site))
    (C : AffineConnection3) (h : ℝ) (p : Point3)
    (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
    ‖combinedHilbertDefect m₀ m₁ τx τy τz
      ux uy uz ux uy uz (affineCubeLinks C h p)‖ ≤
      h ^ 2 * affineCurvatureAmplitude C := by
  calc
    ‖combinedHilbertDefect m₀ m₁ τx τy τz
      ux uy uz ux uy uz (affineCubeLinks C h p)‖ ≤
        hilbertEdgeBudget ux uy uz ux uy uz +
          curvatureBudget (affineCubeLinks C h p) :=
      norm_combinedHilbertDefect_le m₀ m₁ τx τy τz
        ux uy uz ux uy uz (affineCubeLinks C h p) hm₀ hm₁
    _ = curvatureBudget (affineCubeLinks C h p) := by simp
    _ ≤ h ^ 2 * affineCurvatureAmplitude C :=
      curvatureBudget_affineCubeLinks_le C h p


/-- Vanishing affine curvature makes the connection-generated child cube flat. -/
theorem affineCubeLinks_flat_of_curvature_eq_zero
    (C : AffineConnection3) (h : ℝ) (p : Point3)
    (hxy : curvatureXY C = 0) (hxz : curvatureXZ C = 0)
    (hyz : curvatureYZ C = 0) :
    (affineCubeLinks C h p).Flat := by
  constructor
  · intro z
    rw [affineCubeLinks_plaquetteXY, hxy]
    simp
  · intro y
    rw [affineCubeLinks_plaquetteXZ, hxz]
    simp
  · intro x
    rw [affineCubeLinks_plaquetteYZ, hyz]
    simp

/-- Exact half-edge reconstruction and zero affine curvature annihilate the
complete edge-plus-gluing Hilbert defect. -/
theorem affineCombinedHilbertDefect_eq_zero_of_flat
    {Site : Type u} [Fintype Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site)
    (ux uy uz : Link (Site := Site))
    (C : AffineConnection3) (h : ℝ) (p : Point3)
    (hxy : curvatureXY C = 0) (hxz : curvatureXZ C = 0)
    (hyz : curvatureYZ C = 0) :
    combinedHilbertDefect m₀ m₁ τx τy τz
      ux uy uz ux uy uz (affineCubeLinks C h p) = 0 := by
  exact combinedHilbertDefect_eq_zero_of_exact_flat
    m₀ m₁ τx τy τz ux uy uz (affineCubeLinks C h p)
    (affineCubeLinks_flat_of_curvature_eq_zero C h p hxy hxz hyz)

/-! ## Explicit dyadic quadratic regime -/

/-- Quadratic curvature budget along the physical dyadic mesh. -/
def affineDyadicBudget (C : AffineConnection3) (a₀ : ℝ) (n : ℕ) : ℝ :=
  (dyadicMesh a₀ n) ^ 2 * affineCurvatureAmplitude C

/-- Closed geometric-series form of the affine dyadic budget. -/
theorem affineDyadicBudget_eq (C : AffineConnection3) (a₀ : ℝ) (n : ℕ) :
    affineDyadicBudget C a₀ n =
      (a₀ ^ 2 * affineCurvatureAmplitude C) * ((4 : ℝ)⁻¹) ^ n := by
  unfold affineDyadicBudget dyadicMesh
  have hpow : (((2 : ℝ)⁻¹) ^ n) ^ 2 = ((4 : ℝ)⁻¹) ^ n := by
    rw [pow_two, ← mul_pow]
    norm_num
  rw [mul_pow, hpow]
  ring

/-- Quadratic affine-curvature errors are summable on the dyadic hierarchy. -/
theorem summable_affineDyadicBudget (C : AffineConnection3) (a₀ : ℝ) :
    Summable (affineDyadicBudget C a₀) := by
  have hgeom : Summable (fun n : ℕ => ((4 : ℝ)⁻¹) ^ n) :=
    summable_geometric_of_norm_lt_one (by norm_num)
  rw [show affineDyadicBudget C a₀ = fun n =>
    (a₀ ^ 2 * affineCurvatureAmplitude C) * ((4 : ℝ)⁻¹) ^ n by
      funext n
      exact affineDyadicBudget_eq C a₀ n]
  exact hgeom.mul_left (a₀ ^ 2 * affineCurvatureAmplitude C)

/-- The concrete affine curvature budget tends to zero quadratically. -/
theorem tendsto_affineDyadicBudget_zero (C : AffineConnection3) (a₀ : ℝ) :
    Tendsto (affineDyadicBudget C a₀) atTop (𝓝 0) := by
  rw [show affineDyadicBudget C a₀ = fun n =>
    (a₀ ^ 2 * affineCurvatureAmplitude C) * ((4 : ℝ)⁻¹) ^ n by
      funext n
      exact affineDyadicBudget_eq C a₀ n]
  have hpow : Tendsto (fun n : ℕ => ((4 : ℝ)⁻¹) ^ n) atTop (𝓝 0) :=
    tendsto_pow_atTop_nhds_zero_of_norm_lt_one (by norm_num)
  simpa only [mul_zero] using
    hpow.const_mul (a₀ ^ 2 * affineCurvatureAmplitude C)


/-- Dyadic specialization of the complete Hilbert defect estimate. -/
theorem norm_affineCombinedHilbertDefect_dyadic_le
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site)
    (ux uy uz : Link (Site := Site))
    (C : AffineConnection3) (a₀ : ℝ) (p : Point3)
    (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) (n : ℕ) :
    ‖combinedHilbertDefect m₀ m₁ τx τy τz ux uy uz ux uy uz
      (affineCubeLinks C (dyadicMesh a₀ n) p)‖ ≤
      affineDyadicBudget C a₀ n := by
  exact norm_affineCombinedHilbertDefect_le
    m₀ m₁ τx τy τz ux uy uz C (dyadicMesh a₀ n) p hm₀ hm₁

/-- The actual connection-generated complete Hilbert operator defects form a
summable sequence along dyadic refinement. -/
theorem summable_norm_affineCombinedHilbertDefect_dyadic
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site)
    (ux uy uz : Link (Site := Site))
    (C : AffineConnection3) (a₀ : ℝ) (p : Point3)
    (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
    Summable (fun n =>
      ‖combinedHilbertDefect m₀ m₁ τx τy τz ux uy uz ux uy uz
        (affineCubeLinks C (dyadicMesh a₀ n) p)‖) := by
  exact Summable.of_nonneg_of_le
    (fun _ => norm_nonneg _)
    (fun n => norm_affineCombinedHilbertDefect_dyadic_le
      m₀ m₁ τx τy τz ux uy uz C a₀ p hm₀ hm₁ n)
    (summable_affineDyadicBudget C a₀)

/-- Dyadic estimate for the actual affine connection-generated link triples. -/
theorem norm_affineGeneratedCombinedHilbertDefect_dyadic_le
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site)
    (pos : Site → Point3)
    (C : AffineConnection3) (a₀ : ℝ) (p : Point3)
    (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) (n : ℕ) :
    ‖combinedHilbertDefect m₀ m₁ τx τy τz
      (affineHalfProductLinkXOn C (dyadicMesh a₀ n) pos)
      (affineHalfProductLinkYOn C (dyadicMesh a₀ n) pos)
      (affineHalfProductLinkZOn C (dyadicMesh a₀ n) pos)
      (affineCoarseLinkXOn C (dyadicMesh a₀ n) pos)
      (affineCoarseLinkYOn C (dyadicMesh a₀ n) pos)
      (affineCoarseLinkZOn C (dyadicMesh a₀ n) pos)
      (affineCubeLinks C (dyadicMesh a₀ n) p)‖ ≤
      affineDyadicBudget C a₀ n := by
  exact norm_affineGeneratedCombinedHilbertDefect_le
    m₀ m₁ τx τy τz pos C (dyadicMesh a₀ n) p hm₀ hm₁

/-- The actual affine line-integral refinement defects are summable along the
dyadic hierarchy. -/
theorem summable_norm_affineGeneratedCombinedHilbertDefect_dyadic
    {Site : Type u} [Fintype Site] [Nonempty Site]
    (m₀ m₁ : HilbertState Site →L[ℂ] HilbertState Site)
    (τx τy τz : Site ≃ Site)
    (pos : Site → Point3)
    (C : AffineConnection3) (a₀ : ℝ) (p : Point3)
    (hm₀ : ‖m₀‖ ≤ 1) (hm₁ : ‖m₁‖ ≤ 1) :
    Summable (fun n =>
      ‖combinedHilbertDefect m₀ m₁ τx τy τz
        (affineHalfProductLinkXOn C (dyadicMesh a₀ n) pos)
        (affineHalfProductLinkYOn C (dyadicMesh a₀ n) pos)
        (affineHalfProductLinkZOn C (dyadicMesh a₀ n) pos)
        (affineCoarseLinkXOn C (dyadicMesh a₀ n) pos)
        (affineCoarseLinkYOn C (dyadicMesh a₀ n) pos)
        (affineCoarseLinkZOn C (dyadicMesh a₀ n) pos)
        (affineCubeLinks C (dyadicMesh a₀ n) p)‖) := by
  exact Summable.of_nonneg_of_le
    (fun _ => norm_nonneg _)
    (fun n => norm_affineGeneratedCombinedHilbertDefect_dyadic_le
      m₀ m₁ τx τy τz pos C a₀ p hm₀ hm₁ n)
    (summable_affineDyadicBudget C a₀)

/-! ## Concrete constant magnetic-field witness -/

/-- Affine gauge potential `A_y = B x`, with uniform `F_xy = B`. -/
def uniformBzConnection (B : ℝ) : AffineConnection3 where
  ax := ⟨0, 0, 0, 0⟩
  ay := ⟨0, B, 0, 0⟩
  az := ⟨0, 0, 0, 0⟩

@[simp] theorem uniformBz_curvatureXY (B : ℝ) :
    curvatureXY (uniformBzConnection B) = B := by
  simp [curvatureXY, uniformBzConnection]

@[simp] theorem uniformBz_curvatureXZ (B : ℝ) :
    curvatureXZ (uniformBzConnection B) = 0 := by
  simp [curvatureXZ, uniformBzConnection]

@[simp] theorem uniformBz_curvatureYZ (B : ℝ) :
    curvatureYZ (uniformBzConnection B) = 0 := by
  simp [curvatureYZ, uniformBzConnection]

@[simp] theorem uniformBz_affineCurvatureAmplitude (B : ℝ) :
    affineCurvatureAmplitude (uniformBzConnection B) = |B| := by
  simp [affineCurvatureAmplitude]

/-- Uniform magnetic flux gives the exact elementary plaquette phase
`exp(i h² B)`. -/
theorem uniformBz_plaquetteXY (B h : ℝ) (p : Point3) :
    plaquetteXY (uniformBzConnection B) h p = Circle.exp (h ^ 2 * B) := by
  simpa using plaquetteXY_eq_exp_curvature (uniformBzConnection B) h p

/-- A unit cell with flux angle `π` is explicitly nonflat. -/
theorem uniformBz_pi_unit_plaquette_ne_one (p : Point3) :
    plaquetteXY (uniformBzConnection Real.pi) 1 p ≠ 1 := by
  rw [uniformBz_plaquetteXY]
  norm_num
  exact Circle.exp_pi_ne_one

variable {Y : Type u} [MetricSpace Y] [CompleteSpace Y]

/-- Global convergence for a hierarchy whose adjacent reconstruction error is
controlled by the connection-derived quadratic plaquette budget. -/
theorem tendsto_affineConnectionLimit (f : ℕ → Y)
    (C : AffineConnection3) (a₀ : ℝ)
    (hstep : ∀ n, dist (f n) (f n.succ) ≤ affineDyadicBudget C a₀ n) :
    Tendsto f atTop
      (𝓝 ((twoBudgetSummableDefect f (fun _ => 0)
        (affineDyadicBudget C a₀) summable_zero
        (summable_affineDyadicBudget C a₀) (by
          intro n
          simpa [combinedScaleBudget] using hstep n)).limit)) := by
  let hcombined : ∀ n, dist (f n) (f n.succ) ≤
      combinedScaleBudget (fun _ => 0) (affineDyadicBudget C a₀) n := by
    intro n
    simpa [combinedScaleBudget] using hstep n
  exact tendsto_twoBudgetLimit f (fun _ => 0) (affineDyadicBudget C a₀)
    summable_zero (summable_affineDyadicBudget C a₀) hcombined

/-- Quantitative tail control in the affine connection regime. -/
theorem dist_affineConnectionLimit_le_tail (f : ℕ → Y)
    (C : AffineConnection3) (a₀ : ℝ)
    (hstep : ∀ n, dist (f n) (f n.succ) ≤ affineDyadicBudget C a₀ n)
    (n : ℕ) :
    dist (f n)
      ((twoBudgetSummableDefect f (fun _ => 0)
        (affineDyadicBudget C a₀) summable_zero
        (summable_affineDyadicBudget C a₀) (by
          intro k
          simpa [combinedScaleBudget] using hstep k)).limit) ≤
      ∑' m : ℕ, affineDyadicBudget C a₀ (n + m) := by
  simpa [combinedScaleBudget] using
    (dist_twoBudgetLimit_le_tail f (fun _ => 0)
      (affineDyadicBudget C a₀) summable_zero
      (summable_affineDyadicBudget C a₀) (by
        intro k
        simpa [combinedScaleBudget] using hstep k) n)

