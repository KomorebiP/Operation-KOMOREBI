      "id": "correctness-F001",
      "lane": "correctness",
      "title": "Failure of the sufficient margin does not make existence unresolved",
      "severity": "moderate",
      "type": "overbroad-statement",
      "confidence": 0.99,
      "location": "chemistry_stage14/RECOVERY_THEOREM.md:79-80",
      "quote": "If this\ncondition fails under nonzero noise, positivity feasibility is unresolved;",
      "analysis": "Take Y=0 and epsilon>0. Least squares gives Hhat=0 and Chat=0. The estimate itself is a compatible positive-integral solution, while Chat-r_H I/4 is not PSD. The quoted blanket existence conclusion fails. The retained decoder already returns true in this case, so this is a local statement defect, not failure of the recovery theorem.",
      "suggested_fix": "Separate existence from an all-compatible guarantee. State the PSD-estimate case, the non-PSD singleton case, and the genuinely unresolved case.",
      "unit_id": "sha256:4e738c4f3d32e94de45cc1d46c8703551a9e851e2b27326f942e054d84e8269a:3",
      "reviewer": "correctness"
    }
