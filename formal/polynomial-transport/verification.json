    "KomorebiPolynomial/FallingFactorial.lean",
    "KomorebiPolynomial/FallingPackets.lean",
    "KomorebiPolynomial/RootsOfUnity.lean",
    "KomorebiPolynomial/FourierBridge.lean",
    "KomorebiPolynomial/FallingProduct.lean"
  ],
