    "generation_every_steps": 4000,
    "resume_every_steps": 500,
    "heldout_loss_samples": 0,
    "heldout_generation_samples": 1024,
    "curriculum_stages": [
      {
        "name": "digits_1_2",
        "end_step": 1000,
