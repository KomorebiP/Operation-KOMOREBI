      },
      {
        "name": "digits_1_3",
        "end_step": 4000,
        "difficulties": [1, 2, 3],
        "operations": ["add", "div_exact", "mul", "sub"]
      },
      {
        "name": "digits_1_4",
        "end_step": 9000,
        "difficulties": [1, 2, 3, 4],
        "operations": ["add", "div_exact", "mul", "sub"]
      },
      {
        "name": "digits_1_5",
        "end_step": 20000,
        "difficulties": [1, 2, 3, 4, 5],
        "operations": ["add", "div_exact", "mul", "sub"]
      }
    ]
  },
  "probe": {
    "checkpoint_steps": [0, 1000, 4000, 9000, 14000, 20000],
    "rank": 8,
    "layer": 4,
    "activation_samples": 256,
    "gradient_samples": 64,
    "jacobian_projections": 8,
    "random_controls": 24,
    "batch_size": 8,
