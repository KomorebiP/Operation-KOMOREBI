{
  "experiment_name": "arithmetic_jspace_deep_symbolic_v1",
  "data_config": "configs/deep_symbolic.json",
  "arms": [
    {
      "name": "symbolic_correct",
      "regime": "symbolic_answer",
      "control": "correct",
      "matched_control": true,
      "stream_key": "symbolic_primary"
    },
    {
      "name": "symbolic_shuffled",
      "regime": "symbolic_answer",
      "control": "shuffled",
      "matched_control": true,
      "stream_key": "symbolic_primary"
    }
  ],
  "model": {
