# Keep the exact hashed program/manuscript inputs portable between checkouts.
.gitattributes text eol=lf
examples/euler_packets.py text eol=lf
examples/euler_polyphase_taps.py text eol=lf
manifests/euler-packets-worked-example-2026-10-29.json text eol=lf
tools/check_euler_case.py text eol=lf
docs/demonstrations/EULER_PACKETS.md text eol=lf
manifests/reader-site-libraries.json text eol=lf
verification/euler-packets/** text eol=lf
# Preserve the exact bytes captured by the bounded computation runners.
verification/euler-packets/run-*/** -text !eol
verification/euler-packets/cross-check-*/** -text !eol
verification/euler-packets/polyphase-taps-*/** -text !eol

# Preserve the completion check runner records exactly.
verification/euler-packets/completion-*/** -text !eol
verification/euler-packets/completion-contract-*.json -text !eol
