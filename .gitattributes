# Keep the exact hashed program/manuscript inputs portable between checkouts.
.gitattributes text eol=lf
examples/euler_packets.py text eol=lf
examples/euler_polyphase_taps.py text eol=lf
manifests/euler-packets-worked-example-2026-10-29.json text eol=lf
tools/check_euler_case.py text eol=lf
docs/demonstrations/EULER_PACKETS.md text eol=lf
manifests/reader-site-libraries.json text eol=lf
verification/euler-packets/** text eol=lf
# Preserve the exact bytes captured by the bounded computation runners.
verification/euler-packets/run-*/** -text !eol
verification/euler-packets/cross-check-*/** -text !eol
verification/euler-packets/polyphase-taps-*/** -text !eol

# Preserve the completion check runner records exactly.
verification/euler-packets/completion-*/** -text !eol
verification/euler-packets/completion-contract-*.json -text !eol

# Keep the manuscript-bound proofreading note identical across platforms.
verification/demonstrations/PROOFREADING_2026-11-01.txt text eol=lf

# Preserve the exact Smith proof, source-binding, and computation-run bytes.
research/smith-chart/completion-formal/** -text !eol whitespace=cr-at-eol
research/smith-chart/computations/check_completion_boundary.py -text !eol
research/smith-chart/computations/derive_candidate_142.py -text !eol
research/smith-chart/computations/*-contract.json -text !eol
research/smith-chart/computations/verification/candidate-142-system-001/** -text !eol whitespace=cr-at-eol
research/smith-chart/computations/verification/completion-boundary-003/** -text !eol whitespace=cr-at-eol
research/smith-chart/edition/** -text !eol whitespace=cr-at-eol
research/smith-chart/edition/figures/*.svg linguist-generated=true
# The author/review metadata uses intentional Markdown hard line breaks.
docs/demonstrations/SMITH_SINGULAR_COMPLETION.md -text !eol whitespace=-blank-at-eol
docs/demonstrations/figures/smith-two-packet-feasibility.svg -text !eol
research/smith-chart/edition/*.md whitespace=-blank-at-eol,cr-at-eol
