Komorebi.Representation.Symbolic.Large.minimum_two_scalar_coordinates :
  (∃ encode,
      ∀ (x : Komorebi.Representation.Matrix.Vec Komorebi.Representation.Symbolic.Large.R 8) (w : List (Fin 2))
        (j : Fin 1),
        Komorebi.Representation.behavior
            (Komorebi.Representation.Matrix.sourceSystem Komorebi.Representation.Symbolic.Large.data) x w j =
          Komorebi.Representation.behavior
            (Komorebi.Representation.Matrix.targetSystem Komorebi.Representation.Symbolic.Large.data) (encode x) w j) ∧
    ∀ (n : Nat),
      n < 2 →
        ∀
          (U :
            Komorebi.Representation.System
              (Komorebi.Representation.Matrix.Vec Komorebi.Representation.Symbolic.Large.R n) (Fin 2) (Fin 1)
              Komorebi.Representation.Symbolic.Large.R)
          (encode :
            Komorebi.Representation.Matrix.Vec Komorebi.Representation.Symbolic.Large.R 8 →
              Komorebi.Representation.Matrix.Vec Komorebi.Representation.Symbolic.Large.R n),
          ¬∀ (x : Komorebi.Representation.Matrix.Vec Komorebi.Representation.Symbolic.Large.R 8) (w : List (Fin 2))
              (j : Fin 1),
              Komorebi.Representation.behavior
                  (Komorebi.Representation.Matrix.sourceSystem Komorebi.Representation.Symbolic.Large.data) x w j =
                Komorebi.Representation.behavior U (encode x) w j
