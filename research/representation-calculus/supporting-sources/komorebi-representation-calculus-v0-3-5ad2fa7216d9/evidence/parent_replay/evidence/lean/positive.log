Komorebi.Representation.Generated.all_words (x : Fin 256) (w : List (Fin 2)) (j : Fin 1) :
  Komorebi.Representation.behavior Komorebi.Representation.Generated.sourceSystem x w j =
    Komorebi.Representation.behavior Komorebi.Representation.Generated.targetSystem
      (Komorebi.Representation.Generated.encoder x) w j
