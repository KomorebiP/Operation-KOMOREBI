import KomorebiPadic.Arithmetic
import KomorebiPadic.IntervalGraph

/-!
# Valuation model for the Pascal predecessor mechanism

For the concrete Cartier graph one takes

`ν q k = v_p ((q + k - 1).choose k)`.

Pascal's identity and the nonarchimedean valuation inequality imply
`pascalPred` below.  This file proves all graph consequences from that exact
interface, while deliberately leaving the concrete p-adic/binomial instance as
a separate formalization obligation.
-/

namespace KomorebiPadic

/-- The valuation facts needed from the binomial family. -/
structure PascalValuationModel where
  ν : ℕ → ℕ → ℕ
  zeroOrder : ∀ q : ℕ, ν q 0 = 0
  firstQuotient : ∀ k : ℕ, ν 1 k = 0
  pascalPred :
    ∀ {q k : ℕ}, 1 < q → 0 < k →
      ν q (k - 1) ≤ ν q k ∨ ν (q - 1) k ≤ ν q k

/-- The active-edge relation attached to a valuation model. -/
def valuationEdge
    (V : PascalValuationModel) (r h q k : ℕ) : Prop :=
  ActiveAt r h k (V.ν q k)

/-- Pascal predecessor control makes the valuation edge system downward. -/
theorem valuationEdge_predecessor
    (V : PascalValuationModel) (r h : ℕ)
    {q k : ℕ} (hq1 : 1 ≤ q)
    (hedge : valuationEdge V r h q k)
    (htarget : 1 < q + k) :
    (0 < k ∧ valuationEdge V r h q (k - 1)) ∨
    (1 < q ∧ valuationEdge V r h (q - 1) k) := by
  by_cases hk0 : k = 0
  · subst k
    right
    have hq : 1 < q := by omega
    refine ⟨hq, ?_⟩
    unfold valuationEdge ActiveAt branchCost at hedge ⊢
    rw [V.zeroOrder] at hedge ⊢
    omega
  · have hk : 0 < k := Nat.pos_of_ne_zero hk0
    by_cases hqeq : q = 1
    · subst q
      left
      refine ⟨hk, ?_⟩
      unfold valuationEdge ActiveAt branchCost at hedge ⊢
      rw [V.firstQuotient] at hedge ⊢
      have hmul : (k - 1) * (h + 1) ≤ k * (h + 1) := by
        exact Nat.mul_le_mul_right (h + 1) (by omega)
      omega
    · have hq : 1 < q := by omega
      rcases V.pascalPred hq hk with hleft | hright
      · left
        refine ⟨hk, ?_⟩
        unfold valuationEdge ActiveAt branchCost at hedge ⊢
        have hmul : (k - 1) * (h + 1) ≤ k * (h + 1) := by
          exact Nat.mul_le_mul_right (h + 1) (by omega)
        omega
      · right
        refine ⟨hq, ?_⟩
        unfold valuationEdge ActiveAt branchCost at hedge ⊢
        omega

/-- The edge system generated by a Pascal valuation model. -/
def valuationEdgeSystem
    (V : PascalValuationModel) (r h : ℕ) : PredecessorEdgeSystem where
  edge := valuationEdge V r h
  predecessor := valuationEdge_predecessor V r h

/-- Layer `1` reaches every zero-carry correction order fitting the precision. -/
theorem firstQuotient_target
    (V : PascalValuationModel) {r h Q k : ℕ}
    (hQ : 1 ≤ Q) (hcost : k * (h + 1) < r) :
    IsTarget (valuationEdgeSystem V r h) Q (k + 1) := by
  refine ⟨1, k, by omega, hQ, ?_, by omega⟩
  change ActiveAt r h k (V.ν 1 k)
  unfold ActiveAt branchCost
  rw [V.firstQuotient]
  omega

/-- Consequently every order up to `coarseK` is produced from quotient state `1`. -/
theorem firstQuotient_reaches_coarseK
    (V : PascalValuationModel) {r h Q k : ℕ}
    (hr : 0 < r) (hQ : 1 ≤ Q) (hk : k ≤ coarseK r h) :
    IsTarget (valuationEdgeSystem V r h) Q (k + 1) := by
  apply firstQuotient_target V hQ
  exact visible_cost_lt_of_le_coarseK hr hk

/-- Any target forces the complete interval below it. -/
theorem valuation_targets_form_initial_interval
    (V : PascalValuationModel) {r h Q M : ℕ}
    (hM : IsTarget (valuationEdgeSystem V r h) Q M) :
    ∀ s : ℕ, 1 ≤ s → s ≤ M →
      IsTarget (valuationEdgeSystem V r h) Q s := by
  exact target_interval_property (valuationEdgeSystem V r h) hM

end KomorebiPadic
