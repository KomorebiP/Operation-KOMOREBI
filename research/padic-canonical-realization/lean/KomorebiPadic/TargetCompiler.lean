import KomorebiPadic.SuffixWindow

/-!
# Exact finite target-membership compiler

For a fixed target layer `t`, every witness has the form `q + k = t` with
`1 ≤ q ≤ min Q t` and `k = t - q`.  This turns the existential target
predicate into a finite executable search over quotient witnesses.
-/

namespace KomorebiPadic

/-- Finite quotient witnesses whose diagonal branch reaches target `t`. -/
def targetWitnessSet (p r h Q t : ℕ) : Finset ℕ :=
  (Finset.Icc 1 (min Q t)).filter fun q =>
    branchCost h (t - q)
      (padicValNat p ((t - 1).choose (t - q))) < r

/-- Executable membership test for the target set generated by quotients
`1, ..., Q`. -/
def targetCompiler (p r h Q t : ℕ) : Bool :=
  decide (targetWitnessSet p r h Q t).Nonempty

/-- The Boolean compiler is true exactly when the finite witness set is
nonempty. -/
theorem targetCompiler_eq_true_iff_nonempty
    {p r h Q t : ℕ} :
    targetCompiler p r h Q t = true ↔
      (targetWitnessSet p r h Q t).Nonempty := by
  simp [targetCompiler]

/-- Exact correctness of the finite target compiler against the abstract
`IsTarget` predicate for the concrete binomial p-adic edge system. -/
theorem targetCompiler_eq_true_iff_isTarget
    {p r h Q t : ℕ} (hp : 1 < p) :
    targetCompiler p r h Q t = true ↔
      IsTarget (binomialPadicEdgeSystem p r h hp) Q t := by
  rw [targetCompiler_eq_true_iff_nonempty]
  constructor
  · intro hnonempty
    rw [targetWitnessSet, Finset.filter_nonempty_iff] at hnonempty
    rcases hnonempty with ⟨q, hqIcc, hcost⟩
    have hq1 : 1 ≤ q := (Finset.mem_Icc.mp hqIcc).1
    have hqmin : q ≤ min Q t := (Finset.mem_Icc.mp hqIcc).2
    have hqQ : q ≤ Q := hqmin.trans (Nat.min_le_left Q t)
    have hqt : q ≤ t := hqmin.trans (Nat.min_le_right Q t)
    have hsum : q + (t - q) = t := Nat.add_sub_of_le hqt
    refine ⟨q, t - q, hq1, hqQ, ?_, hsum.symm⟩
    change ActiveAt r h (t - q)
      (padicValNat p ((q + (t - q) - 1).choose (t - q)))
    unfold ActiveAt
    simpa only [hsum] using hcost
  · rintro ⟨q, k, hq1, hqQ, hedge, htarget⟩
    have hqt : q ≤ t := by omega
    have hqmin : q ≤ min Q t := Nat.le_min.2 ⟨hqQ, hqt⟩
    have hqIcc : q ∈ Finset.Icc 1 (min Q t) :=
      Finset.mem_Icc.2 ⟨hq1, hqmin⟩
    have hk : t - q = k := by omega
    have htop : t - 1 = q + k - 1 := by omega
    have hcost : branchCost h (t - q)
        (padicValNat p ((t - 1).choose (t - q))) < r := by
      change ActiveAt r h k (padicValNat p ((q + k - 1).choose k)) at hedge
      unfold ActiveAt at hedge
      simpa only [hk, htop] using hedge
    rw [targetWitnessSet, Finset.filter_nonempty_iff]
    exact ⟨q, hqIcc, hcost⟩

/-- False reflection form of the target compiler. -/
theorem targetCompiler_eq_false_iff_not_isTarget
    {p r h Q t : ℕ} (hp : 1 < p) :
    targetCompiler p r h Q t = false ↔
      ¬ IsTarget (binomialPadicEdgeSystem p r h hp) Q t := by
  constructor
  · intro hfalse htarget
    have htrue := (targetCompiler_eq_true_iff_isTarget
      (p := p) (r := r) (h := h) (Q := Q) (t := t) hp).2 htarget
    rw [hfalse] at htrue
    contradiction
  · intro hnot
    cases hcompiler : targetCompiler p r h Q t with
    | false => rfl
    | true =>
        have htarget := (targetCompiler_eq_true_iff_isTarget
          (p := p) (r := r) (h := h) (Q := Q) (t := t) hp).1 hcompiler
        exact (hnot htarget).elim

end KomorebiPadic
