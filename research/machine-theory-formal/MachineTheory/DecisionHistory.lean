import MachineTheory.ResponseDecision

/-!
A checked bridge from Block04's actual history laws to Core4.1. Conditioning,
projection, record rounding and response approximation all refer to one event
and the same candidate coordinates. Conditional certificates require positive
mass under both laws; external access to the conditioning event is not inferred.
-/
namespace Komorebi.MachineTheory.DecisionHistory
open scoped BigOperators
open Instrument Variation ApproximateHistory ApproximateDecision ResponseDecision
noncomputable section
universe u
variable {X Y I V : Type*}

/-- Retain the requested coordinate only after conditioning on the named event. -/
def recordAfter [Fintype X] [DecidableEq X] [DecidableEq Y]
    (f : X → Y) (E : Finset X) (p : X → ℝ) : Y → ℝ :=
  push f (normalize (restrict E p))

theorem recordAfter_dist [Fintype X] [Fintype Y] [DecidableEq X] [DecidableEq Y]
    (f : X → Y) (E : Finset X) (p : X → ℝ) (hp : IsDist p)
    (hE : 0 < mass (restrict E p)) : IsDist (recordAfter f E p) :=
  push_dist f _ (normalize_dist _ (restrict_nonneg E p hp.1) hE)

/-- The record error includes conditioning and any further storage perturbation. -/
def recordAllowance [Fintype X] [DecidableEq X]
    (E : Finset X) (p q : X → ℝ) (δ s : ℝ) : ℝ :=
  min 1 (min 1 (δ / max (mass (restrict E p)) (mass (restrict E q))) + s)

theorem conditioning_and_storage [Fintype X] [Fintype Y] [DecidableEq X] [DecidableEq Y]
    (f : X → Y) (E : Finset X) (p q : X → ℝ) (r : Y → ℝ)
    (hp : IsDist p) (hq : IsDist q) (hr : IsDist r)
    (hEp : 0 < mass (restrict E p)) (hEq : 0 < mass (restrict E q))
    (δ s : ℝ) (hδ : tv p q ≤ δ) (hs : tv (recordAfter f E q) r ≤ s) :
    tv (recordAfter f E p) r ≤ recordAllowance E p q δ s := by
  apply le_min
  · exact tv_le_one _ _ (recordAfter_dist f E p hp hEp) hr
  · have h := conditional_output_bound f E p q hp hq hEp hEq δ hδ
    exact (tv_triangle (recordAfter f E p) (recordAfter f E q) r).trans (add_le_add h hs)

/-- The complete record/response inequality after an actual event and stored-record revision. -/
theorem conditioned_response_error [Fintype X] [Fintype Y]
    [DecidableEq X] [DecidableEq Y] [PseudoMetricSpace V]
    (f : X → Y) (E : Finset X) (p q : X → ℝ) (r : Y → ℝ)
    (hp : IsDist p) (hq : IsDist q) (hr : IsDist r)
    (hEp : 0 < mass (restrict E p)) (hEq : 0 < mass (restrict E q))
    (δ s : ℝ) (hδ : tv p q ≤ δ) (hs : tv (recordAfter f E q) r ≤ s)
    (v w : Y → V) (loss : I → V → ℝ) (i : I) (K d : ℝ) (hK : 0 ≤ K)
    (hd : ∀ y, dist (v y) (w y) ≤ d)
    (hlip : ∀ y, |loss i (v y)-loss i (w y)| ≤ K*dist (v y) (w y))
    (hv : ∀ y, 0 ≤ loss i (v y) ∧ loss i (v y) ≤ 1)
    (hw : ∀ y, 0 ≤ loss i (w y) ∧ loss i (w y) ≤ 1) :
    |responseRisk (recordAfter f E p) v loss i-responseRisk r w loss i| ≤
      allowance (recordAllowance E p q δ s) K d :=
  decision_error _ r v w loss i (recordAfter_dist f E p hp hEp) hr _ K d hK
    (conditioning_and_storage f E p q r hp hq hr hEp hEq δ s hδ hs) hd hlip hv hw

/-- Report/next-state law generated by an instrument and a prior. -/
def jointKernel {S A O : Type u} [Fintype S] [Fintype O] (K : Law S A O) (a : A) :
    Kernel S (O × S) where
  entry y x := jointRow K a x y
  nonnegative y x := (jointRow_dist K a x).1 y
  normalized x := (jointRow_dist K a x).2

def jointEvidence {S A O : Type u} [Fintype S] [Fintype O]
    (K : Law S A O) (a : A) (p : S → ℝ) : O × S → ℝ :=
  applyKernel (jointKernel K a).entry p

theorem jointEvidence_dist {S A O : Type u} [Fintype S] [Fintype O]
    (K : Law S A O) (a : A) (p : S → ℝ) (hp : IsDist p) :
    IsDist (jointEvidence K a p) := kernel_dist (jointKernel K a) p hp

/-- The model discrepancy is obtained from complete instrument rows, not scalar accuracy alone. -/
theorem jointEvidence_error {S Z A O : Type u}
    [Fintype S] [Fintype Z] [Fintype O] [DecidableEq Z] [DecidableEq O]
    (π : S → Z) (K : Law S A O) (L : Law Z A O) (a : A)
    (p : S → ℝ) (q : Z → ℝ) (hp : IsDist p) (δ ε : ℝ)
    (h0 : tv (push π p) q ≤ δ)
    (hε : ∀ x, tv (push (reportMap π) (jointRow K a x)) (jointRow L a (π x)) ≤ ε) :
    tv (push (reportMap π) (jointEvidence K a p)) (jointEvidence L a q) ≤ δ+ε :=
  (push_kernel_step π (reportMap π) (jointKernel K a) (jointKernel L a)
    p q hp ε hε).trans (add_le_add h0 (le_refl ε))

variable {S Z A O : Type u}

/-- The full-history result and response estimate are composed on the same realized laws. -/
theorem history_response_error [Fintype S] [Fintype Z] [Fintype A] [Fintype O]
    [DecidableEq S] [DecidableEq Z] [DecidableEq A] [DecidableEq O]
    [Fintype Y] [DecidableEq Y] [PseudoMetricSpace V]
    (π : S → Z) (K : Nat → Law S A O) (L : Nat → Law Z A O)
    (g : Policy A O) (p : S → ℝ) (q : Z → ℝ) (hp : IsDist p) (hq : IsDist q)
    (δ : ℝ) (ε : Nat → ℝ) (h0 : tv (push π p) q ≤ δ)
    (hε : ∀ n a x, tv (push (reportMap π) (jointRow (K n) a x)) (jointRow (L n) a (π x)) ≤ ε n)
    (H : Nat) (f : Path Z A O H → Y) (v w : Y → V) (loss : I → V → ℝ) (i : I)
    (C d : ℝ) (hC : 0 ≤ C) (hd : ∀ y, dist (v y) (w y) ≤ d)
    (hlip : ∀ y, |loss i (v y)-loss i (w y)| ≤ C*dist (v y) (w y))
    (hv : ∀ y, 0 ≤ loss i (v y) ∧ loss i (v y) ≤ 1)
    (hw : ∀ y, 0 ≤ loss i (w y) ∧ loss i (w y) ≤ 1) :
    |responseRisk (push f (push (project π H) (law K g p H))) v loss i-
      responseRisk (push f (law L g q H)) w loss i| ≤
      allowance (min 1 (δ + ∑ n ∈ Finset.range H, ε n)) C d :=
  decision_error _ _ v w loss i
    (push_dist _ _ (push_dist _ _ (law_dist K g p hp H)))
    (push_dist _ _ (law_dist L g q hq H)) _ C d hC
    (observed_history_bound π K L g p q hp hq δ ε h0 hε H f) hd hlip hv hw

/-- A complete event-conditioned history, followed by rounded storage and response approximation. -/
theorem history_conditioned_response_error [Fintype S] [Fintype Z] [Fintype A] [Fintype O]
    [DecidableEq S] [DecidableEq Z] [DecidableEq A] [DecidableEq O]
    [Fintype Y] [DecidableEq Y] [PseudoMetricSpace V]
    (π : S → Z) (K : Nat → Law S A O) (L : Nat → Law Z A O)
    (g : Policy A O) (p : S → ℝ) (q : Z → ℝ) (hp : IsDist p) (hq : IsDist q)
    (δ : ℝ) (ε : Nat → ℝ) (h0 : tv (push π p) q ≤ δ)
    (hε : ∀ n a x, tv (push (reportMap π) (jointRow (K n) a x)) (jointRow (L n) a (π x)) ≤ ε n)
    (H : Nat) (f : Path Z A O H → Y) (E : Finset (Path Z A O H))
    (hEp : 0 < mass (restrict E (push (project π H) (law K g p H))))
    (hEq : 0 < mass (restrict E (law L g q H)))
    (r : Y → ℝ) (hr : IsDist r) (s : ℝ)
    (hs : tv (recordAfter f E (law L g q H)) r ≤ s)
    (v w : Y → V) (loss : I → V → ℝ) (i : I)
    (C d : ℝ) (hC : 0 ≤ C) (hd : ∀ y, dist (v y) (w y) ≤ d)
    (hlip : ∀ y, |loss i (v y)-loss i (w y)| ≤ C*dist (v y) (w y))
    (hv : ∀ y, 0 ≤ loss i (v y) ∧ loss i (v y) ≤ 1)
    (hw : ∀ y, 0 ≤ loss i (w y) ∧ loss i (w y) ≤ 1) :
    |responseRisk (recordAfter f E (push (project π H) (law K g p H))) v loss i-
      responseRisk r w loss i| ≤
      allowance (recordAllowance E (push (project π H) (law K g p H))
        (law L g q H) (min 1 (δ + ∑ n ∈ Finset.range H, ε n)) s) C d :=
  conditioned_response_error f E _ _ r
    (push_dist _ _ (law_dist K g p hp H)) (law_dist L g q hq H) hr hEp hEq
    _ s (whole_history_bound π K L g p q hp hq δ ε h0 hε H) hs
    v w loss i C d hC hd hlip hv hw

end
end Komorebi.MachineTheory.DecisionHistory
