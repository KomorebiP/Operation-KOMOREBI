{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/osl-core/0.3/capability.schema.json",
  "title": "OSL-Core 0.3 Bounded Capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["effect", "remaining_uses", "expires_at", "source", "grant_digest"],
  "properties": {
    "effect": {"type": "string"},
    "remaining_uses": {"type": ["integer", "null"], "minimum": 0},
    "expires_at": {"type": ["integer", "null"], "minimum": 0},
    "source": {"type": "string"},
    "grant_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
