module verified_terminal_session
lineage L_A
lineage L_B
agent A lineage L_A
agent B lineage L_B
session S participants ["A","B"] initial waiting_A
session_transition S waiting_A communicate A B -> waiting_B
session_transition S waiting_B communicate B A -> ready
session_terminal S ready
verify_session S
start_session S
observe map by A content "map" confidence 0.95
communicate map from A to B as map_at_B in S
observe hazard by B content "hazard" confidence 0.93
communicate hazard from B to A as hazard_at_A in S
assert session S state ready
