# EXPECT-ERROR: no transition
module session_order_violation
lineage L_A
lineage L_B
agent A lineage L_A
agent B lineage L_B
session S participants ["A","B"] initial waiting_A
session_transition S waiting_A communicate A B -> waiting_B
start_session S
observe e by B content "out-of-order" confidence 0.9
communicate e from B to A as eA in S
