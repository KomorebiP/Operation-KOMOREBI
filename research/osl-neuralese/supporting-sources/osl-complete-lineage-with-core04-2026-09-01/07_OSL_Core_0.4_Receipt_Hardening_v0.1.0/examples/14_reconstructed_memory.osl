module reconstructed_memory
lineage L_A
agent A lineage L_A
grant A effect writeMemory
observe fragment by A content "episode-fragment-12" confidence 0.84
infer reconstruction by A from fragment content "episode-12-reconstructed" confidence 0.71
# The finite core treats reconstruction as an explicit relabeling policy outside
# this minimal interpreter; the example stores the available inference safely.
write_memory reconstruction by A as inferred
assert memory A contains reconstruction as inferred true
