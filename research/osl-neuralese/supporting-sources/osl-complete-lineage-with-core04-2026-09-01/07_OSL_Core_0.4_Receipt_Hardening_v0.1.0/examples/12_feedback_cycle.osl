module feedback_cycle
lineage L_A
agent A lineage L_A
grant A effect externalAct
observe prediction by A content "candidate-action-value" confidence 0.88
endorse prediction by A threshold 0.80
authorize prediction by A for planning
plan candidate_action by A using prediction effect externalAct expected 2.0
execute candidate_action by A
feedback candidate_action by A observed 2.75
assert action candidate_action executed true
