{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/osl-core/0.4/capability.schema.json",
  "title": "OSL-Core 0.4 Bounded Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effect", "initial_uses", "remaining_uses", "expires_at", "source",
    "grant_index", "issued_step", "grant_digest"
  ],
  "properties": {
    "effect": {"type": "string"},
    "initial_uses": {"type": ["integer", "null"], "minimum": 1},
    "remaining_uses": {"type": ["integer", "null"], "minimum": 0},
    "expires_at": {"type": ["integer", "null"], "minimum": 0},
    "source": {"type": "string"},
    "grant_index": {"type": "integer", "minimum": 0},
    "issued_step": {"type": "integer", "minimum": 0},
    "grant_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
