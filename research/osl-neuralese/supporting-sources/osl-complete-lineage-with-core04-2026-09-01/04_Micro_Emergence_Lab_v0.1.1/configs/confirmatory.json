{
  "schema_version": "0.1.1",
  "preset": "confirmatory",
  "seed": 1729,
  "runtime": {
    "offline": true,
    "deterministic": true,
    "device": "auto",
    "num_workers": 0,
    "pretrained_downloads": false
  },
  "dataset": {
    "seed": 1729,
    "worlds": ["algebra", "provenance", "resources"],
    "renderers": ["direct", "narrative", "dialogue", "log", "passive"],
    "split_sizes": {
      "train": 20000,
      "renaming_train": 4000,
      "renaming_scrambled_train": 4000,
      "iid_validation": 2000,
      "iid_test": 2000,
      "lexical": 2000,
      "heldout_pair": 2000,
      "heldout_triple": 2000,
      "law": 2000,
      "length": 2000,
      "counterfactual": 2000,
      "renaming": 1998
    },
    "train_min_length": 1,
    "train_max_length": 4,
    "length_test_min": 5,
    "length_test_max": 8,
    "include_formal_fields": true
  },
  "baselines": {
    "majority": true,
    "question_majority": true,
    "tfidf": true,
    "tfidf_max_features": 100000
  },
  "training": {
    "default_arm": "answer_only",
    "architectures": ["transformer"],
    "arms": ["answer_only", "role_bind_augmented", "role_bind_scrambled"],
    "epochs": 8,
    "batch_size": 32,
    "lr": 0.0003,
    "max_length": 256,
    "num_workers": 0,
    "weight_decay": 0.01,
    "gradient_clip": 1.0,
    "early_stopping_patience": 8,
    "selection_metric": "query_macro_accuracy",
    "amp": true,
    "checkpoint_every_epoch": true,
    "model": {
      "d_model": 192,
      "n_heads": 6,
      "n_layers": 4,
      "d_ff": 512,
      "dropout": 0.1,
      "representation_dim": 96,
      "operator_dim": 16
    },
    "loss_weights": {
      "answer": 1.0,
      "state": 0.35,
      "equivalence": 0.2,
      "operator_alignment": 0.1,
      "operator_laws": 0.1
    }
  },
  "evaluation": {
    "batch_size": 64,
    "bootstrap_samples": 1000,
    "checkpoint": "last",
    "save_predictions": true,
    "adjudication": {
      "required_splits": ["lexical", "heldout_pair", "heldout_triple", "renaming"],
      "minimum_split_accuracy": 0.55,
      "minimum_margin_over_control": 0.02,
      "balance": {
        "required": true,
        "splits": ["lexical", "heldout_pair", "heldout_triple", "renaming"],
        "minimum_world_macro_accuracy": 0.55,
        "minimum_query_macro_accuracy": 0.55,
        "minimum_world_accuracy": 0.50,
        "minimum_query_accuracy": 0.40,
        "minimum_margin_over_control": 0.0
      },
      "renaming": {
        "required": true,
        "minimum_pair_completeness": 1.0,
        "minimum_prediction_consistency": 0.80,
        "minimum_pair_joint_correctness": 0.55,
        "maximum_robustness_gap": 0.10,
        "require_gold_consistency": true
      },
      "learned_binding_h2": {
        "required": true,
        "minimum_triplet_completeness": 1.0,
        "minimum_correct_minus_scrambled_accuracy": 0.10,
        "minimum_correct_vs_scrambled_prediction_change": 0.25,
        "minimum_correct_only_success_rate": 0.10,
        "require_triplet_gold_consistency": true
      },
      "counterfactual": {
        "required": true,
        "minimum_affected_joint_accuracy": 0.50,
        "minimum_unaffected_joint_accuracy": 0.50,
        "minimum_change_sensitivity": 0.75,
        "minimum_invariance_specificity": 0.75,
        "minimum_pair_level_completeness": 0.50,
        "minimum_pair_level_specificity": 0.75
      }
    }
  },
  "replication": {
    "data_seeds": [1729, 2718],
    "model_seeds": [1729, 2718, 31415],
    "architectures": ["transformer"],
    "arms": ["answer_only", "role_bind_augmented", "role_bind_scrambled"],
    "splits": [
      "iid_test",
      "lexical",
      "heldout_pair",
      "heldout_triple",
      "law",
      "length",
      "counterfactual",
      "renaming"
    ],
    "baseline_gate_min_margin": 0.02,
    "learned_binding_gate": {
      "minimum_mean_renamed_accuracy_gain_over_scrambled_arm": 0.05,
      "minimum_mean_pair_joint_gain_over_scrambled_arm": 0.05,
      "minimum_mean_correct_calibration_gain_at_test": 0.05,
      "minimum_positive_seed_cells": 5,
      "require_positive_each_data_seed_mean": true,
      "minimum_correct_arm_renamed_accuracy": 0.60,
      "minimum_correct_arm_prediction_consistency": 0.80,
      "minimum_correct_arm_pair_joint_correctness": 0.55,
      "maximum_mean_heldout_pair_accuracy_loss": 0.05,
      "maximum_mean_heldout_triple_accuracy_loss": 0.05
    }
  },
  "quotient": {
    "enabled": false,
    "candidate_dimensions": [2, 4, 8, 16, 32],
    "temperatures": [2.0, 1.0, 0.5, 0.25, 0.1],
    "max_iterations": 250
  },
  "report": {
    "make_figures": true,
    "format": "markdown",
    "include_per_split_tables": true,
    "include_negative_controls": true,
    "include_confidence_intervals": true
  }
}
