module bounded_capability
lineage L_A
agent A lineage L_A
grant A effect toolCall uses 1 until 100
observe query by A content "query-validated" confidence 0.98
endorse query by A threshold 0.90
authorize query by A for toolCall
plan run_query by A using query effect toolCall
execute run_query by A
assert capability A effect toolCall remaining 0
assert action run_query executed true
