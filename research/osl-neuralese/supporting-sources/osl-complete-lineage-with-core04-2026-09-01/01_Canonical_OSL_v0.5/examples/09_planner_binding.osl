module planner_binding
lineage L_A
agent A lineage L_A
grant A effect externalAct
observe hazard by A content "hazard-on-path-2" confidence 0.91
endorse hazard by A threshold 0.80
authorize hazard by A for planning
plan avoid_path_2 by A using hazard effect externalAct expected 0.5
execute avoid_path_2 by A
assert action avoid_path_2 executed true
