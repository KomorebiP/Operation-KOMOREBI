{
  "schema_version": "0.1.0",
  "suite_id": "komorebi_recurrent_depth_safe_pilot_v0.1.0",
  "description": "Safe discovery and held-out prompts for recurrent latent dynamics, packet discovery, and causal intervention tests.",
  "safety": {
    "safe_only": true,
    "excluded_categories": [
      "weapons",
      "self-harm",
      "malware",
      "illegal instructions",
      "graphic violence",
      "personal data"
    ],
    "note": "The unsafe example from the paper is replaced with a benign conflict-resolution analogue."
  },
  "model": {
    "id": "tomg-group-umd/huginn-0125",
    "revision": "bb6621b65e90b6a4b9b29ef88dc83866d450470c",
    "trust_remote_code": true
  },
  "format": {
    "system_message": "You are a helpful assistant that can assist users with mathematical reasoning.",
    "use_chat_template": true,
    "add_generation_prompt": true,
    "scored_answer_instruction": "Choose exactly one option and answer with its letter only.",
    "candidate_labels": ["A", "B", "C", "D"],
    "require_single_token_labels": true
  },
  "capture_defaults": {
    "batch_size": 1,
    "use_cache": false,
    "test_time_noise": 0,
    "seeds": [0, 1, 2, 3, 4],
    "max_recurrence": 64,
    "extended_recurrences": [96, 128, 192],
    "logit_depths": [0, 1, 2, 4, 8, 16, 32, 48, 64]
  },
  "split_policy": {
    "unit": "complete_prompt",
    "fit_split": "discovery",
    "evaluation_split": "heldout",
    "prohibit_stepwise_split": true,
    "discovery_ids": [
      "D01_PAPER_MATH",
      "D02_PAPER_TRIVIA",
      "D03_SAFE_DELIBERATION",
      "D04_MULTI_ARITHMETIC",
      "D05_CYCLIC_PATTERN",
      "D06_MODULAR_UPDATE",
      "D07_COUNTING",
      "D08_EASY_FACT",
      "D09_REPEATED_TOKEN_CONTEXT",
      "D10_EASY_ARITHMETIC",
      "D11_MULTI_TRANSFORM",
      "D12_NULL_CONTROL"
    ],
