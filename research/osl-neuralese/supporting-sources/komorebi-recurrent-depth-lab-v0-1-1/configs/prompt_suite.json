      "H01_PAPER_MATH_PARAPHRASE",
      "H02_TRIVIA_PARAPHRASE",
      "H03_DELIBERATION_PARAPHRASE",
      "H04_MULTI_ARITHMETIC",
      "H05_CYCLIC_PATTERN",
      "H06_MODULAR_UPDATE",
      "H07_COUNTING",
      "H08_EASY_FACT",
      "H09_REPEATED_TOKEN_CONTEXT",
