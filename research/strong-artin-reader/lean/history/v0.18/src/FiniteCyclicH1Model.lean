import Mathlib.RepresentationTheory.Homological.GroupCohomology.FiniteCyclic
import Mathlib.LinearAlgebra.Quotient.Basic

/-!
# First cohomology of a cyclic group when the norm vanishes

For a finite cyclic group generated by `g`, if the representation norm is zero,
then evaluation on the chosen generator presents `H¹` as the quotient by
`ρ(g) - 1`.
-/

namespace Komorebi.StrongArtin.FiniteCyclicH1Model

open CategoryTheory
open Rep
open Rep.FiniteCyclicGroup
open groupCohomology

noncomputable section

universe u

variable {k G : Type u} [CommRing k] [CommGroup G] [Fintype G]
  (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)

/-- Under a zero norm hypothesis, every coefficient vector is an odd-degree
cyclic cocycle representative. -/
def toNormKernel (hN : A.norm.hom.toLinearMap = 0) :
    A →ₗ[k] LinearMap.ker A.norm.hom.toLinearMap :=
  LinearMap.codRestrict _ LinearMap.id (by
    intro x
    rw [LinearMap.mem_ker, hN]
    rfl)

@[simp]
theorem toNormKernel_coe (hN : A.norm.hom.toLinearMap = 0) (x : A) :
    ((toNormKernel A hN x : LinearMap.ker A.norm.hom.toLinearMap) : A) = x := rfl

/-- The class in `H¹` represented by a prescribed value at the cyclic generator. -/
def h1ClassOfValue (hN : A.norm.hom.toLinearMap = 0) :
    A →ₗ[k] groupCohomology.H1 A :=
  (groupCohomologyπOdd A g hg 1 (by simp)).hom.comp (toNormKernel A hN)

@[simp]
theorem h1ClassOfValue_apply (hN : A.norm.hom.toLinearMap = 0) (x : A) :
    h1ClassOfValue A g hg hN x =
      (groupCohomologyπOdd A g hg 1 (by simp)) (toNormKernel A hN x) := rfl

/-- Equality of cyclic `H¹` classes is exactly congruence modulo `ρ(g)-1`. -/
theorem h1ClassOfValue_eq_iff
    (hN : A.norm.hom.toLinearMap = 0) (x y : A) :
    h1ClassOfValue A g hg hN x = h1ClassOfValue A g hg hN y ↔
      x - y ∈ LinearMap.range (applyAsHom A g - 𝟙 A).hom.toLinearMap := by
  simpa [h1ClassOfValue_apply] using
    (groupCohomologyπOdd_eq_iff A g hg 1 (by simp)
      (toNormKernel A hN x) (toNormKernel A hN y))

/-- The concrete cyclic quotient map is surjective. -/
theorem groupCohomologyπOdd_surjective :
    Function.Surjective
      ((groupCohomologyπOdd A g hg 1 (by simp)).hom) := by
  intro z
  let S := subCompNormHom A g
  let e := groupCohomologyIsoOdd A g hg 1 (by simp)
  have hπ : Function.Surjective S.homologyπ.hom :=
    (ModuleCat.epi_iff_surjective _).1 inferInstance
  obtain ⟨c, hc⟩ := hπ (e.hom z)
  let x : LinearMap.ker A.norm.hom.toLinearMap :=
    S.moduleCatCyclesIso.hom.hom c
  refine ⟨x, ?_⟩
  change e.inv (S.homologyπ (S.moduleCatCyclesIso.inv x)) = z
  have hx : S.moduleCatCyclesIso.inv x = c := by
    dsimp [x]
    exact S.moduleCatCyclesIso.hom_inv_id_apply c
  rw [hx, hc]
  exact e.hom_inv_id_apply z

/-- The cyclic value map is surjective when the norm vanishes. -/
theorem h1ClassOfValue_surjective
    (hN : A.norm.hom.toLinearMap = 0) :
    Function.Surjective (h1ClassOfValue A g hg hN) := by
  intro z
  obtain ⟨x, hx⟩ := groupCohomologyπOdd_surjective A g hg z
  refine ⟨x.1, ?_⟩
  rw [h1ClassOfValue_apply]
  have hker : toNormKernel A hN x.1 = x := by
    apply Subtype.ext
    rfl
  rw [hker]
  exact hx


/-- The kernel of the value-class map is exactly the image of `ρ(g)-1`. -/
theorem ker_h1ClassOfValue
    (hN : A.norm.hom.toLinearMap = 0) :
    LinearMap.ker (h1ClassOfValue A g hg hN) =
      LinearMap.range (applyAsHom A g - 𝟙 A).hom.toLinearMap := by
  ext x
  rw [LinearMap.mem_ker]
  have h := h1ClassOfValue_eq_iff A g hg hN x 0
  simpa using h

/-- **Cyclic `H¹` quotient model.** If the cyclic norm vanishes, first group
cohomology is linearly equivalent to coefficients modulo `ρ(g)-1`. -/
def h1EquivValueQuotient
    (hN : A.norm.hom.toLinearMap = 0) :
    (A ⧸ LinearMap.range (applyAsHom A g - 𝟙 A).hom.toLinearMap) ≃ₗ[k]
      groupCohomology.H1 A :=
  (Submodule.quotEquivOfEq
      (LinearMap.range (applyAsHom A g - 𝟙 A).hom.toLinearMap)
      (LinearMap.ker (h1ClassOfValue A g hg hN))
      (ker_h1ClassOfValue A g hg hN).symm).trans
    ((LinearMap.quotKerEquivRange (h1ClassOfValue A g hg hN)).trans
      (LinearEquiv.ofTop
        (LinearMap.range (h1ClassOfValue A g hg hN))
        (LinearMap.range_eq_top.mpr
          (h1ClassOfValue_surjective A g hg hN))))

@[simp]
theorem h1EquivValueQuotient_mkQ
    (hN : A.norm.hom.toLinearMap = 0) (x : A) :
    h1EquivValueQuotient A g hg hN
      ((LinearMap.range (applyAsHom A g - 𝟙 A).hom.toLinearMap).mkQ x) =
      h1ClassOfValue A g hg hN x := by
  rfl

end
end Komorebi.StrongArtin.FiniteCyclicH1Model
