import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.LinearAlgebra.Dual.Defs

/-!
# Split-prime localization factors through the cyclic transverse quotient

If the canonical cyclic deformation class localizes to zero at an auxiliary
prime (as expected when the prime splits in the cyclic extension), then every
raw local functional factors through the global quotient by the cyclic line.
Thus local probes need not be centered individually at such primes.

This module proves the linear statement.  It does not prove the arithmetic fact
that splitting in a number-field extension makes the chosen global cyclic
Selmer class localize to zero.
-/

namespace Komorebi.StrongArtin.SplitPrimeTransverseLocalization

noncomputable section

variable {k H L : Type*} [Field k]
  [AddCommGroup H] [Module k H]
  [AddCommGroup L] [Module k L]

/-- The one-dimensional cyclic defect subspace generated by `d`. -/
def cyclicLine (d : H) : Submodule k H :=
  Submodule.span k ({d} : Set H)

/-- If localization kills the cyclic generator, it kills the whole cyclic line. -/
theorem cyclicLine_le_ker_localization
    (loc : H →ₗ[k] L) (d : H) (hd : loc d = 0) :
    cyclicLine (k := k) d ≤ LinearMap.ker loc := by
  rw [cyclicLine, Submodule.span_le]
  intro x hx
  have hxd : x = d := by simpa using hx
  subst x
  exact hd

/-- Localization descends to the quotient by the cyclic defect line. -/
def transverseLocalization
    (loc : H →ₗ[k] L) (d : H) (hd : loc d = 0) :
    (H ⧸ cyclicLine (k := k) d) →ₗ[k] L :=
  (cyclicLine (k := k) d).liftQ loc (cyclicLine_le_ker_localization loc d hd)

@[simp]
theorem transverseLocalization_mkQ
    (loc : H →ₗ[k] L) (d : H) (hd : loc d = 0) (h : H) :
    transverseLocalization loc d hd ((cyclicLine (k := k) d).mkQ h) = loc h := rfl

/-- Any scalar local detector composes with the transverse localization. -/
def transverseLocalFunctional
    (loc : H →ₗ[k] L) (d : H) (hd : loc d = 0)
    (φ : Module.Dual k L) :
    Module.Dual k (H ⧸ cyclicLine (k := k) d) :=
  φ.comp (transverseLocalization loc d hd)

@[simp]
theorem transverseLocalFunctional_mkQ
    (loc : H →ₗ[k] L) (d : H) (hd : loc d = 0)
    (φ : Module.Dual k L) (h : H) :
    transverseLocalFunctional loc d hd φ ((cyclicLine (k := k) d).mkQ h) =
      φ (loc h) := rfl

/-- A raw local functional is unchanged when a global class is shifted by any
multiple of the cyclic defect. -/
theorem localFunctional_add_cyclic
    (loc : H →ₗ[k] L) (d : H) (hd : loc d = 0)
    (φ : Module.Dual k L) (h : H) (a : k) :
    φ (loc (h + a • d)) = φ (loc h) := by
  simp only [map_add, map_smul, hd, smul_zero, add_zero]

/-- Nonzero raw local evaluation detects a nonzero class in the transverse
quotient. -/
theorem quotient_class_ne_zero_of_local_detection
    (loc : H →ₗ[k] L) (d : H) (hd : loc d = 0)
    (φ : Module.Dual k L) (h : H)
    (hdet : φ (loc h) ≠ 0) :
    (cyclicLine (k := k) d).mkQ h ≠ 0 := by
  intro hzero
  apply hdet
  rw [← transverseLocalFunctional_mkQ loc d hd φ h, hzero]
  exact map_zero _

/--
**Split-prime transverse-functional capstone.** Localization killing the cyclic
class produces a canonical scalar functional on the transverse quotient, with
exactly the same evaluations as the original raw local projector functional.
-/
theorem exists_transverse_functional_with_same_value
    (loc : H →ₗ[k] L) (d : H) (hd : loc d = 0)
    (φ : Module.Dual k L) :
    ∃ ψ : Module.Dual k (H ⧸ cyclicLine (k := k) d),
      ∀ h : H, ψ ((cyclicLine (k := k) d).mkQ h) = φ (loc h) := by
  exact ⟨transverseLocalFunctional loc d hd φ,
    transverseLocalFunctional_mkQ loc d hd φ⟩

end

end Komorebi.StrongArtin.SplitPrimeTransverseLocalization

#print axioms Komorebi.StrongArtin.SplitPrimeTransverseLocalization.cyclicLine_le_ker_localization
#print axioms Komorebi.StrongArtin.SplitPrimeTransverseLocalization.localFunctional_add_cyclic
#print axioms Komorebi.StrongArtin.SplitPrimeTransverseLocalization.quotient_class_ne_zero_of_local_detection
#print axioms Komorebi.StrongArtin.SplitPrimeTransverseLocalization.exists_transverse_functional_with_same_value
