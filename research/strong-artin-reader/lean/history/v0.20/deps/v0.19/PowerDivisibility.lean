import Mathlib.LinearAlgebra.Projection

/-!
# Power divisibility in modules

A small API for the filtration generated by powers of one coefficient.  This is
used to state finite-depth nonlinear lifting without choosing quotient-ring
representatives.
-/

namespace Komorebi.StrongArtin.PowerDivisibility

variable {R M N : Type*} [CommRing R]
  [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N]

/-- `PowDivisible pi n x` means that `x` lies in `pi^n M`. -/
def PowDivisible (pi : R) (n : ℕ) (x : M) : Prop :=
  ∃ y : M, (pi ^ n) • y = x

@[simp] theorem powDivisible_zero (pi : R) (x : M) :
    PowDivisible pi 0 x := by
  exact ⟨x, by simp⟩

@[simp] theorem powDivisible_zero_elem (pi : R) (n : ℕ) :
    PowDivisible pi n (0 : M) := by
  exact ⟨0, by simp⟩

theorem PowDivisible.add {pi : R} {n : ℕ} {x y : M}
    (hx : PowDivisible pi n x) (hy : PowDivisible pi n y) :
    PowDivisible pi n (x + y) := by
  obtain ⟨x₀, rfl⟩ := hx
  obtain ⟨y₀, rfl⟩ := hy
  exact ⟨x₀ + y₀, by simp [smul_add]⟩

theorem PowDivisible.neg {pi : R} {n : ℕ} {x : M}
    (hx : PowDivisible pi n x) : PowDivisible pi n (-x) := by
  obtain ⟨x₀, rfl⟩ := hx
  exact ⟨-x₀, by simp⟩

theorem PowDivisible.sub {pi : R} {n : ℕ} {x y : M}
    (hx : PowDivisible pi n x) (hy : PowDivisible pi n y) :
    PowDivisible pi n (x - y) := by
  simpa [sub_eq_add_neg] using hx.add hy.neg

theorem PowDivisible.map (f : M →ₗ[R] N) {pi : R} {n : ℕ} {x : M}
    (hx : PowDivisible pi n x) : PowDivisible pi n (f x) := by
  obtain ⟨x₀, rfl⟩ := hx
  exact ⟨f x₀, by simp⟩

theorem PowDivisible.smul (a pi : R) {n : ℕ} {x : M}
    (hx : PowDivisible pi n x) : PowDivisible pi n (a • x) := by
  obtain ⟨x₀, rfl⟩ := hx
  exact ⟨a • x₀, by simp [smul_smul, mul_comm]⟩

theorem PowDivisible.of_succ {pi : R} {n : ℕ} {x : M}
    (hx : PowDivisible pi (n + 1) x) : PowDivisible pi n x := by
  obtain ⟨x₀, hx₀⟩ := hx
  refine ⟨pi • x₀, ?_⟩
  rw [← hx₀, pow_succ, smul_smul]

theorem PowDivisible.mono {pi : R} {m n : ℕ} {x : M}
    (hmn : m ≤ n) (hx : PowDivisible pi n x) : PowDivisible pi m x := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hmn
  obtain ⟨x₀, rfl⟩ := hx
  refine ⟨(pi ^ d) • x₀, ?_⟩
  rw [smul_smul, ← pow_add]

theorem eq_zero_of_pow_eq_zero {pi : R} {n : ℕ} {x : M}
    (hx : PowDivisible pi n x) (hpi : pi ^ n = 0) : x = 0 := by
  obtain ⟨x₀, hx₀⟩ := hx
  rw [← hx₀, hpi, zero_smul]

end Komorebi.StrongArtin.PowerDivisibility

#print axioms Komorebi.StrongArtin.PowerDivisibility.PowDivisible.map
#print axioms Komorebi.StrongArtin.PowerDivisibility.PowDivisible.mono
#print axioms Komorebi.StrongArtin.PowerDivisibility.eq_zero_of_pow_eq_zero
