import SurjectiveMatrixRightInverse
import Mathlib.LinearAlgebra.Matrix.BaseChange

/-!
# Polynomial Hensel lifting through a residue-field homomorphism

This formulation avoids hard-wiring the residue field as a quotient type.  A
surjective ring homomorphism `q : R →+* k` with kernel `(pi)` is enough.  A
surjective residual Jacobian over `k` produces a matrix right inverse; it lifts
entrywise to `R` with `pi`-divisible error; polynomial Jacobian stability and
the nonlinear Hensel theorem then give an exact solution.
-/

namespace Komorebi.StrongArtin.SurjectiveResidueHomPolynomialHensel

open Komorebi.StrongArtin.PowerDivisibility
open Komorebi.StrongArtin.FiniteCoordinatePolynomialHensel
open Komorebi.StrongArtin.SurjectiveMatrixRightInverse
open Komorebi.StrongArtin.PolynomialSystemTaylor
open Komorebi.StrongArtin.VariableJacobianHensel

noncomputable section

variable {R k ι κ : Type*} [CommRing R] [Field k]

/-- A matrix over a quotient field lifts entrywise along a surjective ring map. -/
theorem exists_matrix_lift_of_surjective
    (q : R →+* k) (hq : Function.Surjective q)
    (Mbar : Matrix ι κ k) :
    ∃ M : Matrix ι κ R, M.map q = Mbar := by
  classical
  have hpre : ∀ i j, ∃ x : R, q x = Mbar i j := by
    intro i j
    exact hq (Mbar i j)
  choose M hM using hpre
  refine ⟨M, ?_⟩
  ext i j
  exact hM i j

/-- A residual matrix right inverse lifts with an entrywise `pi`-divisible
error whenever the residue map has kernel `(pi)`. -/
theorem exists_lifted_approx_rightInverse_of_residue_hom
    [Fintype ι] [DecidableEq κ]
    (pi : R) (q : R →+* k) (hq : Function.Surjective q)
    (hker : RingHom.ker q = Ideal.span ({pi} : Set R))
    (J : Matrix κ ι R) (Rbar : Matrix ι κ k)
    (hbar : J.map q * Rbar = 1) :
    ∃ R₀ : Matrix ι κ R,
      R₀.map q = Rbar ∧
      EntrywisePowDivisible pi 1 (J * R₀ - 1) := by
  classical
  obtain ⟨R₀, hR₀⟩ := exists_matrix_lift_of_surjective q hq Rbar
  refine ⟨R₀, hR₀, ?_⟩
  let D : Matrix κ κ R := J * R₀ - 1
  have hmatrix : D.map q = (0 : Matrix κ κ k) := by
    dsimp [D]
    rw [Matrix.map_sub q q.map_sub]
    rw [Matrix.map_mul]
    rw [hR₀]
    rw [hbar]
    rw [Matrix.map_one q q.map_zero q.map_one]
    simp
  intro i j
  have hentry := congrFun (congrFun hmatrix i) j
  have hqzero : q (D i j) = 0 := by simpa using hentry
  have hmemker : D i j ∈ RingHom.ker q := RingHom.mem_ker.mpr hqzero
  rw [hker] at hmemker
  rw [Ideal.mem_span_singleton] at hmemker
  obtain ⟨c, hc⟩ := hmemker
  refine ⟨c, ?_⟩
  simpa [D, pow_one, smul_eq_mul] using hc.symm

/--
**Surjective residue-field Jacobian polynomial Hensel theorem.** Let `q : R → k`
be a surjective residue map with kernel generated by a nilpotent `pi`.  If a
finite coordinate polynomial system has a residual solution and its Jacobian
after applying `q` is surjective, then the residual solution lifts to an exact
solution over `R`.
-/
theorem exists_exact_solution_of_surjective_residue_jacobian
    [Fintype ι] [DecidableEq ι]
    [Fintype κ] [DecidableEq κ]
    (pi : R) (q : R →+* k) (hq : Function.Surjective q)
    (hker : RingHom.ker q = Ideal.span ({pi} : Set R))
    (system : System ι κ R) (x₀ : ι → R)
    (hJ : Function.Surjective
      (matrixLinear ((jacobianMatrix system x₀).map q)))
    (hpi : IsNilpotent pi)
    (hx₀ : PowDivisible pi 1 (evalSystem system x₀)) :
    ∃ x : ι → R, SameResidual pi x₀ x ∧ evalSystem system x = 0 := by
  obtain ⟨Rbar, hRbar⟩ :=
    exists_matrix_rightInverse_of_surjective
      ((jacobianMatrix system x₀).map q) hJ
  obtain ⟨R₀, -, hR₀⟩ :=
    exists_lifted_approx_rightInverse_of_residue_hom
      pi q hq hker (jacobianMatrix system x₀) Rbar hRbar
  exact exists_exact_solution_of_residual_matrix_rightInverse
    pi system x₀ R₀ hR₀ hpi hx₀

end

end Komorebi.StrongArtin.SurjectiveResidueHomPolynomialHensel

#print axioms Komorebi.StrongArtin.SurjectiveResidueHomPolynomialHensel.exists_matrix_lift_of_surjective
#print axioms Komorebi.StrongArtin.SurjectiveResidueHomPolynomialHensel.exists_lifted_approx_rightInverse_of_residue_hom
#print axioms Komorebi.StrongArtin.SurjectiveResidueHomPolynomialHensel.exists_exact_solution_of_surjective_residue_jacobian
