import CompletedPresentationHenselCapstone
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Algebra points of completed formal presentations

An exact nilpotent solution of a finite formal power-series system induces an
`R`-algebra homomorphism from the quotient by the relation ideal.  Combined with
the completed-presentation Hensel theorem, a surjective residual linear
coefficient matrix constructs an actual finite-level point of the presented
complete local algebra.
-/

namespace Komorebi.StrongArtin.FormalPresentationPoint

open Komorebi.StrongArtin.PowerDivisibility
open Komorebi.StrongArtin.FormalPowerSeriesSystemHensel
open Komorebi.StrongArtin.FormalPowerSeriesJacobianAtOrigin
open Komorebi.StrongArtin.CompletedPresentationHenselCapstone
open Komorebi.StrongArtin.MvPowerSeriesNilpotentSubstitution
open Komorebi.StrongArtin.FiniteCoordinatePolynomialHensel

noncomputable section

variable {R k ι κ : Type*} [CommRing R] [Field k]
  [Fintype ι] [DecidableEq ι]
  [Fintype κ] [DecidableEq κ]

/-- Ideal generated by the equations of a finite formal presentation. -/
def relationIdeal (system : FormalSystem ι κ R) : Ideal (MvPowerSeries ι R) :=
  Ideal.span (Set.range system)

/-- Canonical evaluation algebra homomorphism at a point for which constant
substitution is admissible. -/
def formalEvalAlgHom (x : ι → R)
    (ha : MvPowerSeries.HasSubst (constSubst x)) :
    MvPowerSeries ι R →ₐ[R] R :=
  (MvPowerSeries.isEmptyEquiv Empty R).toAlgHom.comp
    (MvPowerSeries.substAlgHom ha)

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem formalEvalAlgHom_apply
    (x : ι → R) (ha : MvPowerSeries.HasSubst (constSubst x))
    (f : MvPowerSeries ι R) :
    formalEvalAlgHom x ha f = formalEval f x := by
  simp [formalEvalAlgHom, formalEval, MvPowerSeries.coe_substAlgHom]

omit [Fintype ι] [DecidableEq ι] in
@[simp] theorem formalEvalAlgHom_X
    (x : ι → R) (ha : MvPowerSeries.HasSubst (constSubst x)) (i : ι) :
    formalEvalAlgHom x ha (MvPowerSeries.X i) = x i := by
  rw [formalEvalAlgHom_apply, formalEval, MvPowerSeries.isEmptyEquiv_apply,
    MvPowerSeries.subst_X ha]
  simp [constSubst]

omit [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] in
/-- If every relation vanishes at `x`, the full generated relation ideal lies
in the kernel of evaluation. -/
theorem relationIdeal_le_ker_formalEval
    (system : FormalSystem ι κ R) (x : ι → R)
    (ha : MvPowerSeries.HasSubst (constSubst x))
    (hsol : formalEvalSystem system x = 0) :
    relationIdeal system ≤ RingHom.ker (formalEvalAlgHom x ha).toRingHom := by
  rw [relationIdeal]
  apply Ideal.span_le.mpr
  intro f hf
  obtain ⟨j, rfl⟩ := hf
  apply RingHom.mem_ker.mpr
  change formalEvalAlgHom x ha (system j) = 0
  rw [formalEvalAlgHom_apply]
  have hj := congrFun hsol j
  simpa [formalEvalSystem] using hj

/-- Evaluation factors through the quotient by the formal relations. -/
def presentedPoint
    (system : FormalSystem ι κ R) (x : ι → R)
    (ha : MvPowerSeries.HasSubst (constSubst x))
    (hsol : formalEvalSystem system x = 0) :
    (MvPowerSeries ι R ⧸ relationIdeal system) →ₐ[R] R :=
  Ideal.Quotient.liftₐ (relationIdeal system) (formalEvalAlgHom x ha)
    (fun _f hf => RingHom.mem_ker.mp
      (relationIdeal_le_ker_formalEval system x ha hsol hf))

omit [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] in
@[simp] theorem presentedPoint_mk
    (system : FormalSystem ι κ R) (x : ι → R)
    (ha : MvPowerSeries.HasSubst (constSubst x))
    (hsol : formalEvalSystem system x = 0)
    (f : MvPowerSeries ι R) :
    presentedPoint system x ha hsol (Ideal.Quotient.mk (relationIdeal system) f) =
      formalEvalAlgHom x ha f := by
  rfl

omit [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ] in
@[simp] theorem presentedPoint_variable
    (system : FormalSystem ι κ R) (x : ι → R)
    (ha : MvPowerSeries.HasSubst (constSubst x))
    (hsol : formalEvalSystem system x = 0) (i : ι) :
    presentedPoint system x ha hsol
      (Ideal.Quotient.mk (relationIdeal system) (MvPowerSeries.X i)) = x i := by
  rw [presentedPoint_mk, formalEvalAlgHom_X]

/--
**Completed-presentation point theorem.** Under the hypotheses of the centered
formal Hensel theorem, the quotient complete local algebra defined by the
formal relations admits an `R`-algebra point whose coordinate values all lie in
`(pi)`.
-/
theorem exists_algebra_point_of_surjective_linearCoefficientMatrix
    (pi : R) (N : ℕ) (hN : 2 ≤ N) (hpiN : pi ^ N = 0)
    (q : R →+* k) (hq : Function.Surjective q)
    (hker : RingHom.ker q = Ideal.span ({pi} : Set R))
    (system : FormalSystem ι κ R)
    (hJ : Function.Surjective
      (matrixLinear ((linearCoefficientMatrix system).map q)))
    (hzero : q ∘ constantCoefficientVector system = 0) :
    ∃ x : ι → R,
      (∀ i, PowDivisible pi 1 (x i)) ∧
      ∃ φ : (MvPowerSeries ι R ⧸ relationIdeal system) →ₐ[R] R,
        ∀ i, φ (Ideal.Quotient.mk (relationIdeal system)
          (MvPowerSeries.X i)) = x i := by
  obtain ⟨x, hx, hsol⟩ :=
    exists_exact_solution_of_residual_zero_and_surjective_linear_part
      pi N hN hpiN q hq hker system hJ hzero
  have ha : MvPowerSeries.HasSubst (constSubst x) :=
    hasSubst_constSubst pi N hpiN x hx
  refine ⟨x, hx, presentedPoint system x ha hsol, ?_⟩
  intro i
  exact presentedPoint_variable system x ha hsol i

end

end Komorebi.StrongArtin.FormalPresentationPoint

#print axioms Komorebi.StrongArtin.FormalPresentationPoint.relationIdeal_le_ker_formalEval
#print axioms Komorebi.StrongArtin.FormalPresentationPoint.exists_algebra_point_of_surjective_linearCoefficientMatrix
