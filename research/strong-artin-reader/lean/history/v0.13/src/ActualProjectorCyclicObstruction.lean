import ProjectorTraceTransverse
import CyclicTransverseObstruction

namespace Komorebi.StrongArtin.ActualProjectorCyclicObstruction

open Komorebi.StrongArtin.ProjectorProbeSurjectivity
open Komorebi.StrongArtin.ProjectorTraceTransverse
open Komorebi.StrongArtin.CyclicTransverseObstruction

noncomputable section

variable {k W ι : Type*} [Field k]
  [AddCommGroup W] [Module k W]

/-- The transverse correction map generated by centered spectral-projector trace
probes, after quotienting out the scalar/cyclic defect line. -/
def centeredProjectorCorrectionMap
    (P : ι → Module.End k W) (i0 : ι)
    (href : LinearMap.trace k W (P i0) ≠ 0) :
    Module.Dual k (ι → k) →ₗ[k]
      Module.Dual k
        (Module.End k W ⧸ (k ∙ (1 : Module.End k W))) :=
  (probeEvalMap
    (quotientProbe
      (k ∙ (1 : Module.End k W))
      (fun i => projectorTraceProbe (centeredProjector (P i) (P i0)))
      (fun i => by
        intro X hX
        rw [Submodule.mem_span_singleton] at hX
        rcases hX with ⟨a, rfl⟩
        exact centeredProjectorProbe_scalar_zero P i0 i href a))).dualMap

/-- Raw separating projector traces imply the centered actual-projector
correction map is surjective on the quotient by the cyclic scalar direction. -/
theorem centeredProjectorCorrectionMap_surjective
    (P : ι → Module.End k W) (i0 : ι)
    (href : LinearMap.trace k W (P i0) ≠ 0)
    (hsep : ∀ X : Module.End k W,
      (∀ i : ι, projectorTraceProbe (P i) X = 0) → X = 0) :
    Function.Surjective (centeredProjectorCorrectionMap P i0 href) := by
  exact centeredProjectorProbes_transverse_dual_surjective P i0 href hsep

/-- **Actual spectral-projector cyclic obstruction theorem.** Under the raw
spectral-projector trace separation hypothesis, centering against one projector
which sees the scalar direction reduces the complete first-order quotient-prime
obstruction to the scalar cyclic residual alone. -/
theorem full_obstruction_eq_zero_iff_cyclic_residual_zero_of_projector_detection
    (P : ι → Module.End k W) (i0 : ι)
    (href : LinearMap.trace k W (P i0) ≠ 0)
    (hsep : ∀ X : Module.End k W,
      (∀ i : ι, projectorTraceProbe (P i) X = 0) → X = 0)
    (b : k × Module.Dual k
      (Module.End k W ⧸ (k ∙ (1 : Module.End k W)))) :
    obstructionClass
        (blockJacobian (0 : k →ₗ[k] k)
          (centeredProjectorCorrectionMap P i0 href)) b = 0 ↔
      b.1 = 0 := by
  apply quotientPrime_blockObstruction_eq_zero_iff_cyclicResidual_zero
  exact centeredProjectorCorrectionMap_surjective P i0 href hsep

/-- Numerical form: after raw projector detection and centering, exactly one
first-order obstruction dimension survives, namely the cyclic scalar defect. -/
theorem full_obstruction_finrank_eq_one_of_projector_detection
    [FiniteDimensional k W]
    (P : ι → Module.End k W) (i0 : ι)
    (href : LinearMap.trace k W (P i0) ≠ 0)
    (hsep : ∀ X : Module.End k W,
      (∀ i : ι, projectorTraceProbe (P i) X = 0) → X = 0) :
    Module.finrank k
      ((k × Module.Dual k
          (Module.End k W ⧸ (k ∙ (1 : Module.End k W)))) ⧸
        LinearMap.range
          (blockJacobian (0 : k →ₗ[k] k)
            (centeredProjectorCorrectionMap P i0 href))) = 1 := by
  apply finrank_blockCoker_eq_one_of_scalar_cyclic
  exact centeredProjectorCorrectionMap_surjective P i0 href hsep

end
end Komorebi.StrongArtin.ActualProjectorCyclicObstruction

