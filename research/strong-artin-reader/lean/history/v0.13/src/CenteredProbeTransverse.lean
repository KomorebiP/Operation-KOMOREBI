import ProjectorProbeSurjectivity

namespace Komorebi.StrongArtin.CenteredProbeTransverse

open Komorebi.StrongArtin.ProjectorProbeSurjectivity

noncomputable section

variable {k V ι : Type*} [Field k]
  [AddCommGroup V] [Module k V]

/-- Center a probe family against a reference probe so that the chosen defect
vector `d` becomes invisible. -/
def centeredProbe (probe : ι → Module.Dual k V) (i0 : ι) (d : V) :
    ι → Module.Dual k V :=
  fun i => probe i - (probe i d / probe i0 d) • probe i0

@[simp] theorem centeredProbe_apply
    (probe : ι → Module.Dual k V) (i0 i : ι) (d v : V) :
    centeredProbe probe i0 d i v =
      probe i v - (probe i d / probe i0 d) * probe i0 v := by
  rfl

/-- Every centered probe kills the reference defect vector, provided the
reference probe actually sees that vector. -/
theorem centeredProbe_defect_zero
    (probe : ι → Module.Dual k V) (i0 i : ι) (d : V)
    (href : probe i0 d ≠ 0) :
    centeredProbe probe i0 d i d = 0 := by
  rw [centeredProbe_apply]
  field_simp [href]
  ring

/-- Hence each centered probe vanishes on the entire one-dimensional defect
line generated by `d`. -/
theorem defectLine_le_centeredProbe_kernel
    (probe : ι → Module.Dual k V) (i0 i : ι) (d : V)
    (href : probe i0 d ≠ 0) :
    k ∙ d ≤ LinearMap.ker (centeredProbe probe i0 d i) := by
  intro v hv
  rw [Submodule.mem_span_singleton] at hv
  rcases hv with ⟨a, rfl⟩
  simp [centeredProbe_defect_zero probe i0 i d href]

/-- **Centering theorem.** If the original probes separate all vectors and one
reference probe is nonzero on the chosen defect vector `d`, then the common
kernel of the centered probes is exactly the line `k • d`.

This converts an ordinary separating projector family into a family which is
blind precisely on one retained cyclic defect direction. -/
theorem centeredProbe_joint_kernel_eq_defectLine
    (probe : ι → Module.Dual k V) (i0 : ι) (d : V)
    (href : probe i0 d ≠ 0)
    (hsep : ∀ v : V, (∀ i : ι, probe i v = 0) → v = 0) :
    {v : V | ∀ i : ι, centeredProbe probe i0 d i v = 0} = (k ∙ d : Set V) := by
  ext v
  constructor
  · intro hv
    let a : k := probe i0 v / probe i0 d
    have hz : v - a • d = 0 := by
      apply hsep
      intro i
      rw [map_sub, map_smul]
      have hi := sub_eq_zero.mp (hv i)
      change probe i v = (probe i d / probe i0 d) * probe i0 v at hi
      rw [hi]
      dsimp [a]
      field_simp [href]
      ring
    have hvad : v = a • d := sub_eq_zero.mp hz
    rw [hvad]
    change a • d ∈ k ∙ d
    exact Submodule.smul_mem _ a (Submodule.mem_span_singleton_self d)
  · intro hv
    rw [SetLike.mem_coe] at hv
    intro i
    exact defectLine_le_centeredProbe_kernel probe i0 i d href hv

/-- Pointwise form: if every centered probe kills `v`, then `v` is a scalar
multiple of the retained defect vector. -/
theorem centeredProbe_kernel_le_defectLine
    (probe : ι → Module.Dual k V) (i0 : ι) (d : V)
    (href : probe i0 d ≠ 0)
    (hsep : ∀ v : V, (∀ i : ι, probe i v = 0) → v = 0)
    (v : V) (hv : ∀ i : ι, centeredProbe probe i0 d i v = 0) :
    v ∈ k ∙ d := by
  have hset := centeredProbe_joint_kernel_eq_defectLine probe i0 d href hsep
  have : v ∈ {v : V | ∀ i : ι, centeredProbe probe i0 d i v = 0} := hv
  rw [hset] at this
  exact this

/-- The centered probes therefore satisfy the transverse-adequacy hypothesis of
`ProjectorProbeSurjectivity` for the retained defect line. -/
theorem centeredProbe_transverse_dual_surjective
    (probe : ι → Module.Dual k V) (i0 : ι) (d : V)
    (href : probe i0 d ≠ 0)
    (hsep : ∀ v : V, (∀ i : ι, probe i v = 0) → v = 0) :
    Function.Surjective
      (probeEvalMap
        (quotientProbe (k ∙ d) (centeredProbe probe i0 d)
          (fun i => defectLine_le_centeredProbe_kernel probe i0 i d href))).dualMap := by
  apply dual_quotientProbe_surjective_of_kernel_le_defect
  exact centeredProbe_kernel_le_defectLine probe i0 d href hsep

end
end Komorebi.StrongArtin.CenteredProbeTransverse

#print axioms Komorebi.StrongArtin.CenteredProbeTransverse.centeredProbe_defect_zero
#print axioms Komorebi.StrongArtin.CenteredProbeTransverse.defectLine_le_centeredProbe_kernel
#print axioms Komorebi.StrongArtin.CenteredProbeTransverse.centeredProbe_joint_kernel_eq_defectLine
#print axioms Komorebi.StrongArtin.CenteredProbeTransverse.centeredProbe_kernel_le_defectLine
#print axioms Komorebi.StrongArtin.CenteredProbeTransverse.centeredProbe_transverse_dual_surjective
