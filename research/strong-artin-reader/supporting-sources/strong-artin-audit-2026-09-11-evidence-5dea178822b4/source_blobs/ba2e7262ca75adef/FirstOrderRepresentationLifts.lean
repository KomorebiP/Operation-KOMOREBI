import RepresentationGaugeH1
import Mathlib.Algebra.TrivSqZeroExt.Basic

/-!
# Actual square-zero first-order representation lifts

A tangent of the representation multiplication equations is equivalently an
actual monoid homomorphism into the trivial square-zero extension of the
endomorphism ring, with prescribed base representation.  The gauge tangent
normalizes to the standard adjoint coboundary, identifying the infinitesimal
strict-equivalence directions at the cohomological level.
-/

namespace Komorebi.StrongArtin.FirstOrderRepresentationLifts

open Representation
open Komorebi.StrongArtin.RepresentationTangentCocycles
open Komorebi.StrongArtin.RepresentationGaugeH1
open TrivSqZeroExt

noncomputable section

universe u

variable {k G V : Type u} [CommRing k] [Group G]
  [AddCommGroup V] [Module k V]

abbrev EndSq (k V : Type u) [CommRing k] [AddCommGroup V] [Module k V] :=
  TrivSqZeroExt (Module.End k V) (Module.End k V)

/-- Actual first-order lifts of `rho` to the trivial square-zero extension of
its endomorphism ring. -/
def FirstOrderLift (rho : Representation k G V) :=
  {L : G →* EndSq k V // ∀ g : G, (L g).fst = rho g}

/-- A representation tangent vanishes at the identity. -/
theorem tangent_apply_one_eq_zero
    (rho : Representation k G V) (delta : representationTangents rho) :
    delta.1 1 = 0 := by
  have h := delta.2 1 1
  rw [one_mul] at h
  simp only [map_one, mul_one, one_mul] at h
  apply add_left_cancel (a := delta.1 1)
  simpa using h.symm

/-- A tangent gives an actual square-zero representation lift. -/
def liftOfTangent (rho : Representation k G V)
    (delta : representationTangents rho) : FirstOrderLift rho := by
  refine ⟨{
    toFun := fun g => (rho g, delta.1 g)
    map_one' := ?_
    map_mul' := ?_
  }, ?_⟩
  · apply TrivSqZeroExt.ext
    · simp
    · simpa using tangent_apply_one_eq_zero rho delta
  · intro g h
    apply TrivSqZeroExt.ext
    · change rho (g * h) = rho g * rho h
      exact map_mul rho g h
    · change delta.1 (g * h) =
        rho g • delta.1 h + MulOpposite.op (rho h) • delta.1 g
      rw [delta.2 g h]
      change delta.1 g * rho h + rho g * delta.1 h =
        rho g * delta.1 h + delta.1 g * rho h
      exact add_comm _ _
  · intro g
    rfl

/-- The infinitesimal coordinate of a square-zero representation lift. -/
def tangentOfLift (rho : Representation k G V)
    (L : FirstOrderLift rho) : representationTangents rho := by
  refine ⟨fun g => (L.1 g).snd, ?_⟩
  intro g h
  have hm := congrArg TrivSqZeroExt.snd (L.1.map_mul g h)
  change (L.1 (g * h)).snd =
    (L.1 g).snd * rho h + rho g * (L.1 h).snd
  rw [hm]
  simp only [TrivSqZeroExt.snd_mul, L.2]
  simp only [smul_eq_mul]
  abel

/-- Representation tangents are exactly actual first-order lifts into the
square-zero endomorphism algebra. -/
def tangentEquivFirstOrderLift (rho : Representation k G V) :
    representationTangents rho ≃ FirstOrderLift rho where
  toFun := liftOfTangent rho
  invFun := tangentOfLift rho
  left_inv delta := by
    apply Subtype.ext
    funext g
    rfl
  right_inv L := by
    apply Subtype.ext
    apply MonoidHom.ext
    intro g
    apply TrivSqZeroExt.ext
    · exact (L.2 g).symm
    · rfl

@[simp] theorem liftOfTangent_fst
    (rho : Representation k G V) (delta : representationTangents rho) (g : G) :
    ((liftOfTangent rho delta).1 g).fst = rho g :=
  rfl

@[simp] theorem liftOfTangent_snd
    (rho : Representation k G V) (delta : representationTangents rho) (g : G) :
    ((liftOfTangent rho delta).1 g).snd = delta.1 g :=
  rfl

/-- Under the normalization equivalence, the gauge tangent generated by `Y`
is the standard adjoint coboundary.  Combined with
`tangentEquivFirstOrderLift`, this identifies infinitesimal strict-equivalence
directions among actual square-zero lifts. -/
theorem firstOrderLift_gauge_normalizes_to_coboundary
    (rho : Representation k G V) (Y : Module.End k V) (g : G) :
    tangentEquivCocycles rho (gaugeTangent rho Y) g =
      (AdRep rho).ρ g Y - Y :=
  tangentEquivCocycles_gauge_apply rho Y g

end

end Komorebi.StrongArtin.FirstOrderRepresentationLifts

#print axioms Komorebi.StrongArtin.FirstOrderRepresentationLifts.tangentEquivFirstOrderLift
