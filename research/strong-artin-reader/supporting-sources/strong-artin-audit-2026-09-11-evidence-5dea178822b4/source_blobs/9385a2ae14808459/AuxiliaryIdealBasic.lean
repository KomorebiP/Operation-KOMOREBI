import AugmentedRelationAlgebra
import Mathlib.RingTheory.Ideal.Quotient.Operations

/-!
# Killing the auxiliary variables recovers the base presentation

The auxiliary-augmented coordinate algebra is a genuine deformation of the
base presented algebra.  Its augmentation ideal is generated by the added
Taylor--Wiles coordinates.  Quotienting by that ideal is canonically
isomorphic to the base coordinate algebra, and the kernel of the augmentation
specialization is exactly the auxiliary ideal.
-/

namespace Komorebi.StrongArtin.AuxiliaryIdealBasic

open Set
open Komorebi.StrongArtin.PolynomialExpressionTaylor
open Komorebi.StrongArtin.PolynomialSystemTaylor
open Komorebi.StrongArtin.ExprMvPolynomial
open Komorebi.StrongArtin.PresentedAlgebraPoint
open Komorebi.StrongArtin.PolynomialRelationAlgebra
open Komorebi.StrongArtin.AuxiliaryAugmentedPolynomialSystem
open Komorebi.StrongArtin.AugmentedRelationAlgebra

noncomputable section

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

variable {R ι κ Aux : Type*} [CommRing R] [DecidableEq Aux]

/-- The ideal generated by all selected auxiliary coordinate classes. -/
def auxiliaryIdeal
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux) :
    Ideal (AugmentedPresentedAlgebra system column Q) :=
  Ideal.span (Set.range fun a : Q =>
    augmentedGenerator system column Q (Sum.inr a))

/-- Every selected auxiliary generator vanishes after quotienting by the
auxiliary ideal. -/
@[simp] theorem auxiliaryGenerator_mk_eq_zero
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux)
    (a : Q) :
    Ideal.Quotient.mk (auxiliaryIdeal system column Q)
      (augmentedGenerator system column Q (Sum.inr a)) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨a, rfl⟩

/-- The auxiliary ideal lies in the kernel of the specialization that sets all
new coordinates to zero. -/
theorem auxiliaryIdeal_le_ker_baseSpecialization
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux) :
    auxiliaryIdeal system column Q ≤
      RingHom.ker (baseSpecialization system column Q).toRingHom := by
  rw [auxiliaryIdeal, Ideal.span_le]
  rintro x ⟨a, rfl⟩
  exact baseSpecialization_auxGenerator system column Q a

/-- The quotient of the augmented algebra by its auxiliary ideal. -/
abbrev AuxiliaryKilledAlgebra
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux) :=
  AugmentedPresentedAlgebra system column Q ⧸ auxiliaryIdeal system column Q

/-- The augmentation specialization descends to the auxiliary-variable
quotient. -/
def auxiliaryQuotientToBase
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux) :
    AuxiliaryKilledAlgebra system column Q →ₐ[R] PresentedAlgebra system :=
  Ideal.Quotient.liftₐ (auxiliaryIdeal system column Q)
    (baseSpecialization system column Q)
    (auxiliaryIdeal_le_ker_baseSpecialization system column Q)

@[simp] theorem auxiliaryQuotientToBase_mk
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux)
    (x : AugmentedPresentedAlgebra system column Q) :
    auxiliaryQuotientToBase system column Q
      (Ideal.Quotient.mk (auxiliaryIdeal system column Q) x) =
        baseSpecialization system column Q x := by
  rfl

/-- The base coordinates viewed in the quotient where all auxiliary variables
have been killed. -/
def baseQuotientCoordinates
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux) :
    ι → AuxiliaryKilledAlgebra system column Q :=
  fun i => Ideal.Quotient.mk (auxiliaryIdeal system column Q)
    (augmentedGenerator system column Q (Sum.inl i))

/-- All augmented quotient coordinates, including the auxiliary coordinates
that become zero. -/
def allQuotientCoordinates
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux) :
    Sum ι Q → AuxiliaryKilledAlgebra system column Q :=
  fun s => Ideal.Quotient.mk (auxiliaryIdeal system column Q)
    (augmentedGenerator system column Q s)

@[simp] theorem allQuotientCoordinates_inl
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux)
    (i : ι) :
    allQuotientCoordinates system column Q (Sum.inl i) =
      baseQuotientCoordinates system column Q i := rfl

@[simp] theorem allQuotientCoordinates_inr
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux)
    (a : Q) :
    allQuotientCoordinates system column Q (Sum.inr a) = 0 := by
  exact auxiliaryGenerator_mk_eq_zero system column Q a

/-- Evaluation at all quotient coordinates is the composite of the two
canonical quotient maps. -/
theorem aeval_allQuotientCoordinates
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux) :
    MvPolynomial.aeval (allQuotientCoordinates system column Q) =
      (Ideal.Quotient.mkₐ R (auxiliaryIdeal system column Q)).comp
        (Ideal.Quotient.mkₐ R
          (relationFamilyIdeal
            (augmentedRelationPolynomial system column Q))) := by
  apply MvPolynomial.algHom_ext
  intro s
  simp [allQuotientCoordinates, augmentedGenerator,
    PolynomialRelationAlgebra.generator, AlgHom.comp_apply]

/-- The surviving base coordinates satisfy the original relations. -/
theorem baseQuotientCoordinates_satisfy
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux) :
    ∀ j, MvPolynomial.aeval (baseQuotientCoordinates system column Q)
      (Expr.toMvPolynomial (system j)) = 0 := by
  letI cr : CommRing (AuxiliaryKilledAlgebra system column Q) := inferInstance
  letI ar : Algebra R (AuxiliaryKilledAlgebra system column Q) := inferInstance
  intro j
  have haug :
      MvPolynomial.aeval (allQuotientCoordinates system column Q)
        (augmentedRelationPolynomial system column Q j) = 0 := by
    rw [aeval_allQuotientCoordinates]
    change Ideal.Quotient.mk (auxiliaryIdeal system column Q)
      (Ideal.Quotient.mk
        (relationFamilyIdeal (augmentedRelationPolynomial system column Q))
        (augmentedRelationPolynomial system column Q j)) = 0
    rw [PolynomialRelationAlgebra.relation_mk_eq_zero]
    exact map_zero (Ideal.Quotient.mk (auxiliaryIdeal system column Q))
  have heval := aeval_augmentedRelationPolynomial system column Q
    (allQuotientCoordinates system column Q) j
  rw [heval] at haug
  have hterm (a : Q) :
      allQuotientCoordinates system column Q (Sum.inr a) *
          algebraMap R _
            (column a.1 j) = 0 := by
    rw [allQuotientCoordinates_inr, zero_mul]
  have hsum :
      (∑ a : Q,
        allQuotientCoordinates system column Q (Sum.inr a) *
          algebraMap R _
            (column a.1 j)) = 0 := by
    exact Finset.sum_eq_zero fun a _ => hterm a
  rw [hsum, add_zero] at haug
  change MvPolynomial.aeval (baseQuotientCoordinates system column Q)
    (Expr.toMvPolynomial (system j)) = 0 at haug
  exact haug

end

end Komorebi.StrongArtin.AuxiliaryIdealBasic

#print axioms Komorebi.StrongArtin.AuxiliaryIdealBasic.baseQuotientCoordinates_satisfy
