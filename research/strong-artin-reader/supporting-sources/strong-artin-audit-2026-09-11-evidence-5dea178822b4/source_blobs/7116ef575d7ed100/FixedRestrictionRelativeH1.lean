import FixedRestrictionTangent

/-!
# Relative first cohomology for fixed-restriction deformations

The tangent space of representation deformations which fix the restriction to a
subgroup maps canonically to global adjoint `H¹`. Its kernel is exactly the
infinitesimal conjugation space generated by endomorphisms centralizing the
fixed restriction. The image consists precisely of classes admitting a cocycle
representative which vanishes on the subgroup.
-/

namespace Komorebi.StrongArtin.FixedRestrictionRelativeH1

open Representation
open groupCohomology
open Komorebi.StrongArtin.RepresentationTangentCocycles
open Komorebi.StrongArtin.RepresentationGaugeH1
open Komorebi.StrongArtin.FixedRestrictionTangent

noncomputable section

universe u

variable {k G V : Type u} [CommRing k] [Group G]
  [AddCommGroup V] [Module k V]

/-- Send a fixed-restriction framed tangent to its global adjoint cohomology
class. -/
def fixedRestrictionTangentToH1
    (rho : Representation k G V) (H : Subgroup G) :
    fixedRestrictionTangents rho H →ₗ[k] H1 (AdRep rho) :=
  (tangentToH1 rho).comp (Submodule.subtype (fixedRestrictionTangents rho H))

@[simp] theorem fixedRestrictionTangentToH1_apply
    (rho : Representation k G V) (H : Subgroup G)
    (delta : fixedRestrictionTangents rho H) :
    fixedRestrictionTangentToH1 rho H delta = tangentToH1 rho delta.1 :=
  rfl

/-- The kernel of the relative tangent-to-`H¹` map is exactly the gauge range
coming from endomorphisms centralizing the fixed restriction. -/
theorem ker_fixedRestrictionTangentToH1
    (rho : Representation k G V) (H : Subgroup G) :
    LinearMap.ker (fixedRestrictionTangentToH1 rho H) =
      fixedRestrictionGaugeRange rho H := by
  ext delta
  rw [LinearMap.mem_ker, fixedRestrictionTangentToH1_apply]
  constructor
  · intro hzero
    have hmem : delta.1 ∈ LinearMap.ker (tangentToH1 rho) := hzero
    rw [ker_tangentToH1 rho] at hmem
    rcases hmem with ⟨Y, hY⟩
    have hcent : Y ∈ restrictionCentralizer rho H := by
      rw [← gaugeTangent_mem_fixedRestriction_iff rho H Y]
      rw [hY]
      exact delta.2
    refine ⟨⟨Y, hcent⟩, ?_⟩
    apply Subtype.ext
    exact hY
  · rintro ⟨Y, hY⟩
    subst delta
    change tangentToH1 rho (gaugeTangent rho Y.1) = 0
    have hmem : gaugeTangent rho Y.1 ∈ gaugeRange rho :=
      ⟨Y.1, rfl⟩
    rw [← ker_tangentToH1 rho] at hmem
    exact hmem

/-- The relative `H¹` image: global classes admitting a fixed-restriction
tangent representative. -/
abbrev RelativeH1Image
    (rho : Representation k G V) (H : Subgroup G) :=
  LinearMap.range (fixedRestrictionTangentToH1 rho H)

/-- The canonical surjection from framed fixed-restriction tangents onto their
intrinsic relative cohomology image. -/
def fixedRestrictionTangentToRelativeH1Image
    (rho : Representation k G V) (H : Subgroup G) :
    fixedRestrictionTangents rho H →ₗ[k] RelativeH1Image rho H :=
  (fixedRestrictionTangentToH1 rho H).rangeRestrict

/-- Every relative `H¹` image class is represented by a fixed-restriction
tangent. -/
theorem fixedRestrictionTangentToRelativeH1Image_surjective
    (rho : Representation k G V) (H : Subgroup G) :
    Function.Surjective (fixedRestrictionTangentToRelativeH1Image rho H) :=
  LinearMap.surjective_rangeRestrict _

/-- The range-restricted map has the same kernel: precisely the allowed
centralizer gauge directions. -/
theorem ker_fixedRestrictionTangentToRelativeH1Image
    (rho : Representation k G V) (H : Subgroup G) :
    LinearMap.ker (fixedRestrictionTangentToRelativeH1Image rho H) =
      fixedRestrictionGaugeRange rho H := by
  rw [fixedRestrictionTangentToRelativeH1Image]
  rw [LinearMap.ker_rangeRestrict]
  exact ker_fixedRestrictionTangentToH1 rho H

/-- Exactness of the fixed-restriction deformation sequence:
centralizer gauge directions are exactly the tangents killed in relative
cohomology. -/
theorem fixedRestrictionGauge_exact_relativeH1
    (rho : Representation k G V) (H : Subgroup G) :
    Function.Exact
      (Submodule.subtype (fixedRestrictionGaugeRange rho H))
      (fixedRestrictionTangentToRelativeH1Image rho H) := by
  rw [LinearMap.exact_iff]
  rw [Submodule.range_subtype]
  exact ker_fixedRestrictionTangentToRelativeH1Image rho H

/-- Membership in the relative image is exactly existence of a
fixed-restriction tangent representative. -/
theorem mem_relativeH1Image_iff
    (rho : Representation k G V) (H : Subgroup G) (c : H1 (AdRep rho)) :
    c ∈ RelativeH1Image rho H ↔
      ∃ delta : fixedRestrictionTangents rho H,
        tangentToH1 rho delta.1 = c := by
  rfl

end

end Komorebi.StrongArtin.FixedRestrictionRelativeH1

#print axioms Komorebi.StrongArtin.FixedRestrictionRelativeH1.ker_fixedRestrictionTangentToH1
#print axioms Komorebi.StrongArtin.FixedRestrictionRelativeH1.fixedRestrictionGauge_exact_relativeH1
