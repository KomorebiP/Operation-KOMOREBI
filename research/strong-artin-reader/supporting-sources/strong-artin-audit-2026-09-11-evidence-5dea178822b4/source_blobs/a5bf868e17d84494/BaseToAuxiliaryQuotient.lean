import AuxiliaryIdealBasic

/-!
# Exact augmentation quotient

Quotienting the auxiliary-augmented presentation by the ideal generated by
the selected auxiliary variables recovers the base presentation exactly.
-/

namespace Komorebi.StrongArtin.BaseToAuxiliaryQuotient

open Komorebi.StrongArtin.PolynomialExpressionTaylor
open Komorebi.StrongArtin.PolynomialSystemTaylor
open Komorebi.StrongArtin.PresentedAlgebraPoint
open Komorebi.StrongArtin.PolynomialRelationAlgebra
open Komorebi.StrongArtin.AugmentedRelationAlgebra
open Komorebi.StrongArtin.AuxiliaryIdealBasic

noncomputable section

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

variable {R ι κ Aux : Type*} [CommRing R] [DecidableEq Aux]

/-- The base presentation maps back into the quotient by the auxiliary ideal. -/

def baseToAuxiliaryQuotient
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux) :
    PresentedAlgebra system →ₐ[R] AuxiliaryKilledAlgebra system column Q := by
  letI cr : CommRing (AuxiliaryKilledAlgebra system column Q) := inferInstance
  letI ar : Algebra R (AuxiliaryKilledAlgebra system column Q) := inferInstance
  exact PresentedAlgebraPoint.pointAlgHom system
    (baseQuotientCoordinates system column Q)
    (baseQuotientCoordinates_satisfy system column Q)

@[simp] theorem baseToAuxiliaryQuotient_generator
    (system : System ι κ R) (column : Aux → (κ → R)) (Q : Finset Aux)
    (i : ι) :
    baseToAuxiliaryQuotient system column Q
      (PresentedAlgebraPoint.generator system i) =
        baseQuotientCoordinates system column Q i := by
  letI cr : CommRing (AuxiliaryKilledAlgebra system column Q) := inferInstance
  letI ar : Algebra R (AuxiliaryKilledAlgebra system column Q) := inferInstance
  change PresentedAlgebraPoint.pointAlgHom system
      (baseQuotientCoordinates system column Q)
      (baseQuotientCoordinates_satisfy system column Q)
      (PresentedAlgebraPoint.generator system i) = _
  exact PresentedAlgebraPoint.pointAlgHom_generator system
    (baseQuotientCoordinates system column Q)
    (baseQuotientCoordinates_satisfy system column Q) i

end

end Komorebi.StrongArtin.BaseToAuxiliaryQuotient

#print axioms Komorebi.StrongArtin.BaseToAuxiliaryQuotient.baseToAuxiliaryQuotient
