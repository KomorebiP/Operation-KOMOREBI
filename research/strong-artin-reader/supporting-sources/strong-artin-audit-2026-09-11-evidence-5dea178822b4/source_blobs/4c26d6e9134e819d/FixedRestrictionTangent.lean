import RepresentationGaugeH1

/-!
# Fixed-restriction representation tangents

For a subgroup `H ≤ G`, fixing the restricted representation means that the
unnormalized tangent vanishes on `H`.  Under the normalization equivalence this
is exactly the subspace of adjoint one-cocycles vanishing on `H`.

The infinitesimal conjugations preserving the fixed restriction are precisely
those generated by endomorphisms centralizing the restricted representation.
-/

namespace Komorebi.StrongArtin.FixedRestrictionTangent

open Representation
open groupCohomology
open Komorebi.StrongArtin.RepresentationTangentCocycles
open Komorebi.StrongArtin.RepresentationGaugeH1

noncomputable section

universe u

variable {k G V : Type u} [CommRing k] [Group G]
  [AddCommGroup V] [Module k V]

/-- Tangent directions which leave the restriction to `H` fixed to first order. -/
def fixedRestrictionTangents (rho : Representation k G V) (H : Subgroup G) :
    Submodule k (representationTangents rho) where
  carrier := {delta | ∀ h : H, delta.1 h.1 = 0}
  zero_mem' := by intro h; rfl
  add_mem' := by
    intro a b ha hb h
    change a.1 h.1 + b.1 h.1 = 0
    rw [ha h, hb h, add_zero]
  smul_mem' := by
    intro c a ha h
    change c • a.1 h.1 = 0
    rw [ha h, smul_zero]

@[simp] theorem mem_fixedRestrictionTangents_iff
    (rho : Representation k G V) (H : Subgroup G)
    (delta : representationTangents rho) :
    delta ∈ fixedRestrictionTangents rho H ↔
      ∀ h : H, delta.1 h.1 = 0 :=
  Iff.rfl

/-- Adjoint cocycles whose restriction to `H` is pointwise zero. -/
def restrictionZeroCocycles (rho : Representation k G V) (H : Subgroup G) :
    Submodule k (cocycles₁ (AdRep rho)) where
  carrier := {f | ∀ h : H, f.1 h.1 = 0}
  zero_mem' := by intro h; rfl
  add_mem' := by
    intro a b ha hb h
    change a.1 h.1 + b.1 h.1 = 0
    rw [ha h, hb h, add_zero]
  smul_mem' := by
    intro c a ha h
    change c • a.1 h.1 = 0
    rw [ha h, smul_zero]

@[simp] theorem mem_restrictionZeroCocycles_iff
    (rho : Representation k G V) (H : Subgroup G)
    (f : cocycles₁ (AdRep rho)) :
    f ∈ restrictionZeroCocycles rho H ↔
      ∀ h : H, f.1 h.1 = 0 :=
  Iff.rfl

/-- Normalization identifies fixed-restriction tangents with adjoint cocycles
vanishing on the fixed subgroup. -/
def fixedRestrictionTangentEquivCocycles
    (rho : Representation k G V) (H : Subgroup G) :
    fixedRestrictionTangents rho H ≃ₗ[k] restrictionZeroCocycles rho H where
  toFun delta := by
    refine ⟨tangentEquivCocycles rho delta.1, ?_⟩
    intro h
    change delta.1.1 h.1 * rho h.1⁻¹ = 0
    rw [delta.2 h, zero_mul]
  invFun f := by
    refine ⟨(tangentEquivCocycles rho).symm f.1, ?_⟩
    intro h
    change f.1.1 h.1 * rho h.1 = 0
    rw [f.2 h, zero_mul]
  left_inv delta := by
    apply Subtype.ext
    exact (tangentEquivCocycles rho).symm_apply_apply delta.1
  right_inv f := by
    apply Subtype.ext
    exact (tangentEquivCocycles rho).apply_symm_apply f.1
  map_add' a b := by
    apply Subtype.ext
    exact map_add (tangentEquivCocycles rho) a.1 b.1
  map_smul' c a := by
    apply Subtype.ext
    exact map_smul (tangentEquivCocycles rho) c a.1

@[simp] theorem fixedRestrictionTangentEquivCocycles_apply
    (rho : Representation k G V) (H : Subgroup G)
    (delta : fixedRestrictionTangents rho H) (g : G) :
    (fixedRestrictionTangentEquivCocycles rho H delta).1 g =
      delta.1.1 g * rho g⁻¹ :=
  rfl

/-- Endomorphisms centralizing the restricted representation. -/
def restrictionCentralizer (rho : Representation k G V) (H : Subgroup G) :
    Submodule k (Module.End k V) where
  carrier := {Y | ∀ h : H, rho h.1 * Y = Y * rho h.1}
  zero_mem' := by intro h; simp
  add_mem' := by
    intro Y Z hY hZ h
    simp only [mul_add, add_mul, hY h, hZ h]
  smul_mem' := by
    intro c Y hY h
    simp only [mul_smul_comm, smul_mul_assoc, hY h]

@[simp] theorem mem_restrictionCentralizer_iff
    (rho : Representation k G V) (H : Subgroup G) (Y : Module.End k V) :
    Y ∈ restrictionCentralizer rho H ↔
      ∀ h : H, rho h.1 * Y = Y * rho h.1 :=
  Iff.rfl

/-- A gauge direction preserves the fixed restriction exactly when its generator
centralizes the restricted representation. -/
theorem gaugeTangent_mem_fixedRestriction_iff
    (rho : Representation k G V) (H : Subgroup G) (Y : Module.End k V) :
    gaugeTangent rho Y ∈ fixedRestrictionTangents rho H ↔
      Y ∈ restrictionCentralizer rho H := by
  constructor
  · intro hY h
    have hz := hY h
    change rho h.1 * Y - Y * rho h.1 = 0 at hz
    exact sub_eq_zero.mp hz
  · intro hY h
    change rho h.1 * Y - Y * rho h.1 = 0
    exact sub_eq_zero.mpr (hY h)

/-- Infinitesimal gauge transformations allowed by the fixed-restriction
problem. -/
def fixedRestrictionGaugeTangent
    (rho : Representation k G V) (H : Subgroup G) :
    restrictionCentralizer rho H →ₗ[k] fixedRestrictionTangents rho H where
  toFun Y := ⟨gaugeTangent rho Y.1,
    (gaugeTangent_mem_fixedRestriction_iff rho H Y.1).2 Y.2⟩
  map_add' Y Z := by
    apply Subtype.ext
    exact map_add (gaugeTangent rho) Y.1 Z.1
  map_smul' c Y := by
    apply Subtype.ext
    exact map_smul (gaugeTangent rho) c Y.1

/-- The fixed-restriction gauge subspace. -/
def fixedRestrictionGaugeRange
    (rho : Representation k G V) (H : Subgroup G) :
    Submodule k (fixedRestrictionTangents rho H) :=
  LinearMap.range (fixedRestrictionGaugeTangent rho H)

/-- Allowed fixed-restriction gauge directions normalize to the corresponding
adjoint coboundaries and continue to vanish on `H`. -/
theorem fixedRestrictionGauge_normalize_apply
    (rho : Representation k G V) (H : Subgroup G)
    (Y : restrictionCentralizer rho H) (g : G) :
    (fixedRestrictionTangentEquivCocycles rho H
      (fixedRestrictionGaugeTangent rho H Y)).1 g =
      (AdRep rho).ρ g Y.1 - Y.1 := by
  exact tangentEquivCocycles_gauge_apply rho Y.1 g

end

end Komorebi.StrongArtin.FixedRestrictionTangent

#print axioms Komorebi.StrongArtin.FixedRestrictionTangent.fixedRestrictionTangentEquivCocycles
#print axioms Komorebi.StrongArtin.FixedRestrictionTangent.gaugeTangent_mem_fixedRestriction_iff
