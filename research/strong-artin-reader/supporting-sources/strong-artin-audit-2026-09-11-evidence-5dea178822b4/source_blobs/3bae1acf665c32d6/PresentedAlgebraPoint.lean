import ExprMvPolynomial
import Mathlib.Algebra.MvPolynomial.Rename
import Mathlib.RingTheory.Ideal.Quotient.Over

/-!
# Points of a finitely presented coordinate algebra

A finite polynomial system determines a quotient of the universal
multivariable polynomial algebra.  Algebra homomorphisms from that quotient
are exactly coordinate solutions of the defining equations.
-/

namespace Komorebi.StrongArtin.PresentedAlgebraPoint

open Set
open Komorebi.StrongArtin.PolynomialExpressionTaylor
open Komorebi.StrongArtin.PolynomialSystemTaylor
open Komorebi.StrongArtin.ExprMvPolynomial

noncomputable section

variable {R S ι κ : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The ideal generated by the equations of a coordinate polynomial system. -/
def relationIdeal (system : System ι κ R) : Ideal (MvPolynomial ι R) :=
  Ideal.span (Set.range fun j => Expr.toMvPolynomial (system j))

/-- The affine coordinate algebra represented by a finite polynomial system. -/
abbrev PresentedAlgebra (system : System ι κ R) :=
  MvPolynomial ι R ⧸ relationIdeal system

/-- The universal coordinate in the presented algebra. -/
def generator (system : System ι κ R) (i : ι) : PresentedAlgebra system :=
  Ideal.Quotient.mk (relationIdeal system) (MvPolynomial.X i)

/-- A solution of the defining equations in an arbitrary `R`-algebra. -/
def Solution (system : System ι κ R) (S : Type*) [CommRing S] [Algebra R S] :=
  {x : ι → S // ∀ j, MvPolynomial.aeval x (Expr.toMvPolynomial (system j)) = 0}

/-- Every defining relation vanishes in the presented algebra. -/
@[simp] theorem relation_mk_eq_zero (system : System ι κ R) (j : κ) :
    Ideal.Quotient.mk (relationIdeal system)
      (Expr.toMvPolynomial (system j)) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨j, rfl⟩

/-- Evaluation at a solution kills the complete relation ideal. -/
theorem aeval_vanishes_relationIdeal
    (system : System ι κ R) (x : ι → S)
    (hx : ∀ j, MvPolynomial.aeval x (Expr.toMvPolynomial (system j)) = 0) :
    ∀ p, p ∈ relationIdeal system → (MvPolynomial.aeval x) p = 0 := by
  intro p hp
  have hle : relationIdeal system ≤ RingHom.ker (MvPolynomial.aeval x).toRingHom := by
    rw [relationIdeal, Ideal.span_le]
    rintro y ⟨j, rfl⟩
    exact hx j
  exact hle hp

/-- Evaluating universal polynomials at the quotient generators is exactly the quotient map. -/
theorem aeval_generator_eq_mk (system : System ι κ R) :
    MvPolynomial.aeval (generator system) =
      Ideal.Quotient.mkₐ R (relationIdeal system) := by
  apply MvPolynomial.algHom_ext
  intro i
  simp [generator]

/-- A coordinate solution induces an algebra point of the presented algebra. -/
def pointAlgHom (system : System ι κ R) (x : ι → S)
    (hx : ∀ j, MvPolynomial.aeval x (Expr.toMvPolynomial (system j)) = 0) :
    PresentedAlgebra system →ₐ[R] S :=
  AlgHom.mk
    (Ideal.Quotient.lift (relationIdeal system)
      (MvPolynomial.aeval x).toRingHom
      (aeval_vanishes_relationIdeal system x hx))
    (by
      intro r
      change (Ideal.Quotient.lift (relationIdeal system)
        (MvPolynomial.aeval x).toRingHom
        (aeval_vanishes_relationIdeal system x hx))
          (Ideal.Quotient.mk (relationIdeal system) (MvPolynomial.C r)) =
            (algebraMap R S) r
      rw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.aeval_C x r)

@[simp] theorem pointAlgHom_mk
    (system : System ι κ R) (x : ι → S)
    (hx : ∀ j, MvPolynomial.aeval x (Expr.toMvPolynomial (system j)) = 0)
    (p : MvPolynomial ι R) :
    pointAlgHom system x hx (Ideal.Quotient.mk (relationIdeal system) p) =
      MvPolynomial.aeval x p := by
  rfl

@[simp] theorem pointAlgHom_generator
    (system : System ι κ R) (x : ι → S)
    (hx : ∀ j, MvPolynomial.aeval x (Expr.toMvPolynomial (system j)) = 0)
    (i : ι) :
    pointAlgHom system x hx (generator system i) = x i := by
  simp [generator]

/-- Coordinates extracted from an algebra point. -/
def coordinates (system : System ι κ R)
    (φ : PresentedAlgebra system →ₐ[R] S) : ι → S :=
  fun i => φ (generator system i)

/-- Pulling a point back to the polynomial algebra is evaluation at its extracted coordinates. -/
theorem comp_mk_eq_aeval_coordinates
    (system : System ι κ R) (φ : PresentedAlgebra system →ₐ[R] S) :
    φ.comp (Ideal.Quotient.mkₐ R (relationIdeal system)) =
      MvPolynomial.aeval (coordinates system φ) := by
  apply MvPolynomial.algHom_ext
  intro i
  simp [coordinates, generator, AlgHom.comp_apply]

/-- Coordinates extracted from a point satisfy every defining relation. -/
theorem coordinates_satisfy
    (system : System ι κ R) (φ : PresentedAlgebra system →ₐ[R] S) :
    ∀ j, MvPolynomial.aeval (coordinates system φ)
      (Expr.toMvPolynomial (system j)) = 0 := by
  intro j
  rw [← comp_mk_eq_aeval_coordinates system φ]
  change φ (Ideal.Quotient.mk (relationIdeal system)
    (Expr.toMvPolynomial (system j))) = 0
  rw [relation_mk_eq_zero]
  exact map_zero φ

/-- Algebra points of the presentation are exactly solutions of its equations. -/
def pointEquivSolution (system : System ι κ R) :
    (PresentedAlgebra system →ₐ[R] S) ≃ Solution system S where
  toFun φ := ⟨coordinates system φ, coordinates_satisfy system φ⟩
  invFun x := pointAlgHom system x.1 x.2
  left_inv φ := by
    apply Ideal.Quotient.algHom_ext R
    apply MvPolynomial.algHom_ext
    intro i
    simp [coordinates, generator]
  right_inv x := by
    apply Subtype.ext
    funext i
    exact pointAlgHom_generator system x.1 x.2 i

end

end Komorebi.StrongArtin.PresentedAlgebraPoint

#print axioms Komorebi.StrongArtin.PresentedAlgebraPoint.pointAlgHom
#print axioms Komorebi.StrongArtin.PresentedAlgebraPoint.pointEquivSolution
