import RepresentationTangentCocycles
import Mathlib.Tactic.NoncommRing

/-!
# Gauge directions and first cohomology

Infinitesimal strict conjugation gives the coboundary subspace.  Therefore the
tangent space of representation equations modulo gauge is canonically the
first group cohomology of the adjoint representation.
-/

namespace Komorebi.StrongArtin.RepresentationGaugeH1

open Representation
open groupCohomology
open Komorebi.StrongArtin.RepresentationTangentCocycles

noncomputable section

universe u

variable {k G V : Type u} [CommRing k] [Group G]
  [AddCommGroup V] [Module k V]

/-- The tangent generated by infinitesimal strict conjugation.  Its normalization
is the standard adjoint one-coboundary `g • Y - Y`. -/
def gaugeTangent (rho : Representation k G V) :
    Module.End k V →ₗ[k] representationTangents rho where
  toFun Y := ⟨fun g => rho g * Y - Y * rho g, by
    intro g h
    change rho (g * h) * Y - Y * rho (g * h) =
      (rho g * Y - Y * rho g) * rho h +
        rho g * (rho h * Y - Y * rho h)
    rw [map_mul]
    noncomm_ring⟩
  map_add' Y Z := by
    apply Subtype.ext
    funext g
    change rho g * (Y + Z) - (Y + Z) * rho g =
      (rho g * Y - Y * rho g) + (rho g * Z - Z * rho g)
    noncomm_ring
  map_smul' c Y := by
    apply Subtype.ext
    funext g
    change rho g * (c • Y) - (c • Y) * rho g =
      c • (rho g * Y - Y * rho g)
    simp only [mul_smul_comm, smul_mul_assoc, smul_sub]

/-- The subspace of tangent directions coming from infinitesimal conjugation. -/
def gaugeRange (rho : Representation k G V) :
    Submodule k (representationTangents rho) :=
  LinearMap.range (gaugeTangent rho)

/-- After normalization, a gauge tangent is exactly the standard adjoint
one-coboundary. -/
theorem tangentEquivCocycles_gauge_apply
    (rho : Representation k G V) (Y : Module.End k V) (g : G) :
    tangentEquivCocycles rho (gaugeTangent rho Y) g =
      (AdRep rho).ρ g Y - Y := by
  change ((rho g * Y - Y * rho g) * rho g⁻¹) =
    (rho g ∘ₗ Y ∘ₗ rho g⁻¹) - Y
  simp only [Module.End.mul_eq_comp]
  ext x
  simp [LinearMap.comp_apply, LinearMap.sub_apply]

/-- The canonical map from representation tangents to adjoint `H¹`. -/
def tangentToH1 (rho : Representation k G V) :
    representationTangents rho →ₗ[k] H1 (AdRep rho) :=
  (H1π (AdRep rho)).hom.comp (tangentToCocycle rho)

@[simp] theorem tangentToH1_apply
    (rho : Representation k G V) (delta : representationTangents rho) :
    tangentToH1 rho delta = H1π (AdRep rho) (tangentEquivCocycles rho delta) :=
  rfl

/-- Every adjoint cohomology class is represented by a representation tangent. -/
theorem tangentToH1_surjective (rho : Representation k G V) :
    Function.Surjective (tangentToH1 rho) := by
  intro h
  refine H1_induction_on h ?_
  intro f
  refine ⟨(tangentEquivCocycles rho).symm f, ?_⟩
  rw [tangentToH1_apply, LinearEquiv.apply_symm_apply]

/-- The kernel of the tangent-to-cohomology map is precisely the infinitesimal
strict-conjugation subspace. -/
theorem ker_tangentToH1 (rho : Representation k G V) :
    LinearMap.ker (tangentToH1 rho) = gaugeRange rho := by
  ext delta
  rw [LinearMap.mem_ker, tangentToH1_apply, H1π_eq_zero_iff]
  constructor
  · intro h
    rcases h with ⟨Y, hY⟩
    refine ⟨Y, ?_⟩
    apply (tangentEquivCocycles rho).injective
    apply Subtype.ext
    funext g
    have hYg := congrFun hY g
    change (AdRep rho).ρ g Y - Y =
      (tangentEquivCocycles rho delta) g at hYg
    exact (tangentEquivCocycles_gauge_apply rho Y g).trans hYg
  · rintro ⟨Y, rfl⟩
    refine ⟨Y, ?_⟩
    funext g
    exact (tangentEquivCocycles_gauge_apply rho Y g).symm

/-- The intrinsic first-order deformation tangent: representation-equation
tangents modulo infinitesimal strict conjugation. -/
abbrev DeformationTangentH1 (rho : Representation k G V) :=
  representationTangents rho ⧸ gaugeRange rho

/-- Tangents to the representation equations modulo gauge are exactly the first
group cohomology of the adjoint representation. -/
def deformationTangentEquivH1 (rho : Representation k G V) :
    DeformationTangentH1 rho ≃ₗ[k] H1 (AdRep rho) := by
  let e := (tangentToH1 rho).quotKerEquivOfSurjective
    (tangentToH1_surjective rho)
  rw [ker_tangentToH1 rho] at e
  exact e


end

end Komorebi.StrongArtin.RepresentationGaugeH1

#print axioms Komorebi.StrongArtin.RepresentationGaugeH1.deformationTangentEquivH1
