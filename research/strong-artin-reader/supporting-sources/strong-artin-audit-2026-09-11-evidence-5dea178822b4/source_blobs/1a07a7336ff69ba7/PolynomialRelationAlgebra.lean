import Mathlib.Algebra.MvPolynomial.Rename
import Mathlib.RingTheory.Ideal.Quotient.Over

/-!
# Algebra points of a finite polynomial relation family

A family of multivariable polynomial relations defines an affine quotient
algebra.  Algebra homomorphisms from that quotient are exactly simultaneous
zeros of the relations in the target algebra.
-/

namespace Komorebi.StrongArtin.PolynomialRelationAlgebra

open Set

noncomputable section

variable {R S ι κ : Type*} [CommRing R] [CommRing S] [Algebra R S]

/-- The ideal generated by a family of multivariable polynomial relations. -/
def relationFamilyIdeal (relation : κ → MvPolynomial ι R) :
    Ideal (MvPolynomial ι R) :=
  Ideal.span (Set.range relation)

/-- The coordinate algebra presented by a family of relations. -/
abbrev RelationAlgebra (relation : κ → MvPolynomial ι R) :=
  MvPolynomial ι R ⧸ relationFamilyIdeal relation

/-- The universal coordinate class in a relation algebra. -/
def generator (relation : κ → MvPolynomial ι R) (i : ι) :
    RelationAlgebra relation :=
  Ideal.Quotient.mk (relationFamilyIdeal relation) (MvPolynomial.X i)

/-- Simultaneous solutions of a relation family in an `R`-algebra. -/
def Solution (relation : κ → MvPolynomial ι R)
    (S : Type*) [CommRing S] [Algebra R S] :=
  {x : ι → S // ∀ j, MvPolynomial.aeval x (relation j) = 0}

@[simp] theorem relation_mk_eq_zero
    (relation : κ → MvPolynomial ι R) (j : κ) :
    Ideal.Quotient.mk (relationFamilyIdeal relation) (relation j) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨j, rfl⟩

/-- Evaluation at a solution kills the complete generated relation ideal. -/
theorem aeval_vanishes_relationFamilyIdeal
    (relation : κ → MvPolynomial ι R) (x : ι → S)
    (hx : ∀ j, MvPolynomial.aeval x (relation j) = 0) :
    ∀ p, p ∈ relationFamilyIdeal relation → (MvPolynomial.aeval x) p = 0 := by
  intro p hp
  have hle : relationFamilyIdeal relation ≤
      RingHom.ker (MvPolynomial.aeval x).toRingHom := by
    rw [relationFamilyIdeal, Ideal.span_le]
    rintro y ⟨j, rfl⟩
    exact hx j
  exact hle hp

/-- Evaluation at the quotient generators is the quotient map. -/
theorem aeval_generator_eq_mk (relation : κ → MvPolynomial ι R) :
    MvPolynomial.aeval (generator relation) =
      Ideal.Quotient.mkₐ R (relationFamilyIdeal relation) := by
  apply MvPolynomial.algHom_ext
  intro i
  simp [generator]

/-- A simultaneous zero defines an algebra point of the relation algebra. -/
def pointAlgHom (relation : κ → MvPolynomial ι R) (x : ι → S)
    (hx : ∀ j, MvPolynomial.aeval x (relation j) = 0) :
    RelationAlgebra relation →ₐ[R] S :=
  AlgHom.mk
    (Ideal.Quotient.lift (relationFamilyIdeal relation)
      (MvPolynomial.aeval x).toRingHom
      (aeval_vanishes_relationFamilyIdeal relation x hx))
    (by
      intro r
      change (Ideal.Quotient.lift (relationFamilyIdeal relation)
        (MvPolynomial.aeval x).toRingHom
        (aeval_vanishes_relationFamilyIdeal relation x hx))
          (Ideal.Quotient.mk (relationFamilyIdeal relation) (MvPolynomial.C r)) =
            (algebraMap R S) r
      rw [Ideal.Quotient.lift_mk]
      exact MvPolynomial.aeval_C x r)

@[simp] theorem pointAlgHom_mk
    (relation : κ → MvPolynomial ι R) (x : ι → S)
    (hx : ∀ j, MvPolynomial.aeval x (relation j) = 0)
    (p : MvPolynomial ι R) :
    pointAlgHom relation x hx
        (Ideal.Quotient.mk (relationFamilyIdeal relation) p) =
      MvPolynomial.aeval x p := by
  rfl

@[simp] theorem pointAlgHom_generator
    (relation : κ → MvPolynomial ι R) (x : ι → S)
    (hx : ∀ j, MvPolynomial.aeval x (relation j) = 0) (i : ι) :
    pointAlgHom relation x hx (generator relation i) = x i := by
  simp [generator]

/-- Coordinates extracted from an algebra point. -/
def coordinates (relation : κ → MvPolynomial ι R)
    (φ : RelationAlgebra relation →ₐ[R] S) : ι → S :=
  fun i => φ (generator relation i)

theorem comp_mk_eq_aeval_coordinates
    (relation : κ → MvPolynomial ι R)
    (φ : RelationAlgebra relation →ₐ[R] S) :
    φ.comp (Ideal.Quotient.mkₐ R (relationFamilyIdeal relation)) =
      MvPolynomial.aeval (coordinates relation φ) := by
  apply MvPolynomial.algHom_ext
  intro i
  simp [coordinates, generator, AlgHom.comp_apply]

/-- Coordinates of any algebra point satisfy the defining relations. -/
theorem coordinates_satisfy
    (relation : κ → MvPolynomial ι R)
    (φ : RelationAlgebra relation →ₐ[R] S) :
    ∀ j, MvPolynomial.aeval (coordinates relation φ) (relation j) = 0 := by
  intro j
  rw [← comp_mk_eq_aeval_coordinates relation φ]
  change φ (Ideal.Quotient.mk (relationFamilyIdeal relation) (relation j)) = 0
  rw [relation_mk_eq_zero]
  exact map_zero φ

/-- The universal property of a finitely related coordinate algebra. -/
def pointEquivSolution (relation : κ → MvPolynomial ι R) :
    (RelationAlgebra relation →ₐ[R] S) ≃ Solution relation S where
  toFun φ := ⟨coordinates relation φ, coordinates_satisfy relation φ⟩
  invFun x := pointAlgHom relation x.1 x.2
  left_inv φ := by
    apply Ideal.Quotient.algHom_ext R
    apply MvPolynomial.algHom_ext
    intro i
    simp [coordinates, generator]
  right_inv x := by
    apply Subtype.ext
    funext i
    exact pointAlgHom_generator relation x.1 x.2 i

end

end Komorebi.StrongArtin.PolynomialRelationAlgebra

#print axioms Komorebi.StrongArtin.PolynomialRelationAlgebra.pointAlgHom
#print axioms Komorebi.StrongArtin.PolynomialRelationAlgebra.pointEquivSolution
