LinearMap.leftInverse.{u_3, u_4, u_5} {K : Type u_3} {V : Type u_4} {V' : Type u_5} [DivisionRing K] [AddCommGroup V]
  [AddCommGroup V'] [Module K V] [Module K V'] (f : V →ₗ[K] V') : V' →ₗ[K] V
LinearMap.leftInverse_apply_of_inj.{u_3, u_4, u_5} {K : Type u_3} {V : Type u_4} {V' : Type u_5} [DivisionRing K]
  [AddCommGroup V] [AddCommGroup V'] [Module K V] [Module K V'] {f : V →ₗ[K] V'} (h_inj : f.ker = ⊥) (x : V) :
  f.leftInverse (f x) = x
Submodule.mem_map.{u_1, u_2, u_4, u_5} {R : Type u_1} {R₂ : Type u_2} {M : Type u_4} {M₂ : Type u_5} [Semiring R]
  [Semiring R₂] [AddCommMonoid M] [AddCommMonoid M₂] [Module R M] [Module R₂ M₂] {σ₁₂ : R →+* R₂}
  [RingHomSurjective σ₁₂] {f : M →ₛₗ[σ₁₂] M₂} {p : Submodule R M} {x : M₂} : x ∈ Submodule.map f p ↔ ∃ y ∈ p, f y = x
Subspace.dualLift.{u_1, u_2} {K : Type u_1} {V : Type u_2} [Field K] [AddCommGroup V] [Module K V] (W : Subspace K V) :
  Module.Dual K ↥W →ₗ[K] Module.Dual K V
