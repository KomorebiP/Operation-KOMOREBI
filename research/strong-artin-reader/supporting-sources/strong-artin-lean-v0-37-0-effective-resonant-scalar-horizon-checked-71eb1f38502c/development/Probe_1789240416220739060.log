map_ofNat.{u_3, u_4, u_5} {R : Type u_3} {S : Type u_4} {F : Type u_5} [NonAssocSemiring R] [NonAssocSemiring S]
  [FunLike F R S] [RingHomClass F R S] (f : F) (n : ℕ) [n.AtLeastTwo] : f (OfNat.ofNat n) = OfNat.ofNat n
map_natCast.{u_3, u_4, u_5} {R : Type u_3} {S : Type u_4} {F : Type u_5} [NonAssocSemiring R] [NonAssocSemiring S]
  [FunLike F R S] [RingHomClass F R S] (f : F) (n : ℕ) : f ↑n = ↑n
padicValNat_self {p : ℕ} [Fact (Nat.Prime p)] : padicValNat p p = 1
padicValNat.prime_pow {p : ℕ} [hp : Fact (Nat.Prime p)] (n : ℕ) : padicValNat p (p ^ n) = n
Pi.isUnit_iff.{u_1, u_2} {ι : Type u_1} {M : ι → Type u_2} [(i : ι) → Monoid (M i)] {x : (i : ι) → M i} :
  IsUnit x ↔ ∀ (i : ι), IsUnit (x i)
