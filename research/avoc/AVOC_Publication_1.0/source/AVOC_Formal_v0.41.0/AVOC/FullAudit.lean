open Lean Elab Command
run_cmd do
  let env ← getEnv
  let names : List String := ["_private.AVOC.RobustQuoteExamples.0.Komorebi.AVOC.Affine.RobustQuoteExamples.warm_supported", "_private.AVOC.RobustQuoteExamples.0.Komorebi.AVOC.Affine.RobustQuoteExamples.warm_confirmed"]
  let mut found := 0
  for (name, _) in env.constants.toList do
    if names.contains name.toString then
      found := found + 1
      let axioms ← collectAxioms name
      logInfo m!"'{name.toString}' depends on axioms: {axioms.qsort Name.lt |>.map MessageData.ofConstName |>.toList}"
  unless found = 2 do throwError "private declaration inventory mismatch"
