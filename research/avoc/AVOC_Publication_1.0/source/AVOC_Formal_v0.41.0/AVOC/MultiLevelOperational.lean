import AVOC.AffineTerminal
import AVOC.MultiLevelRank

namespace Komorebi.AVOC.Affine.MultiLevelOperational

set_option linter.unusedSectionVars false

open Komorebi.AVOC.MultiLevel
open Komorebi.AVOC.Affine.MultiLevelRank
open Komorebi.AVOC.Affine.Terminal

variable {R : Type} [Field R] [DecidableEq R] {n m : Nat}
variable {Ω P : Type*} [Fintype Ω] [DecidableEq Ω] [Fintype P] [DecidableEq P]

/-- Infrastructure failures are not algebraic reports. -/
inductive AttemptResult (α : Type*) where
  | report (value : α)
  | fault
  deriving Repr, DecidableEq

/-- Exact report contract for one retained catalogue world. -/
def ProbeMatches (c : Catalogue R Ω P n m) (s : State (model c))
    (w : Ω) (p : P) (o : Bool) : Prop :=
  w ∈ s.worlds ∧ p ∈ s.remaining ∧ o = (model c).detects p w

/-- A probe report advances the controller only when it is the exact report for
one retained actual world and the probe is currently available. -/
noncomputable def acknowledgeProbe (c : Catalogue R Ω P n m) (s : State (model c))
    (w : Ω) (p : P) (result : AttemptResult Bool) : Option (State (model c)) := by
  classical
  exact match result with
    | .fault => none
    | .report o => if ProbeMatches c s w p o then some (step (model c) s (.probe p) o) else none

@[simp] theorem fault_is_not_probe_report (c : Catalogue R Ω P n m)
    (s : State (model c)) (w : Ω) (p : P) :
    acknowledgeProbe c s w p .fault = none := rfl

theorem matching_probe_accepted (c : Catalogue R Ω P n m)
    (s : State (model c)) (w : Ω) (p : P) (o : Bool)
    (h : ProbeMatches c s w p o) :
    acknowledgeProbe c s w p (.report o) = some (step (model c) s (.probe p) o) := by
  classical
  simp [acknowledgeProbe,h]

theorem mismatching_probe_rejected (c : Catalogue R Ω P n m)
    (s : State (model c)) (w : Ω) (p : P) (o : Bool)
    (h : ¬ ProbeMatches c s w p o) :
    acknowledgeProbe c s w p (.report o) = none := by
  classical
  simp [acknowledgeProbe,h]

theorem acknowledged_probe_exact (c : Catalogue R Ω P n m)
    (s : State (model c)) (w : Ω) (p : P) (o : Bool) (t : State (model c))
    (h : acknowledgeProbe c s w p (.report o) = some t) :
    ProbeMatches c s w p o ∧ t = step (model c) s (.probe p) o := by
  classical
  simp only [acknowledgeProbe] at h
  split at h
  next hm => exact ⟨hm,(Option.some.inj h).symm⟩
  next _ => simp at h

/-- The actual retained world survives its own exact report update. -/
theorem actual_world_retained (c : Catalogue R Ω P n m)
    (s : State (model c)) (w : Ω) (p : P) (o : Bool)
    (h : ProbeMatches c s w p o) :
    w ∈ (step (model c) s (.probe p) o).worlds := by
  rcases h with ⟨hw,_hp,ho⟩
  subst o
  cases hd : (model c).detects p w with
  | false =>
      have hdet : detects (c.matrix w) (c.probe p) = false := by
        simpa only [model_detects] using hd
      have hm : w ∈ failureWorlds (model c) s p :=
        Finset.mem_filter.mpr ⟨hw,by simp [hdet]⟩
      have hn : (failureWorlds (model c) s p).Nonempty := ⟨w,hm⟩
      simpa [step,afterFailure,hn,hd] using hm
  | true =>
      have hdet : detects (c.matrix w) (c.probe p) = true := by
        simpa only [model_detects] using hd
      have hm : w ∈ successWorlds (model c) s p :=
        Finset.mem_filter.mpr ⟨hw,by exact hdet⟩
      have hn : (successWorlds (model c) s p).Nonempty := ⟨w,hm⟩
      simpa [step,afterSuccess,hn,hd] using hm

/-- An exact report generated by a retained world has strictly positive model probability. -/
theorem actual_report_positive_probability (c : Catalogue R Ω P n m)
    (s : State (model c)) (w : Ω) (p : P) (o : Bool)
    (h : ProbeMatches c s w p o) :
    0 < probability (model c) s (.probe p) o := by
  rcases h with ⟨hw,_hp,ho⟩
  subst o
  cases hd : (model c).detects p w with
  | true =>
      have hdet : detects (c.matrix w) (c.probe p) = true := by
        simpa only [model_detects] using hd
      have hm : w ∈ successWorlds (model c) s p :=
        Finset.mem_filter.mpr ⟨hw,hdet⟩
      have hn : (successWorlds (model c) s p).Nonempty := ⟨w,hm⟩
      change 0 < successProb (model c) s p
      exact (successProb_pos_iff (model c) s p).2 hn
  | false =>
      have hdet : detects (c.matrix w) (c.probe p) = false := by
        simpa only [model_detects] using hd
      have hm : w ∈ failureWorlds (model c) s p :=
        Finset.mem_filter.mpr ⟨hw,by simp [hdet]⟩
      have hc : 0 < (failureWorlds (model c) s p).card :=
        Finset.card_pos.mpr ⟨w,hm⟩
      have hdcard : (0 : ℚ) < s.worlds.card := by exact_mod_cast worlds_card_pos s
      have hratio : (0 : ℚ) < (failureWorlds (model c) s p).card / s.worlds.card :=
        div_pos (by exact_mod_cast hc) hdcard
      change 0 < 1 - successProb (model c) s p
      rw [one_sub_successProb]
      exact hratio

theorem acknowledged_probe_preserves_rank (c : Catalogue R Ω P n m)
    (s : State (model c)) (hs : RankSound c s) (w : Ω) (p : P) (o : Bool)
    (t : State (model c))
    (h : acknowledgeProbe c s w p (.report o) = some t) : RankSound c t := by
  obtain ⟨_hm,rfl⟩ := acknowledged_probe_exact c s w p o t h
  exact rankSound_step c s (.probe p) o hs

/-- Terminal operation evidence. The deployment proof is kept separate from an
operational fault or missing result. -/
inductive TerminalResult (n m : Nat) where
  | success (deployment : Deployment n m)
  | fault

/-- Terminal evidence is accepted only for the matching action and an available
controller action. -/
noncomputable def acknowledgeTerminal (md : Model Ω P) (s : State md) (a : Action P)
    (result : TerminalResult n m) : Option (State md) := by
  classical
  exact match result with
    | .fault => none
    | .success d =>
        if a ∈ actions md s ∧
            ((a = .reuse ∧ d.kind = .warm) ∨ (a = .cold ∧ d.kind = .cold)) then
          some (terminal s)
        else none

@[simp] theorem terminal_fault_rejected (md : Model Ω P) (s : State md) (a : Action P) :
    acknowledgeTerminal (n:=n) (m:=m) md s a .fault = none := rfl

theorem matching_terminal_accepted (md : Model Ω P) (s : State md) (a : Action P)
    (d : Deployment n m) (ha : a ∈ actions md s)
    (hk : (a = .reuse ∧ d.kind = .warm) ∨ (a = .cold ∧ d.kind = .cold)) :
    acknowledgeTerminal md s a (.success d) = some (terminal s) := by
  simp [acknowledgeTerminal,ha,hk]

theorem accepted_terminal_exact (md : Model Ω P) (s : State md) (a : Action P)
    (d : Deployment n m) (t : State md)
    (h : acknowledgeTerminal md s a (.success d) = some t) :
    a ∈ actions md s ∧
      ((a = .reuse ∧ d.kind = .warm) ∨ (a = .cold ∧ d.kind = .cold)) ∧
      t = terminal s := by
  classical
  simp only [acknowledgeTerminal] at h
  split at h
  next hm => exact ⟨hm.1,hm.2,(Option.some.inj h).symm⟩
  next _ => simp at h

theorem accepted_terminal_deployment_correct (md : Model Ω P) (s : State md)
    (a : Action P) (d : Deployment n m) (t : State md)
    (_h : acknowledgeTerminal md s a (.success d) = some t) :
    (∀ x, execute d.selected x = execute d.source x) ∧
      executionCost d.selected ≤ executionCost d.source := by
  exact ⟨d.correct,d.noWorse⟩

theorem accepted_terminal_preserves_rank (c : Catalogue R Ω P n m)
    (s : State (model c)) (hs : RankSound c s) (a : Action P)
    (d : Deployment n m) (t : State (model c))
    (h : acknowledgeTerminal (model c) s a (.success d) = some t) : RankSound c t := by
  obtain ⟨_ha,_hk,rfl⟩ := accepted_terminal_exact (model c) s a d t h
  exact rankSound_terminal c s hs

/-- The implementation records model discrepancy without converting it into an
algebraic observation. -/
def terminalDiscrepancy (md : Model Ω P) (s : State md) (a : Action P)
    (d : Deployment n m) (calls : Nat) : ℚ :=
  |reward md s a - d.payoff calls|

theorem discrepancy_is_absolute_error (md : Model Ω P) (s : State md)
    (a : Action P) (d : Deployment n m) (calls : Nat) :
    terminalDiscrepancy md s a d calls = |reward md s a - d.payoff calls| := rfl

end Komorebi.AVOC.Affine.MultiLevelOperational
