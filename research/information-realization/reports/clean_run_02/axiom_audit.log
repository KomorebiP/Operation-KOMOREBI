KomorebiInformation.Haar.characteristic_two_collision :
  have x := ![1, 0, 0, 0];
  have y := ![0, 1, 0, 0];
  KomorebiInformation.Haar.coarse x = KomorebiInformation.Haar.coarse y ∧
    KomorebiInformation.Haar.detail x = KomorebiInformation.Haar.detail y ∧ x ≠ y
