import Lean
import KTG.HodgeReduct

/-!
# Local valuation hulls: an IUT-inspired realization test

A structured toy model of two different saturations of a nonzero local
field carrier: multiplication by valuation-zero units, and multiplication
by arbitrary nonnegative-valuation scalars.  The actual IUT holomorphic
hull/prime-strip data are NOT defined here.  Nothing about IUT III or ABC
is assumed or concluded.
-/

namespace KTG
namespace ValuationBridge

universe u

/-- A nonzero multiplicative carrier with an integral valuation.  We record
only the algebraic laws needed to form and measure quotients.  Standard
nonarchimedean local fields restricted to nonzero elements are examples.
We do not require that `carrier` be a Lean field. -/
structure ValuationShell (α : Type u) where
  mul : α → α → α
  div : α → α → α
  ord : α → Int
  ord_mul : ∀ x y, ord (mul x y) = ord x + ord y
  ord_div : ∀ x y, ord (div x y) = ord x - ord y
  div_mul_cancel : ∀ x y, mul (div x y) y = x

/-- The valuation-zero (unit) subgroup as a predicate. -/
def IsUnit {α : Type u} (V : ValuationShell α) (x : α) : Prop :=
  V.ord x = 0

/-- The local *unit orbit* of a collection of nonzero elements. -/
def UnitSaturation {α : Type u}
    (V : ValuationShell α) (R : α → Prop) (x : α) : Prop :=
  ∃ (a : α), R a ∧ ∃ (u : α), IsUnit V u ∧ x = V.mul u a

/-- The local *integral-multiplier closure*: allow multipliers of
nonnegative valuation, not just units. It models the nonzero part of the
`O`-module generated by a region in the simplest DVR setting. -/
def IntegralSaturation {α : Type u}
    (V : ValuationShell α) (R : α → Prop) (x : α) : Prop :=
  ∃ (a : α), R a ∧ ∃ (u : α), 0 ≤ V.ord u ∧ x = V.mul u a

/-- **Exact unit-orbit criterion**: unit multiples preserve the level and,
conversely, equality of levels produces a unit multiplier via division. -/
theorem unitSaturation_iff_sameOrd
    {α : Type u} (V : ValuationShell α) (R : α → Prop) (x : α) :
    UnitSaturation V R x ↔
      ∃ a, R a ∧ V.ord x = V.ord a := by
  constructor
  · rintro ⟨a, ha, u, hu, rfl⟩
    refine ⟨a, ha, ?_⟩
    rw [V.ord_mul, hu]
    simp
  · rintro ⟨a, ha, heq⟩
    refine ⟨a, ha, V.div x a, ?_, ?_⟩
    · unfold IsUnit
      rw [V.ord_div, heq]
      simp
    · exact (V.div_mul_cancel x a).symm

/-- **Exact integral-hull criterion**: multiplication by local integral
scalars can only increase valuation, and every increase is realizable. -/
theorem integralSaturation_iff_geOrd
    {α : Type u} (V : ValuationShell α) (R : α → Prop) (x : α) :
    IntegralSaturation V R x ↔
      ∃ a, R a ∧ V.ord a ≤ V.ord x := by
  constructor
  · rintro ⟨a, ha, u, hu, rfl⟩
    refine ⟨a, ha, ?_⟩
    rw [V.ord_mul]
    omega
  · rintro ⟨a, ha, hle⟩
    refine ⟨a, ha, V.div x a, ?_, ?_⟩
    · rw [V.ord_div]
      omega
    · exact (V.div_mul_cancel x a).symm

/-- Unit saturation does not exceed integral saturation. -/
theorem unitSaturation_subset_integralSaturation
    {α : Type u} (V : ValuationShell α) (R : α → Prop) (x : α)
    (h : UnitSaturation V R x) : IntegralSaturation V R x := by
  obtain ⟨a, ha, u, hu, hmul⟩ := h
  exact ⟨a, ha, u, by simp [IsUnit] at hu; omega, hmul⟩

/-- Unit saturation is already an invariant of the valuation-level image.
No additive reconstruction or ring identification is needed. -/
theorem unitSaturation_iff_equal_val_image
    {α : Type u} (V : ValuationShell α)
    (R S : α → Prop) (h : ∀ n : Int,
      (∃ a, R a ∧ V.ord a = n) ↔ (∃ a, S a ∧ V.ord a = n))
    (x : α) :
    UnitSaturation V R x ↔ UnitSaturation V S x := by
  rw [unitSaturation_iff_sameOrd, unitSaturation_iff_sameOrd]
  constructor
  · rintro ⟨a, ha, hval⟩
    obtain ⟨b, hb, hbval⟩ := (h (V.ord x)).mp ⟨a, ha, hval.symm⟩
    exact ⟨b, hb, hbval.symm⟩
  · rintro ⟨a, ha, hval⟩
    obtain ⟨b, hb, hbval⟩ := (h (V.ord x)).mpr ⟨a, ha, hval.symm⟩
    exact ⟨b, hb, hbval.symm⟩

/-- **Obstruction**: units alone cannot reach any valuation level absent
from the input region. -/
theorem unitSaturation_absent_level
    {α : Type u} (V : ValuationShell α)
    (R : α → Prop) (x : α)
    (h : ∀ a, R a → V.ord x ≠ V.ord a) :
    ¬ UnitSaturation V R x := by
  intro hx
  obtain ⟨a, ha, heq⟩ := (unitSaturation_iff_sameOrd V R x).mp hx
  exact h a ha heq

/-- **Stronger obstruction**: even taking the local integral hull cannot
create a pilot of strictly shallower valuation than every output. -/
theorem integralSaturation_excludes_shallower
    {α : Type u} (V : ValuationShell α)
    (R : α → Prop) (x : α)
    (h : ∀ a, R a → V.ord x < V.ord a) :
    ¬ IntegralSaturation V R x := by
  intro hx
  obtain ⟨a, ha, hle⟩ := (integralSaturation_iff_geOrd V R x).mp hx
  have hlt := h a ha
  omega

/-- Unit action cannot change valuation, whether or not it preserves addition. -/
theorem unit_action_preserves_ord
    {α : Type u} (V : ValuationShell α) (u x : α)
    (hu : IsUnit V u) : V.ord (V.mul u x) = V.ord x := by
  rw [V.ord_mul, hu]
  simp

/-- Invariance also holds for the unit-saturated region itself. -/
theorem unitSaturation_action_iff
    {α : Type u} (V : ValuationShell α) (R : α → Prop)
    (u x : α) (hu : IsUnit V u) :
    UnitSaturation V R (V.mul u x) ↔ UnitSaturation V R x := by
  rw [unitSaturation_iff_sameOrd, unitSaturation_iff_sameOrd]
  simp only [unit_action_preserves_ord V u x hu]

/-- Concrete nontrivial shell: two independent integer coordinates, the
first a valuation level and the second a unit-phase coordinate. -/
def phaseShell : ValuationShell (Int × Int) where
  mul := fun x y => (x.1 + y.1, x.2 + y.2)
  div := fun x y => (x.1 - y.1, x.2 - y.2)
  ord := Prod.fst
  ord_mul := by intros; rfl
  ord_div := by intros; rfl
  div_mul_cancel := by
    intro x y
    apply Prod.ext
    · exact Int.sub_add_cancel _ _
    · exact Int.sub_add_cancel _ _

/-- At level 4, a unit orbit can alter the phase but not the level. -/
theorem phase_example_unit_orbit :
    UnitSaturation phaseShell (fun a => a = ((4 : Int), (0 : Int))) (4, 100) := by
  apply (unitSaturation_iff_sameOrd _ _ _).mpr
  exact ⟨(4, 0), rfl, rfl⟩

/-- In the same example the q-pilot at level 1 cannot be produced even by
nonnegative-valuation multipliers. -/
theorem phase_example_no_integral_lift :
    ¬ IntegralSaturation phaseShell
      (fun a => a = ((4 : Int), (0 : Int))) (1, 99) := by
  apply integralSaturation_excludes_shallower
  intro a ha
  subst a
  decide

/-- Level 6 is in the integral hull of level 4, but not the unit orbit. -/
theorem phase_example_integral_not_unit :
    IntegralSaturation phaseShell
        (fun a => a = ((4 : Int), (0 : Int))) (6, 99) ∧
      ¬ UnitSaturation phaseShell
        (fun a => a = ((4 : Int), (0 : Int))) (6, 99) := by
  constructor
  · apply (integralSaturation_iff_geOrd _ _ _).mpr
    exact ⟨(4, 0), rfl, by decide⟩
  · apply unitSaturation_absent_level
    intro a ha
    subst a
    decide

end ValuationBridge
end KTG
