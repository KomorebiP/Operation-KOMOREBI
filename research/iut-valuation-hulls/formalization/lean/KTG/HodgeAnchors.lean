import KTG.HodgeFinite

/-!
# A stronger finite marked-addition obstruction over F17

The multiplicative involution x -> x^9 fixes the complete cyclic subgroup
<2> (order eight), hence fixes 1+1=2.  Nonetheless it does not preserve
addition generally.  Even one additional labelled additive anchor is not
sufficient to reconstruct the full addition law from multiplication.

All claims are about the deliberately specified finite-field model, not IUT.
-/

namespace KTG
namespace HodgeBridge

/-- Multiplicative involution with exponent 9 on F17. -/
def twist17 (x : Fin 17) : Fin 17 := x ^ 9

theorem twist17_involution :
    ∀ x : Fin 17, twist17 (twist17 x) = x := by decide

theorem twist17_multiplicative :
    ∀ x y : Fin 17, twist17 (x * y) = twist17 x * twist17 y := by decide

theorem twist17_preserves_zero : twist17 0 = 0 := by decide

theorem twist17_preserves_one : twist17 1 = 1 := by decide

theorem twist17_preserves_two : twist17 2 = 2 := by decide

/-- Every element of the eight-element subgroup generated by 2 is fixed. -/
theorem twist17_fixes_orderEight_subgroup :
    ∀ x : Fin 17, x ^ 8 = 1 → twist17 x = x := by decide

def standard17 : ArithmeticLayer (Fin 17) where
  zero := 0
  one := 1
  add := fun x y => x + y
  mul := fun x y => x * y

def twistLink17 : MultiplicativeLink standard17 standard17 where
  toFun := twist17
  invFun := twist17
  left_inv := twist17_involution
  right_inv := twist17_involution
  map_mul := twist17_multiplicative
  map_zero := twist17_preserves_zero
  map_one := twist17_preserves_one

def alien17 : ArithmeticLayer (Fin 17) :=
  transportedLayer standard17 twistLink17

theorem alien17_one_plus_one : alien17.add 1 1 = 2 := by decide

theorem standard17_one_plus_one : standard17.add 1 1 = 2 := by decide

/-- The next additive anchor distinguishes the transported structure. -/
theorem alien17_one_plus_two : alien17.add 1 2 = 14 := by decide

theorem standard17_one_plus_two : standard17.add 1 2 = 3 := by decide

def observedCoarse17 (A : ArithmeticLayer (Fin 17)) :
    (Fin 17 → Fin 17 → Fin 17) × Fin 17 :=
  (A.mul, A.add 1 1)

def observedOnePlusTwo17 (A : ArithmeticLayer (Fin 17)) : Fin 17 :=
  A.add 1 2

/-- The observer retains *all multiplication* and one labelled additive
fact, 1+1=2; still it cannot distinguish the two valid field additions. -/
theorem same_reduct_and_first_additive_anchor :
    observedCoarse17 standard17 = observedCoarse17 alien17 := by
  unfold observedCoarse17
  apply Prod.ext
  · rfl
  · exact standard17_one_plus_one.trans alien17_one_plus_one.symm

theorem first_new_additive_anchor_separates :
    observedOnePlusTwo17 standard17 ≠ observedOnePlusTwo17 alien17 := by decide

/-- Information-theoretic non-reconstruction with the *stronger* public
view: complete multiplication together with the 1+1 observation. -/
theorem no_reconstruction_from_first_additive_anchor :
    ¬ Nonempty (FactorsThrough observedCoarse17 observedOnePlusTwo17) := by
  exact differing_fiber_blocks_reconstruction
    observedCoarse17 observedOnePlusTwo17
    same_reduct_and_first_additive_anchor
    first_new_additive_anchor_separates

end HodgeBridge
end KTG
