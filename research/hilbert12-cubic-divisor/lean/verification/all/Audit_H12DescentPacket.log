H12DescentPacket.packet_intertwiner_phase (r a b j : Int) :
  H12DescentPacket.phase (4 * r) a b j + H12DescentPacket.quad r (2 * (j + b)) - H12DescentPacket.quad r (2 * j) -
      H12DescentPacket.phase r (2 * a + b) (2 * b) (2 * j) =
    7 * (2 * r * b * j)
'H12DescentPacket.packet_intertwiner_phase' depends on axioms: [propext, Classical.choice, Quot.sound]
H12DescentPacket.packet_three_lift_phase (r j : Int) :
  H12DescentPacket.quad (2 * r) (2 * j) + H12DescentPacket.quad (4 * r) (4 * j) + H12DescentPacket.quad r (8 * j) -
      3 * H12DescentPacket.quad r j =
    7 * (38 * r * j ^ 2)
'H12DescentPacket.packet_three_lift_phase' depends on axioms: [propext, Classical.choice, Quot.sound]
