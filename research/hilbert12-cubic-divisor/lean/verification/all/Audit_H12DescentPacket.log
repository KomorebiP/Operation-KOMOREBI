H12DescentPacket.weyl_product_phase (r a b c d j : Int) :
  H12DescentPacket.phase r c d j + H12DescentPacket.phase r a b (j + d) - H12DescentPacket.phase r (a + c) (b + d) j -
      4 * r * (a * d - b * c) =
    -7 * r * a * d
'H12DescentPacket.weyl_product_phase' depends on axioms: [propext, Classical.choice, Quot.sound]
H12DescentPacket.weyl_periodic_index (r a b j k : Int) :
  H12DescentPacket.phase r a b (j + 7 * k) - H12DescentPacket.phase r a b j = 7 * (r * a * k)
