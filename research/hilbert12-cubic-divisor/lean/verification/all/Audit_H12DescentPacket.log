H12DescentPacket.weyl_periodic_labels (r a b j k l : Int) :
  H12DescentPacket.phase r (a + 7 * k) (b + 7 * l) j - H12DescentPacket.phase r a b j =
    7 * r * (k * j + 4 * a * l + 4 * k * b + 28 * k * l)
'H12DescentPacket.weyl_periodic_labels' depends on axioms: [propext, Classical.choice, Quot.sound]
H12DescentPacket.shear_lift_phase (r a b j : Int) :
  -H12DescentPacket.quad r j + H12DescentPacket.phase r a b j + H12DescentPacket.quad r (j + b) -
      H12DescentPacket.phase r (a + 4 * b) b j =
    -14 * r * b ^ 2
