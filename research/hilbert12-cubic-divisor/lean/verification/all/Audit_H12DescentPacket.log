H12DescentPacket.rotation_packet_phase (r a b j : Int) :
  H12DescentPacket.phase (2 * r) a b j - H12DescentPacket.phase r (4 * a) (4 * b) (4 * j) =
    -7 * (2 * r * a * j + 8 * r * a * b)
