H12.ThreeStepTransport.actual_unit_cube.{u_1} {A : Type u_1} [CommRing A] (v : H12.ThreeStepTransport.Vec A) :
  H12.ThreeStepTransport.backward (H12.ThreeStepTransport.backward (H12.ThreeStepTransport.backward v)) =
    H12.ThreeStepTransport.cubeMap v
'H12.ThreeStepTransport.actual_unit_cube' depends on axioms: [propext, Quot.sound]
H12.ThreeStepTransport.actual_three_step_carry (b c a : ℚ) :
  H12.ThreeStepTransport.cubeMap (b / 2, c / 2, 1 / 3 + a / 2) =
    (b / 2 + (H12.ThreeStepTransport.oneCarry b c a).1, c / 2 + (H12.ThreeStepTransport.oneCarry b c a).2.1,
      1 / 3 + a / 2 + (H12.ThreeStepTransport.oneCarry b c a).2.2)
'H12.ThreeStepTransport.actual_three_step_carry' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.ThreeStepTransport.all_iterates_affine (n : ℕ) (b c a : ℤ) :
  H12.ThreeStepTransport.accum n b c a =
    H12.ThreeStepTransport.mix b c a (H12.ThreeStepTransport.accum n 0 0 0) (H12.ThreeStepTransport.accum n 1 0 0)
      (H12.ThreeStepTransport.accum n 0 1 0) (H12.ThreeStepTransport.accum n 0 0 1)
'H12.ThreeStepTransport.all_iterates_affine' depends on axioms: [propext, Quot.sound]
H12.ThreeStepTransport.all_iterates_eta_affine (n : ℕ) (b c a : ℤ) :
  H12.ThreeStepTransport.eta n b c a =
    H12.ThreeStepTransport.eta n 0 0 0 + b * (H12.ThreeStepTransport.eta n 1 0 0 - H12.ThreeStepTransport.eta n 0 0 0) +
        c * (H12.ThreeStepTransport.eta n 0 1 0 - H12.ThreeStepTransport.eta n 0 0 0) +
      a * (H12.ThreeStepTransport.eta n 0 0 1 - H12.ThreeStepTransport.eta n 0 0 0)
'H12.ThreeStepTransport.all_iterates_eta_affine' depends on axioms: [propext, Quot.sound]
