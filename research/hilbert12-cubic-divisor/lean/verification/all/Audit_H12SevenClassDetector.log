H12SevenClassDetector.root_two : (2 * 2 + 2 + 1) % 7 = 0
'H12SevenClassDetector.root_two' does not depend on any axioms
H12SevenClassDetector.root_four : (4 * 4 + 4 + 1) % 7 = 0
'H12SevenClassDetector.root_four' does not depend on any axioms
H12SevenClassDetector.eval_twist_two (a b : Int) : -b + 2 * (a - b) - 2 * (a + 2 * b) = -7 * b
'H12SevenClassDetector.eval_twist_two' depends on axioms: [propext, Quot.sound]
H12SevenClassDetector.eval_twist_four (a b : Int) : -b + 4 * (a - b) - 4 * (a + 4 * b) = -21 * b
'H12SevenClassDetector.eval_twist_four' depends on axioms: [propext, Quot.sound]
H12SevenClassDetector.fixed_at_two (x y z : Fin 7) :
  H12SevenClassDetector.fixedAt 2 ↑x ↑y ↑z ↔ ↑y = 2 * ↑x % 7 ∧ ↑z = 4 * ↑x % 7
'H12SevenClassDetector.fixed_at_two' does not depend on any axioms
H12SevenClassDetector.fixed_at_four (x y z : Fin 7) :
  H12SevenClassDetector.fixedAt 4 ↑x ↑y ↑z ↔ ↑x = 0 ∧ ↑y = 0 ∧ ↑z = 0
'H12SevenClassDetector.fixed_at_four' does not depend on any axioms
H12SevenClassDetector.coefficient_recovery (a b k : Fin 7) :
  (↑a + 2 * ↑b) % 7 = ↑k ∧ (↑a + 4 * ↑b) % 7 = 0 ↔ ↑a = 2 * ↑k % 7 ∧ ↑b = 3 * ↑k % 7
'H12SevenClassDetector.coefficient_recovery' does not depend on any axioms
H12SevenClassDetector.selector_formula (a b12 b21 c : Int) :
  c - a + 2 * (-a - b12 + b21) = c - 3 * a - 2 * b12 + 2 * b21
'H12SevenClassDetector.selector_formula' depends on axioms: [propext, Quot.sound]
H12SevenClassDetector.model_selector : (-5 + 2 * 3) % 7 = 1 ∧ (-5 + 4 * 3) % 7 = 0
'H12SevenClassDetector.model_selector' does not depend on any axioms
