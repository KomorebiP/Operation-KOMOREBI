H12.SignedGeometry.affine_gauge_spectrum (k : Fin 8) :
  H12.SignedGeometry.walsh (H12.SignedGeometry.affine (-4) 3 3 3) k =
    if ↑k = 0 then 4 else if ↑k = 1 ∨ ↑k = 2 ∨ ↑k = 4 then -12 else 0
