H12.SignedGeometry.one_step_gain (k : Fin 8) :
  H12.SignedGeometry.walsh (H12.SignedGeometry.affine 5 4 (-2) 7) k =
    if ↑k = 0 then 76 else if ↑k = 1 then -28 else if ↑k = 2 then 8 else if ↑k = 4 then -16 else 0
'H12.SignedGeometry.one_step_gain' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.SignedGeometry.three_step_gain (k : Fin 8) :
  H12.SignedGeometry.walsh (H12.SignedGeometry.affine 630 471 (-246) 945) k =
    if ↑k = 0 then 9720 else if ↑k = 1 then -3780 else if ↑k = 2 then 984 else if ↑k = 4 then -1884 else 0
