H12.SignedGeometry.gauge_rotation_invariant (i : Fin 8) :
  H12.SignedGeometry.affine (-4) 3 3 3 (H12.SignedGeometry.rotate i) = H12.SignedGeometry.affine (-4) 3 3 3 i
'H12.SignedGeometry.gauge_rotation_invariant' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.SignedGeometry.high_subspace_rotation (k : Fin 8) :
  ↑k = 3 ∨ ↑k = 5 ∨ ↑k = 6 ∨ ↑k = 7 ↔
    ↑(H12.SignedGeometry.rotate k) = 3 ∨
      ↑(H12.SignedGeometry.rotate k) = 5 ∨ ↑(H12.SignedGeometry.rotate k) = 6 ∨ ↑(H12.SignedGeometry.rotate k) = 7
'H12.SignedGeometry.high_subspace_rotation' depends on axioms: [propext, Quot.sound]
H12.SignedGeometry.walsh_add.{u_2} {A : Type u_2} [AddCommGroup A] (x y : Fin 8 → A) (k : Fin 8) :
  H12.SignedGeometry.walsh (fun i => x i + y i) k = H12.SignedGeometry.walsh x k + H12.SignedGeometry.walsh y k
'H12.SignedGeometry.walsh_add' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.SignedGeometry.walsh_zsmul.{u_2} {A : Type u_2} [AddCommGroup A] (n : Fin 8 → ℤ) (a : A) (k : Fin 8) :
  H12.SignedGeometry.walsh (fun i => n i • a) k = H12.SignedGeometry.walsh n k • a
'H12.SignedGeometry.walsh_zsmul' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.SignedGeometry.walsh_aggregate.{u_2} {A : Type u_2} [AddCommGroup A] (x : Fin 8 → A) :
  H12.SignedGeometry.walsh x 0 +
          (H12.SignedGeometry.walsh x 1 + H12.SignedGeometry.walsh x 2 + H12.SignedGeometry.walsh x 4) +
        (H12.SignedGeometry.walsh x 3 + H12.SignedGeometry.walsh x 5 + H12.SignedGeometry.walsh x 6) +
      H12.SignedGeometry.walsh x 7 =
    8 • x 0
