H12.SignedGeometry.rotate_cube (i : Fin 8) :
  H12.SignedGeometry.rotate (H12.SignedGeometry.rotate (H12.SignedGeometry.rotate i)) = i
'H12.SignedGeometry.rotate_cube' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.SignedGeometry.character_transport (k i : Fin 8) :
  H12.SignedGeometry.chi (H12.SignedGeometry.rotate k) (H12.SignedGeometry.rotate i) = H12.SignedGeometry.chi k i
'H12.SignedGeometry.character_transport' depends on axioms: [propext, Quot.sound]
H12.SignedGeometry.walsh_transport.{u_2} {A : Type u_2} [AddCommGroup A] (x : Fin 8 → A) (k : Fin 8) :
  H12.SignedGeometry.walsh (fun i => x (H12.SignedGeometry.rotate i)) k =
    H12.SignedGeometry.walsh x (H12.SignedGeometry.rotate k)
'H12.SignedGeometry.walsh_transport' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.SignedGeometry.walsh_inversion.{u_2} {A : Type u_2} [AddCommGroup A] (x : Fin 8 → A) (k : Fin 8) :
  H12.SignedGeometry.walsh (H12.SignedGeometry.walsh x) k = 8 • x k
'H12.SignedGeometry.walsh_inversion' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.SignedGeometry.affine_spectrum.{u_1} {K : Type u_1} [CommRing K] (u db dc da : K) (k : Fin 8) :
  H12.SignedGeometry.walsh (H12.SignedGeometry.affine u db dc da) k =
    if ↑k = 0 then 8 * u + 4 * db + 4 * dc + 4 * da
    else if ↑k = 1 then -4 * da else if ↑k = 2 then -4 * dc else if ↑k = 4 then -4 * db else 0
'H12.SignedGeometry.affine_spectrum' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.SignedGeometry.quadratic_top_cancellation.{u_1} {K : Type u_1} [CommRing K] (u db dc da : K) :
