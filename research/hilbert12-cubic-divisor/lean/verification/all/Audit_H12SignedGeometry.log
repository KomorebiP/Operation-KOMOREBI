H12.SignedGeometry.quadratic_pair_110.{u_1} {K : Type u_1} [CommRing K] (u db dc da : K) :
  H12.SignedGeometry.walsh (fun i => H12.SignedGeometry.affine u db dc da i ^ 2) 6 = 4 * db * dc
