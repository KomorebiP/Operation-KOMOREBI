H12.ConjugationRelations.sigma_order_three (x : H12.ConjugationRelations.V) :
  H12.ConjugationRelations.sigma (H12.ConjugationRelations.sigma (H12.ConjugationRelations.sigma x)) = x
'H12.ConjugationRelations.sigma_order_three' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.ConjugationRelations.kappa_involution (x : H12.ConjugationRelations.V) :
  H12.ConjugationRelations.kappa (H12.ConjugationRelations.kappa x) = x
'H12.ConjugationRelations.kappa_involution' depends on axioms: [propext]
H12.ConjugationRelations.dihedral_relation (x : H12.ConjugationRelations.V) :
  H12.ConjugationRelations.kappa (H12.ConjugationRelations.sigma (H12.ConjugationRelations.kappa x)) =
    H12.ConjugationRelations.sigma (H12.ConjugationRelations.sigma x)
'H12.ConjugationRelations.dihedral_relation' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.ConjugationRelations.residue_rotation (x : H12.ConjugationRelations.V) :
  H12.ConjugationRelations.residue (H12.ConjugationRelations.sigma x) = H12.ConjugationRelations.residue x
'H12.ConjugationRelations.residue_rotation' depends on axioms: [propext, Quot.sound]
H12.ConjugationRelations.rotation_kernel_exact (x : H12.ConjugationRelations.V) :
  H12.ConjugationRelations.residue x = 0 ↔ ∃ y, H12.ConjugationRelations.rotationRelation y = x
'H12.ConjugationRelations.rotation_kernel_exact' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.ConjugationRelations.residue_surjective (n : Int) : ∃ x, H12.ConjugationRelations.residue x = n % 3
'H12.ConjugationRelations.residue_surjective' depends on axioms: [propext]
H12.ConjugationRelations.full_relation_lattice (x : H12.ConjugationRelations.V) :
  H12.ConjugationRelations.add (H12.ConjugationRelations.rotationRelation (-x.fst, 0))
      (H12.ConjugationRelations.reflectionRelation (-(x.fst + x.snd), 0)) =
    x
'H12.ConjugationRelations.full_relation_lattice' depends on axioms: [propext, Quot.sound]
H12.ConjugationRelations.primitive_relation :
  H12.ConjugationRelations.add (H12.ConjugationRelations.rotationRelation (-1, 0))
      (H12.ConjugationRelations.reflectionRelation (-1, 0)) =
    (1, 0)
