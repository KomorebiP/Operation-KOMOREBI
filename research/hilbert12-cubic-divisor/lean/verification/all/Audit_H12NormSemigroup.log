H12.NormSemigroup.all_residue_products (a b : Fin 10) :
  H12.NormSemigroup.action (H12.NormSemigroup.residueProduct a b) =
    H12.NormSemigroup.multiply (H12.NormSemigroup.action a) (H12.NormSemigroup.action b)
'H12.NormSemigroup.all_residue_products' does not depend on any axioms
H12.NormSemigroup.residue_product (m n : ℕ) :
  H12.NormSemigroup.residue (m * n) =
    H12.NormSemigroup.residueProduct (H12.NormSemigroup.residue m) (H12.NormSemigroup.residue n)
'H12.NormSemigroup.residue_product' depends on axioms: [propext]
H12.NormSemigroup.norm_matrix_multiplicative (m n : ℕ) :
  H12.NormSemigroup.normMatrix (m * n) =
    H12.NormSemigroup.multiply (H12.NormSemigroup.normMatrix m) (H12.NormSemigroup.normMatrix n)
'H12.NormSemigroup.norm_matrix_multiplicative' depends on axioms: [propext]
