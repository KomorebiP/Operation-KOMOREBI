H12PrincipalModel.alpha_carry (v : H12PrincipalModel.P) :
  H12PrincipalModel.alpha (H12PrincipalModel.principal v) =
    -H12PrincipalModel.beta v + 7 * (v.snd.snd.fst - v.snd.snd.snd.fst)
'H12PrincipalModel.alpha_carry' depends on axioms: [propext, Quot.sound]
H12PrincipalModel.beta_carry (v : H12PrincipalModel.P) :
  H12PrincipalModel.beta (H12PrincipalModel.principal v) =
    7 * (v.fst - 3 * v.snd.snd.fst - 2 * v.snd.snd.snd.fst + 7 * v.snd.snd.snd.snd.snd)
'H12PrincipalModel.beta_carry' depends on axioms: [propext, Quot.sound]
H12PrincipalModel.principal_wedge_zero (a b : Int) : H12PrincipalModel.wedge (-a) 0 (-b) 0 = 0
'H12PrincipalModel.principal_wedge_zero' depends on axioms: [propext]
H12PrincipalModel.principal_label_square (a b : Int) :
  have transform := fun v => (-v.snd, 0);
  transform (transform (a, b)) = (0, 0)
'H12PrincipalModel.principal_label_square' does not depend on any axioms
