H12.NormProjector.projector_idempotent (v : H12.NormProjector.Pair) :
  H12.NormProjector.evenNorm (H12.NormProjector.evenNorm v) = H12.NormProjector.evenNorm v
'H12.NormProjector.projector_idempotent' depends on axioms: [propext]
H12.NormProjector.theta_axis_fixed (a : ℤ) :
  H12.NormProjector.evenNorm (H12.NormProjector.thetaAxis a) = H12.NormProjector.thetaAxis a
'H12.NormProjector.theta_axis_fixed' depends on axioms: [propext]
H12.NormProjector.primitive_axis_killed (b : ℤ) :
  H12.NormProjector.evenNorm (H12.NormProjector.primitiveAxis b) = (0, 0)
'H12.NormProjector.primitive_axis_killed' depends on axioms: [propext]
H12.NormProjector.kernel_exact (v : H12.NormProjector.Pair) :
  H12.NormProjector.evenNorm v = (0, 0) ↔ v = H12.NormProjector.primitiveAxis v.2
'H12.NormProjector.kernel_exact' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.NormProjector.fixed_exact (v : H12.NormProjector.Pair) : H12.NormProjector.evenNorm v = v ↔ v.2 = 0
'H12.NormProjector.fixed_exact' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.NormProjector.coordinates_inverse (v : H12.NormProjector.Pair) :
  H12.NormProjector.fromCoordinates (H12.NormProjector.coordinates v) = v
'H12.NormProjector.coordinates_inverse' depends on axioms: [propext]
H12.NormProjector.inverse_coordinates (v : H12.NormProjector.Pair) :
  H12.NormProjector.coordinates (H12.NormProjector.fromCoordinates v) = v
'H12.NormProjector.inverse_coordinates' depends on axioms: [propext]
H12.NormProjector.diagonal_in_split_basis (v : H12.NormProjector.Pair) :
  H12.NormProjector.coordinates (H12.NormProjector.evenNorm v) = ((H12.NormProjector.coordinates v).1, 0)
'H12.NormProjector.diagonal_in_split_basis' depends on axioms: [propext]
H12.NormProjector.two_charge_injective (a b : ℤ) (h0 : 4 * a + 4 * b = 0) (hhalf : -4 * b = 0) : a = 0 ∧ b = 0
'H12.NormProjector.two_charge_injective' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.NormProjector.primitive_nonzero (b : ℤ) : H12.NormProjector.primitiveAxis b = (0, 0) ↔ b = 0
'H12.NormProjector.primitive_nonzero' depends on axioms: [propext, Classical.choice, Quot.sound]
