H12FourierExtension.explicit_flat_extension (m : H12DualFourier.V) :
  H12FourierExtension.rowDelta (H12FourierExtension.liftNumerator m) = { x := -6 * m.x, y := -6 * m.y, z := -6 * m.z }
'H12FourierExtension.explicit_flat_extension' depends on axioms: [propext, Quot.sound]
H12FourierExtension.lift_pairing (m n : H12DualFourier.V) :
  H12DualFourier.dot (H12FourierExtension.liftNumerator m) (H12DualFourier.original n) -
      H12DualFourier.dot (H12FourierExtension.liftNumerator m) n =
    -6 * H12DualFourier.dot m n
'H12FourierExtension.lift_pairing' depends on axioms: [propext, Classical.choice, Quot.sound]
H12FourierExtension.invariant_character_residue (m n : H12DualFourier.V) :
  H12DualFourier.dot (H12FourierExtension.liftNumerator m) (H12DualFourier.original n) % 6 =
    H12DualFourier.dot (H12FourierExtension.liftNumerator m) n % 6
'H12FourierExtension.invariant_character_residue' depends on axioms: [propext, Classical.choice, Quot.sound]
H12FourierExtension.cubic_based_exponent (m : H12DualFourier.V) : 3 * m.z % 3 = 0
'H12FourierExtension.cubic_based_exponent' depends on axioms: [propext, Quot.sound]
H12FourierExtension.finite_grid_phase_vanishes (q n : Int) : q * n % q = 0
'H12FourierExtension.finite_grid_phase_vanishes' depends on axioms: [propext]
