H12.LineNorms.four_line_incidence.{u_1} {K : Type u_1} [CommRing K] (f : Fin 3 → Fin 3 → K) :
  ∏ i, H12.LineNorms.lineProducts f i = f 0 0 ^ 3 * ∏ i, ∏ j, f i j
'H12.LineNorms.four_line_incidence' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.LineNorms.cube_reconstruction.{u_1} {K : Type u_1} [CommRing K] (f : Fin 3 → Fin 3 → K) (hn : ∏ i, ∏ j, f i j = 1) :
  ∏ i, H12.LineNorms.lineProducts f i = f 0 0 ^ 3
'H12.LineNorms.cube_reconstruction' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.LineNorms.cube_reconstruction_with_norm.{u_1} {K : Type u_1} [Field K] (f : Fin 3 → Fin 3 → K)
  (hn : ∏ i, ∏ j, f i j ≠ 0) : f 0 0 ^ 3 = (∏ i, H12.LineNorms.lineProducts f i) / ∏ i, ∏ j, f i j
'H12.LineNorms.cube_reconstruction_with_norm' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.LineNorms.polarized_product.{u_1} {K : Type u_1} [Field K] (u w e eb a ab d db : K) (hw : w ≠ 0) (hd : d ≠ 0)
  (hu : u ^ 3 = w * e * eb ^ 2 * a ^ 2 * ab ^ 3 * db ^ 2 / d) :
  u ^ 3 * (e * a * d ^ 3 / w) = (e * eb) ^ 2 * (a * ab) ^ 3 * (d * db) ^ 2
'H12.LineNorms.polarized_product' depends on axioms: [propext, Classical.choice, Quot.sound]
