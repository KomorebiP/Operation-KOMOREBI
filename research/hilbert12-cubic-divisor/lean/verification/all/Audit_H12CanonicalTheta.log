H12.CanonicalTheta.coordinate_factorization.{u_1} {K : Type u_1} [Field K] (a b x : K) (hd : a - b ≠ 0) :
  (x - a) * (x - b) = (a - b) ^ 2 * H12.CanonicalTheta.coordinate a b x * (H12.CanonicalTheta.coordinate a b x + 1)
'H12.CanonicalTheta.coordinate_factorization' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.CanonicalTheta.canonical_coordinate_form.{u_1} {K : Type u_1} [Field K] (a b x : K) (hd : a - b ≠ 0)
  (ha : x - a ≠ 0) (hb : x - b ≠ 0) :
  H12.CanonicalTheta.canonical a b x =
    1 / (H12.CanonicalTheta.coordinate a b x * (H12.CanonicalTheta.coordinate a b x + 1))
'H12.CanonicalTheta.canonical_coordinate_form' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.CanonicalTheta.normalized_scalar_replacement.{u_1} {K : Type u_1} [Field K] (a b x c : K) (hc : c = (a - b) ^ 2) :
  c / ((x - a) * (x - b)) = H12.CanonicalTheta.canonical a b x
'H12.CanonicalTheta.normalized_scalar_replacement' depends on axioms: [propext, Quot.sound]
H12.CanonicalTheta.nonzero_difference.{u_1} {K : Type u_1} [Field K] (a b : K) (h : a ≠ b) : a - b ≠ 0
'H12.CanonicalTheta.nonzero_difference' depends on axioms: [propext, Quot.sound]
H12.CanonicalTheta.canonical_swap.{u_1} {K : Type u_1} [Field K] (a b x : K) :
  H12.CanonicalTheta.canonical b a x = H12.CanonicalTheta.canonical a b x
'H12.CanonicalTheta.canonical_swap' depends on axioms: [propext, Quot.sound]
H12.CanonicalTheta.coordinate_swap.{u_1} {K : Type u_1} [Field K] (a b x : K) (hd : a - b ≠ 0) :
  H12.CanonicalTheta.coordinate b a x = -1 - H12.CanonicalTheta.coordinate a b x
'H12.CanonicalTheta.coordinate_swap' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.CanonicalTheta.rational_shape_reflection.{u_1} {K : Type u_1} [Field K] (u : K) :
  (-1 - u) * (-1 - u + 1) = u * (u + 1)
'H12.CanonicalTheta.rational_shape_reflection' depends on axioms: [propext, Quot.sound]
H12.CanonicalTheta.scale_invariance.{u_1} {K : Type u_1} [Field K] (a b x scale : K) (hs : scale ≠ 0) :
  H12.CanonicalTheta.canonical (scale * a) (scale * b) (scale * x) = H12.CanonicalTheta.canonical a b x
'H12.CanonicalTheta.scale_invariance' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.CanonicalTheta.field_normalizer.{u_1} {K : Type u_1} [Field K] (c d : K) (hc : c ≠ 0) (h3 : c ^ 3 = d ^ 6)
  (h8 : c ^ 8 = d ^ 16) : c = d ^ 2
'H12.CanonicalTheta.field_normalizer' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.CanonicalTheta.symmetric_kernel_formula.{u_1} {K : Type u_1} [Field K] (a b x : K) :
  H12.CanonicalTheta.canonical a b x = ((a + b) ^ 2 - 4 * a * b) / (x ^ 2 - (a + b) * x + a * b)
'H12.CanonicalTheta.symmetric_kernel_formula' depends on axioms: [propext, Quot.sound]
