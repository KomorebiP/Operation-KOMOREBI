H12ExplicitDescent.carry_defect (a b c d k l m n : Int) :
  H12ExplicitDescent.alt (a + 4 * b + 7 * k) (b + 7 * l) (c + 4 * d + 7 * m) (d + 7 * n) -
      H12ExplicitDescent.alt a b c d =
    7 * (a * n + 4 * b * n + k * d - b * m - l * c - 4 * l * d + 7 * (k * n - l * m))
'H12ExplicitDescent.carry_defect' depends on axioms: [propext, Classical.choice, Quot.sound]
H12ExplicitDescent.real_cover_coboundary (az bz an bn am bm : Int) :
  4 * H12ExplicitDescent.alt (az + an) (bz + bn) am bm - 4 * H12ExplicitDescent.alt az bz (an + am) (bn + bm) +
      4 * H12ExplicitDescent.alt az bz an bn =
    4 * H12ExplicitDescent.alt an bn am bm
'H12ExplicitDescent.real_cover_coboundary' depends on axioms: [propext, Classical.choice, Quot.sound]
H12ExplicitDescent.full_cover_residual (al bl az bz am bm : Int) :
  4 * H12ExplicitDescent.alt al bl am bm - 4 * H12ExplicitDescent.alt az bz am bm =
    4 * H12ExplicitDescent.alt (al - az) (bl - bz) am bm
