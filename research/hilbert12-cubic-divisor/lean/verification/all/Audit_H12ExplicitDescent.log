H12ExplicitDescent.alpha_original (v : H12ExplicitDescent.V) :
  H12ExplicitDescent.alpha (H12ExplicitDescent.original v) =
    2 * H12ExplicitDescent.alpha v + H12ExplicitDescent.beta v + 7 * (-v.x2 + v.y0)
'H12ExplicitDescent.alpha_original' depends on axioms: [propext, Quot.sound]
H12ExplicitDescent.beta_original (v : H12ExplicitDescent.V) :
  H12ExplicitDescent.beta (H12ExplicitDescent.original v) =
    2 * H12ExplicitDescent.beta v + 7 * (-v.x0 + 3 * v.x2 + 2 * v.y0 - 7 * v.y2)
'H12ExplicitDescent.beta_original' depends on axioms: [propext, Quot.sound]
H12ExplicitDescent.alpha_rotation (v : H12ExplicitDescent.V) :
  H12ExplicitDescent.alpha (H12ExplicitDescent.rotate v) =
    4 * H12ExplicitDescent.alpha v + 7 * (-v.x0 + v.x2 + 2 * v.y0 + v.y2)
