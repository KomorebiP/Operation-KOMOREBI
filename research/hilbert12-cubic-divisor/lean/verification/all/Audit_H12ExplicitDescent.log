H12ExplicitDescent.beta_rotation (v : H12ExplicitDescent.V) :
  H12ExplicitDescent.beta (H12ExplicitDescent.rotate v) =
    4 * H12ExplicitDescent.beta v + 7 * (-v.x1 - 2 * v.x2 + 2 * v.y1 + v.y2)
'H12ExplicitDescent.beta_rotation' depends on axioms: [propext, Quot.sound]
H12ExplicitDescent.quotient_section (a b : Int) :
  H12ExplicitDescent.alpha (H12ExplicitDescent.liftPair a b) = a ∧
    H12ExplicitDescent.beta (H12ExplicitDescent.liftPair a b) = b
'H12ExplicitDescent.quotient_section' depends on axioms: [propext]
H12ExplicitDescent.cocycle_identity (a b c d e f : Int) :
  4 * H12ExplicitDescent.alt a b c d + 4 * H12ExplicitDescent.alt (a + c) (b + d) e f =
    4 * H12ExplicitDescent.alt c d e f + 4 * H12ExplicitDescent.alt a b (c + e) (d + f)
'H12ExplicitDescent.cocycle_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
H12ExplicitDescent.alternating_swap (a b c d : Int) : H12ExplicitDescent.alt a b c d = -H12ExplicitDescent.alt c d a b
