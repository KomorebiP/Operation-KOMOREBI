'H12FlatGerbeAction.flat_inverse_opposite' depends on axioms: [propext, Classical.choice, Quot.sound]
H12FlatGerbeAction.fixed_kernel_relation (v : H12FlatGerbeAction.V) :
  H12FlatGerbeAction.original (H12FlatGerbeAction.sub (H12FlatGerbeAction.flat v) v) =
    H12FlatGerbeAction.rotate (H12FlatGerbeAction.sub v (H12FlatGerbeAction.opposite v))
'H12FlatGerbeAction.fixed_kernel_relation' depends on axioms: [propext, Classical.choice, Quot.sound]
H12FlatGerbeAction.fixed_groups_agree (v : H12FlatGerbeAction.V) :
  H12FlatGerbeAction.flat v = v ↔ H12FlatGerbeAction.opposite v = v
'H12FlatGerbeAction.fixed_groups_agree' depends on axioms: [propext, Classical.choice, Quot.sound]
H12FlatGerbeAction.opposite_parameter (a b : Int) :
  H12FlatGerbeAction.sub (H12FlatGerbeAction.opposite (H12FlatGerbeAction.parameter a b))
      (H12FlatGerbeAction.parameter a b) =
    { c0 := 0 * a + 0 * b, c1 := 12 * a + 6 * b, c2 := 0 * a + 0 * b, c3 := 0 * a + 0 * b, c4 := -6 * a + 18 * b,
      c5 := 0 * a + 0 * b }
'H12FlatGerbeAction.opposite_parameter' depends on axioms: [propext, Classical.choice, Quot.sound]
H12FlatGerbeAction.all_two_minors (i j : Fin 15) :
  (H12FlatGerbeAction.table.getD ↑i []).getD (↑j) 0 = H12FlatGerbeAction.minor ↑i ↑j
'H12FlatGerbeAction.all_two_minors' depends on axioms: [propext]
H12FlatGerbeAction.pull_matches_table (i j : Fin 15) :
  (H12FlatGerbeAction.coordinates (H12FlatGerbeAction.pull (H12FlatGerbeAction.basis ↑j))).getD (↑i) 0 =
    (H12FlatGerbeAction.table.getD ↑i []).getD (↑j) 0
'H12FlatGerbeAction.pull_matches_table' depends on axioms: [propext]
