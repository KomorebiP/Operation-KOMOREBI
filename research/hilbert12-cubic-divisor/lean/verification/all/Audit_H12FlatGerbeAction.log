H12FlatGerbeAction.projection_intertwines (v : H12FlatGerbeAction.TwoForm) :
  H12FlatGerbeAction.project (H12FlatGerbeAction.pull v) = H12FlatGerbeAction.flat (H12FlatGerbeAction.project v)
'H12FlatGerbeAction.projection_intertwines' depends on axioms: [propext, Classical.choice, Quot.sound]
H12FlatGerbeAction.projection_surjective_witness (v : H12FlatGerbeAction.V) :
  H12FlatGerbeAction.project (H12FlatGerbeAction.lift v) = v
'H12FlatGerbeAction.projection_surjective_witness' depends on axioms: [propext, Classical.choice, Quot.sound]
H12FlatGerbeAction.opposite_inverse_flat (v : H12FlatGerbeAction.V) :
  H12FlatGerbeAction.opposite (H12FlatGerbeAction.flat v) = v
