  H12.FifthIsogeny.mapZ u x (H12.FifthIsogeny.negateZ z) = H12.FifthIsogeny.negateZ (H12.FifthIsogeny.mapZ u x z)
'H12.FifthIsogeny.quotient_commutes_with_negation' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.FifthIsogeny.differential_quotient_identity.{u_1} {K : Type u_1} [Field K] (u x : K) :
  H12.FifthIsogeny.num u x =
    (5 * x - 2 * u) * H12.FifthIsogeny.den u x + (x ^ 2 + (x - u) ^ 2) * H12.FifthIsogeny.source u x -
      (2 * x - u) * x * (x - u) * (6 * x ^ 2 + H12.FifthIsogeny.b2 u * x + H12.FifthIsogeny.b4 u)
'H12.FifthIsogeny.differential_quotient_identity' depends on axioms: [propext, Quot.sound]
