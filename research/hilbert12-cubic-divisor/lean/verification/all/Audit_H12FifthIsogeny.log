H12.FifthIsogeny.rational_quotient_formula.{u_1} {K : Type u_1} [Field K] (u x : K) (hx : x ≠ 0) (hxu : x - u ≠ 0) :
  H12.FifthIsogeny.mapX u x = x + u * (u - 1) / x + u ^ 2 / x ^ 2 + u ^ 2 * (u + 1) / (x - u) + u ^ 4 / (x - u) ^ 2
'H12.FifthIsogeny.rational_quotient_formula' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.FifthIsogeny.cleared_curve_identity.{u_1} {K : Type u_1} [Field K] (u x : K) :
  H12.FifthIsogeny.jacNum u x ^ 2 * H12.FifthIsogeny.source u x =
    4 * H12.FifthIsogeny.num u x ^ 3 * H12.FifthIsogeny.den u x +
          H12.FifthIsogeny.b2 u * H12.FifthIsogeny.num u x ^ 2 * H12.FifthIsogeny.den u x ^ 2 +
        (2 * H12.FifthIsogeny.b4 u + 4 * H12.FifthIsogeny.a4 u) * H12.FifthIsogeny.num u x *
          H12.FifthIsogeny.den u x ^ 3 +
      (u ^ 2 + 4 * H12.FifthIsogeny.a6 u) * H12.FifthIsogeny.den u x ^ 4
'H12.FifthIsogeny.cleared_curve_identity' depends on axioms: [propext, Quot.sound]
H12.FifthIsogeny.maps_curve.{u_1} {K : Type u_1} [Field K] (u x z : K) (hd : H12.FifthIsogeny.den u x ≠ 0)
  (hz : z ^ 2 = H12.FifthIsogeny.source u x) :
