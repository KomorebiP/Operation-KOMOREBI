H12.charge_sub (a b : ℤ →₀ ℤ) : H12.charge (a - b) = H12.charge a - H12.charge b
'H12.charge_sub' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.charge_add (a b : ℤ →₀ ℤ) : H12.charge (a + b) = H12.charge a + H12.charge b
'H12.charge_add' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.charge_single (n k : ℤ) : H12.charge (Finsupp.single n k) = k
'H12.charge_single' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.charge_shift (a : ℤ →₀ ℤ) : H12.charge (H12.shift a) = H12.charge a
'H12.charge_shift' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.charge_boundary (a : ℤ →₀ ℤ) : H12.charge (H12.boundary a) = 0
'H12.charge_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.nonzero_charge_not_boundary (d : ℤ →₀ ℤ) (hd : H12.charge d ≠ 0) : ¬∃ a, H12.boundary a = d
'H12.nonzero_charge_not_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.kernel_profile_not_boundary (k : ℤ) (hk : k ≠ 0) : ¬∃ a, H12.boundary a = Finsupp.single 0 (4 * k)
'H12.kernel_profile_not_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.normed_profile_not_boundary (k : ℤ) (hk : k ≠ 0) :
  ¬∃ a, H12.boundary a = Finsupp.single 0 (-8 * k) + Finsupp.single (-1) (-16 * k)
'H12.normed_profile_not_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.invariant_projection_kills_boundary.{u_1, u_2} {A : Type u_1} {B : Type u_2} (step : A → A) (label : A → B)
  (h : ∀ (a : A), label (step a) = label a) (d : A →₀ ℤ) : Finsupp.mapDomain label (Finsupp.mapDomain step d - d) = 0
'H12.invariant_projection_kills_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.two_profile_exact (a b : ℤ) (d : H12.OrbitPoint →₀ ℤ) (h : H12.orbitShift d - d = H12.twoProfile a b) :
  a = 0 ∧ b = 0
'H12.two_profile_exact' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.two_profile_not_boundary (a b : ℤ) (h : a ≠ 0 ∨ b ≠ 0) : ¬∃ d, H12.orbitShift d - d = H12.twoProfile a b
'H12.two_profile_not_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
