H12.Taps.phase3_lift (n : ℤ) : ∃ d, H12.Taps.phase3 n = n + 3 * d
'H12.Taps.phase3_lift' depends on axioms: [propext, Quot.sound]
H12.Taps.gain_lift (xs : List (ℤ × ℤ)) : ∃ d, H12.Taps.gain xs = H12.Taps.firstMoment xs + 3 * d
'H12.Taps.gain_lift' depends on axioms: [propext, Quot.sound]
H12.Taps.gain_divisible_by_three (xs : List (ℤ × ℤ)) (h : H12.Taps.firstMoment xs = 0) : 3 ∣ H12.Taps.gain xs
'H12.Taps.gain_divisible_by_three' depends on axioms: [propext, Quot.sound]
H12.Taps.stencil_first_moment : H12.Taps.firstMoment H12.Taps.cubicStencil = 0
'H12.Taps.stencil_first_moment' does not depend on any axioms
H12.Taps.stencil_second_moment : H12.Taps.secondMoment H12.Taps.cubicStencil = 0
'H12.Taps.stencil_second_moment' depends on axioms: [propext]
H12.Taps.stencil_target_gain : H12.Taps.gain H12.Taps.cubicStencil = 3
