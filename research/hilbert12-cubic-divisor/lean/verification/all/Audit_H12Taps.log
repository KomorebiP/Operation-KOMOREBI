H12.Taps.triple_zero_identity.{u_1} {K : Type u_1} [Field K] (z : K) (hz : z ≠ 0) :
  z * (z⁻¹ + 3 * z - z ^ 2 - 3) = -(z - 1) ^ 3
'H12.Taps.triple_zero_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
H12.Taps.cubic_unit_identity.{u_1} {K : Type u_1} [CommRing K] (b : K) (h : b ^ 3 = 7) :
  (2 - b) * (b ^ 2 + 2 * b + 4) = 1
'H12.Taps.cubic_unit_identity' depends on axioms: [propext, Quot.sound]
