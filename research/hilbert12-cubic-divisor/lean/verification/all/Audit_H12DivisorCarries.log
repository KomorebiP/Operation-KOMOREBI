H12DivisorCarries.unit_period_pivot (b c : Int) :
  H12PrincipalDivisor.pivot (b - 15) (c - 10) = H12PrincipalDivisor.pivot b c
'H12DivisorCarries.unit_period_pivot' depends on axioms: [propext, Quot.sound]
H12DivisorCarries.unit_period_weight (c : Int) : H12PrincipalDivisor.weight (c - 10) = H12PrincipalDivisor.weight c
'H12DivisorCarries.unit_period_weight' depends on axioms: [propext, Quot.sound]
H12DivisorCarries.finite_window_boundary (b : Int) :
  H12PrincipalDivisor.step (b - 15) - H12PrincipalDivisor.step b = -if 0 < b ∧ b ≤ 15 then 1 else 0
'H12DivisorCarries.finite_window_boundary' depends on axioms: [propext, Classical.choice, Quot.sound]
H12DivisorCarries.unit_period_order (a b c : Int) :
  H12PrincipalDivisor.correctionOrder a (b - 15) (c - 10) - H12PrincipalDivisor.correctionOrder a b c =
    -H12PrincipalDivisor.weight c * if 0 < b ∧ b ≤ 15 then 1 else 0
'H12DivisorCarries.unit_period_order' depends on axioms: [propext, Classical.choice, Quot.sound]
H12DivisorCarries.seventh_pivot_carry (b c : Int) :
  H12PrincipalDivisor.pivot (b - 8) (c - 5) =
    H12PrincipalDivisor.pivot b c + if H12PrincipalDivisor.digit b c = 0 then 1 else 0
'H12DivisorCarries.seventh_pivot_carry' depends on axioms: [propext, Classical.choice, Quot.sound]
H12DivisorCarries.seventh_digit_carry (b c : Int) :
  H12PrincipalDivisor.digit (b - 8) (c - 5) = (H12PrincipalDivisor.digit b c + 6) % 7
'H12DivisorCarries.seventh_digit_carry' depends on axioms: [propext, Classical.choice, Quot.sound]
