H12WeilCharacter.pairing_all_residue_multiples (a b : Fin 7) :
  H12WeilCharacter.phase (H12WeilCharacter.scale (↑↑a) H12WeilCharacter.Jbar)
      (H12WeilCharacter.scale (↑↑b) H12WeilCharacter.J) =
    3 * ↑↑a * ↑↑b % 7
