import PaperXII.AugmentationCoinvariants
import Mathlib.LinearAlgebra.TensorProduct.Associator

set_option autoImplicit false

/-! The actual balanced tensor product R ⊗[A,ε] M for a possibly
noncommutative augmented R-algebra A. Start with R ⊗[R] M and quotient
by all A-balancing relations. This fixes the left-module convention. -/
namespace PaperXII.BalancedAugmentation

open scoped TensorProduct
open AugmentationCoinvariants

variable {R A M : Type*} [CommRing R] [Ring A] [Algebra R A]
  [AddCommGroup M] [Module R M] [Module A M]

/-- All balancing relations for the right action r·a = r ε(a) on R. -/
def tensorRelations (ε : A →ₐ[R] R) : Submodule R (R ⊗[R] M) :=
  Submodule.span R (Set.range fun ram : R × A × M =>
    ram.1 ⊗ₜ[R] (ram.2.1 • ram.2.2) - (ram.1 * ε ram.2.1) ⊗ₜ[R] ram.2.2)

/-- The balanced tensor product, defined by the full relation quotient. -/
abbrev Tensor (ε : A →ₐ[R] R) := (R ⊗[R] M) ⧸ tensorRelations (M := M) ε

/-- Its canonical coefficient-bilinear tensor map. -/
def tensorMk (ε : A →ₐ[R] R) : R →ₗ[R] M →ₗ[R] Tensor (M := M) ε :=
  (TensorProduct.mk R R M).compr₂ (tensorRelations ε).mkQ

/-- The canonical tensor map satisfies every A-balancing equation. -/
theorem tensorMk_balanced (ε : A →ₐ[R] R) (r : R) (a : A) (m : M) :
    tensorMk ε r (a • m) = tensorMk ε (r * ε a) m :=
  (Submodule.Quotient.eq _).mpr (Submodule.subset_span (Set.mem_range_self (r,a,m)))

/-- The coefficient factor is generated by one. -/
theorem tensorMk_scalar (ε : A →ₐ[R] R) (r : R) (m : M) :
    tensorMk ε r m = r • tensorMk ε 1 m := by
  have h : tensorMk ε (r • (1 : R)) m = r • tensorMk ε 1 m := by
    rw [map_smul, LinearMap.smul_apply]
  simpa only [smul_eq_mul, mul_one] using h

variable {W : Type*} [AddCommGroup W] [Module R W]

/-- Every balanced bilinear map descends to the actual tensor quotient. -/
def lift (ε : A →ₐ[R] R) (f : R →ₗ[R] M →ₗ[R] W)
    (hf : ∀ r a m, f r (a • m) = f (r * ε a) m) : Tensor (M := M) ε →ₗ[R] W :=
  (tensorRelations ε).liftQ (TensorProduct.lift f) (Submodule.span_le.mpr <| by
    rintro v ⟨⟨r,a,m⟩,rfl⟩
    change TensorProduct.lift f (r ⊗ₜ[R] (a • m) - (r * ε a) ⊗ₜ[R] m) = 0
    simpa only [map_sub, TensorProduct.lift.tmul, sub_eq_zero] using hf r a m)

/-- The descended map evaluates pure tensors as prescribed. -/
theorem lift_tensorMk (ε : A →ₐ[R] R) (f : R →ₗ[R] M →ₗ[R] W)
    (hf : ∀ r a m, f r (a • m) = f (r * ε a) m) (r : R) (m : M) :
    lift ε f hf (tensorMk ε r m) = f r m := rfl

/-- A map out of the balanced tensor product is determined by pure tensors. -/
theorem hom_ext (ε : A →ₐ[R] R) {f g : Tensor (M := M) ε →ₗ[R] W}
    (h : ∀ r m, f (tensorMk ε r m) = g (tensorMk ε r m)) : f = g := by
  apply Submodule.linearMap_qext
  apply TensorProduct.ext'
  intro r m
  exact h r m

/-- Existence and uniqueness give the full balanced tensor universal property. -/
theorem exists_unique_lift (ε : A →ₐ[R] R) (f : R →ₗ[R] M →ₗ[R] W)
    (hf : ∀ r a m, f r (a • m) = f (r * ε a) m) :
    ∃! F : Tensor (M := M) ε →ₗ[R] W, ∀ r m, F (tensorMk ε r m) = f r m := by
  refine ⟨lift ε f hf, lift_tensorMk ε f hf, ?_⟩
  intro F hF
  exact hom_ext ε fun r m => (hF r m).trans (lift_tensorMk ε f hf r m).symm

/-- Evaluate a balanced tensor in the augmentation coinvariants. -/
def toCoinvariants (ε : A →ₐ[R] R) :
    Tensor (M := M) ε →ₗ[R] Coinvariants (M := M) ε :=
  lift ε ((TensorProduct.mk R R M).compr₂
    ((mk ε).comp (TensorProduct.lid R M).toLinearMap)) (by
      intro r a m
      change mk ε (r • (a • m)) = mk ε ((r * ε a) • m)
      rw [map_smul, mk_smul, map_smul, smul_smul])

/-- Tensor evaluation is coefficient multiplication in the quotient. -/
theorem toCoinvariants_tensorMk (ε : A →ₐ[R] R) (r : R) (m : M) :
    toCoinvariants ε (tensorMk ε r m) = r • mk ε m := by
  change mk ε (r • m) = r • mk ε m
  exact map_smul (mk ε) r m

/-- Send a coinvariant to the tensor of one with a representative. -/
def fromCoinvariants (ε : A →ₐ[R] R) :
    Coinvariants (M := M) ε →ₗ[R] Tensor (M := M) ε :=
  (relations ε).liftQ (tensorMk ε 1) (Submodule.span_le.mpr <| by
    rintro v ⟨⟨a,m⟩,rfl⟩
    change tensorMk ε 1 (a • m - ε a • m) = 0
    rw [map_sub, (tensorMk ε 1).map_smul (ε a), sub_eq_zero,
      tensorMk_balanced, one_mul]
    exact tensorMk_scalar ε (ε a) m)

/-- The quotient-to-tensor map uses the original representative. -/
theorem fromCoinvariants_mk (ε : A →ₐ[R] R) (m : M) :
    fromCoinvariants ε (mk ε m) = tensorMk ε 1 m := rfl

/-- Reconstructing and evaluating a coinvariant is the identity. -/
theorem to_from (ε : A →ₐ[R] R) :
    (toCoinvariants (M := M) ε).comp (fromCoinvariants ε) = LinearMap.id := by
  apply Submodule.linearMap_qext
  ext m
  change toCoinvariants ε (fromCoinvariants ε (mk ε m)) = mk ε m
  rw [fromCoinvariants_mk, toCoinvariants_tensorMk, one_smul]

/-- Evaluating and reconstructing a tensor is the identity. -/
theorem from_to (ε : A →ₐ[R] R) :
    (fromCoinvariants (M := M) ε).comp (toCoinvariants ε) = LinearMap.id := by
  apply hom_ext ε
  intro r m
  change fromCoinvariants ε (toCoinvariants ε (tensorMk ε r m)) = tensorMk ε r m
  rw [toCoinvariants_tensorMk, map_smul, fromCoinvariants_mk]
  exact (tensorMk_scalar ε r m).symm

/-- Balanced tensor product equals the actual augmentation quotient. -/
def tensorEquivCoinvariants (ε : A →ₐ[R] R) :
    Tensor (M := M) ε ≃ₗ[R] Coinvariants (M := M) ε :=
  LinearEquiv.ofLinearMap (toCoinvariants ε) (fromCoinvariants ε) (to_from ε) (from_to ε)

/-- A free A-module recovers exactly its original number of R-coordinates. -/
noncomputable def freeTensorEquiv [IsScalarTower R A M] {ι : Type*} [Fintype ι]
    (ε : A →ₐ[R] R) (b : Module.Basis ι A M) : Tensor (M := M) ε ≃ₗ[R] (ι → R) :=
  (tensorEquivCoinvariants ε).trans (freeEquiv ε b)

end PaperXII.BalancedAugmentation
