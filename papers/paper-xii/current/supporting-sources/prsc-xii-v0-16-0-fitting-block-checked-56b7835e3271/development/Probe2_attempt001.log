Matrix.det_succ_row_zero.{v} {R : Type v} [CommRing R] {n : ℕ} (A : Matrix (Fin n.succ) (Fin n.succ) R) :
  A.det = ∑ j, (-1) ^ ↑j * A 0 j * (A.submatrix Fin.succ j.succAbove).det
Matrix.submatrix_submatrix.{v, u_1, u_2, u_3, u_4, u_8, u_9} {l : Type u_1} {m : Type u_2} {n : Type u_3} {o : Type u_4}
  {α : Type v} {l₂ : Type u_8} {o₂ : Type u_9} (A : Matrix m n α) (r₁ : l → m) (c₁ : o → n) (r₂ : l₂ → l)
  (c₂ : o₂ → o) : (A.submatrix r₁ c₁).submatrix r₂ c₂ = A.submatrix (r₁ ∘ r₂) (c₁ ∘ c₂)
