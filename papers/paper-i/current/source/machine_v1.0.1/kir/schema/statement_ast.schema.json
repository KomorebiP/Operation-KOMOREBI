{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSC-I Statement AST v1",
  "type": "object",
  "required": [
    "stable_id",
    "ast_version",
    "status",
    "statement_ast"
  ],
  "properties": {
    "stable_id": {
      "type": "string"
    },
    "ast_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "TYPED_CORE",
        "STRUCTURED_SYMBOLIC",
        "TEXTUAL_SEMANTIC"
      ]
    },
    "statement_ast": {
      "type": "object"
    }
  }
}