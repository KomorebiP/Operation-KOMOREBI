{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSC-I Machine Paper v1",
  "type": "object",
  "required": [
    "schema",
    "format_version",
    "package_id",
    "package_version",
    "release_class",
    "authoritative_source",
    "canonical_records",
    "statement_ast",
    "dependency_graph",
    "actions",
    "evidence",
    "release",
    "machine_rules"
  ],
  "properties": {
    "schema": {
      "const": "komorebi.machine_paper.v1"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "const": "PSC-I"
    },
    "package_version": {
      "const": "1.0.1"
    },
    "release_class": {
      "const": "FINAL_MACHINE_INTERFACE"
    },
    "machine_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
