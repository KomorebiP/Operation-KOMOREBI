{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSC-I Machine Record v1",
  "type": "object",
  "required": [
    "stable_id",
    "kind",
    "title",
    "statement_tex",
    "dependencies",
    "semantic_class",
    "evidence"
  ],
  "properties": {
    "stable_id": {
      "type": "string",
      "pattern": "^PSC-I-"
    },
    "kind": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "statement_tex": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_tex": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "machine_actions": {
      "type": "array"
    }
  }
}