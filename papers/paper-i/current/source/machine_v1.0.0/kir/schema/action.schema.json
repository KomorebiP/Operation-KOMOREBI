{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PSC-I Action Contract v1",
  "type": "object",
  "required": [
    "action",
    "execution_mode",
    "record"
  ],
  "properties": {
    "action": {
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "RUNTIME_EXECUTABLE_EXACT_FINITE",
        "RUNTIME_EXECUTABLE_SEMANTIC_GATE",
        "EXACT_FIXTURE_ONLY",
        "PLANNER_ONLY"
      ]
    },
    "record": {
      "type": "string"
    }
  }
}