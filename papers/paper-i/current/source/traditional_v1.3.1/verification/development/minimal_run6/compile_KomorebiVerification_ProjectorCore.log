Komorebi.Foundation.LinearProjectorFamily.synthesize_analyze.{u, v, w} {R : Type u} {M : Type v} {ι : Type w}
  [Semiring R] [AddCommMonoid M] [Module R M] [Fintype ι] (P : Komorebi.Foundation.LinearProjectorFamily R M ι)
  (x : M) : P.synthesize (P.analyze x) = x
Komorebi.Foundation.transferBlock_reconstruction.{u, v, w, y, u_1} {R : Type u} {M : Type v} {N : Type w} {ι : Type y}
  {κ : Type u_1} [Semiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N] [Fintype ι] [Fintype κ]
  (P : Komorebi.Foundation.LinearProjectorFamily R M ι) (Q : Komorebi.Foundation.LinearProjectorFamily R N κ)
  (T : M →ₗ[R] N) (x : M) : ∑ j, ∑ i, (Q.proj j) (T ((P.proj i) x)) = T x
Komorebi.Foundation.transferBlock_comp.{u, v, w, x, y, u_1, u_2} {R : Type u} {M : Type v} {N : Type w} {L : Type x}
  {ι : Type y} {κ : Type u_1} {τ : Type u_2} [Semiring R] [AddCommMonoid M] [Module R M] [AddCommMonoid N] [Module R N]
  [AddCommMonoid L] [Module R L] [Fintype ι] [Fintype κ] [Fintype τ]
  (P : Komorebi.Foundation.LinearProjectorFamily R M ι) (Q : Komorebi.Foundation.LinearProjectorFamily R N κ)
  (S : Komorebi.Foundation.LinearProjectorFamily R L τ) (T : M →ₗ[R] N) (U : N →ₗ[R] L) (k : τ) (i : ι) (x : M) :
  (S.proj k) (U (T ((P.proj i) x))) = ∑ j, (S.proj k) (U ((Q.proj j) (T ((P.proj i) x))))
Komorebi.Packet.fibreProj_reconstruction.{u, v, w} {α : Type u} {β : Type v} {M : Type w} [DecidableEq β] [Fintype β]
  [AddCommMonoid M] (address : α → β) (x : α → M) : ∑ b, Komorebi.Packet.fibreProj address b x = x
Komorebi.Algebra.MatrixSupported.mul.{u, v} {ι : Type u} {A : Type v} [Fintype ι] [DecidableEq ι] [Semiring A]
  {rel : ι → ι → Prop} (htrans : ∀ (i j k : ι), rel i j → rel j k → rel i k) {M N : Matrix ι ι A}
  (hM : Komorebi.Algebra.MatrixSupported rel M) (hN : Komorebi.Algebra.MatrixSupported rel N) :
  Komorebi.Algebra.MatrixSupported rel (M * N)
Komorebi.FiniteDifference.iteratedWeightedDiff_geometric.{u} {R : Type u} [CommRing R] (q r : R) (k n : ℕ) :
  Komorebi.FiniteDifference.iteratedWeightedDiff q k (fun j => r ^ j) n = (1 - q * r) ^ k * r ^ n
Komorebi.Polyphase.coeffSection_comp.{u} {A : Type u} (l s m r : ℕ) (f : ℕ → A) (n : ℕ) :
  Komorebi.Polyphase.coeffSection m r (Komorebi.Polyphase.coeffSection l s f) n =
    Komorebi.Polyphase.coeffSection (l * m) (l * r + s) f n
Komorebi.Quantum.finiteAmplitude_zero.{u} {ι : Type u} [Fintype ι] (weight sign : ι → ℂ) (energy : ι → ℝ) :
  Komorebi.Quantum.finiteAmplitude weight sign energy 0 = ∑ i, weight i * sign i
