Komorebi.PacketNaturalityCompletion.FullBlocks.end_finrank_eq_packet_sum_eq_square.{u, v, w} {ι : Type w} [Fintype ι]
  [DecidableEq ι] {K : Type u} {V : Type v} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  (P : Komorebi.Foundation.LinearProjectorFamily K V ι) :
  Module.finrank K (Module.End K V) =
      ∑ b, ∑ a, Module.finrank K ↥(LinearMap.range (P.proj a)) * Module.finrank K ↥(LinearMap.range (P.proj b)) ∧
    ∑ b, ∑ a, Module.finrank K ↥(LinearMap.range (P.proj a)) * Module.finrank K ↥(LinearMap.range (P.proj b)) =
      (∑ a, Module.finrank K ↥(LinearMap.range (P.proj a))) ^ 2
