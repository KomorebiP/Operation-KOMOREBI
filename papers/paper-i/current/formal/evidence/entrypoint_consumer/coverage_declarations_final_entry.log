Komorebi.FiniteAlgorithms.exactGraphSeedRank.{u, v} {K : Type u} {ν : Type v} [Field K] [Fintype ν] [DecidableEq ν]
  (A : Matrix ν ν K) : ℕ
Komorebi.FiniteAlgorithms.exactGraphSeedRank_isLeast.{u, v, w} {K : Type u} {ν : Type v} [Field K] [Fintype ν]
  [DecidableEq ν] {Λ : Type w} [Fintype Λ] (A : Matrix ν ν K) (R : ℕ) (multiplicity : Λ → ℕ) (eigenvalue : Λ → K)
  (eigenbasis : Module.Basis ((eigen : Λ) × Fin (multiplicity eigen)) K (ν → K))
  (hEigen :
    ∀ (z : (eigen : Λ) × Fin (multiplicity eigen)), (Matrix.toLin' A) (eigenbasis z) = eigenvalue z.fst • eigenbasis z)
  (hbound : ∀ (eigen : Λ), multiplicity eigen ≤ R) (maxEigen : Λ) (hmax : multiplicity maxEigen = R)
  (projectorPolynomial : Λ → Polynomial K)
  (hproject :
    ∀ (eigen : Λ) (j : Fin (multiplicity eigen)),
      ((Polynomial.aeval (Matrix.toLin' A)) (projectorPolynomial eigen))
          (Komorebi.SingleOperatorGraph.paddedBlockSum R multiplicity (fun e j => eigenbasis ⟨e, j⟩) ⟨↑j, ⋯⟩) =
        eigenbasis ⟨eigen, j⟩)
  (hSpectrumCover : ∀ μ ∈ spectrum K A, ∃ eigen, eigenvalue eigen = μ)
  (hMultiplicity :
    ∀ (eigen : Λ), Komorebi.FiniteAlgorithms.graphEigenMultiplicity A (eigenvalue eigen) = multiplicity eigen)
  (hMaxSpectrum : eigenvalue maxEigen ∈ spectrum K A) :
  IsLeast {r | Komorebi.SingleOperatorGraph.SeedNumberLE (Matrix.toLin' A) r}
    (Komorebi.FiniteAlgorithms.exactGraphSeedRank A)
