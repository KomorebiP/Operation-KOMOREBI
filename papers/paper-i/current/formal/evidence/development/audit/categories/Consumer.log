Komorebi.PaperIRelease.CategoryPackets.transferBlock_naturality.{u} {K : Type u} [Field K]
  {X Y : Komorebi.PaperIRelease.CategoryPackets.PacketObject K}
  (f : Komorebi.PaperIRelease.CategoryPackets.PacketMorphism X Y) (T : ↥X.algebra) (j i : Y.index) :
  Komorebi.Foundation.transferBlock Y.packets Y.packets (↑(f.algebraMap T)) j i ∘ₗ f.linearMap =
    ∑ b,
      if f.packetMap b = j then
        ∑ a,
          if f.packetMap a = i then f.linearMap ∘ₗ Komorebi.Foundation.transferBlock X.packets X.packets (↑T) b a else 0
      else 0
