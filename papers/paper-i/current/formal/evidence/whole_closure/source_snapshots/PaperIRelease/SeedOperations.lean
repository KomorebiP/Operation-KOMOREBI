import KomorebiVerification.SeedRankOperations

set_option autoImplicit false
noncomputable section
namespace Komorebi.PaperIRelease.SeedOperations
open Komorebi.SeedRankBasics Komorebi.SeedRankOperations
universe u v

/-- The regular left module is generated by its unit, over any unital semiring. -/
theorem regular_generates_one (A : Type u) [Semiring A] : Generates A A {1} := by
  apply (generates_singleton_iff_surjective A A 1).mpr
  intro a
  exact ⟨a, by simp [oneSeedMap]⟩

/-- Algebra generators are irrelevant to the regular-module seed rank. -/
theorem regular_seedRank (A : Type u) [Semiring A] [Nontrivial A] :
    seedRank A A = 1 :=
  (cyclic_iff_seedRank_eq_one A A).mp ⟨1, regular_generates_one A⟩

/-- Both cardinal bounds for the same acting algebra on a binary direct sum. -/
theorem shared_direct_sum_bounds (A M N : Type u) [Semiring A]
    [AddCommMonoid M] [Module A M] [AddCommMonoid N] [Module A N] :
    max (seedRank A M) (seedRank A N) ≤ seedRank A (M × N) ∧
      seedRank A (M × N) ≤ seedRank A M + seedRank A N := by
  constructor
  · apply max_le
    · exact seedRank_le_of_surjective (LinearMap.fst A M N) (fun m => ⟨(m, 0), rfl⟩)
    · exact seedRank_le_of_surjective (LinearMap.snd A M N) (fun n => ⟨(0, n), rfl⟩)
  · exact seedRank_prod_le_add A M N

section Annihilator
variable {A : Type u} [Ring A] {M : Type v} [AddCommGroup M] [Module A M]

/-- The actual kernel of scalar evaluation at a vector. -/
def vectorAnnihilator (s : M) : Ideal A := (oneSeedMap A M s).ker

@[simp] theorem mem_vectorAnnihilator (s : M) (a : A) :
    a ∈ vectorAnnihilator (A := A) s ↔ a • s = 0 := Iff.rfl

/-- Right-ideal closure of the left annihilator is exactly annihilation of its cyclic span. -/
theorem annihilator_two_sided_iff (s : M) :
    (∀ a ∈ vectorAnnihilator (A := A) s, ∀ b : A, a * b ∈ vectorAnnihilator (A := A) s) ↔
      ∀ a ∈ vectorAnnihilator (A := A) s, ∀ m ∈ Submodule.span A {s}, a • m = 0 := by
  constructor
  · intro h a ha m hm
    obtain ⟨b, rfl⟩ := (Submodule.mem_span_singleton.mp hm)
    rw [smul_smul]
    exact h a ha b
  · intro h a ha b
    change (a * b) • s = 0
    rw [mul_smul]
    exact h a ha (b • s) (Submodule.smul_mem _ _ (Submodule.subset_span (by simp)))

/-- For a cyclic vector, right-ideal closure is equality with the module annihilator. -/
theorem cyclic_annihilator_two_sided_iff (s : M) (hs : Generates A M {s}) :
    (∀ a ∈ vectorAnnihilator (A := A) s, ∀ b : A, a * b ∈ vectorAnnihilator (A := A) s) ↔
      ∀ a : A, a ∈ vectorAnnihilator (A := A) s ↔ ∀ m : M, a • m = 0 := by
  rw [annihilator_two_sided_iff]
  constructor
  · intro h a
    constructor
    · intro ha m
      exact h a ha m (by rw [hs]; trivial)
    · intro ha
      exact ha s
  · intro h a ha m _
    exact (h a).mp ha m


/-- The criterion in the standard two-sided-ideal interface. -/
theorem annihilator_isTwoSided_iff (s : M) :
    (vectorAnnihilator (A := A) s).IsTwoSided ↔
      ∀ a ∈ vectorAnnihilator (A := A) s,
        ∀ m ∈ Submodule.span A {s}, a • m = 0 := by
  rw [Ideal.isTwoSided_iff, ← annihilator_two_sided_iff]
  constructor
  · intro h a ha b
    exact h b ha
  · intro h a b ha
    exact h a ha b

/-- With a cyclic vector, two-sidedness is literal equality to the module annihilator. -/
theorem cyclic_annihilator_eq_module_iff (s : M) (hs : Generates A M {s}) :
    (vectorAnnihilator (A := A) s).IsTwoSided ↔
      vectorAnnihilator (A := A) s = Module.annihilator A M := by
  rw [annihilator_isTwoSided_iff, ← annihilator_two_sided_iff,
    cyclic_annihilator_two_sided_iff s hs]
  constructor
  · intro h
    ext a
    exact (h a).trans Module.mem_annihilator.symm
  · intro h a
    rw [h, Module.mem_annihilator]

end Annihilator
end Komorebi.PaperIRelease.SeedOperations
