import PaperIRelease.AlgebraSupport

set_option autoImplicit false
set_option maxHeartbeats 2000000

namespace Komorebi.PaperIRelease
open Komorebi.Foundation
open Komorebi.PacketNaturalityCompletion.Reachability
open Komorebi.PacketNaturalityCompletion.StrictNaturality

universe u v w
variable {K : Type u} [Field K]
variable {X : Type v} [AddCommGroup X] [Module K X]
variable {I : Type w} [Fintype I] [DecidableEq I]

def packetGeneratedAlgebra (P : LinearProjectorFamily K X I)
    (ops : Set (Module.End K X)) : Subalgebra K (Module.End K X) :=
  Algebra.adjoin K (Set.range P.proj ∪ ops)

def packetReachabilityAlgebra (P : LinearProjectorFamily K X I)
    (ops : Set (Module.End K X)) : Subalgebra K (Module.End K X) :=
  supportSubalgebra P (Relation.ReflTransGen (TransferEdge P ops))
    (fun _ => Relation.ReflTransGen.refl) (fun _ _ _ hac hcb => hac.trans hcb)

/-- Every element of the algebra generated by the projectors and declared operators
has zero blocks outside graph reachability. -/
theorem generatedAlgebra_le_reachability (P : LinearProjectorFamily K X I)
    (ops : Set (Module.End K X)) :
    packetGeneratedAlgebra P ops ≤ packetReachabilityAlgebra P ops := by
  apply Algebra.adjoin_le
  intro T hT
  apply (operatorSupported_iff_ambient P _ T).mpr
  intro b a hab
  rcases hT with ⟨j, rfl⟩ | hT
  · ext x
    change P.proj b (P.proj j (P.proj a x)) = 0
    by_cases hja : j = a
    · subst j
      rw [P.idempotent]
      have hba : b ≠ a := fun h => by subst b; exact hab Relation.ReflTransGen.refl
      exact P.orthogonal hba x
    · rw [P.orthogonal hja, map_zero]
  · by_contra h
    exact hab (Relation.ReflTransGen.single ⟨T, hT, h⟩)

theorem generatedAlgebra_block_zero (P : LinearProjectorFamily K X I)
    (ops : Set (Module.End K X)) {T : Module.End K X}
    (hT : T ∈ packetGeneratedAlgebra P ops) {a b : I}
    (hab : ¬ Relation.ReflTransGen (TransferEdge P ops) a b) :
    transferBlock P P T b a = 0 :=
  (operatorSupported_iff_ambient P _ T).mp
    (generatedAlgebra_le_reachability P ops hT) b a hab

/-- The full generated algebra preserves the reachable-support space. -/
theorem generatedAlgebra_preserves_reachable (P : LinearProjectorFamily K X I)
    (ops : Set (Module.End K X)) (S₀ : Set I) {T : Module.End K X}
    (hT : T ∈ packetGeneratedAlgebra P ops) {x : X}
    (hx : VectorSupported P (ReachableFrom P ops S₀) x) :
    VectorSupported P (ReachableFrom P ops S₀) (T x) := by
  intro b hb
  calc
    P.proj b (T x) = ∑ a, P.proj b (T (P.proj a x)) := by
      rw [← map_sum, ← map_sum, P.complete]
    _ = 0 := by
      apply Finset.sum_eq_zero
      intro a _
      by_cases ha : ReachableFrom P ops S₀ a
      · have hab : ¬ Relation.ReflTransGen (TransferEdge P ops) a b := by
          intro hab
          rcases ha with ⟨s, hs, hsa⟩
          exact hb ⟨s, hs, hsa.trans hab⟩
        exact LinearMap.congr_fun (generatedAlgebra_block_zero P ops hT hab) x
      · rw [hx a ha, map_zero, map_zero]

/-- Printed hull obstruction for the actual algebra adjoined from projectors and generators. -/
theorem generatedAlgebra_hull_le_reachable (P : LinearProjectorFamily K X I)
    (ops : Set (Module.End K X)) (S₀ : Set I) (seeds : Set X)
    (hseeds : ∀ x ∈ seeds, VectorSupported P S₀ x) :
    AlgebraGeneratedHull (packetGeneratedAlgebra P ops) seeds ≤
      supportedSubmodule P (ReachableFrom P ops S₀) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨T, s, hs, rfl⟩
  apply generatedAlgebra_preserves_reachable P ops S₀ T.property
  intro b hb
  apply hseeds s hs b
  intro hb0
  exact hb (source_reachable P ops S₀ hb0)

/-- A nonzero unreachable packet cannot lie in the generated hull. -/
theorem generatedAlgebra_unreachable_obstruction (P : LinearProjectorFamily K X I)
    (ops : Set (Module.End K X)) (S₀ : Set I) (seeds : Set X)
    (hseeds : ∀ x ∈ seeds, VectorSupported P S₀ x)
    {b : I} (hb : ¬ ReachableFrom P ops S₀ b) {x : X}
    (hx : P.proj b x ≠ 0) :
    x ∉ AlgebraGeneratedHull (packetGeneratedAlgebra P ops) seeds := by
  intro h
  exact hx (generatedAlgebra_hull_le_reachable P ops S₀ seeds hseeds h b hb)

end Komorebi.PaperIRelease
