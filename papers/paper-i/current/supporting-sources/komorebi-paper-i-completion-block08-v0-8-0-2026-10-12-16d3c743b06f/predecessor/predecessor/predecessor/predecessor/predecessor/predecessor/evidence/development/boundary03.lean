import PaperICompletion

set_option autoImplicit false
noncomputable section

namespace PaperICompletionTests
open Komorebi.SingleOperatorGraph
open Komorebi.PaperICompletion.CyclicClassification
open Komorebi.PaperICompletion.SpectralCertificates
open Komorebi.PaperICompletion.ConditionedCoordinates

abbrev ZeroV := Fin 0 → ℚ
abbrev TwoV := Fin 2 → ℚ

-- Zero has at most one generator, but its exact rank is zero.
theorem zero_space_cyclic : HasCyclicVector (0 : Module.End ℚ ZeroV) := by
  refine ⟨fun _ : Fin 1 ↦ 0, ?_⟩
  exact Subsingleton.elim _ _

theorem zero_space_rank :
    Komorebi.SeedRankBasics.seedRank (operatorAlgebra (0 : Module.End ℚ ZeroV)) ZeroV = 0 :=
  (Komorebi.SeedRankBasics.seedRank_eq_zero_iff _ _).mpr inferInstance

theorem zero_space_polynomial_equality :
    minpoly ℚ (0 : Module.End ℚ ZeroV) = (0 : Module.End ℚ ZeroV).charpoly :=
  (hasCyclicVector_iff_minpoly_eq_charpoly _).mp zero_space_cyclic

-- Repeated scalar action in dimension two cannot be generated by one vector.
theorem repeated_scalar_not_cyclic : ¬ HasCyclicVector (0 : Module.End ℚ TwoV) := by
  rintro ⟨v, hv⟩
  have h := multiplicity_le_of_generates (0 : Module.End ℚ TwoV) v 2
    (LinearMap.id : TwoV →ₗ[ℚ] TwoV) Function.surjective_id 0
    (fun p x ↦ by
      simpa using aeval_apply_of_eigenvector (0 : Module.End ℚ TwoV) 0 x (by simp) p) hv
  norm_num at h

theorem repeated_scalar_polynomials_differ :
    minpoly ℚ (0 : Module.End ℚ TwoV) ≠ (0 : Module.End ℚ TwoV).charpoly := by
  intro h
  exact repeated_scalar_not_cyclic ((hasCyclicVector_iff_minpoly_eq_charpoly _).mpr h)

-- A non-diagonalizable rational Jordan block is nevertheless cyclic.
def jordanTwo : Module.End ℚ TwoV where
  toFun x := ![x 1, 0]
  map_add' x y := by ext i; fin_cases i <;> simp
  map_smul' a x := by ext i; fin_cases i <;> simp

theorem jordanTwo_cyclic : HasCyclicVector jordanTwo := by
  refine ⟨fun _ : Fin 1 ↦ ![0, 1], ?_⟩
  apply familyGenerates_singleton_of_pow_span_eq_top jordanTwo ![0, 1]
  let H := Submodule.span ℚ (Set.range fun n : ℕ ↦ (jordanTwo ^ n) ![0, 1])
  have hzero : ![0, 1] ∈ H := by
    apply Submodule.subset_span
    exact ⟨0, rfl⟩
  have hone : ![1, 0] ∈ H := by
    apply Submodule.subset_span
    refine ⟨1, ?_⟩
    ext i
    fin_cases i <;> norm_num [jordanTwo]
  apply top_unique
  intro x _hx
  have hx : x 0 • ![1, 0] + x 1 • ![0, 1] ∈ H :=
    H.add_mem (H.smul_mem (x 0) hone) (H.smul_mem (x 1) hzero)
  convert hx using 1
  ext i
  fin_cases i <;> simp

theorem jordanTwo_polynomial_equality : minpoly ℚ jordanTwo = jordanTwo.charpoly :=
  (hasCyclicVector_iff_minpoly_eq_charpoly jordanTwo).mp jordanTwo_cyclic

theorem jordanTwo_seedRank_one :
    Komorebi.SeedRankBasics.seedRank (operatorAlgebra jordanTwo) TwoV = 1 :=
  (operatorAlgebra_seedRank_eq_one_iff_minpoly_eq_charpoly jordanTwo).mpr
    jordanTwo_polynomial_equality

-- Grouping counts repeats; it does not collapse their multiplicities.
theorem triple_eigenvalue_count :
    eigenMultiplicity (fun _ : Fin 3 ↦ (7 : ℚ)) 7 = 3 := by
  simp [eigenMultiplicity, Nat.card_eq_fintype_card]

-- The spectral construction's empty-dimensional branch really returns zero.
theorem empty_spectrum_rank_zero
    (T : Module.End ℝ (EuclideanSpace ℝ (Fin 0))) (hT : T.IsSymmetric) :
    maxEigenMultiplicity (spectralList T hT) = 0 :=
  (selfAdjoint_seedNumber_isLeast T hT).unique
    (seedNumber_zero_isLeast_of_subsingleton T)

-- The general norm inequality intentionally includes a zero-dimensional endpoint.
theorem zero_coordinate_condition_number :
    conditionNumber (ContinuousLinearEquiv.refl ℝ (EuclideanSpace ℝ (Fin 0))) = 0 :=
  conditionNumber_eq_zero_of_subsingleton _

theorem zero_coordinate_not_conditioned_below_by_one :
    ¬ 1 ≤ conditionNumber
      (ContinuousLinearEquiv.refl ℝ (EuclideanSpace ℝ (Fin 0))) := by
  rw [zero_coordinate_condition_number]
  norm_num

end PaperICompletionTests
