  [Module A M] (x : M) : x ∈ Ideal.primaryComponent M I ↔ ∃ n, x ∈ Submodule.torsionBySet A M ↑(I ^ n)
Ideal.span_singleton_pow.{u} {R : Type u} [Semiring R] (s : R) [(Ideal.span {s}).IsTwoSided] (n : ℕ) :
  Ideal.span {s} ^ n = Ideal.span {s ^ n}
Submodule.torsionBySet_ideal_span_singleton_eq.{u_1, u_2} {R : Type u_1} {M : Type u_2} [CommSemiring R]
  [AddCommMonoid M] [Module R M] (a : R) : Submodule.torsionBySet R M ↑(Ideal.span {a}) = Submodule.torsionBy R M a
Submodule.mem_torsionBy_iff.{u_1, u_2} {R : Type u_1} {M : Type u_2} [CommSemiring R] [AddCommMonoid M] [Module R M]
  (a : R) (x : M) : x ∈ Submodule.torsionBy R M a ↔ a • x = 0
