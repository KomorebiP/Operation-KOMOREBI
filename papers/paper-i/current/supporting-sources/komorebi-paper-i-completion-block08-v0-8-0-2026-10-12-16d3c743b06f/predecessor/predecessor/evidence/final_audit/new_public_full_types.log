theorem Komorebi.PaperICompletion6.ScalarExtension.hasCyclicVector_baseChange_iff.{u, v, w} : ∀ {k : Type u}
  [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] (K : Type w) [inst_3 : Field K]
  [inst_4 : Algebra k K] [FiniteDimensional k V] (T : Module.End k V),
  Komorebi.SingleOperatorGraph.HasCyclicVector (LinearMap.baseChange K T) ↔
    Komorebi.SingleOperatorGraph.HasCyclicVector T :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] K [Field K] [Algebra k K] [FiniteDimensional k V] T =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a ↔ Komorebi.SingleOperatorGraph.HasCyclicVector T)
        (propext
          (Komorebi.PaperICompletion.CyclicClassification.hasCyclicVector_iff_minpoly_eq_charpoly
            (LinearMap.baseChange K T)))))
    (Eq.mpr
      (id
        (congrArg (fun _a => minpoly K (LinearMap.baseChange K T) = (LinearMap.baseChange K T).charpoly ↔ _a)
          (propext (Komorebi.PaperICompletion.CyclicClassification.hasCyclicVector_iff_minpoly_eq_charpoly T))))
      (Komorebi.PaperICompletion6.ScalarExtension.minpoly_eq_charpoly_baseChange_iff K T))
theorem Komorebi.PaperICompletion6.ScalarExtension.hasCyclicVector_iff_extended_spectral_multiplicities_one.{u, v, w} : ∀
  {k : Type u} [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] (K : Type w)
  [inst_3 : Field K] [inst_4 : Algebra k K] [FiniteDimensional k V] [Nontrivial V] [IsAlgClosed K] (T : Module.End k V),
  Komorebi.SingleOperatorGraph.HasCyclicVector T ↔
    ∀ a ∈ spectrum K (LinearMap.baseChange K T),
      Module.finrank K ↥(Module.End.eigenspace (LinearMap.baseChange K T) a) = 1 :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] K [Field K] [Algebra k K] [FiniteDimensional k V] [Nontrivial V]
    [IsAlgClosed K] T =>
  let this := Komorebi.PaperICompletion6.ScalarExtension.baseChange_nontrivial K;
  Iff.trans (Iff.symm (Komorebi.PaperICompletion6.ScalarExtension.hasCyclicVector_baseChange_iff K T))
    (Komorebi.PaperICompletion5.CyclicGeometricCriterion.hasCyclicVector_iff_all_spectral_multiplicities_one
      (LinearMap.baseChange K T))
theorem Komorebi.PaperICompletion6.ScalarExtension.isBaseChange_endomorphisms.{u, v, w} : ∀ {k : Type u}
  [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] (K : Type w) [inst_3 : Field K]
  [inst_4 : Algebra k K] [FiniteDimensional k V], IsBaseChange K (LinearMap.baseChangeHom k K V V) :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] K [Field K] [Algebra k K] [FiniteDimensional k V] =>
  Eq.mpr
    (id
      (congrArg (fun _a => IsBaseChange K _a)
        (Eq.symm (Komorebi.PaperICompletion6.ScalarExtension.tensor_endHom_eq_baseChange K))))
    (IsBaseChange.end (TensorProduct.isBaseChange k V K))
theorem Komorebi.PaperICompletion6.ScalarExtension.linearIndependent_baseChange.{u, v, w, u_1} : ∀ {k : Type u}
  [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] (K : Type w) [inst_3 : Field K]
  [inst_4 : Algebra k K] [FiniteDimensional k V] {ι : Type u_1} {f : ι → Module.End k V},
  LinearIndependent k f → LinearIndependent K fun i => LinearMap.baseChange K (f i) :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] K [inst_3 : Field K] [Algebra k K] [FiniteDimensional k V] {ι} {f}
    hf =>
  have h :=
    LinearIndependent.map' (Module.Flat.linearIndependent_one_tmul hf)
      (↑(Komorebi.PaperICompletion6.ScalarExtension.isBaseChange_endomorphisms K).equiv)
      (LinearMap.ker_eq_bot.mpr
        (LinearEquiv.injective (Komorebi.PaperICompletion6.ScalarExtension.isBaseChange_endomorphisms K).equiv));
  Eq.mp
    (congrFun
      (congrFun
        (congrFun
          (congrArg (LinearIndependent K)
            (funext fun x =>
              Eq.trans (congrArg (HSMul.hSMul 1) (LinearMap.baseChangeHom_apply k K V V (f x)))
                (one_smul K (LinearMap.baseChange K (f x)))))
          inst_3.toDivisionRing.toSemiring)
        LinearMap.addCommGroup.toAddCommMonoid)
      LinearMap.module)
    h
theorem Komorebi.PaperICompletion6.ScalarExtension.linearIndependent_baseChange_powers.{u, v, w} : ∀ {k : Type u}
  [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] (K : Type w) [inst_3 : Field K]
  [inst_4 : Algebra k K] [FiniteDimensional k V] (T : Module.End k V),
  LinearIndependent K fun i => LinearMap.baseChange K T ^ ↑i :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] K [Field K] [Algebra k K] [FiniteDimensional k V] T =>
  Eq.mp
    (congrFun
      (congrFun
        (congrFun (congrArg (LinearIndependent K) (funext fun i => LinearMap.baseChange_pow k K V T ↑i))
          Field.toSemifield.toSemiring)
        LinearMap.addCommMonoid)
      LinearMap.module)
    (Komorebi.PaperICompletion6.ScalarExtension.linearIndependent_baseChange K (linearIndependent_pow T))
theorem Komorebi.PaperICompletion6.ScalarExtension.minpoly_baseChange.{u, v, w} : ∀ {k : Type u} [inst : Field k]
  {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] (K : Type w) [inst_3 : Field K] [inst_4 : Algebra k K]
  [FiniteDimensional k V] (T : Module.End k V),
  minpoly K (LinearMap.baseChange K T) = Polynomial.map (algebraMap k K) (minpoly k T) :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] K [Field K] [Algebra k K] [FiniteDimensional k V] T =>
  minpoly.eq_of_linearIndependent K (LinearMap.baseChange K T)
    (Polynomial.Monic.map (algebraMap k K) (minpoly.monic (LinearMap.isIntegral T)))
    (Eq.mpr
      (id
        (congrArg (fun _a => _a = 0)
          (Komorebi.PaperICompletion6.ScalarExtension.aeval_map_baseChange K T (minpoly k T))))
      (Eq.mpr (id (congrArg (fun _a => LinearMap.baseChange K _a = 0) (minpoly.aeval k T)))
        (Eq.mpr (id (congrArg (fun _a => _a = 0) LinearMap.baseChange_zero)) (Eq.refl 0))))
    (minpoly k T).natDegree
    (Eq.mpr
      (id
        (congrArg (fun _a => _a = ↑(minpoly k T).natDegree)
          (Polynomial.degree_map_eq_of_injective (RingHom.injective (algebraMap k K)) (minpoly k T))))
      (Eq.mpr
        (id
          (congrArg (fun _a => _a = ↑(minpoly k T).natDegree)
            (Polynomial.degree_eq_natDegree (minpoly.ne_zero (LinearMap.isIntegral T)))))
        (Eq.refl ↑(minpoly k T).natDegree)))
    (Komorebi.PaperICompletion6.ScalarExtension.linearIndependent_baseChange_powers K T)
theorem Komorebi.PaperICompletion6.ScalarExtension.minpoly_eq_charpoly_baseChange_iff.{u, v, w} : ∀ {k : Type u}
  [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] (K : Type w) [inst_3 : Field K]
  [inst_4 : Algebra k K] [inst_5 : FiniteDimensional k V] (T : Module.End k V),
  minpoly K (LinearMap.baseChange K T) = (LinearMap.baseChange K T).charpoly ↔ minpoly k T = LinearMap.charpoly T :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] K [Field K] [Algebra k K] [FiniteDimensional k V] T =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a = (LinearMap.baseChange K T).charpoly ↔ minpoly k T = LinearMap.charpoly T)
        (Komorebi.PaperICompletion6.ScalarExtension.minpoly_baseChange K T)))
    (Eq.mpr
      (id
        (congrArg (fun _a => Polynomial.map (algebraMap k K) (minpoly k T) = _a ↔ minpoly k T = LinearMap.charpoly T)
          (LinearMap.charpoly_baseChange T K)))
      (Function.Injective.eq_iff (Polynomial.map_injective (algebraMap k K) (RingHom.injective (algebraMap k K)))))
theorem Komorebi.PaperICompletion6.ScalarExtension.minpoly_natDegree_baseChange.{u, v, w} : ∀ {k : Type u}
  [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] (K : Type w) [inst_3 : Field K]
  [inst_4 : Algebra k K] [FiniteDimensional k V] (T : Module.End k V),
  (minpoly K (LinearMap.baseChange K T)).natDegree = (minpoly k T).natDegree :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] K [Field K] [Algebra k K] [FiniteDimensional k V] T =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a.natDegree = (minpoly k T).natDegree)
        (Komorebi.PaperICompletion6.ScalarExtension.minpoly_baseChange K T)))
    (Eq.mpr
      (id
        (congrArg (fun _a => _a = (minpoly k T).natDegree)
          (Polynomial.natDegree_map_eq_of_injective (RingHom.injective (algebraMap k K)) (minpoly k T))))
      (Eq.refl (minpoly k T).natDegree))
theorem Komorebi.PaperICompletion6.ScalarExtension.tensor_endHom_eq_baseChange.{u, v, w} : ∀ {k : Type u}
  [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] (K : Type w) [inst_3 : Field K]
  [inst_4 : Algebra k K], ⋯.endHom = LinearMap.baseChangeHom k K V V :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] K [Field K] [Algebra k K] =>
  LinearMap.ext fun T =>
    IsBaseChange.algHom_ext (TensorProduct.isBaseChange k V K) ((TensorProduct.isBaseChange k V K).endHom T)
      ((LinearMap.baseChangeHom k K V V) T) fun x =>
      Eq.mpr
        (id
          (congrArg (Eq (((TensorProduct.isBaseChange k V K).endHom T) (1 ⊗ₜ[k] x)))
            (congrFun' (congrArg DFunLike.coe (LinearMap.baseChangeHom_apply k K V V T)) (1 ⊗ₜ[k] x))))
        (IsBaseChange.endHom_comp_apply (TensorProduct.isBaseChange k V K) T x)
theorem Komorebi.PaperICompletion6.SixWayCyclicCriterion.cyclic_iff_invariantFactor_count_one.{u, v} : ∀ {k : Type u}
  [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] [FiniteDimensional k V] [Nontrivial V]
  (T : Module.End k V) {r : ℕ} (p : Fin r → Polynomial k),
  (∀ (i : Fin r), 0 < (p i).natDegree) →
    (∀ (i j : Fin r), i ≤ j → p i ∣ p j) →
      ∀ (E : Module.AEval' T ≃ₗ[Polynomial k] (i : Fin r) → Polynomial k ⧸ Ideal.span {p i}),
        Komorebi.SingleOperatorGraph.HasCyclicVector T ↔ r = 1 :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] [FiniteDimensional k V] [Nontrivial V] T {r} p hp hchain E =>
  have hr :=
    (Komorebi.PaperICompletion3.InvariantFactorCount.invariantFactor_operator_seedRanks T p hp hchain E).right.right;
  have h :=
    Iff.trans (Komorebi.PaperICompletion.CyclicClassification.hasCyclicVector_iff_minpoly_eq_charpoly T)
      (Iff.symm
        (Komorebi.PaperICompletion.CyclicClassification.operatorAlgebra_seedRank_eq_one_iff_minpoly_eq_charpoly T));
  Iff.trans (Eq.mp (congrArg (fun _a => Komorebi.SingleOperatorGraph.HasCyclicVector T ↔ _a = 1) hr) h)
    (Eq.mpr
      (id
        (Eq.trans (congrFun' (congrArg Iff (congrArg (Eq ↑r) (Eq.symm Nat.cast_one))) (r = 1))
          (congrFun' (congrArg Iff Nat.cast_inj._simp_1) (r = 1))))
      Iff.rfl)
theorem Komorebi.PaperICompletion6.SixWayCyclicCriterion.cyclic_six_way.{u, v, w} : ∀ {k : Type u} [inst : Field k]
  {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] [inst_3 : FiniteDimensional k V] [Nontrivial V]
  (K : Type w) [inst_5 : Field K] [inst_6 : Algebra k K] [IsAlgClosed K] (T : Module.End k V),
  [Komorebi.SingleOperatorGraph.HasCyclicVector T,
      Komorebi.SeedRankBasics.seedRank (↥(Komorebi.SingleOperatorGraph.operatorAlgebra T)) V = 1,
      ∀ (p : Polynomial k),
        Irreducible p →
          Nontrivial ↥(Komorebi.PaperICompletion4.IntrinsicPrimary.primarySubmodule (Module.AEval' T) p) →
            Komorebi.SeedRankBasics.Cyclic (Polynomial k)
              ↥(Komorebi.PaperICompletion4.IntrinsicPrimary.primarySubmodule (Module.AEval' T) p),
      Komorebi.PaperICompletion6.OneInvariantFactor.HasOneInvariantFactor T, minpoly k T = LinearMap.charpoly T,
      ∀ a ∈ spectrum K (LinearMap.baseChange K T),
        Module.finrank K ↥(Module.End.eigenspace (LinearMap.baseChange K T) a) = 1].TFAE :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] [FiniteDimensional k V] [Nontrivial V] K [Field K] [Algebra k K]
    [IsAlgClosed K] T =>
  have tfae_1_iff_5 := Komorebi.PaperICompletion.CyclicClassification.hasCyclicVector_iff_minpoly_eq_charpoly T;
  have tfae_2_iff_5 :=
    Komorebi.PaperICompletion.CyclicClassification.operatorAlgebra_seedRank_eq_one_iff_minpoly_eq_charpoly T;
  have tfae_1_iff_3 := Komorebi.PaperICompletion6.PrimaryCyclicCriterion.hasCyclicVector_iff_nonzero_primary_cyclic T;
  have tfae_1_iff_4 := Komorebi.PaperICompletion6.OneInvariantFactor.hasCyclicVector_iff_oneInvariantFactor T;
  have tfae_1_iff_6 :=
    Komorebi.PaperICompletion6.ScalarExtension.hasCyclicVector_iff_extended_spectral_multiplicities_one K T;
  List.tfae_of_cycle
    (List.IsChain.cons_cons (fun h => tfae_2_iff_5.mpr (tfae_1_iff_5.mp h))
      (List.IsChain.cons_cons (fun h => tfae_1_iff_3.mp (tfae_1_iff_5.mpr (tfae_2_iff_5.mp h)))
        (List.IsChain.cons_cons (fun h => tfae_1_iff_4.mp (tfae_1_iff_3.mpr h))
          (List.IsChain.cons_cons (fun h => tfae_1_iff_5.mp (tfae_1_iff_4.mpr h))
            (List.IsChain.cons_cons (fun h => tfae_1_iff_6.mp (tfae_1_iff_5.mpr h))
              (List.IsChain.singleton
                (∀ a ∈ spectrum K (LinearMap.baseChange K T),
                  Module.finrank K ↥(Module.End.eigenspace (LinearMap.baseChange K T) a) = 1)))))))
    fun h => tfae_1_iff_6.mpr h
theorem Komorebi.PaperICompletion6.SixWayCyclicCriterion.cyclic_six_way_algebraicClosure.{u, v} : ∀ {k : Type u}
  [inst : Field k] {V : Type v} [inst_1 : AddCommGroup V] [inst_2 : Module k V] [inst_3 : FiniteDimensional k V]
  [Nontrivial V] (T : Module.End k V),
  [Komorebi.SingleOperatorGraph.HasCyclicVector T,
      Komorebi.SeedRankBasics.seedRank (↥(Komorebi.SingleOperatorGraph.operatorAlgebra T)) V = 1,
      ∀ (p : Polynomial k),
        Irreducible p →
          Nontrivial ↥(Komorebi.PaperICompletion4.IntrinsicPrimary.primarySubmodule (Module.AEval' T) p) →
            Komorebi.SeedRankBasics.Cyclic (Polynomial k)
              ↥(Komorebi.PaperICompletion4.IntrinsicPrimary.primarySubmodule (Module.AEval' T) p),
      Komorebi.PaperICompletion6.OneInvariantFactor.HasOneInvariantFactor T, minpoly k T = LinearMap.charpoly T,
      ∀ a ∈ spectrum (AlgebraicClosure k) (LinearMap.baseChange (AlgebraicClosure k) T),
        Module.finrank (AlgebraicClosure k) ↥(Module.End.eigenspace (LinearMap.baseChange (AlgebraicClosure k) T) a) =
          1].TFAE :=
fun {k} [Field k] {V} [AddCommGroup V] [Module k V] [FiniteDimensional k V] [Nontrivial V] T =>
  Komorebi.PaperICompletion6.SixWayCyclicCriterion.cyclic_six_way (AlgebraicClosure k) T
