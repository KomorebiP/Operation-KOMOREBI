\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces A rotating rank one packet and its orthogonal complement. With $u(\mittheta )=(\cos \mittheta ,\sin \mittheta )$ and $P(\mittheta )=u(\mittheta )u(\mittheta )^{\mathsf T}$, the canonical generator is $[P',P]=\bigl  (\begin  {smallmatrix}0&-1 1&0\end  {smallmatrix}\bigr  )$. For a positive step $\mitdelta <\mitpi /2$, the polar unitary is the usual rotation $R(\mitdelta )$. On each displayed mesh, the direct rotation product equals $R(\mitpi /3)$ exactly. This special planar example illustrates the construction. The general theorem supplies convergence for families whose step products need not already equal the continuous transport.}}{67}{figure.caption.6}\protected@file@percent }
\newlabel{fig:rotating-projector-example}{{6}{67}{A rotating rank one packet and its orthogonal complement. With $u(\theta )=(\cos \theta ,\sin \theta )$ and $P(\theta )=u(\theta )u(\theta )^{\mathsf T}$, the canonical generator is $[P',P]=\bigl (\begin {smallmatrix}0&-1\\1&0\end {smallmatrix}\bigr )$. For a positive step $\delta <\pi /2$, the polar unitary is the usual rotation $R(\delta )$. On each displayed mesh, the direct rotation product equals $R(\pi /3)$ exactly. This special planar example illustrates the construction. The general theorem supplies convergence for families whose step products need not already equal the continuous transport}{figure.caption.6}{}}
\newlabel{fig:rotating-projector-example@cref}{{[figure][6][]6}{[1][66][]67}}
