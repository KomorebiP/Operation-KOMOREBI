import Mathlib.NumberTheory.LocalField.Basic
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.SetTheory.Cardinal.Finite

/-! Uniformizer arithmetic in the actual integer ring of a local field.
An irreducible integer-ring element generates the actual maximal ideal,
so primality, nonzeroness, and residue size are derived rather than supplied. -/
set_option autoImplicit false
noncomputable section
namespace PaperXI.MoritaUniformizer110
open ValuativeRel

variable {E : Type*} [Field E] [ValuativeRel E] [TopologicalSpace E]
  [IsNonarchimedeanLocalField E]

/-- The literal ideal generated by an integer-ring uniformizer. -/
def uniformizerIdeal (π : 𝒪[E]) : Ideal 𝒪[E] := Ideal.span {π}

/-- The DVR instance of the actual integer ring constructs a uniformizer. -/
theorem exists_uniformizer : ∃ π : 𝒪[E], Irreducible π :=
  IsDiscreteValuationRing.exists_irreducible 𝒪[E]

/-- Irreducibility identifies the generated ideal with the actual maximal ideal. -/
theorem uniformizerIdeal_eq_maximalIdeal (π : 𝒪[E]) (hπ : Irreducible π) :
    uniformizerIdeal π = 𝓂[E] := hπ.maximalIdeal_eq.symm

theorem uniformizerIdeal_ne_bot (π : 𝒪[E]) (hπ : Irreducible π) :
    uniformizerIdeal π ≠ ⊥ := by
  rw [uniformizerIdeal_eq_maximalIdeal π hπ]
  exact IsDiscreteValuationRing.not_a_field 𝒪[E]

theorem uniformizerIdeal_isMaximal (π : 𝒪[E]) (hπ : Irreducible π) :
    (uniformizerIdeal π).IsMaximal := by
  rw [uniformizerIdeal_eq_maximalIdeal π hπ]
  infer_instance

/-- The prime-ideal hypothesis for the ideal-power quotient theorem is derived. -/
theorem uniformizerIdeal_isPrime (π : 𝒪[E]) (hπ : Irreducible π) :
    (uniformizerIdeal π).IsPrime :=
  (uniformizerIdeal_isMaximal π hπ).isPrime

/-- The canonical quotient by a uniformizer is the actual residue field. -/
def uniformizerResidueEquiv (π : 𝒪[E]) (hπ : Irreducible π) :
    (𝒪[E] ⧸ uniformizerIdeal π) ≃+* 𝓀[E] :=
  Ideal.quotEquivOfEq (uniformizerIdeal_eq_maximalIdeal π hπ)

@[simp] theorem uniformizerResidueEquiv_mk (π : 𝒪[E]) (hπ : Irreducible π)
    (x : 𝒪[E]) :
    uniformizerResidueEquiv π hπ (Ideal.Quotient.mk (uniformizerIdeal π) x) =
      IsLocalRing.residue 𝒪[E] x := rfl

/-- Quotient finiteness follows from local-field residue finiteness. -/
theorem uniformizer_quotient_finite (π : 𝒪[E]) (hπ : Irreducible π) :
    Finite (𝒪[E] ⧸ uniformizerIdeal π) :=
  Finite.of_equiv 𝓀[E] (uniformizerResidueEquiv π hπ).symm.toEquiv

/-- Its size is the actual residue size, with no supplied finite-card premise. -/
theorem card_uniformizer_quotient (π : 𝒪[E]) (hπ : Irreducible π) :
    Nat.card (𝒪[E] ⧸ uniformizerIdeal π) = Nat.card 𝓀[E] :=
  Nat.card_congr (uniformizerResidueEquiv π hπ).toEquiv

end PaperXI.MoritaUniformizer110
