import PaperX.IdealClassQuantitativeAttachment

/-!
# Exact norm-filtered generator and ideal counts

Arbitrary conditions on the actual absolute norm survive the generator-to-ideal
correspondence. The roots-of-unity multiplicity is retained exactly.
-/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
noncomputable section

open Ideal NumberField Submodule
open scoped nonZeroDivisors Classical
open NumberField.mixedEmbedding NumberField.mixedEmbedding.fundamentalCone
open NumberField.Units

namespace PaperX.IdealNormFilter

open PaperX.IdealClassQuantitative

variable (K : Type*) [Field K] [NumberField K]

/-- Generators in the actual ideal cone correspond to divisible principal ideals
and a roots-of-unity coordinate. -/
def idealSetPrincipalEquiv (J : (Ideal (𝓞 K))⁰) :
    idealSet K J ≃
      {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
        IsPrincipal (I : Ideal (𝓞 K))} × torsion K :=
  calc
    _ ≃ {a : integerSet K // (preimageOfMemIntegerSet a : 𝓞 K) ∈ (J : Ideal (𝓞 K))} :=
      idealSetEquiv K J
    _ ≃ {I : {I : (Ideal (𝓞 K))⁰ // IsPrincipal I.val} × torsion K //
        (J : Ideal (𝓞 K)) ∣ I.1.val} :=
      Equiv.subtypeEquiv (integerSetEquiv K) fun a => by
        rw [integerSetEquiv_apply_fst, dvd_span_singleton]
    _ ≃ {I : {I : (Ideal (𝓞 K))⁰ // IsPrincipal I.val} //
        (J : Ideal (𝓞 K)) ∣ I.val} × torsion K :=
      Equiv.prodSubtypeFstEquivSubtypeProd
        (p := fun I : {I : (Ideal (𝓞 K))⁰ // IsPrincipal I.val} =>
          (J : Ideal (𝓞 K)) ∣ I.val)
    _ ≃ {I : (Ideal (𝓞 K))⁰ //
        (J : Ideal (𝓞 K)) ∣ I ∧ IsPrincipal (I : Ideal (𝓞 K))} × torsion K :=
      Equiv.prodCongrLeft fun _ =>
        (Equiv.subtypeSubtypeEquivSubtypeInter
          (fun I : (Ideal (𝓞 K))⁰ => IsPrincipal (I : Ideal (𝓞 K)))
          (fun I => (J : Ideal (𝓞 K)) ∣ I)).trans
          (Equiv.subtypeEquivRight fun _ => and_comm)

/-- The principal ideal is generated by the represented integral element. -/
theorem idealSetPrincipalEquiv_apply_fst (J : (Ideal (𝓞 K))⁰) (a : idealSet K J) :
    ((idealSetPrincipalEquiv K J a).1 : Ideal (𝓞 K)) =
      span {(preimageOfMemIntegerSet (idealSetMap K J a) : 𝓞 K)} := rfl

/-- The correspondence preserves the actual absolute norm. -/
theorem idealSetPrincipalEquiv_absNorm (J : (Ideal (𝓞 K))⁰) (a : idealSet K J) :
    (absNorm ((idealSetPrincipalEquiv K J a).1 : Ideal (𝓞 K)) : ℝ) =
      mixedEmbedding.norm (a : mixedSpace K) := by
  rw [idealSetPrincipalEquiv_apply_fst, absNorm_span_singleton, ← intNorm,
    intNorm_coe, idealSetMap_apply]

/-- Restricting by any norm predicate retains the full torsion coordinate. -/
def idealSetPrincipalFilterEquiv (J : (Ideal (𝓞 K))⁰) (P : ℝ → Prop) :
    {a : idealSet K J // P (mixedEmbedding.norm (a : mixedSpace K))} ≃
      {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
        IsPrincipal (I : Ideal (𝓞 K)) ∧ P (absNorm (I : Ideal (𝓞 K)))} × torsion K :=
  calc
    _ ≃ {I : {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
        IsPrincipal (I : Ideal (𝓞 K))} × torsion K //
        P (absNorm (I.1 : Ideal (𝓞 K)))} :=
      Equiv.subtypeEquiv (idealSetPrincipalEquiv K J) fun a => by
        rw [idealSetPrincipalEquiv_absNorm]
    _ ≃ {I : {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
        IsPrincipal (I : Ideal (𝓞 K))} //
        P (absNorm (I : Ideal (𝓞 K)))} × torsion K :=
      Equiv.prodSubtypeFstEquivSubtypeProd
        (p := fun I : {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
          IsPrincipal (I : Ideal (𝓞 K))} => P (absNorm (I : Ideal (𝓞 K))))
    _ ≃ {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
        IsPrincipal (I : Ideal (𝓞 K)) ∧ P (absNorm (I : Ideal (𝓞 K)))} × torsion K :=
      Equiv.prodCongrLeft fun _ =>
        (Equiv.subtypeSubtypeEquivSubtypeInter
          (fun I : (Ideal (𝓞 K))⁰ => (J : Ideal (𝓞 K)) ∣ I ∧
            IsPrincipal (I : Ideal (𝓞 K)))
          (fun I => P (absNorm (I : Ideal (𝓞 K))))).trans
          (Equiv.subtypeEquivRight fun _ => and_assoc)

/-- Exact cardinality for an arbitrary norm filter, without finiteness assumptions. -/
theorem card_generators_eq_filtered_principal_mul_torsion
    (J : (Ideal (𝓞 K))⁰) (P : ℝ → Prop) :
    Nat.card {a : idealSet K J // P (mixedEmbedding.norm (a : mixedSpace K))} =
      Nat.card {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
        IsPrincipal (I : Ideal (𝓞 K)) ∧ P (absNorm (I : Ideal (𝓞 K)))} * torsionOrder K := by
  rw [Nat.card_congr (idealSetPrincipalFilterEquiv K J P), Nat.card_prod, torsionOrder]

/-- Multiplication by an inverse-class ideal preserves any predicate on product norm. -/
theorem filtered_class_eq_filtered_principal {C : ClassGroup (𝓞 K)}
    {J : (Ideal (𝓞 K))⁰} (hJ : ClassGroup.mk0 J = C⁻¹) (P : ℝ → Prop) :
    Nat.card {I : (Ideal (𝓞 K))⁰ // ClassGroup.mk0 I = C ∧
      P ((absNorm (I : Ideal (𝓞 K)) : ℝ) * absNorm (J : Ideal (𝓞 K)))} =
    Nat.card {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
      IsPrincipal (I : Ideal (𝓞 K)) ∧ P (absNorm (I : Ideal (𝓞 K)))} := by
  simp_rw [← nonZeroDivisors_dvd_iff_dvd_coe]
  refine Nat.card_congr ?_
  refine ((Equiv.dvd J).subtypeEquiv fun I => ?_).trans
    (Equiv.subtypeSubtypeEquivSubtypeInter (fun I : (Ideal (𝓞 K))⁰ => J ∣ I) _)
  rw [← ClassGroup.mk0_eq_one_iff (SetLike.coe_mem _)]
  simp_rw [Equiv.dvd_apply, Submonoid.coe_mul, ← Submonoid.mul_def, _root_.map_mul, hJ,
    inv_mul_eq_one, Nat.cast_mul]
  simp [mul_comm, eq_comm]

/-- The actual bounded norm-filtered generator count has the exact roots-of-unity factor. -/
theorem card_bounded_filtered_generators {C : ClassGroup (𝓞 K)}
    {J : (Ideal (𝓞 K))⁰} (hJ : ClassGroup.mk0 J = C⁻¹)
    (P : ℝ → Prop) (X : ℝ) :
    Nat.card {a : idealSet K J //
      mixedEmbedding.norm (a : mixedSpace K) ≤ X * absNorm (J : Ideal (𝓞 K)) ∧
      P (mixedEmbedding.norm (a : mixedSpace K))} =
    Nat.card {I : (Ideal (𝓞 K))⁰ // (absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ X ∧
      ClassGroup.mk0 I = C ∧
      P ((absNorm (I : Ideal (𝓞 K)) : ℝ) * absNorm (J : Ideal (𝓞 K)))} * torsionOrder K := by
  rw [card_generators_eq_filtered_principal_mul_torsion K J
    (fun y => y ≤ X * absNorm (J : Ideal (𝓞 K)) ∧ P y),
    ← filtered_class_eq_filtered_principal K hJ
      (fun y => y ≤ X * absNorm (J : Ideal (𝓞 K)) ∧ P y)]
  congr 1
  apply Nat.card_congr
  apply Equiv.subtypeEquivRight
  intro I
  have hN : (0 : ℝ) < absNorm (J : Ideal (𝓞 K)) := by
    exact_mod_cast absNorm_pos_of_nonZeroDivisors J
  rw [mul_le_mul_iff_left₀ hN]
  exact and_left_comm

end PaperX.IdealNormFilter
