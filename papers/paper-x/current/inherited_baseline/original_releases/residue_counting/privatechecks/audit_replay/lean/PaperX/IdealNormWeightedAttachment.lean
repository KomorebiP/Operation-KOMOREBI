import PaperX.IdealNormFilterAttachment
import PaperX.IdealClassCharacterSum
import Mathlib.Algebra.BigOperators.Finprod
import Mathlib.Data.ZMod.Basic

/-! Exact weighted generator-to-ideal attachment. The roots-of-unity factor
and the norm of the inverse-class representative are retained explicitly. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
noncomputable section

open Ideal NumberField Submodule
open scoped nonZeroDivisors Classical BigOperators
open NumberField.mixedEmbedding NumberField.mixedEmbedding.fundamentalCone
open NumberField.Units

namespace PaperX.IdealNormWeighted

open PaperX.IdealNormFilter

variable (K : Type*) [Field K] [NumberField K]

/-- The actual absolute norm of the principal ideal generated by a cone point. -/
def generatorAbsNorm (J : (Ideal (𝓞 K))⁰) (a : idealSet K J) : ℕ :=
  absNorm (span {(preimageOfMemIntegerSet (idealSetMap K J a) : 𝓞 K)})

/-- This integral norm equals the real norm of the represented cone point. -/
theorem generatorAbsNorm_cast (J : (Ideal (𝓞 K))⁰) (a : idealSet K J) :
    (generatorAbsNorm K J a : ℝ) = mixedEmbedding.norm (a : mixedSpace K) := by
  rw [generatorAbsNorm, ← idealSetPrincipalEquiv_apply_fst]
  exact idealSetPrincipalEquiv_absNorm K J a

/-- Actual nonzero integral ideals in a class, bounded by absolute norm. -/
abbrev BoundedClassIdeals (C : ClassGroup (𝓞 K)) (X : ℝ) :=
  {I : (Ideal (𝓞 K))⁰ // (absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ X ∧ ClassGroup.mk0 I = C}

/-- Actual divisible principal ideals, bounded by absolute norm. -/
abbrev BoundedPrincipalIdeals (J : (Ideal (𝓞 K))⁰) (Y : ℝ) :=
  {I : (Ideal (𝓞 K))⁰ // (J : Ideal (𝓞 K)) ∣ I ∧
    IsPrincipal (I : Ideal (𝓞 K)) ∧ (absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ Y}

instance boundedClassIdeals_finite (C : ClassGroup (𝓞 K)) (X : ℝ) :
    Finite (BoundedClassIdeals K C X) :=
  Finite.of_injective
    (fun I => (⟨I.val, I.property.1⟩ :
      {I : (Ideal (𝓞 K))⁰ // (absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ X}))
    (fun _ _ h => Subtype.ext (congrArg
      (fun z : {I : (Ideal (𝓞 K))⁰ // (absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ X} => z.val) h))

instance boundedPrincipalIdeals_finite (J : (Ideal (𝓞 K))⁰) (Y : ℝ) :
    Finite (BoundedPrincipalIdeals K J Y) :=
  Finite.of_injective
    (fun I => (⟨I.val, I.property.2.2⟩ :
      {I : (Ideal (𝓞 K))⁰ // (absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ Y}))
    (fun _ _ h => Subtype.ext (congrArg
      (fun z : {I : (Ideal (𝓞 K))⁰ // (absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ Y} => z.val) h))

/-- Bounded generator sums have finite domains; no infinite-support convention is used. -/
instance boundedGenerators_finite (J : (Ideal (𝓞 K))⁰) (Y : ℝ) :
    Finite {a : idealSet K J // mixedEmbedding.norm (a : mixedSpace K) ≤ Y} :=
  Finite.of_injective (idealSetPrincipalFilterEquiv K J (fun y => y ≤ Y))
    (idealSetPrincipalFilterEquiv K J (fun y => y ≤ Y)).injective

/-- Multiplication by the supplied inverse-class ideal is an exact bounded equivalence. -/
def classPrincipalEquiv {C : ClassGroup (𝓞 K)} {J : (Ideal (𝓞 K))⁰}
    (hJ : ClassGroup.mk0 J = C⁻¹) (X : ℝ) :
    BoundedClassIdeals K C X ≃
      BoundedPrincipalIdeals K J (X * absNorm (J : Ideal (𝓞 K))) := by
  let e : BoundedClassIdeals K C X ≃
      {I : (Ideal (𝓞 K))⁰ // J ∣ I ∧ IsPrincipal (I : Ideal (𝓞 K)) ∧
        (absNorm (I : Ideal (𝓞 K)) : ℝ) ≤ X * absNorm (J : Ideal (𝓞 K))} := by
    refine ((Equiv.dvd J).subtypeEquiv fun I => ?_).trans
      (Equiv.subtypeSubtypeEquivSubtypeInter (fun I : (Ideal (𝓞 K))⁰ => J ∣ I) _)
    rw [← ClassGroup.mk0_eq_one_iff (SetLike.coe_mem _)]
    simp_rw [Equiv.dvd_apply, Submonoid.coe_mul, ← Submonoid.mul_def, _root_.map_mul, hJ,
      inv_mul_eq_one, Nat.cast_mul, mul_comm X, eq_comm, and_comm, and_congr_left_iff]
    exact fun _ =>
      (mul_le_mul_iff_of_pos_left (Nat.cast_pos.mpr (absNorm_pos_of_nonZeroDivisors J))).symm
  exact e.trans (Equiv.subtypeEquivRight fun I => by rw [nonZeroDivisors_dvd_iff_dvd_coe])

/-- The bounded equivalence preserves the product norm, not just the cardinality. -/
theorem classPrincipalEquiv_absNorm {C : ClassGroup (𝓞 K)} {J : (Ideal (𝓞 K))⁰}
    (hJ : ClassGroup.mk0 J = C⁻¹) (X : ℝ) (I : BoundedClassIdeals K C X) :
    absNorm ((classPrincipalEquiv K hJ X I).val : Ideal (𝓞 K)) =
      absNorm (I.val : Ideal (𝓞 K)) * absNorm (J : Ideal (𝓞 K)) := by
  change absNorm ((J : Ideal (𝓞 K)) * (I.val : Ideal (𝓞 K))) = _
  rw [_root_.map_mul, mul_comm]

/-- Sum of any absolute-norm weight over the actual bounded generators. -/
def boundedGeneratorSum (J : (Ideal (𝓞 K))⁰) (f : ℕ → ℂ) (Y : ℝ) : ℂ :=
  ∑ᶠ a : {a : idealSet K J // mixedEmbedding.norm (a : mixedSpace K) ≤ Y},
    f (generatorAbsNorm K J a.val)

/-- Sum of any absolute-norm weight over actual bounded ideals in one class. -/
def classNormSum (C : ClassGroup (𝓞 K)) (f : ℕ → ℂ) (X : ℝ) : ℂ :=
  ∑ᶠ I : BoundedClassIdeals K C X, f (absNorm (I.val : Ideal (𝓞 K)))

/-- The generator sum has the exact roots-of-unity multiplicity over principal ideals. -/
theorem boundedGeneratorSum_eq_principal (J : (Ideal (𝓞 K))⁰) (f : ℕ → ℂ) (Y : ℝ) :
    boundedGeneratorSum K J f Y = (torsionOrder K : ℂ) *
      ∑ᶠ I : BoundedPrincipalIdeals K J Y, f (absNorm (I.val : Ideal (𝓞 K))) := by
  let e := idealSetPrincipalFilterEquiv K J (fun y => y ≤ Y)
  let := Fintype.ofFinite (BoundedPrincipalIdeals K J Y)
  let := Fintype.ofFinite (torsion K)
  have hsum : boundedGeneratorSum K J f Y =
      ∑ᶠ p : BoundedPrincipalIdeals K J Y × torsion K,
        f (absNorm (p.1.val : Ideal (𝓞 K))) := by
    apply finsum_eq_of_bijective e e.bijective
    intro a
    rfl
  rw [hsum, finsum_eq_sum_of_fintype, finsum_eq_sum_of_fintype, Fintype.sum_prod_type]
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  rw [← Finset.mul_sum]
  congr 1
  rw [torsionOrder, Nat.card_eq_fintype_card]

/-- Exact weighted attachment at every real threshold, with the ideal-norm scaling retained. -/
theorem boundedGeneratorSum_eq_classNormSum {C : ClassGroup (𝓞 K)}
    {J : (Ideal (𝓞 K))⁰} (hJ : ClassGroup.mk0 J = C⁻¹) (f : ℕ → ℂ) (X : ℝ) :
    boundedGeneratorSum K J f (X * absNorm (J : Ideal (𝓞 K))) =
      (torsionOrder K : ℂ) *
        classNormSum K C (fun n => f (n * absNorm (J : Ideal (𝓞 K)))) X := by
  rw [boundedGeneratorSum_eq_principal]
  congr 1
  symm
  exact finsum_eq_of_bijective (classPrincipalEquiv K hJ X)
    (classPrincipalEquiv K hJ X).bijective
    (fun I => congrArg f (classPrincipalEquiv_absNorm K hJ X I).symm)

/-- A multiplicative norm-residue character factors out the norm of the
inverse-class representative exactly. -/
theorem boundedGeneratorSum_character {C : ClassGroup (𝓞 K)}
    {J : (Ideal (𝓞 K))⁰} (hJ : ClassGroup.mk0 J = C⁻¹)
    (m : ℕ) (χ : ZMod m →*₀ ℂ) (X : ℝ) :
    boundedGeneratorSum K J (fun n => χ (n : ZMod m))
        (X * absNorm (J : Ideal (𝓞 K))) =
      ((torsionOrder K : ℂ) * χ (absNorm (J : Ideal (𝓞 K)) : ZMod m)) *
        classNormSum K C (fun n => χ (n : ZMod m)) X := by
  rw [boundedGeneratorSum_eq_classNormSum K hJ]
  unfold classNormSum
  simp_rw [Nat.cast_mul, map_mul]
  rw [← finsum_mul]
  ring

/-- Recovering the actual ideal character sum requires the representative's
character value to be nonzero; this condition is not inferred from nontriviality. -/
theorem classNormSum_character_eq_div {C : ClassGroup (𝓞 K)}
    {J : (Ideal (𝓞 K))⁰} (hJ : ClassGroup.mk0 J = C⁻¹)
    (m : ℕ) (χ : ZMod m →*₀ ℂ)
    (hχJ : χ (absNorm (J : Ideal (𝓞 K)) : ZMod m) ≠ 0) (X : ℝ) :
    classNormSum K C (fun n => χ (n : ZMod m)) X =
      boundedGeneratorSum K J (fun n => χ (n : ZMod m))
          (X * absNorm (J : Ideal (𝓞 K))) /
        ((torsionOrder K : ℂ) * χ (absNorm (J : Ideal (𝓞 K)) : ZMod m)) := by
  have htor : (torsionOrder K : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (torsionOrder_ne_zero K)
  apply (eq_div_iff (mul_ne_zero htor hχJ)).mpr
  rw [boundedGeneratorSum_character K hJ]
  ring

end PaperX.IdealNormWeighted
