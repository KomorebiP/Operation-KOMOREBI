import PaperX.CommutativeLogarithm
import Mathlib.RingTheory.Adjoin.Polynomial.Basic

/-! The finite logarithm in an arbitrary rational algebra. Each inverse
identity is proved inside the commutative subalgebra generated by one element,
then transported into the ambient ring. The ambient ring need not commute. -/
set_option autoImplicit false
noncomputable section
namespace PaperX.NilpotentLogarithm
open PaperX.FiniteLogarithm

variable {A : Type*} [Ring A] [Algebra ℚ A]

theorem log_exp {a : A} (ha : IsNilpotent a) : log (IsNilpotent.exp a) = a := by
  let S := Algebra.adjoin ℚ ({a} : Set A)
  let b : S := ⟨a, Algebra.subset_adjoin rfl⟩
  let f : S →+* A := S.val.toRingHom
  have hb : IsNilpotent b := by
    obtain ⟨d, hd⟩ := ha
    refine ⟨d, ?_⟩
    apply Subtype.ext
    exact hd
  calc
    log (IsNilpotent.exp a) = f (log (IsNilpotent.exp b)) := by
      rw [map_log (IsNilpotent.isNilpotent_exp_sub_one hb) f,
        IsNilpotent.map_exp hb f]
      rfl
    _ = f b := congrArg f (PaperX.CommutativeLogarithm.log_exp hb)
    _ = a := rfl

theorem exp_log {u : A} (hu : IsNilpotent (u - 1)) :
    IsNilpotent.exp (log u) = u := by
  let S := Algebra.adjoin ℚ ({u - 1} : Set A)
  let b : S := ⟨u - 1, Algebra.subset_adjoin rfl⟩
  let v : S := 1 + b
  let f : S →+* A := S.val.toRingHom
  have hb : IsNilpotent b := by
    obtain ⟨d, hd⟩ := hu
    refine ⟨d, ?_⟩
    apply Subtype.ext
    exact hd
  have hv : IsNilpotent (v - 1) := by
    simpa only [v, add_sub_cancel_left] using hb
  have hfv : f v = u := by
    change 1 + (u - 1) = u
    abel
  calc
    IsNilpotent.exp (log u) = f (IsNilpotent.exp (log v)) := by
      rw [IsNilpotent.map_exp (isNilpotent_log hv) f, map_log hv f, hfv]
    _ = f v := congrArg f (PaperX.CommutativeLogarithm.exp_log hv)
    _ = u := hfv

/-- Exponential and logarithm are actual inverse functions on the full
nilpotent and unipotent loci, with no fixed nilpotency bound. -/
def nilpotentEquiv : {a : A // IsNilpotent a} ≃ {u : A // IsNilpotent (u - 1)} where
  toFun a := ⟨IsNilpotent.exp a, IsNilpotent.isNilpotent_exp_sub_one a.property⟩
  invFun u := ⟨log u, isNilpotent_log u.property⟩
  left_inv a := Subtype.ext (log_exp a.property)
  right_inv u := Subtype.ext (exp_log u.property)

theorem exp_injective {a b : A} (ha : IsNilpotent a) (hb : IsNilpotent b)
    (h : IsNilpotent.exp a = IsNilpotent.exp b) : a = b := by
  have he := congrArg log h
  simpa only [log_exp ha, log_exp hb] using he

theorem log_injective {u v : A} (hu : IsNilpotent (u - 1)) (hv : IsNilpotent (v - 1))
    (h : log u = log v) : u = v := by
  have he := congrArg IsNilpotent.exp h
  simpa only [exp_log hu, exp_log hv] using he

end PaperX.NilpotentLogarithm
