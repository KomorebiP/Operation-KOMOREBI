import Mathlib.RingTheory.AdjoinRoot

/-! The actual quadratic coordinate ring and its points, over arbitrary
commutative rings, including characteristic two and the zero ring. -/
set_option autoImplicit false
noncomputable section

namespace PaperX.QuadraticAlgebra

variable (B : Type*) [CommRing B]

/-- Solutions of the defining quadratic equation. -/
abbrev Root := {x : B // x ^ 2 = 1}

variable {B} {C : Type*} [CommRing C] {D : Type*} [CommRing D]

/-- Coefficient change on actual roots. -/
def mapRoot (f : B →+* C) (x : Root B) : Root C :=
  ⟨f x.val, by simpa only [map_pow, map_one] using congrArg f x.property⟩

@[simp] theorem mapRoot_val (f : B →+* C) (x : Root B) :
    (mapRoot f x).val = f x.val := rfl

@[simp] theorem mapRoot_id (x : Root B) : mapRoot (RingHom.id B) x = x := rfl

@[simp] theorem mapRoot_comp (f : B →+* C) (g : C →+* D) (x : Root B) :
    mapRoot (g.comp f) x = mapRoot g (mapRoot f x) := rfl

variable (R : Type*) [CommRing R]

def equation : Polynomial R := Polynomial.X ^ 2 - 1

/-- This is literally the polynomial quotient by the ideal generated by
`X^2 - 1`, using Mathlib's `AdjoinRoot` construction. -/
abbrev CoordinateRing := AdjoinRoot (equation R)

def coordinate : CoordinateRing R := AdjoinRoot.root (equation R)

theorem coordinate_sq : coordinate R ^ 2 = 1 := by
  have h := AdjoinRoot.eval₂_root (equation R)
  change (Polynomial.X ^ 2 - (1 : Polynomial R)).eval₂ _ (coordinate R) = 0 at h
  rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X,
    Polynomial.eval₂_one] at h
  exact sub_eq_zero.mp h

variable [Algebra R B]

/-- A genuine algebra point gives a solution by evaluating the coordinate. -/
def pointRoot (f : CoordinateRing R →ₐ[R] B) : Root B :=
  ⟨f (coordinate R), by simpa only [map_pow, map_one] using congrArg f (coordinate_sq R)⟩

/-- The quotient universal property realizes each quadratic root as a point. -/
def rootPoint (x : Root B) : CoordinateRing R →ₐ[R] B :=
  AdjoinRoot.liftAlgHom (equation R) (Algebra.ofId R B) x.val (by
    simp [equation, x.property])

@[simp] theorem rootPoint_coordinate (x : Root B) :
    rootPoint R x (coordinate R) = x.val := by
  simp [rootPoint, coordinate]

/-- The complete functor-of-points statement, without a separability assumption. -/
def pointEquiv : (CoordinateRing R →ₐ[R] B) ≃ Root B where
  toFun := pointRoot R
  invFun := rootPoint R
  left_inv f := by
    apply AdjoinRoot.algHom_ext
    exact rootPoint_coordinate R (pointRoot R f)
  right_inv x := by
    apply Subtype.ext
    exact rootPoint_coordinate R x

@[simp] theorem pointEquiv_val (f : CoordinateRing R →ₐ[R] B) :
    (pointEquiv R f).val = f (coordinate R) := rfl

variable [Algebra R C]

/-- Specializing a point and specializing its root commute exactly. -/
theorem pointEquiv_natural (f : B →ₐ[R] C) (p : CoordinateRing R →ₐ[R] B) :
    pointEquiv R (f.comp p) = mapRoot f.toRingHom (pointEquiv R p) := rfl

theorem rootPoint_natural (f : B →ₐ[R] C) (x : Root B) :
    f.comp (rootPoint R x) = rootPoint R (mapRoot f.toRingHom x) := by
  apply AdjoinRoot.algHom_ext
  simp [rootPoint]

end PaperX.QuadraticAlgebra
