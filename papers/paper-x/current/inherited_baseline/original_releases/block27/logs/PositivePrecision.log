PaperX.PrecisionExamples.actual_two_adic_precision_completion :
  ∃ σ P,
    PaperX.RepresentationForests.Realizes twoIdeal fixedConditions σ ∧
      PaperX.RepresentationTopology.AdicRepContinuous twoIdeal σ ∧
        (∀ (g : C2), σ g * ↑P = ↑P * tau g) ∧ (Ideal.Quotient.mk (twoIdeal ^ 1)) (↑P).det ≠ 0
PaperX.OrderPrecision.finite_integral_classes.{u_1, u_2, u_3} {R : Type u_1} {Γ : Type u_2} [CommRing R] [IsDomain R]
  [IsDiscreteValuationRing R] [Group Γ] [Fintype Γ] {ι : Type u_3} [Fintype ι] [DecidableEq ι] (π : R)
  (hπ : Irreducible π) (hΓ : ↑(Fintype.card Γ) ≠ 0) (finiteR : ∀ (k : ℕ), Finite (R ⧸ Ideal.span {π} ^ k)) :
  Finite (ClassRep R Γ ι)
