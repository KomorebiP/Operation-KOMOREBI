import PaperX.GeneralArithmeticCoverage
import PaperX.NumberFieldFrobeniusRestriction
import Mathlib.RingTheory.Ideal.NatInt
import Mathlib.RingTheory.Unramified.Locus
import Mathlib.RingTheory.Frobenius
import Mathlib.LinearAlgebra.FreeModule.IdealQuotient

/-!
# Prime-ideal Chebotarev to Paper X arithmetic coverage

This module proves the entire Paper-X-side adapter from a qualitative
prime-ideal Chebotarev statement to `ExistentialArithmeticCoverage`.
It does not assume or restate the analytic density theorem itself.
-/
set_option autoImplicit false
noncomputable section

namespace PaperX.ChebotarevPrimeIdealAdapter

open NumberField
open PaperX.AbsoluteIntegralFrobenius
open PaperX.AbsoluteFrobeniusWitnesses
open PaperX.NumberFieldPrimeRestriction
open PaperX.NumberFieldFrobeniusRestriction
open PaperX.UnramifiedFrobeniusUniqueness
open PaperX.GeneralArithmeticCoverage

local instance (L : FiniteGaloisIntermediateField ℚ Qbar) : NumberField L := ⟨⟩

/-- The rational prime `span {(p : 𝓞 ℚ)}` is the pullback of
`span {(p : ℤ)}` along the canonical ring-of-integers equivalence. -/
theorem ratSpan_eq_comap_intSpan (p : ℕ) :
    Ideal.span {(p : 𝓞 ℚ)} =
      Ideal.comap Rat.ringOfIntegersEquiv (Ideal.span {(p : ℤ)}) := by
  rw [← Ideal.map_symm Rat.ringOfIntegersEquiv, Ideal.map_span, Set.image_singleton]
  congr 2
  simp [map_natCast]

/-- Every nonzero prime ideal of `𝓞 ℚ` is generated by a rational prime. -/
theorem ratPrime_eq_span (𝔭 : Ideal (𝓞 ℚ)) (hp : 𝔭.IsPrime) (hne : 𝔭 ≠ ⊥) :
    ∃ p : ℕ, p.Prime ∧ 𝔭 = Ideal.span {(p : 𝓞 ℚ)} := by
  set e := Rat.ringOfIntegersEquiv
  have hbij : Function.Bijective e := e.bijective
  have hJp : (Ideal.map e 𝔭).IsPrime := Ideal.map_isPrime_of_equiv e
  have hcomap : Ideal.comap e (Ideal.map e 𝔭) = 𝔭 :=
    Ideal.comap_map_of_bijective e hbij
  have hJne : Ideal.map e 𝔭 ≠ ⊥ := by
    intro h
    apply hne
    rw [← hcomap, h, Ideal.comap_bot_of_injective e hbij.injective]
  rcases Ideal.isPrime_int_iff.mp hJp with h | ⟨p, hpp, hpJ⟩
  · exact absurd h hJne
  · exact ⟨p, hpp, by rw [← hcomap, hpJ, ratSpan_eq_comap_intSpan]⟩

/-- The ideal generated by a rational prime is prime in `𝓞 ℚ`. -/
theorem span_nat_isPrime {p : ℕ} (hpp : p.Prime) :
    (Ideal.span {(p : 𝓞 ℚ)}).IsPrime := by
  have : (Ideal.span {(p : ℤ)}).IsPrime :=
    (Ideal.span_singleton_prime (by exact_mod_cast hpp.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hpp)
  rw [ratSpan_eq_comap_intSpan]
  exact Ideal.comap_isPrime Rat.ringOfIntegersEquiv (Ideal.span {(p : ℤ)})

/-- The natural-number generator is a prime element of `𝓞 ℚ`. -/
theorem natCast_prime_in_ratIntegers {p : ℕ} (hpp : p.Prime) :
    Prime (p : 𝓞 ℚ) := by
  apply (Ideal.span_singleton_prime ?_).mp
  · exact span_nat_isPrime hpp
  · exact_mod_cast hpp.ne_zero

/-- A prime of a number field over `(p)` over `ℤ` also lies over `(p)` over
`𝓞 ℚ`. -/
theorem liesOver_ratSpan_of_liesOver_intSpan
    {L : Type*} [Field L] [NumberField L]
    {p : ℕ} (hpp : p.Prime) (P : Ideal (𝓞 L)) [P.IsPrime]
    (hP : P.LiesOver (Ideal.span {(p : ℤ)})) :
    P.LiesOver (Ideal.span {(p : 𝓞 ℚ)}) := by
  apply (Ideal.liesOver_span_iff (inferInstance : P.IsPrime).ne_top (natCast_prime_in_ratIntegers hpp)).mpr
  have hp_mem : (algebraMap ℤ (𝓞 L)) (p : ℤ) ∈ P :=
    (Ideal.liesOver_span_iff (inferInstance : P.IsPrime).ne_top
      (Nat.prime_iff_prime_int.mp hpp)).mp hP
  simpa using hp_mem

/-- Unramifiedness over `𝓞 ℚ` at all primes above `(p)` implies that `p`
does not divide the integer discriminant. -/
theorem not_dvd_discr_of_rat_unramified
    {L : Type*} [Field L] [NumberField L]
    {p : ℕ} (hpp : p.Prime)
    (hunr : ∀ (P : Ideal (𝓞 L)) (_ : P.IsMaximal),
      P.LiesOver (Ideal.span {(p : 𝓞 ℚ)}) →
        Algebra.IsUnramifiedAt (𝓞 ℚ) P) :
    ¬ (p : ℤ) ∣ NumberField.discr L := by
  apply (NumberField.not_dvd_discr_iff_forall_liesOver L (𝓞 L)
    (Nat.prime_iff_prime_int.mp hpp)).mpr
  intro P hPmax hPz
  let : P.IsMaximal := hPmax
  let : P.IsPrime := hPmax.isPrime
  have hPrat : P.LiesOver (Ideal.span {(p : 𝓞 ℚ)}) :=
    liesOver_ratSpan_of_liesOver_intSpan hpp P hPz
  let : P.LiesOver (Ideal.span {(p : 𝓞 ℚ)}) := hPrat
  let : Algebra.IsUnramifiedAt (𝓞 ℚ) P := hunr P hPmax hPrat
  let : Algebra.FormallyUnramified ℤ (𝓞 ℚ) :=
    Algebra.FormallyUnramified.of_equiv Rat.ringOfIntegersEquiv.symm.toIntAlgEquiv
  let : (Ideal.span {(p : 𝓞 ℚ)}).IsPrime := span_nat_isPrime hpp
  have hbase : Algebra.IsUnramifiedAt ℤ (Ideal.span {(p : 𝓞 ℚ)}) := by
    infer_instance
  let : Algebra.IsUnramifiedAt ℤ (Ideal.span {(p : 𝓞 ℚ)}) := hbase
  exact Algebra.IsUnramifiedAt.comp (Ideal.span {(p : 𝓞 ℚ)}) P

/-- Arithmetic Frobenius action of an actual Paper X witness at the contracted
prime, expressed using Mathlib's `IsArithFrobAt` predicate over `𝓞 ℚ`. -/
theorem witness_restriction_isArithFrobAt
    (L : FiniteGaloisIntermediateField ℚ Qbar)
    (p : RationalPrime) (u : Witness p.val) :
    IsArithFrobAt (𝓞 ℚ)
      (AbsoluteGaloisRestriction.restriction L u.element)
      (restrictedPrime L u.primeIdeal) := by
  let : u.primeIdeal.IsMaximal := u.isMaximal
  let : u.primeIdeal.IsPrime := u.isMaximal.isPrime
  let : u.primeIdeal.LiesOver (Ideal.span {(p.val : ℤ)}) := u.liesOver
  let P : Ideal (𝓞 L) := restrictedPrime L u.primeIdeal
  let : P.IsPrime := restrictedPrime_isPrime L u.primeIdeal
  have hPz : P.LiesOver (Ideal.span {(p.val : ℤ)}) :=
    restrictedPrime_liesOver L p.val u.primeIdeal
  have hPrat : P.LiesOver (Ideal.span {(p.val : 𝓞 ℚ)}) :=
    liesOver_ratSpan_of_liesOver_intSpan p.property P hPz
  have hcard : Nat.card (𝓞 ℚ ⧸ P.under (𝓞 ℚ)) = p.val := by
    rw [hPrat.over.symm]
    change Ideal.absNorm (Ideal.span {(p.val : 𝓞 ℚ)}) = p.val
    rw [Ideal.absNorm_span_natCast, NumberField.RingOfIntegers.rank,
      Module.finrank_self, pow_one]
  intro x
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_pow, sub_eq_zero, hcard]
  simpa only [P, MulSemiringAction.toAlgHom_apply] using
    restriction_residue_power L u.primeIdeal p.val u.element u.residue x



/-- The Galois group acts faithfully on the ring of integers. -/
private instance faithfulSMul_galois
    {L : Type*} [Field L] [NumberField L] [IsGalois ℚ L] :
    FaithfulSMul Gal(L/ℚ) (𝓞 L) :=
  IsGaloisGroup.faithful (𝓞 ℚ)

/-- Any arithmetic Frobenius element at an unramified prime is the canonical
arithmetic Frobenius at that prime. -/
theorem eq_arithFrobAt_of_isArithFrobAt
    {L : Type*} [Field L] [NumberField L] [IsGalois ℚ L]
    (P : Ideal (𝓞 L)) [P.IsPrime] [Finite (𝓞 L ⧸ P)]
    [Algebra.IsUnramifiedAt (𝓞 ℚ) P]
    (τ : Gal(L/ℚ)) (hτ : IsArithFrobAt (𝓞 ℚ) τ P) :
    τ = arithFrobAt (𝓞 ℚ) Gal(L/ℚ) P :=
  MulSemiringAction.toAlgHom_injective (𝓞 ℚ) (𝓞 L) <|
    AlgHom.IsArithFrobAt.eq_of_isUnramifiedAt hτ
      (IsArithFrobAt.arithFrobAt (𝓞 ℚ) Gal(L/ℚ) P)
      P.primeCompl_le_nonZeroDivisors

/-- Arithmetic Frobenius elements at two primes above the same unramified
rational prime ideal are conjugate. -/
theorem isConj_of_isArithFrobAt
    {L : Type*} [Field L] [NumberField L] [IsGalois ℚ L]
    (𝔭 : Ideal (𝓞 ℚ)) [𝔭.IsPrime] (h𝔭ne : 𝔭 ≠ ⊥)
    (hunr : ∀ (P : Ideal (𝓞 L)) (_ : P.IsMaximal), P.LiesOver 𝔭 →
      Algebra.IsUnramifiedAt (𝓞 ℚ) P)
    (τ τ' : Gal(L/ℚ)) (P P' : Ideal (𝓞 L)) [P.IsPrime] [P'.IsPrime]
    (hτ : IsArithFrobAt (𝓞 ℚ) τ P)
    (hτ' : IsArithFrobAt (𝓞 ℚ) τ' P')
    (hP : P.LiesOver 𝔭) (hP' : P'.LiesOver 𝔭) :
    IsConj τ τ' := by
  have hPne : P ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot h𝔭ne P
  have hP'ne : P' ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot h𝔭ne P'
  have hPmax : P.IsMaximal := (inferInstance : P.IsPrime).isMaximal hPne
  have hP'max : P'.IsMaximal := (inferInstance : P'.IsPrime).isMaximal hP'ne
  let : Finite (𝓞 L ⧸ P) := Ideal.finiteQuotientOfFreeOfNeBot P hPne
  let : Finite (𝓞 L ⧸ P') := Ideal.finiteQuotientOfFreeOfNeBot P' hP'ne
  let : Algebra.IsUnramifiedAt (𝓞 ℚ) P := hunr P hPmax hP
  let : Algebra.IsUnramifiedAt (𝓞 ℚ) P' := hunr P' hP'max hP'
  rw [eq_arithFrobAt_of_isArithFrobAt P τ hτ,
    eq_arithFrobAt_of_isArithFrobAt P' τ' hτ']
  exact isConj_arithFrobAt (𝓞 ℚ) Gal(L/ℚ) P P'
    (hP.over.symm.trans hP'.over)

/-- Qualitative Chebotarev in the exact prime-ideal form needed by the
Paper-X adapter. This is the sole external arithmetic input of this module. -/
def PrimeIdealChebotarevOccurrence : Prop :=
  ∀ (L : FiniteGaloisIntermediateField ℚ Qbar) (σ : Gal(L/ℚ)),
    Set.Infinite
      {𝔭 : Ideal (𝓞 ℚ) |
        𝔭.IsPrime ∧ 𝔭 ≠ ⊥ ∧
        (∀ (P : Ideal (𝓞 L)) (_ : P.IsMaximal), P.LiesOver 𝔭 →
          Algebra.IsUnramifiedAt (𝓞 ℚ) P) ∧
        ∃ (P : Ideal (𝓞 L)) (_ : P.IsPrime), P.LiesOver 𝔭 ∧
          ∃ τ : Gal(L/ℚ), IsArithFrobAt (𝓞 ℚ) τ P ∧ IsConj τ σ}

/-- The full Paper-X arithmetic-coverage obligation follows from qualitative
prime-ideal Chebotarev. All finite avoidance, rational-prime conversion,
discriminant avoidance, actual absolute-witness construction, and Frobenius
convention comparison are performed here. -/
theorem existentialArithmeticCoverage_of_primeIdealChebotarev
    (hCheb : PrimeIdealChebotarevOccurrence) :
    ExistentialArithmeticCoverage := by
  classical
  intro L bad σ
  let badIdeals : Finset (Ideal (𝓞 ℚ)) :=
    bad.image fun p => Ideal.span {(p.val : 𝓞 ℚ)}
  obtain ⟨𝔭, h𝔭, h𝔭bad⟩ := (hCheb L σ).exists_notMem_finset badIdeals
  rcases h𝔭 with ⟨h𝔭prime, h𝔭ne, hunr, P, hPprime, hPover, τ, hτfrob, hτσ⟩
  obtain ⟨q, hqprime, rfl⟩ := ratPrime_eq_span 𝔭 h𝔭prime h𝔭ne
  let p : RationalPrime := ⟨q, hqprime⟩
  have hpbad : p ∉ bad := by
    intro hp
    apply h𝔭bad
    exact Finset.mem_image.mpr ⟨p, hp, rfl⟩
  have hnotdvd : ¬ (q : ℤ) ∣ NumberField.discr L :=
    not_dvd_discr_of_rat_unramified hqprime hunr
  have hpdisc : q ∉ discriminantPrimes L := by
    intro hmem
    have hqdvd : q ∣ (NumberField.discr L).natAbs :=
      (Nat.mem_primeFactors.mp hmem).2.1
    exact hnotdvd (Int.natCast_dvd.mpr hqdvd)
  let u : Witness q := chosenWitness p
  have huFrob : IsArithFrobAt (𝓞 ℚ)
      (AbsoluteGaloisRestriction.restriction L u.element)
      (restrictedPrime L u.primeIdeal) :=
    witness_restriction_isArithFrobAt L p u
  have hUprime : (restrictedPrime L u.primeIdeal).IsPrime := by
    let : u.primeIdeal.IsPrime := u.isMaximal.isPrime
    exact restrictedPrime_isPrime L u.primeIdeal
  have hUover : (restrictedPrime L u.primeIdeal).LiesOver
      (Ideal.span {(q : 𝓞 ℚ)}) := by
    let : u.primeIdeal.IsMaximal := u.isMaximal
    let : u.primeIdeal.IsPrime := u.isMaximal.isPrime
    let : u.primeIdeal.LiesOver (Ideal.span {(q : ℤ)}) := u.liesOver
    let : (restrictedPrime L u.primeIdeal).IsPrime := hUprime
    exact liesOver_ratSpan_of_liesOver_intSpan hqprime _
      (restrictedPrime_liesOver L q u.primeIdeal)
  have hUconjτ : IsConj
      (AbsoluteGaloisRestriction.restriction L u.element) τ := by
    let : (Ideal.span {(q : 𝓞 ℚ)}).IsPrime := span_nat_isPrime hqprime
    let : (restrictedPrime L u.primeIdeal).IsPrime := hUprime
    let : P.IsPrime := hPprime
    exact isConj_of_isArithFrobAt (Ideal.span {(q : 𝓞 ℚ)})
      (by simpa using hqprime.ne_zero) hunr
      (AbsoluteGaloisRestriction.restriction L u.element) τ
      (restrictedPrime L u.primeIdeal) P huFrob hτfrob hUover hPover
  have hcanon : IsConj
      (AlgEquiv.restrictNormalHom L u.element)
      (AbsoluteGaloisRestriction.restriction L u.element) :=
    (PaperX.RestrictionEmbeddingConjugacy.restriction_isConj L.toIntermediateField
      u.element).symm
  exact ⟨p, hpbad, hpdisc, u, hcanon.trans (hUconjτ.trans hτσ)⟩

end PaperX.ChebotarevPrimeIdealAdapter
