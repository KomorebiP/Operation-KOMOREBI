+import Mathlib.MeasureTheory.Function.LpSeminorm.Indicator
+import Mathlib.MeasureTheory.Function.LpSeminorm.TriangleInequality
+import Mathlib.Basic.Complex.Basic
+import Mathlib.Tactic
+
+/-! Author: Komorebi P. Measurable jump-mask perturbations, with extended Lp norms. -/
+namespace KomorebiPaperV.MaskPerturbation
+open MeasureTheory
+open scoped ENNReal symmDiff
+variable {Ω : Type*} [MeasurableSpace Ω]
+
+noncomputable def jump (S : Set Ω) (a : ℂ) : Ω → ℂ := S.indicator (fun _ => a)
+
+theorem jump_measurable (S : Set Ω) (hS : MeasurableSet S) (a : ℂ) (μ : Measure Ω) :
+    AEStronglyMeasurable (jump S a) μ :=
+  (stronglyMeasurable_const.indicator hS).aestronglyMeasurable
+
+theorem symmetric_difference_norm (μ : Measure Ω) (S T : Set Ω)
+    (hS : MeasurableSet S) (hT : MeasurableSet T) (p : ENNReal)
+    (hp : p ≠ 0) (hpTop : p ≠ ∞) (a : ℂ) :
+    eLpNorm (jump S a-jump T a) p μ = ‖a‖ₑ * μ (S ∆ T) ^ (1 / p.toReal) := by
+  rw [jump, jump, eLpNorm_indicator_sub_indicator]
+  exact eLpNorm_indicator_const (hS.symmDiff hT) hp hpTop
+
+theorem indicator_difference_norm (μ : Measure Ω) (S T : Set Ω)
+    (hS : MeasurableSet S) (hT : MeasurableSet T) (p : ENNReal)
+    (hp : p ≠ 0) (hpTop : p ≠ ∞) :
+    eLpNorm (jump S 1-jump T 1) p μ = μ (S ∆ T) ^ (1 / p.toReal) := by
+  simpa using symmetric_difference_norm μ S T hS hT p hp hpTop 1
+
+omit [MeasurableSpace Ω] in
+theorem jump_sub_same_set (S : Set Ω) (a b : ℂ) : jump S a-jump S b = jump S (a-b) := by
+  classical
+  funext x
+  by_cases hx : x ∈ S <;> simp [jump, hx]
+
+omit [MeasurableSpace Ω] in
+theorem jump_error_decomposition (S T : Set Ω) (a b : ℂ) :
+    jump S a-jump T b = jump S (a-b)+(jump S b-jump T b) := by
+  rw [← jump_sub_same_set]
+  abel
+
+theorem finite_p_perturbation (μ : Measure Ω) (S T : Set Ω)
+    (hS : MeasurableSet S) (hT : MeasurableSet T) (p : ENNReal)
+    (hp : 1 ≤ p) (hpTop : p ≠ ∞) (a b : ℂ) :
+    eLpNorm (jump S a-jump T b) p μ ≤
+      ‖a-b‖ₑ * μ S ^ (1 / p.toReal) + ‖b‖ₑ * μ (S ∆ T) ^ (1 / p.toReal) := by
+  have hp0 : p ≠ 0 := ne_of_gt (lt_of_lt_of_le (by norm_num) hp)
+  rw [jump_error_decomposition]
+  calc
+    _ ≤ eLpNorm (jump S (a-b)) p μ + eLpNorm (jump S b-jump T b) p μ :=
+      eLpNorm_add_le (jump_measurable S hS (a-b) μ)
+        ((jump_measurable S hS b μ).sub (jump_measurable T hT b μ)) hp
+    _ = _ := by
+      rw [symmetric_difference_norm μ S T hS hT p hp0 hpTop,
+        jump, eLpNorm_indicator_const hS hp0 hpTop]
+
+omit [MeasurableSpace Ω] in
+theorem pointwise_sup_bound (S T : Set Ω) (a b : ℂ) (x : Ω) :
+    ‖(jump S a-jump T b) x‖ ≤ ‖a-b‖ + if S ∆ T = ∅ then 0 else ‖b‖ := by
+  classical
+  rw [jump_error_decomposition]
+  calc
+    _ ≤ ‖jump S (a-b) x‖ + ‖(jump S b-jump T b) x‖ := norm_add_le _ _
+    _ ≤ ‖a-b‖ + if S ∆ T = ∅ then 0 else ‖b‖ := by
+      apply add_le_add
+      · by_cases hx : x ∈ S <;> simp [jump, hx]
+      · by_cases he : S ∆ T = ∅
+        · have hST : S = T := symmDiff_eq_bot.mp he
+          simp [hST]
+        · by_cases hx : x ∈ S <;> by_cases hy : x ∈ T <;> simp [jump, hx, hy, he]
+
+theorem infinity_perturbation (μ : Measure Ω) (S T : Set Ω) (a b : ℂ) :
+    eLpNorm (jump S a-jump T b) ∞ μ ≤
+      ENNReal.ofReal (‖a-b‖ + if S ∆ T = ∅ then 0 else ‖b‖) := by
+  rw [eLpNorm_exponent_top]
+  exact eLpNormEssSup_le_of_ae_bound (ae_of_all μ (pointwise_sup_bound S T a b))
+
+theorem full_signal_perturbation (μ : Measure Ω) (S T : Set Ω)
+    (hS : MeasurableSet S) (hT : MeasurableSet T) (p : ENNReal)
+    (hp : 1 ≤ p) (hpTop : p ≠ ∞) (a b : ℂ) (s t : Ω → ℂ)
+    (hs : AEStronglyMeasurable s μ) (ht : AEStronglyMeasurable t μ) :
+    eLpNorm ((s+jump S a)-(t+jump T b)) p μ ≤ eLpNorm (s-t) p μ +
+      (‖a-b‖ₑ * μ S ^ (1/p.toReal) + ‖b‖ₑ * μ (S ∆ T) ^ (1/p.toReal)) := by
+  have he : (s+jump S a)-(t+jump T b) = (s-t)+(jump S a-jump T b) := by abel
+  rw [he]
+  exact (eLpNorm_add_le (hs.sub ht)
+    ((jump_measurable S hS a μ).sub (jump_measurable T hT b μ)) hp).trans
+      (add_le_add_right (finite_p_perturbation μ S T hS hT p hp hpTop a b) _)
+
+end KomorebiPaperV.MaskPerturbation
--- v0.3.0/formalization/lean/KomorebiPaperV/PruningAlgorithm.lean
+++ v1.0.0/formalization/lean/KomorebiPaperV/PruningAlgorithm.lean
@@ -0,0 +1,114 @@
+import KomorebiPaperV.PruningSums
+
+/-!
+Author: Komorebi P. A bottom-up evaluator with cached child results.
+The cost model charges one node visit, one comparison per internal node, and
+one addition per child when summing cached values. Scalar node costs are inputs.
+The theorem concerns this unit-cost model, not Lean runtime or output printing.
+-/
+namespace KomorebiPaperV.PruningAlgorithm
+open KomorebiPaperV.FiniteAdaptive KomorebiPaperV.CompletePrunings KomorebiPaperV.PruningSums
+variable {A : Type*}
+
+structure Result (t : FiniteAdaptive.Tree A) where
+  cut : Cut t
+  cost : ℝ
+  comparisons : ℕ
+  additions : ℕ
+  visits : ℕ
+
+noncomputable def solve (c : A → ℝ) : (t : FiniteAdaptive.Tree A) → Result t
+  | .leaf a => ⟨.stop _, c a, 0, 0, 1⟩
+  | .branch a n ch =>
+      let child := fun i => solve c (ch i)
+      let total := ∑ i, (child i).cost
+      let stop := c a ≤ total
+      ⟨if stop then .stop _ else .split (fun i => (child i).cut),
+       min (c a) total,
+       1 + ∑ i, (child i).comparisons,
+       (n+1) + ∑ i, (child i).additions,
+       1 + ∑ i, (child i).visits⟩
+
+def nodes : FiniteAdaptive.Tree A → ℕ
+  | .leaf _ => 1
+  | .branch _ _ ch => 1 + ∑ i, nodes (ch i)
+
+theorem solve_correct (c : A → ℝ) (t : FiniteAdaptive.Tree A) :
+    (solve c t).cost = value c t ∧ (solve c t).cut = best c t := by
+  induction t with
+  | leaf a => exact ⟨rfl,rfl⟩
+  | branch a n ch ih =>
+    have hc : (∑ i, (solve c (ch i)).cost) = ∑ i, value c (ch i) :=
+      Finset.sum_congr rfl (fun i _ => (ih i).1)
+    constructor
+    · simp only [solve, value, hc]
+    · simp only [solve, best, hc]
+      split_ifs
+      · rfl
+      · congr 1
+        funext i
+        exact (ih i).2
+
+theorem solve_comparisons (c : A → ℝ) (t : FiniteAdaptive.Tree A) :
+    (solve c t).comparisons = internalNodes t := by
+  induction t with
+  | leaf a => rfl
+  | branch a n ch ih =>
+    simp only [solve, internalNodes]
+    rw [Finset.sum_congr rfl (fun i _ => ih i)]
+    omega
+
+theorem solve_visits (c : A → ℝ) (t : FiniteAdaptive.Tree A) :
+    (solve c t).visits = nodes t := by
+  induction t with
+  | leaf a => rfl
+  | branch a n ch ih =>
+    simp only [solve, nodes]
+    rw [Finset.sum_congr rfl (fun i _ => ih i)]
+
+theorem solve_additions (c : A → ℝ) (t : FiniteAdaptive.Tree A) :
+    (solve c t).additions + 1 = nodes t := by
+  induction t with
+  | leaf a => rfl
+  | branch a n ch ih =>
+    have hs : ∑ i, ((solve c (ch i)).additions+1) = ∑ i, nodes (ch i) :=
+      Finset.sum_congr rfl (fun i _ => ih i)
+    simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
+      Fintype.card_fin, smul_eq_mul, mul_one] at hs
+    dsimp [solve, nodes]
+    omega
+
+theorem internal_le_nodes (t : FiniteAdaptive.Tree A) : internalNodes t ≤ nodes t := by
+  induction t with
+  | leaf a => simp [internalNodes, nodes]
+  | branch a n ch ih =>
+    have h := Finset.sum_le_sum (fun i (_ : i ∈ Finset.univ) => ih i)
+    dsimp [internalNodes, nodes]
+    omega
+
+theorem solve_linear_work (c : A → ℝ) (t : FiniteAdaptive.Tree A) :
+    (solve c t).visits + (solve c t).comparisons + (solve c t).additions ≤ 3 * nodes t := by
+  have hv := solve_visits c t
+  have hc := solve_comparisons c t
+  have ha := solve_additions c t
+  have hi := internal_le_nodes t
+  omega
+
+theorem computed_antichain_optimal (c : A → ℝ) (t : FiniteAdaptive.Tree A) (S : Pruning t) :
+    nodeSum c (pruningEquiv t (solve c t).cut) ≤ nodeSum c S := by
+  rw [(solve_correct c t).2]
+  exact selected_global_minimum c t S
+
+theorem antichain_probability {Ω : Type*} [MeasurableSpace Ω]
+    (μ : MeasureTheory.Measure Ω) (good : Set Ω) (δ : ENNReal)
+    (c e : A → ℝ) (d : Ω → A → ℝ) (t : FiniteAdaptive.Tree A) (γ : ℝ)
+    (hgood : ∀ ω ∈ good, ∀ a, |d ω a-c a| ≤ e a)
+    (hg : ∀ S : Pruning t, S ≠ selected c t → γ ≤ nodeSum c S-nodeSum c (selected c t))
+    (hm : 2*envelope e t < γ) (hprob : 1-δ ≤ μ good) :
+    1-δ ≤ μ {ω | selected (d ω) t = selected c t} := by
+  apply hprob.trans
+  apply MeasureTheory.measure_mono
+  intro ω hω
+  exact antichain_selector_stable c (d ω) e (hgood ω hω) t γ hg hm
+
+end KomorebiPaperV.PruningAlgorithm
