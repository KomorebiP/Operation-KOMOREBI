\@writefile{toc}{\contentsline {section}{\numberline {1}The object: rows, degrees, and normalization}{1}{section.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The actual reciprocal series is the source of every coefficient in this guide. The factorial normalization changes valuations as well as the constant term.}}{1}{figure.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}What the original conjecture asked}{2}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3}Removing the starting-row threshold}{3}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Unit-step lower bounds on a finite display window. Each colored cell is obtained from a proved formula, rather than from sampled coefficients. The dashed line indicates $k=n$.}}{3}{figure.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {4}Each step contributes its own precision}{4}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces For steps $(1,2,4)$ all eight offsets are distinct. This is an exact signed stencil, rather than an approximate derivative.}}{4}{figure.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}The final rank-four congruence}{5}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces The exponent of the final Euler congruence at unit step. The address zero and one curve is exact at every order. Marked address-two orders are universally exact; the other displayed address-two and address-three values are proved lower bounds.}}{5}{figure.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {6}Why address two has a different slope}{6}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Normalized address-two precision. The paired filtration controls the large-order slope. At order one the constant-surplus bound is stronger.}}{6}{figure.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}When mixed steps attain the baseline}{7}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Exact rational examples at order two and base zero. Strict cases show why the factorial baseline cannot always be called an equality for mixed steps. The universal parity criterion is proved separately.}}{7}{figure.6}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}First differences determine an exact metric}{8}{section.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The proved Euler metric laws, with exact modular sample points at base zero and steps $H=2^s$. Addresses zero and one have the same scale; their circle and square marks overlap.}}{8}{figure.7}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {9}Least periods, rather than sufficient periods}{9}{section.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Binary logarithms of the least row periods. A height of zero means period one. These are theorem-derived values, valid at every precision.}}{9}{figure.8}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}A full period visits every allowed residue}{10}{section.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Exact residue permutations modulo $256$. The vertical coordinate is $y_n=(E_{4n}^{(4,j)}-j!)/2^{B_j}$ modulo $P_j(8)$. Each panel contains one full least period; every vertical residue occurs once.}}{10}{figure.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {11}Seeing the scaled isometry}{11}{section.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Address two modulo $256$ gives an eight-element quotient. The two exact matrices coincide: every pair of distinct rows has the same dyadic valuation before and after the scale is removed. The diagonal represents $v_2(0)=+\infty $ and is left blank.}}{11}{figure.10}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {12}How far the simple metric law extends}{12}{section.12}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Proved scale arrays for the three small ranks. Blank cells are outside the address range. The Euler normalization contributes the factorial valuation, which is already substantial at the larger addresses of rank eight.}}{12}{figure.11}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {13}From factorial gain to analytic radius}{13}{section.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces The Taylor coefficient precision slopes. The degree-zero coefficient is excluded. Marked address-two degrees belong to an unbounded proved equality family, rather than a finite observed pattern.}}{13}{figure.12}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {14}Which evidence does which job}{14}{section.14}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {15}Reading the conclusion at the right strength}{15}{section.15}\protected@file@percent }
