theorem KomorebiPaperIX.NishibuchiCompletion.conjecture_3_9 : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (m j : ℕ)
  (hmpos : 0 < m),
  j < m * p →
    m ∣ p - 1 ∨ m = 2 →
      (∀ (n : ℕ), ↑(generalizedEuler (m * p) ⋯ j (m * p * n)) ∈ PadicInt.subring p) ∧
        ∀ (r : ℕ),
          0 < r →
            ∃ n0,
              0 < n0 ∧
                n0 ≤ r ∧
                  ∀ (n : ℕ),
                    n0 ≤ n →
                      precision p (↑r)
                        (generalizedEuler (m * p) ⋯ j (m * p * n + displacementFactor p * p ^ r) -
                          generalizedEuler (m * p) ⋯ j (m * p * n)) :=
<not imported>
theorem KomorebiPaperIX.DyadicFourCongruences.normalized_bound : ∀ (j u k n : ℕ) (hj : j < 4),
  2 ^ min k n ∣ Mahler.difference u k (DyadicFourCongruences.normalizedLift j hj) n :=
<not imported>
