Fin.sum_univ_eq_sum_range.{u_1} {α : Type u_1} [AddCommMonoid α] (f : ℕ → α) (n : ℕ) :
  ∑ i, f ↑i = ∑ i ∈ Finset.range n, f i
Fin.prod_univ_castSucc.{u_2} {M : Type u_2} [CommMonoid M] {n : ℕ} (f : Fin (n + 1) → M) :
  ∏ i, f i = (∏ i, f i.castSucc) * f (Fin.last n)
Int.cast_ite.{u} {R : Type u} [IntCast R] (P : Prop) [Decidable P] (m n : ℤ) :
  ↑(if P then m else n) = if P then ↑m else ↑n
Finset.sum_congr.{u_1, u_4} {ι : Type u_1} {M : Type u_4} {s₁ s₂ : Finset ι} [AddCommMonoid M] {f g : ι → M}
  (h : s₁ = s₂) : (∀ x ∈ s₂, f x = g x) → s₁.sum f = s₂.sum g
Finset.sum_range_succ.{u_4} {M : Type u_4} [AddCommMonoid M] (f : ℕ → M) (n : ℕ) :
  ∑ x ∈ Finset.range (n + 1), f x = ∑ x ∈ Finset.range n, f x + f n
Finset.sum_range_reflect.{u_3} {M : Type u_3} [AddCommMonoid M] (f : ℕ → M) (n : ℕ) :
  ∑ j ∈ Finset.range n, f (n - 1 - j) = ∑ j ∈ Finset.range n, f j
