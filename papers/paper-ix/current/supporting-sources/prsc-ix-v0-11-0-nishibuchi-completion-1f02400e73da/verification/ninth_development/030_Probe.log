PowerSeries.coeff_one.{u_1} {R : Type u_1} [Semiring R] (n : ℕ) : (PowerSeries.coeff n) 1 = if n = 0 then 1 else 0
PowerSeries.coeff_mk.{u_1} {R : Type u_1} [Semiring R] (n : ℕ) (f : ℕ → R) :
  (PowerSeries.coeff n) (PowerSeries.mk f) = f n
PowerSeries.coeff_log.{u_1} {A : Type u_1} [CommRing A] [Algebra ℚ A] (n : ℕ) :
  (PowerSeries.coeff n) (PowerSeries.log A) = if n = 0 then 0 else (algebraMap ℚ A) ((-1) ^ (n + 1) / ↑n)
PowerSeries.coeff_mul.{u_1} {R : Type u_1} [Semiring R] (n : ℕ) (φ ψ : PowerSeries R) :
  (PowerSeries.coeff n) (φ * ψ) = ∑ p ∈ Finset.antidiagonal n, (PowerSeries.coeff p.1) φ * (PowerSeries.coeff p.2) ψ
PowerSeries.coeff_inv.{u_2} {k : Type u_2} [Field k] (n : ℕ) (φ : PowerSeries k) :
  (PowerSeries.coeff n) φ⁻¹ =
    if n = 0 then (PowerSeries.constantCoeff φ)⁻¹
    else
      -(PowerSeries.constantCoeff φ)⁻¹ *
        ∑ x ∈ Finset.antidiagonal n, if x.2 < n then (PowerSeries.coeff x.1) φ * (PowerSeries.coeff x.2) φ⁻¹ else 0
PowerSeries.expand_mul.{u_2} {R : Type u_2} [CommRing R] (p : ℕ) (hp : p ≠ 0) (q : ℕ) (hq : q ≠ 0) (φ : PowerSeries R) :
  (PowerSeries.expand (p * q) ⋯) φ = (PowerSeries.expand p hp) ((PowerSeries.expand q hq) φ)
