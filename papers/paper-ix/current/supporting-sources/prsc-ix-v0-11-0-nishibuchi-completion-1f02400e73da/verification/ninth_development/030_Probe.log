PowerSeries.coeff_pow.{u_2} {R : Type u_2} [CommSemiring R] (k n : ℕ) (φ : PowerSeries R) :
  (PowerSeries.coeff n) (φ ^ k) =
    ∑ l ∈ (Finset.range k).finsuppAntidiag n, ∏ i ∈ Finset.range k, (PowerSeries.coeff (l i)) φ
PowerSeries.coeff_expand.{u_2} {R : Type u_2} [CommRing R] (p : ℕ) (hp : p ≠ 0) (φ : PowerSeries R) {n : ℕ} :
  (PowerSeries.coeff n) ((PowerSeries.expand p hp) φ) = if p ∣ n then (PowerSeries.coeff (n / p)) φ else 0
PowerSeries.coeff_expand_mul.{u_2} {R : Type u_2} [CommRing R] (p : ℕ) (hp : p ≠ 0) (φ : PowerSeries R) (m : ℕ) :
  (PowerSeries.coeff (p * m)) ((PowerSeries.expand p hp) φ) = (PowerSeries.coeff m) φ
