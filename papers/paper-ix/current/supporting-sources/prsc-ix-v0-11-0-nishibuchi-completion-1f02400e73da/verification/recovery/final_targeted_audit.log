KomorebiPaperIX.Theorem75.global_finite_difference : ∀ (p : ℕ) [inst : Fact (Nat.Prime p)] (m j u k n : ℕ),
  m ∣ p - 1 →
    0 < m →
      j < m * p →
        ↑(KomorebiPaperIX.Congruential.unnormalized (m * p) j n) ∈ PadicInt.subring p ∧
          KomorebiPaperIX.GlobalEulerBoundary.precision p (↑(min k (m * n)))
              (KomorebiPaperIX.Mahler.difference (u * ((p - 1) / m)) k
                (KomorebiPaperIX.Congruential.unnormalized (m * p) j) n) ∧
            KomorebiPaperIX.GlobalEulerBoundary.precision p (↑(min k (m * n)) - ↑(padicValNat p j.factorial))
              (KomorebiPaperIX.Mahler.difference (u * ((p - 1) / m)) k (KomorebiPaperIX.Congruential.coeff (m * p) j) n)
