import CrossRadixReynoldsDFT

noncomputable section
open scoped BigOperators

namespace KomorebiCrossRadix

variable {T : ℕ}

/-- Multiplication by a fixed natural step, viewed as an additive homomorphism from `ℤ`. -/
def stepIntHom (q : ℕ) : ℤ →+ ZMod T where
  toFun z := (z : ZMod T) * (q : ZMod T)
  map_zero' := by simp
  map_add' := by intro a b; push_cast; ring

/-- Canonical cyclic translation homomorphism `ZMod g → ZMod T`, generated by `T/g`.
The divisor certificate in `g` makes the lift well-defined. -/
def subgroupShift (g : DivIdx T) : ZMod g.1 →+ ZMod T := by
  have hgT : g.1 ∣ T := (Nat.mem_divisors.mp g.2).1
  refine ZMod.lift g.1 ⟨stepIntHom (T / g.1), ?_⟩
  change ((g.1 : ℤ) : ZMod T) * ((T / g.1 : ℕ) : ZMod T) = 0
  simp only [Int.cast_natCast]
  rw [← Nat.cast_mul, Nat.mul_div_cancel' hgT, ZMod.natCast_self]

@[simp] lemma subgroupShift_coe (g : DivIdx T) (z : ℤ) :
    subgroupShift g (z : ZMod g.1) = (z : ZMod T) * (T / g.1 : ℕ) := by
  simp [subgroupShift, stepIntHom]

@[simp] lemma subgroupShift_one (g : DivIdx T) :
    subgroupShift g 1 = (T / g.1 : ℕ) := by
  simpa using subgroupShift_coe g (1 : ℤ)

/-- The translation parametrization is injective, so the Reynolds sum below averages over
exactly `g` distinct subgroup elements rather than a multiset with repetitions. -/
lemma subgroupShift_injective (hT : 0 < T) (g : DivIdx T) :
    Function.Injective (subgroupShift g) := by
  rw [subgroupShift, ZMod.lift_injective]
  intro m hm
  have hgT : g.1 ∣ T := (Nat.mem_divisors.mp g.2).1
  have hgpos : 0 < g.1 := Nat.pos_of_dvd_of_pos hgT hT
  have hqpos : 0 < T / g.1 := Nat.div_pos (Nat.le_of_dvd hT hgT) hgpos
  change ((m : ZMod T) * (T / g.1 : ℕ) = 0) at hm
  rw [← Int.cast_natCast (R := ZMod T) (T / g.1), ← Int.cast_mul] at hm
  have hd : (T : ℤ) ∣ m * (T / g.1 : ℕ) :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp hm
  have hfact : (T : ℤ) = (g.1 : ℤ) * (T / g.1 : ℕ) := by
    exact_mod_cast (Nat.mul_div_cancel' hgT).symm
  have hd' : (g.1 : ℤ) * (T / g.1 : ℕ) ∣ m * (T / g.1 : ℕ) := by
    simpa only [← hfact] using hd
  have hqz : ((T / g.1 : ℕ) : ℤ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hqpos)
  have hgd : (g.1 : ℤ) ∣ m := Int.dvd_of_mul_dvd_mul_right hqz hd'
  exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).2 hgd

/-- Every divisor index of a nonzero period is itself nonzero. This supplies the finite
`ZMod g` instance required by the literal averaging formula. -/
instance divIdxNeZero [NeZero T] (g : DivIdx T) : NeZero g.1 := by
  have hgT : g.1 ∣ T := (Nat.mem_divisors.mp g.2).1
  have hT : 0 < T := Nat.pos_of_ne_zero (NeZero.ne T)
  exact ⟨Nat.ne_of_gt (Nat.pos_of_dvd_of_pos hgT hT)⟩

section Fourier

variable [NeZero T]

/-- Restriction of the Fourier character at frequency `k` to the cyclic translation subgroup. -/
def subgroupChar (g : DivIdx T) (k : ZMod T) : AddChar (ZMod g.1) ℂ :=
  (ZMod.stdAddChar (N := T)).mulShift (-k) |>.compAddMonoidHom (subgroupShift g)

/-- Exact annihilator criterion: a Fourier character is trivial on the order-`g` translation
subgroup iff its frequency lies in the certified width mask `g ∣ k`. -/
lemma subgroupChar_eq_one_iff (hT : 0 < T) (g : DivIdx T) (k : ZMod T) :
    subgroupChar g k = 1 ↔ g.1 ∣ k.val := by
  have hgT : g.1 ∣ T := (Nat.mem_divisors.mp g.2).1
  have hgpos : 0 < g.1 := Nat.pos_of_dvd_of_pos hgT hT
  constructor
  · intro hchar
    have h1 := DFunLike.congr_fun hchar (1 : ZMod g.1)
    simp only [subgroupChar, AddChar.compAddMonoidHom_apply, AddChar.mulShift_apply] at h1
    rw [subgroupShift_one] at h1
    have hz : -k * (T / g.1 : ZMod T) = 0 := by
      apply ZMod.injective_stdAddChar
      simpa using h1
    have hd : T ∣ k.val * (T / g.1) := by
      have hz' : (((k.val * (T / g.1) : ℕ) : ZMod T)) = 0 := by
        have hzneg := congrArg Neg.neg hz
        simpa [mul_comm] using hzneg
      exact (ZMod.natCast_eq_zero_iff _ _).mp hz'
    have hqpos : 0 < T / g.1 := Nat.div_pos (Nat.le_of_dvd hT hgT) hgpos
    have hd' : (T / g.1) * g.1 ∣ (T / g.1) * k.val := by
      simpa [Nat.div_mul_cancel hgT, mul_comm] using hd
    exact (Nat.mul_dvd_mul_iff_left hqpos).mp hd'
  · intro hgk
    apply AddChar.ext
    intro z
    simp only [subgroupChar, AddChar.compAddMonoidHom_apply, AddChar.mulShift_apply]
    have hkzero : (((k.val * (T / g.1) : ℕ) : ZMod T)) = 0 := by
      apply (ZMod.natCast_eq_zero_iff _ _).mpr
      have hd0 : (T / g.1) * g.1 ∣ (T / g.1) * k.val :=
        Nat.mul_dvd_mul_left (T / g.1) hgk
      simpa [Nat.div_mul_cancel hgT, mul_comm] using hd0
    rw [← ZMod.intCast_zmod_cast z, subgroupShift_coe]
    have hkzero2 : (k.val : ZMod T) * (T / g.1 : ℕ) = 0 := by
      simpa only [Nat.cast_mul] using hkzero
    have kkzero : k * (T / g.1 : ZMod T) = 0 := by
      rw [← k.natCast_zmod_val]
      exact hkzero2
    have harg : -k * (((z.cast : ℤ) : ZMod T) * (T / g.1 : ℕ)) = 0 := by
      calc
        -k * (((z.cast : ℤ) : ZMod T) * (T / g.1 : ℕ))
            = -(((z.cast : ℤ) : ZMod T) * (k * (T / g.1 : ℕ))) := by ring
        _ = 0 := by rw [kkzero]; simp
    rw [harg]
    simp

/-- Orthogonality of subgroup characters gives exactly `g` on retained modes and zero elsewhere. -/
lemma subgroupChar_sum_mask (hT : 0 < T) (g : DivIdx T) (k : ZMod T) :
    (∑ z : ZMod g.1, subgroupChar g k z) = (g.1 : ℂ) * rawWidthMask g k := by
  by_cases hk : g.1 ∣ k.val
  · have hc : subgroupChar g k = 1 := (subgroupChar_eq_one_iff hT g k).2 hk
    rw [AddChar.sum_eq_card_of_eq_one hc, ZMod.card]
    simp [rawWidthMask, hk]
  · have hc : subgroupChar g k ≠ 1 := fun h => hk ((subgroupChar_eq_one_iff hT g k).1 h)
    rw [AddChar.sum_eq_zero_of_ne_one hc]
    simp [rawWidthMask, hk]

/-- DFT covariance of translation by subtraction. -/
lemma dft_shift_sub (x : ResidueProfile T) (a k : ZMod T) :
    ZMod.dft (N := T) (E := ℂ) (fun t => x (t - a)) k =
      ZMod.stdAddChar (N := T) (-(a * k)) * ZMod.dft (N := T) (E := ℂ) x k := by
  rw [ZMod.dft_apply, ZMod.dft_apply]
  simp only [smul_eq_mul]
  calc
    (∑ t : ZMod T, ZMod.stdAddChar (N := T) (-(t * k)) * x (t - a)) =
        ∑ y : ZMod T, ZMod.stdAddChar (N := T) (-((y + a) * k)) * x y := by
          refine Fintype.sum_equiv (Equiv.subRight a) _ _ ?_
          intro t
          simp
    _ = ∑ y : ZMod T,
        ZMod.stdAddChar (N := T) (-(a * k)) *
          (ZMod.stdAddChar (N := T) (-(y * k)) * x y) := by
          apply Finset.sum_congr rfl
          intro y hy
          rw [← mul_assoc]
          congr 1
          rw [← AddChar.map_add_eq_mul]
          congr 1
          ring
    _ = ZMod.stdAddChar (N := T) (-(a * k)) *
        ∑ y : ZMod T, ZMod.stdAddChar (N := T) (-(y * k)) * x y := by
          rw [Finset.mul_sum]

/-- Literal Reynolds operator: normalized average over the canonical order-`g` translation subgroup. -/
def subgroupReynoldsAverage (g : DivIdx T) : Module.End ℂ (ResidueProfile T) where
  toFun := fun x t => (g.1 : ℂ)⁻¹ * ∑ z : ZMod g.1, x (t - subgroupShift g z)
  map_add' := by
    intro x y
    funext t
    simp only [Pi.add_apply, Finset.sum_add_distrib]
    ring
  map_smul' := by
    intro a x
    funext t
    simp only [Pi.smul_apply, RingHom.id_apply, smul_eq_mul, ← Finset.mul_sum]
    ring

lemma subgroupReynoldsAverage_as_sum (g : DivIdx T) (x : ResidueProfile T) :
    subgroupReynoldsAverage g x =
      (g.1 : ℂ)⁻¹ • ∑ z : ZMod g.1, (fun t : ZMod T => x (t - subgroupShift g z)) := by
  funext t
  simp [subgroupReynoldsAverage]

/-- The literal finite subgroup average has the exact certified `0/1` DFT mask. -/
lemma dft_subgroupReynoldsAverage
    (hT : 0 < T) (g : DivIdx T) (x : ResidueProfile T) (k : ZMod T) :
    ZMod.dft (N := T) (E := ℂ) (subgroupReynoldsAverage g x) k =
      rawWidthMask g k * ZMod.dft (N := T) (E := ℂ) x k := by
  rw [subgroupReynoldsAverage_as_sum]
  rw [map_smul]
  simp only [Pi.smul_apply, smul_eq_mul, map_sum, Finset.sum_apply]
  simp_rw [dft_shift_sub]
  have hchars :
      (∑ z : ZMod g.1,
        ZMod.stdAddChar (N := T) (-(subgroupShift g z * k))) =
        (g.1 : ℂ) * rawWidthMask g k := by
    simpa [subgroupChar, AddChar.compAddMonoidHom_apply, AddChar.mulShift_apply, mul_comm] using
      subgroupChar_sum_mask hT g k
  rw [← Finset.sum_mul]
  rw [hchars]
  have hgT : g.1 ∣ T := (Nat.mem_divisors.mp g.2).1
  have hgpos : 0 < g.1 := Nat.pos_of_dvd_of_pos hgT hT
  have hgc : (g.1 : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt hgpos)
  field_simp

/-- Durable Reynolds identification: the Fourier-defined canonical projector is exactly the
literal normalized subgroup average. -/
lemma subgroupReynoldsAverage_eq_reynoldsProjector
    (hT : 0 < T) (g : DivIdx T) :
    subgroupReynoldsAverage g = reynoldsProjector g := by
  apply LinearMap.ext
  intro x
  apply (ZMod.dft (N := T) (E := ℂ)).injective
  funext k
  rw [dft_subgroupReynoldsAverage hT g x k, dft_reynoldsProjector]
  rfl

end Fourier

end KomorebiCrossRadix

