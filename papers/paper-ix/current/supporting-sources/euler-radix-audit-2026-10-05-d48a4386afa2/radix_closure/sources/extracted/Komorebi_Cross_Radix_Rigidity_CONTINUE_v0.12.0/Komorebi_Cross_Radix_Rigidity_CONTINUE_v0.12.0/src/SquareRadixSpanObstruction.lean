import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.Ring

namespace KomorebiCrossRadix

universe u

/-- Coefficient vector in the integer-valued quadratic basis
`(1, n, binom(n,2))` for the section `(B*n+s)^2`. -/
def squareSectionVec {R : Type u} [CommRing R] (B s : R) : R × R × R :=
  (s ^ 2, B ^ 2 + 2 * B * s, 2 * B ^ 2)

/-- Depth-zero vector for `n^2 = n + 2*binom(n,2)`. -/
def squareSourceVec {R : Type u} [CommRing R] : R × R × R :=
  (0, 1, 2)

/-- Constant-axis vectors generated after a radix factor vanishes modulo a prime. -/
def constantAxisVec {R : Type u} [CommRing R] (s : R) : R × R × R :=
  (s ^ 2, 0, 0)

/-- The saturated basis vector corresponding to `binom(n,2)`. -/
def binomialTwoVec {R : Type u} [CommRing R] : R × R × R :=
  (0, 0, 1)

/-- Linear equation cutting out the reduced raw square-section hyperplane. -/
def squareDefect {R : Type u} [CommRing R] (v : R × R × R) : R :=
  2 * v.2.1 - v.2.2

/-- The defect-zero vectors form a submodule. -/
def squareHyperplane (R : Type u) [CommRing R] : Submodule R (R × R × R) where
  carrier := {v | squareDefect v = 0}
  zero_mem' := by simp [squareDefect]
  add_mem' := by
    intro a b ha hb
    change squareDefect (a + b) = 0
    have hadd : squareDefect (a + b) = squareDefect a + squareDefect b := by
      simp [squareDefect]
      ring
    rw [hadd, ha, hb, add_zero]
  smul_mem' := by
    intro c a ha
    change squareDefect (c • a) = 0
    have hsmul : squareDefect (c • a) = c * squareDefect a := by
      simp [squareDefect]
      ring
    rw [hsmul, ha, mul_zero]

/-- The depth-zero square source lies in the hyperplane. -/
theorem squareSourceVec_mem_hyperplane
    {R : Type u} [CommRing R] :
    squareSourceVec (R := R) ∈ squareHyperplane R := by
  change squareDefect (squareSourceVec (R := R)) = 0
  simp [squareDefect, squareSourceVec]

/-- Every constant-axis vector lies in the same hyperplane. -/
theorem constantAxisVec_mem_hyperplane
    {R : Type u} [CommRing R] (s : R) :
    constantAxisVec s ∈ squareHyperplane R := by
  change squareDefect (constantAxisVec s) = 0
  simp [squareDefect, constantAxisVec]

/-- If the section width vanishes in the coefficient ring, its square-section
vector collapses to the constant axis. -/
theorem squareSectionVec_of_width_eq_zero
    {R : Type u} [CommRing R] (B s : R) (hB : B = 0) :
    squareSectionVec B s = constantAxisVec s := by
  subst B
  simp [squareSectionVec, constantAxisVec]

/-- Over a nontrivial coefficient ring, the saturated `binom(n,2)` direction
escapes the raw reduced hyperplane. -/
theorem binomialTwoVec_not_mem_hyperplane
    {R : Type u} [CommRing R] [Nontrivial R] :
    binomialTwoVec (R := R) ∉ squareHyperplane R := by
  intro h
  change (2 : R) * 0 - 1 = 0 at h
  rw [mul_zero, zero_sub] at h
  have hneg : (-1 : R) = 0 := h
  have hone : (1 : R) = 0 := by
    calc
      (1 : R) = -(-1) := by ring
      _ = -0 := by rw [hneg]
      _ = 0 := neg_zero
  exact one_ne_zero hone

/-- Span of the reduced raw model: source vector plus arbitrary constant-axis
vectors. -/
def squareReducedRawModel (R : Type u) [CommRing R] : Submodule R (R × R × R) :=
  Submodule.span R ({squareSourceVec (R := R)} ∪ Set.range (constantAxisVec (R := R)))

/-- The entire reduced raw model is trapped in the defect hyperplane. -/
theorem squareReducedRawModel_le_hyperplane
    {R : Type u} [CommRing R] :
    squareReducedRawModel R ≤ squareHyperplane R := by
  apply Submodule.span_le.2
  intro v hv
  rcases hv with hv | hv
  · have : v = squareSourceVec (R := R) := by simpa using hv
    subst v
    exact squareSourceVec_mem_hyperplane
  · rcases hv with ⟨s, rfl⟩
    exact constantAxisVec_mem_hyperplane s

/-- Consequently the saturated binomial direction is not generated by the
reduced raw square-section model. -/
theorem binomialTwoVec_not_mem_reducedRawModel
    {R : Type u} [CommRing R] [Nontrivial R] :
    binomialTwoVec (R := R) ∉ squareReducedRawModel R := by
  intro h
  exact binomialTwoVec_not_mem_hyperplane
    (squareReducedRawModel_le_hyperplane h)

end KomorebiCrossRadix

#print axioms KomorebiCrossRadix.squareReducedRawModel_le_hyperplane
#print axioms KomorebiCrossRadix.binomialTwoVec_not_mem_reducedRawModel

namespace KomorebiCrossRadix

/-- A positive power of the radix `p` vanishes after reduction to `ZMod p`. -/
theorem zmod_radix_power_eq_zero (p e : Nat) (he : 0 < e) :
    ((p ^ e : Nat) : ZMod p) = 0 := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt he)
  rw [pow_succ]
  push_cast
  simp

/-- Every positive-depth base-`p` square section reduces into the constant-axis
part of the reduced raw model. -/
theorem positiveDepthSquareSection_mem_reducedRawModel_mod_radix
    (p e s : Nat) (he : 0 < e) :
    squareSectionVec (((p ^ e : Nat) : ZMod p)) (s : ZMod p) ∈
      squareReducedRawModel (ZMod p) := by
  have hB : ((p ^ e : Nat) : ZMod p) = 0 := zmod_radix_power_eq_zero p e he
  rw [squareSectionVec_of_width_eq_zero _ _ hB]
  apply Submodule.subset_span
  right
  exact ⟨(s : ZMod p), rfl⟩

/-- The exact generator set obtained by reducing the depth-zero square source
and all positive-depth valid base-`p` sections. -/
def squareRadixRawGeneratorsMod (p : Nat) : Set (ZMod p × ZMod p × ZMod p) :=
  {squareSourceVec (R := ZMod p)} ∪
    {v | ∃ e s : Nat, 0 < e ∧ s < p ^ e ∧
      v = squareSectionVec (((p ^ e : Nat) : ZMod p)) (s : ZMod p)}

/-- The reduced raw base-`p` square-section span is contained in the explicit
codimension-one model. -/
theorem squareRadixRawSpanMod_le_reducedRawModel (p : Nat) :
    Submodule.span (ZMod p) (squareRadixRawGeneratorsMod p) ≤
      squareReducedRawModel (ZMod p) := by
  apply Submodule.span_le.2
  intro v hv
  rcases hv with hv | hv
  · have hv' : v = squareSourceVec (R := ZMod p) := Set.mem_singleton_iff.mp hv
    subst v
    apply Submodule.subset_span
    left
    rfl
  · rcases hv with ⟨e, s, he, _hs, rfl⟩
    exact positiveDepthSquareSection_mem_reducedRawModel_mod_radix p e s he

/-- For a prime radix, the saturated binomial direction is genuinely absent
from the reduced raw section span. Thus the radix prime is a reduction defect
for the square sequence. -/
theorem primeRadix_square_binomial_direction_missing
    (p : Nat) [hp : Fact p.Prime] :
    binomialTwoVec (R := ZMod p) ∉
      Submodule.span (ZMod p) (squareRadixRawGeneratorsMod p) := by
  intro h
  have hmodel : binomialTwoVec (R := ZMod p) ∈ squareReducedRawModel (ZMod p) :=
    squareRadixRawSpanMod_le_reducedRawModel p h
  exact binomialTwoVec_not_mem_reducedRawModel hmodel

end KomorebiCrossRadix

#print axioms KomorebiCrossRadix.zmod_radix_power_eq_zero
#print axioms KomorebiCrossRadix.squareRadixRawSpanMod_le_reducedRawModel
#print axioms KomorebiCrossRadix.primeRadix_square_binomial_direction_missing
