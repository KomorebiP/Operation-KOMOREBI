\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The figure displays exact coefficient matrices for $d=2$, $m=3$. The combined row support of two seeds has rank three. The bar heights record algebraic orbit dimensions and should not be read as probabilities of unitary state preparation.}}{1}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{monograph:fig:seed_support}{{1}{1}{The figure displays exact coefficient matrices for $d=2$, $m=3$. The combined row support of two seeds has rank three. The bar heights record algebraic orbit dimensions and should not be read as probabilities of unitary state preparation}{figure.caption.1}{}}
\newlabel{monograph:fig:seed_support@cref}{{[figure][1][]1}{[1][1][]1}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces This rational model uses two coordinates to illustrate block inversion. Both the eliminated block and the full operator are invertible, and the plotted values are exact fractions. The example shows why direct compression and resolvent elimination give different results.}}{2}{figure.caption.2}\protected@file@percent }
\newlabel{monograph:fig:feshbach_compression}{{2}{2}{This rational model uses two coordinates to illustrate block inversion. Both the eliminated block and the full operator are invertible, and the plotted values are exact fractions. The example shows why direct compression and resolvent elimination give different results}{figure.caption.2}{}}
\newlabel{monograph:fig:feshbach_compression@cref}{{[figure][2][]2}{[1][2][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The figure shows exact weights for one supported code state. The normalized map preserves trace one, while the unnormalized positive map has output trace four. The illustration records this finite scaling distinction and does not assert a general recovery construction.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{monograph:fig:channel_scale}{{3}{3}{The figure shows exact weights for one supported code state. The normalized map preserves trace one, while the unnormalized positive map has output trace four. The illustration records this finite scaling distinction and does not assert a general recovery construction}{figure.caption.3}{}}
\newlabel{monograph:fig:channel_scale@cref}{{[figure][3][]3}{[1][3][]3}}
