open Lean Meta Elab Command

run_cmd do
  let env ← getEnv
  let mut audited : Nat := 0
  let mut theorems : Nat := 0
  for (name, info) in env.checked.get.constants.toList do
    if Name.isPrefixOf `Komorebi.PaperIV name then
      audited := audited + 1
      match info with
      | .thmInfo _ => theorems := theorems + 1
      | _ => pure ()
      if info.isUnsafe then
        throwError "unsafe Paper IV declaration: {name}"
      match info with
      | .axiomInfo _ =>
          throwError "Paper IV axiom declaration: {name}"
      | .opaqueInfo _ =>
          throwError "opaque Paper IV declaration: {name}"
      | _ => pure ()
      let axioms ← Lean.collectAxioms name
      for axiomName in axioms do
        unless axiomName == ``propext || axiomName == ``Classical.choice ||
            axiomName == ``Quot.sound do
          throwError "unexpected axiom {axiomName} in Paper IV declaration {name}"
  if audited != 2234 then
    throwError "Paper IV namespace declaration count changed: expected 2234, found {audited}"
  if theorems != 1999 then
    throwError "Paper IV namespace theorem count changed: expected 1999, found {theorems}"
  logInfo m!"FAIL-CLOSED PAPER IV v1.0.0 KERNEL AUDIT PASS: {audited} declarations ({theorems} theoremInfo); 1164 explicit mapped targets; allowed axioms only: propext, Classical.choice, Quot.sound"
