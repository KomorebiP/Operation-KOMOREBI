--- second_block/formalization/lean/KomorebiPaperVI/BanachDefects.lean
+++ third_block/formalization/lean/KomorebiPaperVI/BanachDefects.lean
@@ -0,0 +1,47 @@
+import KomorebiPaperVI.Semigroups
+
+/-! Author: Komorebi P. Duhamel defects in a real Banach algebra. -/
+namespace KomorebiPaperVI.BanachDefects
+open KomorebiPaperVI.Semigroups
+variable {R : Type*} [NormedRing R] [NormedAlgebra ℝ R] [CompleteSpace R]
+
+theorem duhamel_derivative (A B C : R) (t r : ℝ) :
+    HasDerivAt (fun u => transfer B (t-u)*C*transfer A u)
+      (transfer B (t-r)*(C*A-B*C)*transfer A r) r := by
+  have hsub : HasDerivAt (fun u : ℝ => t-u) (-1) r := by
+    convert! (hasDerivAt_const r t).sub (hasDerivAt_id r) using 1
+    simp
+  have hB : HasDerivAt (fun u : ℝ => transfer B (t-u))
+      ((-1:ℝ) • (transfer B (t-r)*B)) r := (transfer_derivative_right B (t-r)).scomp r
+    hsub
+  convert! (hB.mul_const C).mul (transfer_derivative_left A r) using 1
+  simp only [neg_smul,one_smul]
+  noncomm_ring
+
+theorem duhamel (A B C : R) (t : ℝ) :
+    C*transfer A t-transfer B t*C=
+      ∫ r in 0..t,transfer B (t-r)*(C*A-B*C)*transfer A r := by
+  have hc : Continuous (fun r => transfer B (t-r)*(C*A-B*C)*transfer A r) := by fun_prop
+  have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
+    (fun r _ => duhamel_derivative A B C t r) (hc.intervalIntegrable 0 t)
+  simpa only [sub_self,transfer_zero,zero_sub,sub_zero,one_mul,mul_one] using h.symm
+
+theorem contraction_bound (A B C : R) (t : ℝ) (ht : 0 ≤ t)
+    (hA : ∀ r,0 ≤ r → ‖transfer A r‖ ≤ 1)
+    (hB : ∀ r,0 ≤ r → ‖transfer B r‖ ≤ 1) :
+    ‖C*transfer A t-transfer B t*C‖ ≤ t*‖C*A-B*C‖ := by
+  rw [duhamel]
+  have hc : Continuous (fun r => transfer B (t-r)*(C*A-B*C)*transfer A r) := by fun_prop
+  calc
+    _ ≤ ∫ r in 0..t,‖transfer B (t-r)*(C*A-B*C)*transfer A r‖ :=
+      intervalIntegral.norm_integral_le_integral_norm ht
+    _ ≤ ∫ _ in 0..t,‖C*A-B*C‖ := by
+      apply intervalIntegral.integral_mono_on ht (hc.norm.intervalIntegrable 0 t) intervalIntegrable_const
+      intro r hr
+      calc
+        _ ≤ ‖transfer B (t-r)‖*‖C*A-B*C‖*‖transfer A r‖ := norm_mul_le_of_le (norm_mul_le _ _) le_rfl
+        _ ≤ 1*‖C*A-B*C‖*1 := by gcongr; exact hB (t-r) (by linarith [hr.2]); exact hA r hr.1
+        _ = _ := by ring
+    _ = _ := by simp [smul_eq_mul]
+
+end KomorebiPaperVI.BanachDefects
--- second_block/formalization/lean/KomorebiPaperVI/ContourNaturality.lean
+++ third_block/formalization/lean/KomorebiPaperVI/ContourNaturality.lean
@@ -0,0 +1,80 @@
+import KomorebiPaperVI.Algebra
+import Mathlib.MeasureTheory.Integral.CircleIntegral
+import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
+
+/-! Author: Komorebi P. Actual finite contour integrals of matrix resolvents.
+This module proves naturality for a supplied common contour representation. -/
+namespace KomorebiPaperVI.ContourNaturality
+open scoped BigOperators
+open Complex
+set_option backward.isDefEq.respectTransparency false
+variable {I J K : Type*} [Fintype I] [Fintype J] [Fintype K] [DecidableEq I] [DecidableEq J]
+
+noncomputable def resolvent (A : Matrix I I ℂ) (z : ℂ) : Matrix I I ℂ :=
+  (Matrix.scalar I z-A)⁻¹
+
+noncomputable def circleMatrix (F : ℂ → Matrix I J ℂ) (c : ℂ) (r : ℝ) : Matrix I J ℂ :=
+  fun i j => ∮ z in C(c,r),F z i j
+
+omit [DecidableEq I] [DecidableEq J] [Fintype J] [Fintype K] in
+theorem circle_mul_left (C : Matrix K I ℂ) (F : ℂ → Matrix I J ℂ) (c : ℂ) (r : ℝ)
+    (hF : ∀ i j,CircleIntegrable (fun z => F z i j) c r) :
+    C*circleMatrix F c r=circleMatrix (fun z => C*F z) c r := by
+  ext i j
+  simp only [Matrix.mul_apply,circleMatrix]
+  have hi (k : I) : CircleIntegrable (fun z => C i k*F z k j) c r := by
+    convert! (hF k j).const_smul (a := C i k) using 1
+  rw [circleIntegral.integral_fun_sum (fun k _ => hi k)]
+  simp only [circleIntegral.integral_const_mul]
+
+omit [DecidableEq I] [DecidableEq J] [Fintype I] [Fintype K] in
+theorem circle_mul_right (C : Matrix J K ℂ) (F : ℂ → Matrix I J ℂ) (c : ℂ) (r : ℝ)
+    (hF : ∀ i j,CircleIntegrable (fun z => F z i j) c r) :
+    circleMatrix F c r*C=circleMatrix (fun z => F z*C) c r := by
+  ext i j
+  simp only [Matrix.mul_apply,circleMatrix]
+  have hi (k : J) : CircleIntegrable (fun z => F z i k*C k j) c r := by
+    have hc : CircleIntegrable (fun z => C k j*F z i k) c r := by
+      convert! (hF i k).const_smul (a := C k j) using 1
+    simpa only [mul_comm] using hc
+  rw [circleIntegral.integral_fun_sum (fun k _ => hi k)]
+  simp only [mul_comm,circleIntegral.integral_const_mul]
+
+omit [Fintype K] in
+theorem resolvent_intertwines (C : Matrix J I ℂ) (A : Matrix I I ℂ) (B : Matrix J J ℂ)
+    (h : C*A=B*C) (z : ℂ) (hA : IsUnit (Matrix.scalar I z-A))
+    (hB : IsUnit (Matrix.scalar J z-B)) : C*resolvent A z=resolvent B z*C := by
+  have he := Algebra.rectangular_resolvent_identity C A B (resolvent A z) (resolvent B z) z
+    (fun i j => mul_comm _ _)
+    (Matrix.mul_nonsing_inv _ ((Matrix.isUnit_iff_isUnit_det _).mp hA))
+    (Matrix.nonsing_inv_mul _ ((Matrix.isUnit_iff_isUnit_det _).mp hB))
+  simpa only [h,sub_self,Matrix.mul_zero,Matrix.zero_mul,sub_eq_zero] using he
+
+noncomputable def calculus (A : Matrix I I ℂ) (f : ℂ → ℂ) (c : K → ℂ) (r : K → ℝ) :
+    Matrix I I ℂ := ((2*Real.pi:ℂ)*Complex.I)⁻¹ •
+      ∑ k,circleMatrix (fun z => f z • resolvent A z) (c k) (r k)
+
+theorem common_contour_naturality (C : Matrix J I ℂ) (A : Matrix I I ℂ) (B : Matrix J J ℂ)
+    (h : C*A=B*C) (f : ℂ → ℂ) (c : K → ℂ) (r : K → ℝ) (hr : ∀ k,0 ≤ r k)
+    (hA : ∀ k z,z∈Metric.sphere (c k) (r k) → IsUnit (Matrix.scalar I z-A))
+    (hB : ∀ k z,z∈Metric.sphere (c k) (r k) → IsUnit (Matrix.scalar J z-B))
+    (hiA : ∀ k i j,CircleIntegrable (fun z => f z*resolvent A z i j) (c k) (r k))
+    (hiB : ∀ k i j,CircleIntegrable (fun z => f z*resolvent B z i j) (c k) (r k)) :
+    C*calculus A f c r=calculus B f c r*C := by
+  unfold calculus
+  rw [Matrix.mul_smul,Matrix.smul_mul,Matrix.mul_sum,Matrix.sum_mul]
+  congr 1
+  apply Finset.sum_congr rfl
+  intro k _
+  have ha : ∀ i j,CircleIntegrable (fun z => (f z • resolvent A z) i j) (c k) (r k) := hiA k
+  have hb : ∀ i j,CircleIntegrable (fun z => (f z • resolvent B z) i j) (c k) (r k) := hiB k
+  rw [circle_mul_left C (fun z => f z • resolvent A z) _ _ ha,
+    circle_mul_right C (fun z => f z • resolvent B z) _ _ hb]
+  ext i j
+  apply circleIntegral.integral_congr (hr k)
+  intro z hz
+  have he := resolvent_intertwines C A B h z (hA k z hz) (hB k z hz)
+  change (C*(f z • resolvent A z)) i j=((f z • resolvent B z)*C) i j
+  rw [Matrix.mul_smul,Matrix.smul_mul,he]
+
+end KomorebiPaperVI.ContourNaturality
--- second_block/formalization/lean/KomorebiPaperVI/DiscreteGreen.lean
+++ third_block/formalization/lean/KomorebiPaperVI/DiscreteGreen.lean
@@ -0,0 +1,131 @@
+import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
+import Mathlib.Data.Matrix.Basic
+import Mathlib.Tactic
+
+/-! Author: Komorebi P. The literal Dirichlet tridiagonal inverse at every grid size. -/
+namespace KomorebiPaperVI.DiscreteGreen
+open scoped BigOperators
+set_option backward.isDefEq.respectTransparency false
+
+noncomputable def green (N : ℝ) (i j : ℕ) : ℝ :=
+  min (i:ℝ) (j:ℝ)-(i:ℝ)*(j:ℝ)/N
+
+theorem green_zero (N : ℝ) (j : ℕ) : green N 0 j=0 := by simp [green]
+
+theorem green_end (n j : ℕ) (hj : j  ≤  n+1) : green (n+1) (n+1) j=0 := by
+  have h : (j:ℝ)  ≤  n+1 := by exact_mod_cast hj
+  have hn : (n:ℝ)+1≠0 := by positivity
+  simp only [green,Nat.cast_add,Nat.cast_one,min_eq_right h]
+  field_simp
+  ring
+
+theorem green_second_difference (N : ℝ) (i j : ℕ) :
+    2*green N (i+1) j-green N i j-green N (i+2) j=if i+1=j then 1 else 0 := by
+  unfold green
+  by_cases ha : j  ≤  i
+  · have h0 : (j:ℝ) ≤ i := by exact_mod_cast ha
+    have h1 : (j:ℝ) ≤ (i+1:ℕ) := by exact_mod_cast (show j ≤ i+1 by omega)
+    have h2 : (j:ℝ) ≤ (i+2:ℕ) := by exact_mod_cast (show j ≤ i+2 by omega)
+    rw [min_eq_right h1,min_eq_right h0,min_eq_right h2,ite_eq_right (by omega)]
+    push_cast
+    ring
+  · by_cases hb : j=i+1
+    · subst j
+      have h0 : (i:ℝ) ≤ (i+1:ℕ) := by exact_mod_cast (show i ≤ i+1 by omega)
+      have h2 : ((i+1:ℕ):ℝ) ≤ (i+2:ℕ) := by exact_mod_cast (show i+1 ≤ i+2 by omega)
+      rw [min_self,min_eq_left h0,min_eq_right h2,ite_eq_left rfl]
+      push_cast
+      ring
+    · have h0 : (i:ℝ) ≤ j := by exact_mod_cast (show i ≤ j by omega)
+      have h1 : ((i+1:ℕ):ℝ) ≤ j := by exact_mod_cast (show i+1 ≤ j by omega)
+      have h2 : ((i+2:ℕ):ℝ) ≤ j := by exact_mod_cast (show i+2 ≤ j by omega)
+      rw [min_eq_left h1,min_eq_left h0,min_eq_left h2,ite_eq_right (by omega)]
+      push_cast
+      ring
+
+noncomputable def tridiagonal (n : ℕ) : Matrix (Fin n) (Fin n) ℝ := fun i j =>
+  (if i=j then 2 else 0)-(if j.val=i.val+1 then 1 else 0)-(if j.val+1=i.val then 1 else 0)
+
+noncomputable def inverseKernel (n : ℕ) : Matrix (Fin n) (Fin n) ℝ :=
+  fun i j => green (n+1) (i.val+1) (j.val+1)
+
+theorem sparse_sum (n q : ℕ) (v : Fin n → ℝ) :
+    (∑ k : Fin n, if k.val=q then v k else 0)=if h:q < n then v ⟨q,h⟩ else 0 := by
+  classical
+  split_ifs with h
+  · rw [Finset.sum_eq_single (⟨q,h⟩ : Fin n)]
+    · simp
+    · intro k _ hk
+      exact ite_eq_right (by intro he; apply hk; exact Fin.ext he)
+    · simp
+  · apply Finset.sum_eq_zero
+    intro k _
+    exact ite_eq_right (by omega)
+
+theorem tridiagonal_mul (n : ℕ) (M : Matrix (Fin n) (Fin n) ℝ) (i j : Fin n) :
+    (tridiagonal n*M) i j=2*M i j-
+      (if h:i.val+1 < n then M ⟨i.val+1,h⟩ j else 0)-
+      (if h:0 < i.val then M ⟨i.val-1,by omega⟩ j else 0) := by
+  classical
+  simp only [Matrix.mul_apply,tridiagonal,sub_mul,Finset.sum_sub_distrib,ite_mul,one_mul,zero_mul]
+  rw [Finset.sum_ite_eq,sparse_sum]
+  simp only [Finset.mem_univ,ite_true]
+  congr 1
+  by_cases h:0 < i.val
+  · rw [dite_eq_left h,Finset.sum_eq_single (⟨i.val-1,by omega⟩ : Fin n)]
+    · simp [show i.val-1+1=i.val by omega]
+    · intro k _ hk
+      exact ite_eq_right (by intro he; apply hk; apply Fin.ext; change k.val=i.val-1; omega)
+    · simp
+  · rw [dite_eq_right h]
+    apply Finset.sum_eq_zero
+    intro k _
+    exact ite_eq_right (by omega)
+
+theorem tridiagonal_inverse_kernel (n : ℕ) : tridiagonal n*inverseKernel n=1 := by
+  ext i j
+  rw [tridiagonal_mul]
+  have h := green_second_difference (n+1) i.val (j.val+1)
+  have hu : (if h:i.val+1 < n then inverseKernel n ⟨i.val+1,h⟩ j else 0)=
+      green (n+1) (i.val+2) (j.val+1) := by
+    split_ifs with hi
+    · rfl
+    · have he : i.val+2=n+1 := by omega
+      rw [he,green_end n (j.val+1) (by omega)]
+  have hd : (if h:0 < i.val then inverseKernel n ⟨i.val-1,by omega⟩ j else 0)=
+      green (n+1) i.val (j.val+1) := by
+    split_ifs with hi
+    · simp only [inverseKernel]
+      congr 1
+      omega
+    · have he : i.val=0 := by omega
+      rw [he,green_zero]
+  rw [hu,hd]
+  simp only [inverseKernel,Matrix.one_apply]
+  have he : (i.val+1=j.val+1) ↔ i=j := by constructor  <;> intro hh; exact Fin.ext (by omega); subst j; rfl
+  simp only [he] at h
+  linarith
+
+theorem inverse_eq_kernel (n : ℕ) : (tridiagonal n)⁻¹=inverseKernel n := by
+  exact Matrix.inv_eq_right_inv (tridiagonal_inverse_kernel n)
+
+noncomputable def laplacian (n : ℕ) : Matrix (Fin n) (Fin n) ℝ :=
+  ((n:ℝ)+1)^2 • tridiagonal n
+
+theorem laplacian_inverse (n : ℕ) :
+    (laplacian n)⁻¹=(((n:ℝ)+1)^2)⁻¹ • inverseKernel n := by
+  apply Matrix.inv_eq_right_inv
+  rw [laplacian,smul_mul_smul_comm,tridiagonal_inverse_kernel]
+  have hn : ((n:ℝ)+1)^2≠0 := by positivity
+  simp [hn]
+
+theorem grid_reconstruction (n : ℕ) (i j : Fin n) :
+    ((n:ℝ)+1)*(laplacian n)⁻¹ i j=
+      min (((i.val:ℝ)+1)/((n:ℝ)+1)) (((j.val:ℝ)+1)/((n:ℝ)+1))-
+        (((i.val:ℝ)+1)/((n:ℝ)+1))*(((j.val:ℝ)+1)/((n:ℝ)+1)) := by
+  rw [laplacian_inverse]
+  simp only [Matrix.smul_apply,smul_eq_mul,inverseKernel,green,Nat.cast_add,Nat.cast_one]
+  rw [min_div_div_right (by positivity)]
+  field_simp
+
+end KomorebiPaperVI.DiscreteGreen
