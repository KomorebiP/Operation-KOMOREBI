+  change IntegrableOn _ _ μ ∧ _
+  nontriviality A
+  have p_pos : 0 < (p : ℝ) := by exact_mod_cast hp.1
+  let f t := rpowIntegrand₀₁ p t
+  let maxr := sSup (quasispectrum ℝ a)
+  have maxr_nonneg : 0 ≤ maxr :=
