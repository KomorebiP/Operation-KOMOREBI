  let mut audited : Nat := 0
  for (name, info) in env.checked.get.constants.toList do
    if Name.isPrefixOf `KomorebiPaperVI name then
      audited := audited + 1
      if info.isUnsafe then
        throwError "unsafe declaration: {name}"
      match info with
      | .axiomInfo _ => throwError "axiom declaration: {name}"
      | .opaqueInfo _ => throwError "opaque declaration: {name}"
      | _ => pure ()
      let axioms ← Lean.collectAxioms name
